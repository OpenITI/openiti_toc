    },
    "2": {
      "title": ": \" الحمد لله نستعينه ونستغفره , ونعوذ بالله من شرور أنفسنا , من يهد الله فلا مضل له ومن يضلل",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
