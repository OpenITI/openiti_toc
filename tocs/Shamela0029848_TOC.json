    },
    "2": {
      "title": ": \" أخبر الناس أنه من قال: لا إله إلا الله وجبت له الجنة \"",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "3": {
      "title": "2 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "4": {
      "title": ": من قال لا إله إلا الله وجبت له الجنة \".",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "5": {
      "title": "3 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "6": {
      "title": ": صليت مع ابن عمر رضي الله عنهما، فجمع المغرب بآذان، فلما فرغ، قال: الصلاة، فصلى بنا العشاء",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "7": {
      "title": "4 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 2
    },
    "8": {
      "title": ": «نور بالفجر قدر ما يبصر الرجل مواقع نبله»",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "9": {
      "title": "5 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "10": {
      "title": ": أصبت يوم خيبر قلادة فيها ذهب وخرز، فأردت بيعها، فذكرت ذلك للنبي صلى الله عليه وسلم، قال:",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "11": {
      "title": "6 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "12": {
      "title": "، قد تمتعنا مع رسول الله صلى الله عليه وسلم، فلم ينهنا عن متعة بعد الحج» .",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "13": {
      "title": "7 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "14": {
      "title": "، أيرجع كل أهلك بحجة وعمرة غيري.",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 3
    },
    "15": {
      "title": "8 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "16": {
      "title": "، إنما نهينا عن الشعر إذا ما رزئت فيه للأموال وأتيت فيه النساء، وإنا لسنا نفعل ذلك، فانطلق",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "17": {
      "title": "9 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "18": {
      "title": "يتناشدون الشعر»",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "19": {
      "title": "10 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "20": {
      "title": "، أنه اشترى من علي رضي الله عنه ديباجا منسوجا بالذهب بأربعة ألف درهم ليخرج عطاؤه، قال: فقبض",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "21": {
      "title": "11 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "22": {
      "title": "عن المتعة من أجل هذا البلد، ليكون موسمان في عام ليصيب أهل مكة من منفعتها",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 4
    },
    "23": {
      "title": "12 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "24": {
      "title": ": «لا يؤم أحد بعدي جالسا»",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "25": {
      "title": "13 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "26": {
      "title": "إذا سافر أمر عليا رضي الله عنه أن يثلم الحيطان ليأكل الناس من التمر»",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 5
    },
    "27": {
      "title": "14 ms4 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "28": {
      "title": "«صلى على قبر رطب» .",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "29": {
      "title": "15 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "30": {
      "title": ": «إن الحياء شعبة من شعب الإيمان، ولا إيمان لمن لا حياء له، وإنما يدرك الخير كله بالعقل، ولا",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "31": {
      "title": "16 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "32": {
      "title": "عن المتعة، فقال: نهى عثمان بن عفان رضي الله عنه \"",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "33": {
      "title": "17 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "34": {
      "title": ": «أثقل شيء وضع في الميزان حسن الخلق»",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "35": {
      "title": "18 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "36": {
      "title": "، «أن زيدا جاء إلى رسول الله صلى الله عليه وسلم يشكو زوجه، فأمره أن",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "37": {
      "title": "19 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "38": {
      "title": ": «كانت المتعة لنا أصحاب رسول الله صلى الله عليه وسلم خاصة»",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 6
    },
    "39": {
      "title": "20 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "40": {
      "title": "عبدا وجد ركزة في عهد عمر رضي الله عنه، فأخذها منه عمر، وابتاعها منها فأعتقه، فأعطاه منها",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "41": {
      "title": "21 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "42": {
      "title": "«بعثه وجواري خيبر، وكان بدريا، سرية وحده»",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "43": {
      "title": "22 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "44": {
      "title": "«بايع النساء وعلى يده ثوب»",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "45": {
      "title": "23 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "46": {
      "title": ": «إن هذه القبور مملوءة ظلمة على أهلها، وإن الله عز وجل ينور عليهم فيها بصلاتي",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "47": {
      "title": "24 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "48": {
      "title": ": جاء رجل من حضر موت ورجل من كندة إلى رسول الله صلى الله عليه وسلم، فقال الحضرمي: يا رسول",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": null
    }
