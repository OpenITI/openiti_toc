      "end_ms": 36
    },
    "23": {
      "title": "AUTO قوله: \"هل تجد رقبة تعتقها؟ قال: لا\":",
      "level": 2,
      "parent": 19,
      "start_ms": 36,
      "end_ms": 36
    },
    "24": {
      "title": "AUTO قوله: \"فهل تستطع أن تصوم شهرين متتابعين؟ قال: لا\":",
      "level": 2,
      "parent": 19,
      "start_ms": 36,
      "end_ms": 36
    },
    "25": {
      "title": "AUTO قوله: \"فهل تجد إطعام ستين مسكينا؟ قال: لا\":",
      "level": 2,
      "parent": 19,
      "start_ms": 36,
      "end_ms": 36
    },
    "26": {
      "title": "AUTO قوله: \"فسكت النبي صلى الله عليه وسلم فبينا نحن على ذلك\":",
      "level": 2,
      "parent": 19,
      "start_ms": 36,
      "end_ms": 36
    },
    "27": {
      "title": "AUTO قوله: \"أتي النبي صلى الله عليه وسلم بعرق فيه تمر\":",
      "level": 2,
      "parent": 19,
      "start_ms": 36,
      "end_ms": 36
    },
    "28": {
      "title": "AUTO قوله: \"خذ هذا فتصدق به\":",
      "level": 2,
      "parent": 19,
      "start_ms": 36,
      "end_ms": 37
    },
    "29": {
      "title": "AUTO قوله: \"فقال الرجل: أعلى أفقر مني؟ \":",
      "level": 2,
      "parent": 19,
      "start_ms": 37,
      "end_ms": 37
    },
    "30": {
      "title": "AUTO قوله: \"فوالله ما بين لابتيها -يريد الحرتين-\":",
      "level": 2,
      "parent": 19,
      "start_ms": 37,
      "end_ms": 37
    },
    "31": {
      "title": "AUTO قوله: \"أفقر من أهل بيتي! \":",
      "level": 2,
      "parent": 19,
      "start_ms": 37,
      "end_ms": 37
    },
    "32": {
      "title": "AUTO قوله: \"فضحك النبي صلى الله عليه وسلم حتى بدت أنيابه\":",
