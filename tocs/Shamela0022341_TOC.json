    "2": {
      "title": ": ماذا معك من القرآن؟ قال: معي سورة كذا وسورة كذا عددها، قال: تقرؤهن عن ظهر قلبك؟ قال: نعم،",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "3": {
      "title": "2 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "4": {
      "title": ": ما تحفظ من القرآن؟ قال: سورة البقرة، أو التي تليها، قال: قم فعلمها عشرين آية وهي",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "5": {
      "title": "3 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 3
    },
    "6": {
      "title": ": زوج رسول الله ms2 صلى الله عليه وسلم، رجلا من أصحابه على سور من المفصل جعله مهرها وأدخلها",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "7": {
      "title": "4 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "8": {
      "title": ": هل لها زوج؟ قال: لا.",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 4
    },
    "9": {
      "title": "5 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "10": {
      "title": "وخطب علي فأنكحني، وخاصمت إليه؛ كان أبي يزيد أخرج دنانير يتصدق بها فوضعها عند رجل في",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "11": {
      "title": "6 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "12": {
      "title": ": زوجه النبي صلى الله عليه وسلم، أم كلثوم بعد رقية، وقال: لو كان عندي ثالثة لزوجتها",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "13": {
      "title": "7 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 5
    },
    "14": {
      "title": ": من خطبني إليكما، قالا: رسول الله صلى الله عليه وسلم، قالت: أفتردون على رسول الله صلى الله",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 6
    },
    "15": {
      "title": "8 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 7
    },
    "16": {
      "title": ": تسبحان في دبر كل صلاة عشرا، وتحمدان عشرا، وتكبران عشرا، فإذا أويتما إلى فراشكما فسبحا",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "17": {
      "title": "9 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "18": {
      "title": "تزوجت فاطمة وما لي ولها فراش غير جلد كبش ننام عليه بالليل ونعلق عليه الناضح بالنهار وما",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": null
    }
