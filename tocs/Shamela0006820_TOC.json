  "sections": {
    "1": {
      "title": "فصل الرأى المحدث في الأصول وهو الكلام المحدث وفي الفروع وهو الرأى",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 12
    },
    "2": {
      "title": "فصل فيما اختلف فيه المؤمنون من الأقوال والافعال في الأصول والفروع",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 22
    },
    "3": {
      "title": "فصل مهم عظيم القدر في هذا الباب وذلك أن طوائف كبيرة من أهل",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 31
    },
    "4": {
      "title": "فصل وكذلك لفظ الحركة أثبته طوائف من أهل السنة والحديث وهو الذي ذكره",
      "level": 1,
      "parent": null,
      "start_ms": 31,
      "end_ms": 34
    },
    "5": {
      "title": "فصل وقد اعترف أكثر أئمة أهل الكلام والفلسفة من الأولين والآخرين بأن",
      "level": 1,
      "parent": null,
      "start_ms": 34,
      "end_ms": 35
    },
    "6": {
      "title": "فصل فيما ذكره الشيخ أبو القاسم القشيرى في رسالته المشهورة من اعتقاد",
      "level": 1,
      "parent": null,
      "start_ms": 35,
      "end_ms": 87
    },
    "7": {
      "title": "فصل قال أبو القاسم وقال ابن عطاء لما خلق الله الأحرف جعلها سرا فلما",
