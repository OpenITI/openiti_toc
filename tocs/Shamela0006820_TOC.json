    "13": {
      "title": "فصل في السكر واسبابه وأحكامه",
      "level": 1,
      "parent": null,
      "start_ms": 278,
      "end_ms": 281
    },
    "14": {
      "title": "فصل ومن أقوى الأسباب المقتضية للسكر سماع الأصوات المريبة من وجهين من",
      "level": 1,
      "parent": null,
      "start_ms": 281,
      "end_ms": 281
    },
    "15": {
      "title": "فصل اذا تبين هذا فاعلم ان اللذة والسرور امر مطلوب بل هو مقصود",
      "level": 1,
      "parent": null,
      "start_ms": 281,
      "end_ms": 283
    },
    "16": {
      "title": "فصل واذا كانت اللذة مطلوبة لنفسها فهي انما تذم اذا اعقبت الما اعظم",
      "level": 1,
      "parent": null,
      "start_ms": 283,
      "end_ms": 286
    },
    "17": {
      "title": "فصل فإذا تبين ان السكر مؤلف من امرين وجودي وهو اللذة وعدمي وهو عدم",
      "level": 1,
      "parent": null,
      "start_ms": 286,
      "end_ms": 287
    },
    "18": {
      "title": "فصل فإذا تبين أن جنس عدم العقل والفقه لا يحمد بحال في الشرع بل",
      "level": 1,
      "parent": null,
      "start_ms": 287,
      "end_ms": 288
    },
    "19": {
      "title": "فصل فهكذا زوال العقل بالسكر هو من نوع زواله بالإغماء والجنون ونحو",
      "level": 1,
      "parent": null,
      "start_ms": 288,
      "end_ms": 289
    },
    "20": {
      "title": "فصل فقد تبين ان احد وصفي السكر منفعة في الاصل والوصف الاخر اثم كما",
      "level": 1,
      "parent": null,
      "start_ms": 289,
      "end_ms": 291
    },
    "21": {
      "title": "فصل قال الله تعالى لما اهبط آدم ومن معه الى الارض",
      "level": 1,
      "parent": null,
      "start_ms": 291,
      "end_ms": 302
    },
