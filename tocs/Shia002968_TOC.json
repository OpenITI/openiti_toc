      "start_ms": 49,
      "end_ms": 49
    },
    "33": {
      "title": "ومنها: أن يكون ممن يترك رواية الثقة أو الجليل، أو تؤول (3) محتجا بروايته ومرجحا لها عليها. وكذا لو خصص الكتاب أو المجمع عليه بها.",
      "level": 3,
      "parent": 23,
      "start_ms": 49,
      "end_ms": 49
    },
    "34": {
      "title": "ومنها: أن يؤتى بروايته بإزاء روايتهما (5) أو غيرهما من الأدلة فتوجه وتجمع بينهما أو تطرح من غير جهته.",
      "level": 3,
      "parent": 23,
      "start_ms": 49,
      "end_ms": 50
    },
    "35": {
      "title": "ومنها: كونه كثير الرواية.",
      "level": 3,
      "parent": 23,
      "start_ms": 50,
      "end_ms": 50
    },
    "36": {
      "title": "ومنها: كونه ممن يروي عنه أو عن كتابه جماعة من الأصحاب.",
      "level": 3,
      "parent": 23,
      "start_ms": 50,
      "end_ms": 50
    },
    "37": {
      "title": "ومنها: روايته عن جماعة من الأصحاب.",
      "level": 3,
      "parent": 23,
      "start_ms": 50,
      "end_ms": 50
    },
    "38": {
