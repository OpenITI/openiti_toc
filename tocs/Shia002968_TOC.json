    },
    "39": {
      "title": "ومنها: رواية صفوان بن يحيى أو ابن أبي عمير عنه؛",
      "level": 3,
      "parent": 23,
      "start_ms": 50,
      "end_ms": 51
    },
    "40": {
      "title": "ومنها: رواية محمد بن إسماعيل بن ميمون أو جعفر بن بشير عنه، أو روايته عنهما؛",
      "level": 3,
      "parent": 23,
      "start_ms": 51,
      "end_ms": 51
    },
    "41": {
      "title": "ومنها: كونه ممن يروي عن الثقات؛",
      "level": 3,
      "parent": 23,
      "start_ms": 51,
      "end_ms": 51
    },
    "42": {
      "title": "ومنها: رواية علي بن حسن بن فضال ومن ماثله عن شخص؛",
      "level": 3,
      "parent": 23,
      "start_ms": 51,
      "end_ms": 51
    },
    "43": {
      "title": "ومنها: كونه ممن يكثر الرواية عنه ويفتى بها؛",
      "level": 3,
      "parent": 23,
      "start_ms": 51,
      "end_ms": 51
    },
    "44": {
      "title": "ومنها: كثرة رواية الثقة عن شخص مشترك الاسم وإكثاره منها، مع عدم إتيانه بما يميزه عن الثقة؛",
      "level": 3,
      "parent": 23,
      "start_ms": 51,
      "end_ms": 51
    },
    "45": {
      "title": "ومنها: اعتماد شيخ على شخص،",
      "level": 3,
      "parent": 23,
      "start_ms": 51,
      "end_ms": 51
    },
    "46": {
      "title": "ومنها: اعتماد القميين أو روايتهم عنه؛",
