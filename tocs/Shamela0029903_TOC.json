    },
    "8": {
      "title": "\" لما رمى الجمرة ناول الحلاق رأسه فناوله الشق الأيمن فأعطاه أبا طلحة، ثم ناوله الشق الأيسر",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
