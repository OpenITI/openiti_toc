      "end_ms": 2
    },
    "6": {
      "title": ": دخل النبي صلى الله عليه وسلم المسجد فإذا حبل ممدود، فقال: «ما هذا؟» فقيل: فلانة تصلي، فإذا",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
