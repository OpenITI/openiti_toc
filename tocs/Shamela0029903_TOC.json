      "start_ms": 3,
      "end_ms": 3
    },
    "12": {
      "title": ": إن الله عز وجل خلق خلقه في ظلمة، ثم ألقى عليه من نوره، فمن أصابه يومئذ شيء من النور",
      "level": 1,
