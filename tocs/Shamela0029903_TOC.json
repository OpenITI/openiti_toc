    },
    "10": {
      "title": ": لا حسد إلا في اثنتين: رجل أتاه الله عز وجل القرآن فهو يقوم به آناء الليل والنهار، ورجل",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "11": {
      "title": "6 - 0 -",
      "level": 1,
