      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "105": {
      "title": "53 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "106": {
      "title": "لقد ذكرتني بقراءتك المرسلات، إن آخر ما سمعت رسول الله صلى الله عليه وسلم يقرأ في المغرب",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "107": {
      "title": "54 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "108": {
      "title": ": «طاف النبي صلى الله عليه وسلم بالبيت ثلاثة أسباع جميعا ثم أتى المقام فصلى خلفه ست ركعات",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "109": {
      "title": "55 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 13
    },
    "110": {
      "title": ": «شهدت وأنا غلام مع عمومتي حلف المطيبين فما أحب أن أنكثه وإن لي حمر",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "111": {
      "title": "56 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "112": {
      "title": "امرأة من اليهود أهدت لرسول الله صلى الله عليه وسلم شاة مسمومة فقال لأصحابه: «أمسكوا فإنها",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "113": {
      "title": "57 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "114": {
      "title": "نفقتك على أهلك لك صدقة، وإن نفقتك على عيالك لك صدقة , حتى اللقمة تضعها في في امرأتك، وإنك",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 14
    },
    "115": {
      "title": "58 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "116": {
      "title": ": «إذا قرب العشاء وأحدكم صائم فليبدأ به قبل الصلاة صلاة المغرب ولا تعجلوا عن",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "117": {
      "title": "59 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "118": {
      "title": ": «إذا حضر الطعام والصلاة فابدءوا بالطعام حتى تأتوا الصلاة وأنتم تعرفون»",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "119": {
      "title": "60 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "120": {
      "title": ": «إذا علم أحدكم من أخيه خيرا فليعلمه ذلك ليزداد فيه رغبة»",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "121": {
      "title": "61 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "122": {
      "title": ": «رأيت النبي صلى الله عليه وسلم توضأ ثلاثا ثلاثا، وتوضأت ثلاثا ثلاثا»",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "123": {
      "title": "62 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "124": {
      "title": "«ورث امرأة أشيم في عقل زوجها»",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "125": {
      "title": "63 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "126": {
      "title": ": لما جاء البشير إلى يعقوب عليه السلام، قال: «ما وجدت عندنا شيئا وما اختبزنا منذ سبعة أيام",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 15
    },
    "127": {
      "title": "64 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "128": {
      "title": "«دية اليهودي والنصراني أربعة ألاف، والمجوسي بمائة»",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "129": {
      "title": "65 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "130": {
      "title": "تصدقن ولو من حليكن وأكثر حطب جهنم أنتن» .",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "131": {
      "title": "66 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 16
    },
    "132": {
      "title": ": «أيما امرأة نكحت بغير إذن وليها فنكاحها باطل ولها الذي أعطاها بما أصاب منها، فإن ms15 اشتجروا",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "133": {
      "title": "67 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "134": {
      "title": "إذا أراد سفرا أقرع بين نسائه، فأيهن خرج سهمها أخرج بها معه»",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "135": {
      "title": "68 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "136": {
      "title": "من الشعر حكمة»",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "137": {
      "title": "69 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "138": {
      "title": ": «لا يقولن أحدكم خبثت نفسي، ولكن ليقل لقست نفسي»",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "139": {
      "title": "70 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "140": {
      "title": ": «توضئي مما مست النار»",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "141": {
      "title": "71 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "142": {
      "title": ": «توفي رسول الله صلى الله عليه وسلم وهو ابن ثلاث وستين»",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "143": {
      "title": "72 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "144": {
      "title": ": \" دخل قائف ورسول الله صلى الله عليه وسلم شاهد، وأسامة بن زيد، وزيد بن حارثة مضجعان، فقال:",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 17
    },
    "145": {
      "title": "73 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "146": {
      "title": ": «لا تخيروني على موسى فإن الناس يصعقون فأكون أول من يفيق، فإذا موسى عليه السلام باطش بجانب",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "147": {
      "title": "74 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "148": {
      "title": ": «نهى رسول الله صلى الله عليه وسلم عن المحاقلة والمزابنة» .",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "149": {
      "title": "75 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "150": {
      "title": ": «أولكلكم ثوبان»",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "151": {
      "title": "76 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "152": {
      "title": "«صلى على النجاشي ملك الحبشة فكبر عليه أربعا»",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "153": {
      "title": "77 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 18
    },
    "154": {
      "title": ": «العجماء جرحها جبار، والمعدن جبار والبئر جبار، وفي الركاز الخمس»",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "155": {
      "title": "78 -",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "156": {
      "title": "«نهى عن اختناث الأسقية»",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "157": {
      "title": "79 -",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "158": {
      "title": "«مستلقيا في المسجد واضعا إحدى رجليه على الأخرى»",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "159": {
      "title": "80 -",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "160": {
      "title": "«منضجعا في المسجد واضعا إحدى رجليه على الأخرى» .",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "161": {
      "title": "81 -",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "162": {
      "title": "«وهو في المسجد مستلق رافعا إحدى رجليه على الأخرى»",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "163": {
      "title": "82 -",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "164": {
      "title": "\" يقرأ: {واتخذوا من مقام إبراهيم مصلى} \"",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "165": {
      "title": "83 -",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 19
    },
    "166": {
      "title": ": «القلب يحزن والعين تدمع، ولا نقول إلا ما يرضي الرب عز وجل يا إبراهيم إنا بك",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "167": {
      "title": "84 -",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "168": {
      "title": "ناركم هذه جزء من سبعين جزءا من نار جهنم ولولا أنه ضرب بها البحر عشر مرات ما انتفعتم منها",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "169": {
      "title": "85 -",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "170": {
      "title": ": «من أفتى الناس بكل ما يسألونه فهو مجنون»",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "171": {
      "title": "86 -",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "172": {
      "title": ": «تعلموا العلم فإن أحدكم لا يدري متى يحتاج إليه؟»",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "173": {
      "title": "87 -",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "174": {
      "title": "إذا كنا مع رسول الله صلى الله عليه وسلم سفرا يأمرنا أن لا ننزع خفافنا ثلاثا، وإذا كنا",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "175": {
      "title": "88 -",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 20
    },
    "176": {
      "title": ": «لأهل الجنة يا أهل الجنة» .",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "177": {
      "title": "89 -",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "178": {
      "title": ": \" كنا مع رسول الله صلى الله عليه بعسفان، فحضرت صلاة الظهر وخالد بن الوليد على المشركين،",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 21
    },
    "179": {
      "title": "90 -",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "180": {
      "title": ": «المسلم من سلم المسلمون من لسانه ويده، والمهاجر من هجر ما نهى الله عز وجل",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "181": {
      "title": "91 -",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "182": {
      "title": ": «اشتد غضب الله عز وجل على امرأة تدخل في قوم من ليس منهم يشركهم في أموالهم ويطلع على",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "183": {
      "title": "92 -",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "184": {
      "title": ": «من كان على ديني ودين داود وسليمان وإبراهيم عليهم السلام، فليتزوج إن وجد إلى النساء سبيلا،",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "185": {
      "title": "93 -",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "186": {
      "title": ": بعث رسول الله صلى الله عليه رهطا واستعمل عليهم عبيدة بن الحارث، قال: فلما انطلق ليتوجه،",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 22
    },
    "187": {
      "title": "94 -",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 22
    },
    "188": {
      "title": "، فجاء رجل، فصلى فلم يتم ركوعها ولا سجودها، فقال حذيفة: «ردوا الرجل» ، فردوه عليه، فقال له:",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 22
    },
    "189": {
      "title": "95 -",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 22
    },
    "190": {
      "title": ": «صلوا الصلاة في المساجد فإنها من أمر الهدى وسنة نبيكم صلى الله عليه",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 22
    },
    "191": {
      "title": "96 -",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 22
    },
    "192": {
      "title": "الرجل من أهل الكفر يسلم على يدي الرجل من المسلمين، ما السنة فيه؟ قال: «هو أولى الناس",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 23
    },
    "193": {
      "title": "97 -",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 23
    },
    "194": {
      "title": ": «اندقت ثنيتي يوم أحد فأتيت النبي صلى الله عليه، فأمرني أن أتخذ ثنية من",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 23
    },
    "195": {
      "title": "98 -",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 23
    },
    "196": {
      "title": ": {سحران} .",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 23
    },
    "197": {
      "title": "99 -",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 23
    },
    "198": {
      "title": "لن تكون عالما حتى تكون متعلما، ولن تكون متعلما حتى تكون بها عاملا»",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": null
    }
