      "start_ms": 13,
      "end_ms": 14
    },
    "139": {
      "title": ": \" أتاني جبريل صلى الله عليه وسلم فقال: إن الله عز ms13 وجل زوجك ابنة أبي بكر، ومعه صورة",
      "level": 1,
      "parent": null,
