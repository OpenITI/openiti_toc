      "title": "69 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "133": {
      "title": ": «اللهم هؤلاء أهل بيتي، اللهم أذهب عنهم الرجس وطهرهم تطهيرا» .",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
