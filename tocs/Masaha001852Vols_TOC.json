    "7": {
      "title": "ذكر نسب رسول الله (صلى الله عليه وعلى آله وسلم) تسليما وكيف طهره الله نفسا وخيما وشرفه حديثا وقديما وألقى إلى آبائه الأقدمين من الدلائل على اصطفائه إياه فى الآخرين وابتعاثه له رحمة للعالمين ما صيره لديهم قبل وجوده بطوائل السنين معلوما",
      "level": 3,
      "parent": null,
      "start_ms": 5,
      "end_ms": null
    },
    "8": {
      "title": "ذكر أولية بيت الله المحرم وركنه المستلم ومن تولى بناءه من ملائكته وأنبيائه (صلى الله على جميعهم وسلم)",
      "level": 3,
      "parent": 7,
      "start_ms": 25,
      "end_ms": 76
    },
    "9": {
      "title": "ذكر دخول الحبشة أرض اليمن واستيلائهم على ملكها وذكر السبب فى ذلك مع ما يتصل به من أمر الفيل",
      "level": 3,
      "parent": 7,
      "start_ms": 76,
      "end_ms": 91
    },
    "10": {
      "title": "ذكر حفر عبد المطلب زمزم وما يتصل بذلك من حديث مولد رسول الله (صلى الله عليه وسلم)",
      "level": 3,
      "parent": 7,
      "start_ms": 91,
