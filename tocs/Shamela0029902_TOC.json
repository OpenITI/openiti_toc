      "end_ms": 2
    },
    "4": {
      "title": ": \" قرأ رسول الله {فلما تجلى ربه للجبل جعله دكا} [الأعراف: 143] ، قال: وضع إبهامه على قريب من",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "5": {
      "title": "3 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "6": {
      "title": ": «طوبى لمن طال عمره، وحسن عمله» قال: يا رسول الله، أي الأعمال أفضل؟ قال: «أن تفارق الدنيا",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "7": {
      "title": "5 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "8": {
      "title": ": \" إياي والأقراد، قال: قلنا: يا رسول الله وما الأقراد؟ قال: يكون أحدكم أميرا، أو عاملا،",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 3
    },
    "9": {
      "title": "6 ms2 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "10": {
      "title": ": «ما رأيت النبي صلى الله عليه صام يوما يجيء أفضله على الأيام إلا هذا",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "11": {
      "title": "7 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "12": {
      "title": ": قدم رسول الله صلى الله عليه المدينة، فإذا اليهود قد صاموا يوم عاشوراء، فسألهم عن ذلك،",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "13": {
      "title": "8 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "14": {
      "title": "، يوم عاشوراء: «منكم أحد طعم اليوم؟» قلنا: منا من طعم، ومنا من لم يطعم، قال: «فأتموا بقية",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "15": {
      "title": "9 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 4
    },
    "16": {
      "title": "، ما ترى في صيام يوم عاشوراء؟ قال رسول الله: «يكفر السنة الماضية»",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "17": {
      "title": "10 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "18": {
      "title": ": «أفضل الصلاة بعد المفروضة صلاة الليل، وأفضل الصيام بعد شهر رمضان شهر الله الذي يدعونه",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "19": {
      "title": "11 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "20": {
      "title": ": «إن عشت إلى قابل، صمت التاسع فرقا أن يفوته»",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "21": {
      "title": "12 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "22": {
      "title": ": «من وسع على عبد له يوم عاشوراء وسع الله عز وجل عليه سنته»",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "23": {
      "title": "13 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 5
    },
    "24": {
      "title": "يوم عاشوراء: «من أصبح منكم صائما فليتم على صومه، ومن كان أكل فلا يأكل بقية",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "25": {
      "title": "14 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "26": {
      "title": ": «لأن أصلي الصبح ثم أجلس في مجلس أذكر الله عز وجل حتى تطلع الشمس، أحب إلي من شد على جياد",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "27": {
      "title": "15 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "28": {
      "title": "الدنيا حلوة خضرة، فمن أخذها بحقها بورك له فيها، ورب متخوض في مال الله عز وجل، ومال رسوله،",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "29": {
      "title": "16 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 6
    },
    "30": {
      "title": ": أقحمت السنة نابغة بني جعدة، فدخل على ابن الزبير في المسجد الحرام",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "31": {
      "title": "17 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 7
    },
    "32": {
      "title": ": «ما وليت قريش فعدلت، واسترحمت فرحمت، وحدثت فصدقت» .",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "33": {
      "title": "18 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "34": {
      "title": "الأنصار أعفة صبر، وإن الناس تبع لقريش في هذا الشأن، مؤمنهم تبع لمؤمنهم، وفاجرهم تبع",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "35": {
      "title": "19 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "36": {
      "title": ": «يا معشر المتكلمين فيما لا يعنيهم ولا يرد عليهم، ألم تعلموا أن بمكة عبادا قد أسكتتهم خيرات",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 8
    },
    "37": {
      "title": "20 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "38": {
      "title": "إياك ومجالسة السفهاء فإن مجالستهم داء، إنه من يحلم عن السفيه يسر بحلمه، ومن يجبه يندم،",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "39": {
      "title": "21 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "40": {
      "title": ": دخلت القصر بالكوفة فإذا رأس الحسين عليه السلام على ترس بين يدي عبيد الله بن زياد، وعبيد",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 9
    },
