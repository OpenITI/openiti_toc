      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "72": {
      "title": ": «ما من شيء في الميزان أثقل من خلق حسن»",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
