      "end_ms": 2
    },
    "4": {
      "title": ": «لأن يحتزم أحدكم حزمة من حطب فيحملها على ظهره فيبيعها خير له من أن يسأل رجلا فيعطيه أو",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
