      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "69": {
      "title": "35 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "70": {
      "title": ": «من كذب علي متعمدا فليتبوأ مقعده من النار»",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
