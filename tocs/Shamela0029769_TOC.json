      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "66": {
      "title": "أي الأعمال أحب إلى الله تعالى؟ قال: الصلاة لوقتها.",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "67": {
      "title": "34 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "68": {
