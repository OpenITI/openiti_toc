    },
    "86": {
      "title": "الرؤيا الصالحة من الله تعالى، والحلم من الشيطان، فإذا حلم أحدكم حلما فخافه فليبصق عن",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
