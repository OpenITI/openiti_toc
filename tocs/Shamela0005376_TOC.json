{
  "filename": "0230AbuMushal.Nawadir.Shamela0005376-ara1",
  "sections": {
    "1": {
      "title": "بسم الله الرحمن الرحيم",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "2": {
      "title": "وما توفيقي إلا بالله",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 13
    },
    "3": {
      "title": "وغام الرجل، وآم، ممدود، إذا ماتت ماشيته وامرأته. وذلك دعاء عليه.",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 14
    },
    "4": {
      "title": "ويقال: قطرت العنز، وبزمته، ومصرتها، وضففتها، وضببتها. وذلك في الحلب. فالقطر:",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 15
    },
    "5": {
      "title": "ويقال: أسوى القوم في السقي: إذا استقاموا على حال واحدة. وقيل لبعضهم: كيف أنتم؟",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 16
    },
    "6": {
      "title": "ويقال: عيش شظف، وجشب، ms015 وشظف. ومكان شظف، إذا كان خشنا غليظا. وقال الشاعر:",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 19
    },
    "7": {
      "title": "ويقال: ذعته، وذأته، وسأبه، وزأته، وظأفه، وزرده، وذأطه، بمعنى خنقه.",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 25
    },
    "8": {
      "title": "ويقال في البعير: طلع نابه، وبقل، وشقأ، وصبأ نابه، وفطر، ونجم، وبدأ، وخرج.",
      "level": 1,
      "parent": null,
      "start_ms": 25,
      "end_ms": 27
    },
    "9": {
      "title": "قال: كلهم يرفع هذا البيت ما خلا واحدا، فصحا، أنشده نصبا:",
      "level": 1,
      "parent": null,
      "start_ms": 27,
      "end_ms": 36
    },
    "10": {
      "title": "بسم الله الرحمن الرحيم",
      "level": 1,
      "parent": null,
      "start_ms": 36,
      "end_ms": 42
    },
    "11": {
      "title": "[تتمة القسم المروي عن أبي العباس أحمد بن يحيى ثعلب]",
      "level": 1,
      "parent": null,
      "start_ms": 42,
      "end_ms": 45
    },
    "12": {
      "title": ".......................",
      "level": 1,
      "parent": null,
      "start_ms": 45,
      "end_ms": 60
    },
    "13": {
      "title": "هذا آخر نوادر أبي مسحل من كتاب أبي العباس أحمد بن يحيى ثعلب.",
      "level": 1,
      "parent": null,
      "start_ms": 60,
      "end_ms": 60
    },
    "14": {
      "title": "القسم المروي عن أبي عبد الرحمن أحمد بن سهل صاحب أبي عبيد القاسم بن سلام",
      "level": 1,
      "parent": null,
      "start_ms": 60,
      "end_ms": 60
    },
    "15": {
      "title": "وهذا من كتاب أبي عبد الرحمن, صاحب أبي عبيد بخطه.",
      "level": 1,
      "parent": null,
      "start_ms": 60,
      "end_ms": 87
    },
    "16": {
      "title": "....",
      "level": 1,
      "parent": null,
      "start_ms": 87,
      "end_ms": null
    }
