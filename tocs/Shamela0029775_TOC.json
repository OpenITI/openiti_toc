    "2": {
      "title": "، إني أصبت مالا بخيبر لم أصب مالا قط أحب إلي منه , فقال له: «إن شئت تصدقت وإن شئت أمسكت",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "3": {
      "title": "2 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "4": {
      "title": ": «تعرض أعمال بني آدم في كل يوم اثنين وفي كل يوم خميس، فيرحم المترحمين ويغفر للمستغفرين، ثم",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "5": {
      "title": "3 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 2
    },
    "6": {
      "title": ": «اللهم إنهم حفاة فاحملهم، اللهم إنهم عراة فاكسهم، اللهم إنهم جياع",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "7": {
      "title": "4 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "8": {
      "title": "، ما عمل أهل الجنة؟ قال: «الصدق، وإذا صدق العبد بر وإذا بر آمن وإذا آمن دخل",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "9": {
      "title": "5 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "10": {
      "title": ": لما احتلمت دخلت على رسول الله صلى الله عليه وسلم فأخبرته، فقال: «لا تدخل على",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "11": {
      "title": "6 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 3
    },
    "12": {
      "title": ": «بعثت بجوامع الكلم، ونصرت بالرعب، وبينا أنا نائم أتيت بمفاتيح خزائن الأرض، فوضعت في يدي» ،",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "13": {
      "title": "7 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "14": {
      "title": "، إن الله لا يستحي من الحق، أرأيت المرأة ترى في النوم ما يرى الرجل، أتغتسل؟ قال:",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "15": {
      "title": "8 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "16": {
      "title": ": «إياكم والظن فإن الظن أكذب الحديث، ولا تحسسوا، ولا تجسسوا، ولا تنافسوا، ولا تحاسدوا، ولا",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "17": {
      "title": "9 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 4
    },
    "18": {
      "title": ": «إياكم والظن فإن الظن أكذب الحديث، ولا تجسسوا، ولا تباغضوا، ولا تقاطعوا، ولا تحاسدوا، ولا",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "19": {
      "title": "10 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "20": {
      "title": ": «لو يعلم الناس ما في النداء والصف الأول، ثم لم يجدوا إلا أن يستهموا عليه لاستهموا، أو لو",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "21": {
      "title": "11 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "22": {
      "title": ": «من توضأ فليستنثر، ومن استجمر فليوتر»",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "23": {
      "title": "12 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "24": {
      "title": ": «إن قدر حوضي لما بين أيلة وصنعاء في اليمن، وإن فيه من الأباريق بعدد نجوم",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "25": {
      "title": "13 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 5
    },
    "26": {
      "title": "، أي الناس أحب إليك؟ قال: «لم» ؟ قال: لأحب من تحب.",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "27": {
      "title": "14 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "28": {
      "title": ": «اللهم صل على أبي بكر فإنه يحبك ويحب رسولك، اللهم صل على عمر فإنه يحبك ويحب رسولك، اللهم",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "29": {
      "title": "15 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "30": {
      "title": ": إن ابني كان بطني له وعاء وثديي له سقاء وحجري له حواء، وإن أباه يزعم أنه سينزعه مني , فقال",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "31": {
      "title": "16 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 6
    },
    "32": {
      "title": ": «ليس على الرجل المسلم زكاة في كرمة، ولا في زرعة إذا كان أقل من خمسة",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "33": {
      "title": "17 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "34": {
      "title": ": «إن من الحنطة خمرا، ومن الشعير خمرا، ومن الزبيب خمرا، ومن التمر خمرا، ومن العسل خمرا، وأنا",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "35": {
      "title": "18 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "36": {
      "title": ": «كل مسكر حرام , ومن شرب الخمر في الدنيا فمات وهو يدمنها لم يتب لم يشربها في",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "37": {
      "title": "19 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "38": {
      "title": ": «من مات مدمن خمر لقي الله عز وجل كعابد وثن»",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "39": {
      "title": "20 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 7
    },
    "40": {
      "title": ": «في الخمر قليلها إثم وكثيرها فسوق، ولا يقبل الله له صلاة أربعين ليلة فإن مات فيها مات ميتة",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "41": {
      "title": "21 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "42": {
      "title": ": «ما أسكر كثيره فقليله حرام»",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "43": {
      "title": "22 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "44": {
      "title": ": «قليل ما كثيره مسكر، وكثير ما قليله مسكر حرام»",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "45": {
      "title": "23 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "46": {
      "title": "نهى عن ثمن الخمر ومهر البغي وثمن الكلب، وقال: «إذا أتاك يطلب ثمن الكلب فاملأ كفيه",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "47": {
      "title": "24 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 8
    },
    "48": {
      "title": ": «من شرب الخمر فاجلدوه، ثم إذا شرب فاجلدوه، ثم إذا شرب فاجلدوه، ثم إذا شرب في الرابعة",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "49": {
      "title": "25 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "50": {
      "title": "جلد رجلا في الخمر أربعين جلدة بسوط له طرفان",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "51": {
      "title": "26 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "52": {
      "title": ": «لعن الله اليهود، حرمت عليهم الشحوم فجملوها فباعوها» ؟",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "53": {
      "title": "27 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "54": {
      "title": "\" إياكم والخمر فإنها مفتاح كل شر، أتي رجل فقيل له: إما أن تحرق هذا الكتاب وإما أن تقتل هذا",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "55": {
      "title": "28 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "56": {
      "title": ": \" بينا نحن قعود على شراب لنا على رملة، ونحن ثلاثة أو أربعة، عندنا باطية لنا، ونحن نشرب",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 9
    },
    "57": {
      "title": "29 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "58": {
      "title": ": «ثلاثة لا ترى أعينهم النار» زاد ابن الحارث: يوم القيامة ثم اتفقوا: «عين بكت من خشية الله،",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "59": {
      "title": "30 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "60": {
      "title": ": \" أربع خلال من كن فيه كان منافقا خالصا: من إذا حدث كذب، وإذا وعد أخلف، وإذا عاهد غدر، وإذا",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "61": {
      "title": "31 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 10
    },
    "62": {
      "title": ": \" {الله يتوفى الأنفس حين موتها} [الزمر: 42] .",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "63": {
      "title": "32 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "64": {
      "title": ": \" لولا ثلاث خلال ما أحببت أن أبقى في الدنيا.",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 11
    },
    "65": {
      "title": "33 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "66": {
      "title": ": «لا يحل لامرأة تؤمن بالله واليوم الآخر تحد على ميت فوق ثلاث إلا على زوج»",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "67": {
      "title": "34 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "68": {
      "title": "يصلي صلاته من الليل وأنا معترضة بينه وبين القبلة كاعتراض الجنازة»",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "69": {
      "title": "35 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 12
    },
    "70": {
      "title": ": «من ms11 اقتنى كلبا إلا كلب ماشية نقص من أجره كل يوم قيراطان»",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "71": {
      "title": "36 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "72": {
      "title": ": «ألا أخبركم بخياركم من شراركم , خياركم أطولكم أعمارا وأحسنكم أعمالا»",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "73": {
      "title": "37 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "74": {
      "title": ": «الولد للفراش وللعاهر الحجر»",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "75": {
      "title": "38 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "76": {
      "title": ": «أشد الناس يوم القيامة عذابا الذين يشبهون خلق الله»",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "77": {
      "title": "39 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "78": {
      "title": ": «إن الله عز وجل ليقبل توبة العبد ما لم يغرغر»",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "79": {
      "title": "40 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 13
    },
    "80": {
      "title": ": «الدنيا سجن المؤمن وجنة الكافر»",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "81": {
      "title": "41 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "82": {
      "title": ": «ما آتى الله عز وجل عالما علما إلا أخذ عليه الميثاق ألا يكتم»",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "83": {
      "title": "42 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "84": {
      "title": ": «ما من نفس إلا قد كتب مدخلها ومخرجها وما هو لاقيه» .",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "85": {
      "title": "43 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "86": {
      "title": ": «لا يقوم الرجل للرجل من مجلسه، ولكن أفسحوا يفسح الله لكم»",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "87": {
      "title": "44 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 14
    },
    "88": {
      "title": ": «لا يبغض أبا بكر وعمر مؤمن، ولا يحبهما منافق»",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "89": {
      "title": "45 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "90": {
      "title": "لو أنكم تتفقان لي على أمر واحد ما عصيتكما في مشورة أبدا، ولقد ضرب لي ربي عز وجل لكما",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "91": {
      "title": "46 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 15
    },
    "92": {
      "title": ": \" تعوذوا بالله من جب الحزن.",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "93": {
      "title": "47 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "94": {
      "title": ": «من حج فلم يرفث ولم يفسق يرجع كيوم ولدته أمه»",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "95": {
      "title": "48 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 16
    },
    "96": {
      "title": ": «النفقة في الحج كالنفقة في سبيل الله سبعين ms15 ضعفا»",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "97": {
      "title": "49 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "98": {
      "title": ": «من أضحى يوما ملبيا حتى تغرب الشمس غربت بذنوبه وعاد كما ولدته أمه»",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "99": {
      "title": "50 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "100": {
      "title": ": «الحجاج والعمار وفد الله، إن سألوا أعطوا، وإن دعوا أجيبوا، وإن أنفقوا أخلف",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "101": {
      "title": "51 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "102": {
      "title": ": «الغازي في سبيل الله والحاج إلى بيت الله وفد الله عز وجل، دعاهم فأجابوه»",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "103": {
      "title": "52 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "104": {
      "title": ": \" إن أبي أدرك الحج وهو شيخ كبير لا يستطيع أن يركب على البعير، أفأحج عنه؟ قال: حجي",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "105": {
      "title": "53 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 17
    },
    "106": {
      "title": ": «إذا رأيتم هلال ذي الحجة وأراد أحدكم أن يضحي، فليمسك عن شعره وأظفاره»",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "107": {
      "title": "54 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "108": {
      "title": "يقصر بمشقص»",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "109": {
      "title": "55 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "110": {
      "title": ": أن الصلاة الوسطى هي العصر، وأن الحج الأكبر يوم النحر، وأن إدبار السجود الركعتان بعد",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "111": {
      "title": "56 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "112": {
      "title": "يوم عرفة، ورسول الله صلى الله عليه يصلي بالناس، ونحن على أتان لنا، فمررنا ببعض الصف",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "113": {
      "title": "57 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "114": {
      "title": ": «صليت مع رسول الله صلى الله عليه الظهر بالمدينة أربعا، وبذي الحليفة",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "115": {
      "title": "58 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 18
    },
    "116": {
      "title": ": «اغسلوه بماء وسدر، وادفنوه في ثوبه، ولا تخمروا رأسه، فإن الله يبعثه وهو",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "117": {
      "title": "59 -",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "118": {
      "title": "، دعا لأمته عشية عرفة بالمغفرة والرحمة، وأكثر الدعاء، فأجابه: «أني قد فعلت إلا ظلم بعضهم",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "119": {
      "title": "60 -",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "120": {
      "title": ": إذا كان يوم عرفة ينزل الرب جل وعز إلى السماء الدنيا، فيباهي بهم الملائكة، فيقول: «انظروا",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "121": {
      "title": "61 -",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "122": {
      "title": "، اسمعوا قولي لعلي لا ألقاكم بعدها في هذا الموقف، يأيها الناس إن دماءكم وأموالكم حرام إلى",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 19
    },
    "123": {
      "title": "62 -",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "124": {
      "title": "، ابن خطل متعلق بأستار الكعبة.",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "125": {
      "title": "63 -",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "126": {
      "title": ": \" من تيمم بكسب حرام حاجا كان في شخص في غير طاعة الله، حتى إذا وضع رجله في الغرز، وبعث",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 20
    },
    "127": {
      "title": "64 -",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "128": {
      "title": ": «رأيت النبي صلى الله عليه على ناقة صهباء يرمي الجمرة، لا ضرب ولا طرد ولا جلد ولا",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "129": {
      "title": "65 -",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "130": {
      "title": ": «اللهم حجة لا رياء فيها ولا سمعة»",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "131": {
      "title": "66 -",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "132": {
      "title": "أعطاه دينارا يشتري له شاة للضحية، فاشترى له شاتين، فباع إحداهما بدينار، فأتى النبي صلى",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "133": {
      "title": "67 -",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 21
    },
    "134": {
      "title": ": «من أخاف أهل المدينة فعليه لعنة ms20 الله والملائكة والناس أجمعين»",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "135": {
      "title": "68 -",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "136": {
      "title": ": «من جاءني زائرا لم تنزعه حاجة إلا زيارتي، كان حقا علي أن أكون له شفيعا يوم",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "137": {
      "title": "69 -",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "138": {
      "title": ": «من زار قبري وجبت له شفاعتي»",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
