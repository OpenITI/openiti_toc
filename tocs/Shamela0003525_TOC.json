      "title": ": «إن الله تبارك وتعالى ليبتلي العبد وهو يحبه؛ ليسمع تضرعه»",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "111": {
      "title": "35 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "112": {
      "title": ": «توضئوا؛ فإن بعض ما تقولون أشد من الحدث»",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "113": {
      "title": "36 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "114": {
      "title": "[ص: 52]",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "115": {
      "title": ": {فنادوا ولات حين مناص} [ص: 3] ، قال: «حين لا نزو، ولا فرار»",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "116": {
      "title": "36 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 7
    },
    "117": {
      "title": ": {وأنى لهم التناوش} [سبأ: 52] ، قال: «الرد»",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "118": {
      "title": "37 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "119": {
      "title": ": «يخرج من النار من ذكرني يوما، أو خافني في مقام»",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "120": {
      "title": "38 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "121": {
      "title": "[ص: 53]",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "122": {
      "title": "39 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "123": {
      "title": ": «جنب قلبك الريب وما تخشى فساده»",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "124": {
      "title": "40 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "125": {
      "title": "أبواب السماء تفتح للرجل ليلة الملاك، يقال له: أراد التعفف عما حرم الله \"",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "126": {
      "title": "41 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "127": {
      "title": ": {لابثين فيها أحقابا} [النبأ: 23] ، قال: «الحقب ثمانون عاما»",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "128": {
      "title": "42 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "129": {
      "title": "[ص: 54]",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "130": {
      "title": ": \" المشهود يوم القيامة، والموعود يوم القيامة، وقرأ: {ذلك يوم مجموع له الناس، وذلك يوم مشهود}",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "131": {
      "title": "43 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "132": {
      "title": ": {فلا تسمع إلا همسا} [طه: 108] ، قال: همس أقدامهم",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "133": {
      "title": "44 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 8
    },
    "134": {
      "title": ": {قالوا يا ويلنا من بعثنا من مرقدنا} [يس: 52] الآية : يقول الكافر: {يا ويلنا من بعثنا من",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "135": {
      "title": "45 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "136": {
      "title": ": {ونحن أقرب إليه من حبل الوريد} [ق: 16] ، قال: «نياط القلب وما حمل»",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "137": {
      "title": "46 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "138": {
      "title": "[ص: 55]",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "139": {
      "title": "كان إذا قرأ: {فكيف إذا جئنا من كل أمة بشهيد وجئنا بك على هؤلاء شهيدا} [النساء: 41]",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "140": {
      "title": "47 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "141": {
      "title": "الملائكة تفرح للمؤمن بالشتاء: أن ليله طويل يقومه، وأن نهاره قصير يصومه \"",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "142": {
      "title": "48 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "143": {
      "title": ": «لأنا للقارئ الفاجر أخوف مني من الفاجر المبرز بفجوره، إن هذا أبعدهما",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "144": {
      "title": "49 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "145": {
      "title": ": «لا خبيث أخبث من قارئ فاجر»",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "146": {
      "title": "50 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "147": {
      "title": "[ص: 57]",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "148": {
      "title": "51 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "149": {
      "title": "، إنكم في زمان كثير تفاخرهم، أو قال: تعاجبهم، قد انتفخت ألسنتهم في أفواههم، وطلبوا الدنيا",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "150": {
      "title": "52 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 9
    },
    "151": {
      "title": "، اتخذ ألف صديق؛ فإنه قليل، ولا تتخذن عدوا؛ فإنه كثير \"",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "152": {
      "title": "53 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "153": {
      "title": ": «أنا لا أرجوه وقد صمت ثمانين رمضانا؟»",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "154": {
      "title": "54 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "155": {
      "title": ": «لا يزال العبد في توبة ما لم يعاين الملك»",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "156": {
      "title": "55 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "157": {
      "title": "[ص: 59]",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "158": {
      "title": ": {ثم يتوبون من قريب} [النساء: 17] ، قال: «ما لم يغرغر بالحياة»",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "159": {
      "title": "56 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "160": {
      "title": ": {ننقصها من أطرافها} [الرعد: 41] ، قال: «الموت»",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "161": {
      "title": "57 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "162": {
      "title": ": {سيماهم في وجوههم من أثر السجود} [الفتح: 29] ، قال: \" بياض في وجوههم يوم",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "163": {
      "title": "58 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "164": {
      "title": "[ص: 60]",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "165": {
      "title": ": «ما أرى هذا إلا الذي ليس الله بتارك منه أحدا لموافاة يوم القيامة»",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "166": {
      "title": "59 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "167": {
      "title": ": «ما منه من عرق إلا يألم، ولقد أتاه آت من ربه فبشره أنه لا أدب عليه»",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "168": {
      "title": "60 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 10
    },
    "169": {
      "title": ": كان مسلم بن يسار إذا صلى كأنه ثوب ملقى، من قلة التفاته \"",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "170": {
      "title": "61 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "171": {
      "title": "[ص: 61]",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "172": {
      "title": "62 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "173": {
      "title": ": «أفلا أنبئكم عن ذلك؟ إن المؤمن يبقى عليه ذنوب ليكافأ بها عند موته، وإن الكافر تبقى له",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "174": {
      "title": "63 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "175": {
      "title": "[ص: 62]",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "176": {
      "title": ": «ما تربة الجنة يا ابن صائد؟» قال: درمكة بيضاء مسك يا أبا القاسم، قال:",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "177": {
      "title": "64 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "178": {
      "title": ": {اعملوا آل داود شكرا} ، قال: «الشكر تقوى الله، والعمل بطاعته»",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "179": {
      "title": "65 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "180": {
      "title": ": {يعلمون ظاهرا من الحياة الدنيا} [الروم: 7] قال: متى يزرعون، ومتى يغرسون، ومتى يحصدون،",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "181": {
      "title": "66 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "182": {
      "title": ": {يعلمون ظاهرا من الحياة الدنيا} [الروم: 7] الآية، فقال الحسن: «والله لبلغ من علم أحدهم من",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "183": {
      "title": "67 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 11
    },
    "184": {
      "title": ": «ضعها بالحضيض، فلو كانت تعدل عند الله جناح بعوضة ما سقى منها كافرا شربة»",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "185": {
      "title": "68 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "186": {
      "title": "[ص: 64]",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "187": {
      "title": ": «لئن أؤتمن على بيت من در أحب إلي من أن أؤتمن على امرأة حسناء»",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "188": {
      "title": "69 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "189": {
      "title": "ما عز هذا لله دينا، ولا رد مظلمة مظلوم، هذا وأبيك الحسين \"",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "190": {
      "title": "70 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "191": {
      "title": "، أظهر الإياس مما عند الناس؛ فإنه الغنى، وإياك وطلب الحوائج إليهم؛ فإنه فقر حاضر، وإذا قمت",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "192": {
      "title": "71 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "193": {
      "title": "[ص: 66]",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "194": {
      "title": "، أسألك عن كلمة واحدة، قال: أحب الله تبارك وتعالى أن يعصى؟ قال زيد بن علي: فعصي عنوة؟ قال:",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "195": {
      "title": "72 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "196": {
      "title": ": «قتل من علي ومعاوية سبعون ألفا يوم صفين»",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "197": {
      "title": "73 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 12
    },
    "198": {
      "title": ": \" الخير كله في هذين الحرفين: الأخذ بما أمرتم، والنهي عما نهيتم عنه \"",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "199": {
      "title": "74 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "200": {
      "title": "، عيش هذا آخره، ما خير في أوله»",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "201": {
      "title": "75 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "202": {
      "title": "إذا أتاه الرجل يطلب العلم سأله: هل لك وجه معيشة؟ فإن أخبره أنه في كفاية أمره بطلب العلم،",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "203": {
      "title": "76 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "204": {
      "title": ": «كما تدين تدان، وكما تزرع تحصد»",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "205": {
      "title": "77 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "206": {
      "title": ": «ما كذبت منذ شددت علي إزاري»",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "207": {
      "title": "78 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "208": {
      "title": ": \" من حدث الناس بما رأته عيناه، أو سمعت أذناه، أو أخذته يداه، فهو من {الذين يحبون أن تشيع",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "209": {
      "title": "79 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "210": {
      "title": ": «إن استطعت أن تغير خلقك بأحسن فافعل، وإلا فيسعك من أخلاقنا ما ضاق عليك من",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "211": {
      "title": "80 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "212": {
      "title": ": ادع الله لنا فيها بالبركة، قال: «اللهم بارك لنا فيها» ، فأصبحت وقد نفقت. ثم اشترى بغلة",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "213": {
      "title": "81 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 13
    },
    "214": {
      "title": "، يكره أن يقول له الرجل من إخوانه: أمتع الله بك، قال: «إنما هي دعوة محدثة»",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "215": {
      "title": "82 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "216": {
      "title": ": «ما علي وقد لبست درعي، اليوم أموت عند طاقتي»",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "217": {
      "title": "83 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "218": {
      "title": "[ص: 69]",
      "level": 1,
      "parent": null,
      "start_ms": 13,
