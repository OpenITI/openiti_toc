      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "75": {
      "title": ": \" سبعة يظلهم الله يوم القيامة في ظله يوم لا ظل إلا ظله: إمام عادل وشاب نشأ في عبادة",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "76": {
      "title": "34 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "77": {
      "title": ": \" سبعة يظلهم الله في ظل عرشه يوم القيامة: إمام مقسط ورجل يتصدق بيمينه يخفيها عن",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
