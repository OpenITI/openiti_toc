      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "79": {
      "title": ": \" سبعة في ظل العرش يوم لا ظل إلا ظله: إمام مقسط ورجل دعته امرأة ذات حسب وجمال إلى نفسها",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 9
    },
    "80": {
