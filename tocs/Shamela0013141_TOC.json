      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "73": {
      "title": ": «السلطان ظل الله في الأرض، فمن نصحهم ودعا لهم اهتدى، ومن غشهم ودعا عليهم ضل» قال أبو نعيم:",
      "level": 1,
