      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "81": {
      "title": ": \" اثنان من الناس إذا صلحا صلح الناس، وإذا فسدا فسد الناس: العلماء",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "82": {
      "title": "37 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "83": {
      "title": "، لن يزالوا بخير ما استقامت لهم ولاتهم وهداتهم»",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "84": {
      "title": "38 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "85": {
      "title": ": «لن تهلك الرعية وإن كانت ظالمة سيئة إذا كانت الولاة هادية مهدية، ولكن تهلك الرعية وإن كانت",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
