      "title": "24 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "55": {
      "title": ": \" ثلاثة لا يرد دعاؤهم: الذاكر لله كثيرا، ودعوة المظلوم، ودعوة الإمام",
      "level": 1,
      "parent": null,
