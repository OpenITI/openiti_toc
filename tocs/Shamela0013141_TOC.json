      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 11
    },
    "98": {
      "title": ": «ويل لديان من في الأرض من ديان من في السماء يوم يلقونه إلا من أمر بالعدل وقضى بالحق ولم",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "99": {
      "title": "46 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "100": {
      "title": "مثلك مثل رجل استأجر أجيرا فولاه ماشيته وجعل له الأجر على أن يحسن الرعية، ويوفر جزازها",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "101": {
      "title": "أعطاك الدنيا بكمالها. فاشتر نفسك منه ببعضها، واعلم أنك واقف بين يديه، وسائلك عن مثاقيل",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 12
    },
