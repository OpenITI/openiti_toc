      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "87": {
      "title": ": «الإسلام والسلطان أخوان توأم، لا يصلح واحد منهما إلا بصاحبه، فالإسلام أس والسلطان حارس،",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
