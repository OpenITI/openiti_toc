      "end_ms": 7
    },
    "63": {
      "title": "في الجنة قصرا، حوله البروج والمروج، له خمسة آلاف باب، لا يدخله أو لا يسكنه إلا نبي أو",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
