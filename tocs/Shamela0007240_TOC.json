    "1": {
      "title": "فصل في ذكر البغي",
      "level": 1,
      "parent": null,
      "start_ms": 29,
      "end_ms": 32
    },
    "2": {
      "title": "فصل واعلم أنه ليس لسرعة الانتقام وتعجيل العقوبة والإعراض عن الصفح وقلة الرغبة في العفو سبب سوى قوة الغضب فلنذكر منه جملا موجزة",
      "level": 1,
      "parent": null,
      "start_ms": 32,
      "end_ms": 34
    },
    "3": {
      "title": "فصل في الانتقام ممن يجريه العفو على الاقتحام الجرائم والآثام",
      "level": 1,
      "parent": null,
      "start_ms": 34,
      "end_ms": 35
    },
    "4": {
      "title": "فصل اعلم أن الأناة إنما قصدت للاستظهار والاستبصار",
      "level": 1,
      "parent": null,
      "start_ms": 35,
      "end_ms": 37
    },
    "5": {
      "title": "فصل وينبغي لمن ابتلي بعدو أن يكون معه كما قال بعض وزراء العجم",
      "level": 1,
      "parent": null,
      "start_ms": 37,
      "end_ms": 38
    },
    "6": {
      "title": "فصل ف أما كان العدو مما لا يرجى انصلاحه بالبذل واللين فيجب أن يسارع بالكيد المبين إلى جسم مادته واستئصال شأفته",
      "level": 1,
      "parent": null,
      "start_ms": 38,
      "end_ms": 39
    },
