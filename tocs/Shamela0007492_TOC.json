{
  "filename": "0310Tabari.IkhtilafFuqaha.Shamela0007492-ara1",
  "sections": {
    "1": {
      "title": "كتاب المدبر",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "2": {
      "title": "مدخل",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "3": {
      "title": "ثم اختلفوا في صفة القول الذي إذا وجد من القائل لعبده حكم للمقول له ذلك من عبيده بأنه مدبر",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 3
    },
    "4": {
      "title": "واختلفوا في قول القائل لمملوكه أنت حر.",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 4
    },
    "5": {
      "title": "ثم اختلفوا في حكم العبد يعتق إلى أجل",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 9
    },
    "6": {
      "title": "ثم اختلفوا في عتق المدبر إذا مات سيده قبل رجوعه عن تدبيره أمن جميع ما له عتقه أم من الثلث",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 10
    },
    "7": {
      "title": "ثم اختلفوا في السيد هل له أن يرجع عن تدبيره ببيع أو قول أو غير ذلك من وجوه الرجوع؟",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 14
    },
    "8": {
      "title": "واختلفوا في بيع خدمة المدبر من نفسه أو من غيره",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 16
    },
    "9": {
      "title": "واختلفوا في حكم العبد بين اثنين يدبره أحدهما",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 17
    },
    "10": {
      "title": "ثم اختلفوا في حكم ما في بطنها إن أفردها السيد بالتدبير أو أفرد ما في بطنها أو حدث لها ولد بعد التدبير",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 21
    },
    "11": {
      "title": "واختلفوا في حكم البيع إذا عقد إلى أجلين مختلفين بثمنين مختلفين",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 23
    },
    "12": {
      "title": "حكم الخيار في البيوع: ثم اختلفوا في معنى الفرقة",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 24
    },
    "13": {
      "title": "واختلف القائلون إن التفرق بالأبدان في حكم ما أحدث أحدهم في السلعة قبل تفرقهما",
      "level": 1,
      "parent": null,
      "start_ms": 24,
      "end_ms": 26
    },
    "14": {
      "title": "واختلفوا في جواز اشتراط الخيار أكثر من ثلاثة",
      "level": 1,
      "parent": null,
      "start_ms": 26,
      "end_ms": 27
    },
    "15": {
      "title": "واختلف الذين أبطلوا البيع باشتراط الخيار أكثر من ثلاثة أيام إذا اختير في الثلاث",
      "level": 1,
      "parent": null,
      "start_ms": 27,
      "end_ms": 27
    },
    "16": {
      "title": "واختلف مجيزو اشتراط الخيار إذا حدث بالمشروط ذلك له حدث منعه من خياره حتى جازت المدة",
      "level": 1,
      "parent": null,
      "start_ms": 27,
      "end_ms": 28
    },
    "17": {
      "title": "واختلفوا في حكم السلعة تتلف قبل أن يقضي المشروط له الخيار فيها في أيام حياته",
      "level": 1,
      "parent": null,
      "start_ms": 28,
      "end_ms": 30
    },
    "18": {
      "title": "واختلفوا في حكم الذي له الخيار إذا أراد فسخ البيع بغير محضر من صاحبه",
      "level": 1,
      "parent": null,
      "start_ms": 30,
      "end_ms": 31
    },
    "19": {
      "title": "واختلفوا في الحكم في ذلك ان رضيه من اشترط خياره وخالف أحد المتبايعين",
      "level": 1,
      "parent": null,
      "start_ms": 31,
      "end_ms": 32
    },
    "20": {
      "title": "واختلفوا في حكمها إذا تناقضا البيع والخيار لاحداهما أو لهما فهلك في يدي المشتري قبل ان يقبضه البائع",
      "level": 1,
      "parent": null,
      "start_ms": 32,
      "end_ms": 32
    },
    "21": {
      "title": "واختلفوا في حكم الرجل يشتري عدلا من متاع برأس المال ولم يخبره البائع برأس المال",
      "level": 1,
      "parent": null,
      "start_ms": 32,
      "end_ms": 33
    },
    "22": {
      "title": "واختلفوا في حكم البيع يعقد على المشتري إن لم ينقده الثمن إلى أيام فلا بيع بينهما",
      "level": 1,
      "parent": null,
      "start_ms": 33,
      "end_ms": 34
    },
    "23": {
      "title": "ثم اختلفوا في الربح الذي يجوز به البيع على المرابحة",
      "level": 1,
      "parent": null,
      "start_ms": 34,
      "end_ms": 36
    },
    "24": {
      "title": "واختلفوا في حكم الرجل يشتري سلعة بثمن في بلد فيبيعها مرابحة ببلد غيره أو يبيعها مرابحة وقد دخلها نقص",
      "level": 1,
      "parent": null,
      "start_ms": 36,
      "end_ms": 37
    },
    "25": {
      "title": "الصرف في تراب المعدن والصاغة",
      "level": 1,
      "parent": null,
      "start_ms": 37,
      "end_ms": 38
    },
    "26": {
      "title": "واختلفوا في بيع العطاء",
      "level": 1,
      "parent": null,
      "start_ms": 38,
      "end_ms": 38
    },
    "27": {
      "title": "واختلفوا في شراء العبد من سيده الدرهم بالدرهمين والمعاملة في دار الحرب",
      "level": 1,
      "parent": null,
      "start_ms": 38,
      "end_ms": 40
    },
    "28": {
      "title": "واختلفوا في رجلين لكل واحد منهما على صاحبه لواحد ذهب وللآخر فضه فيتصارفان",
      "level": 1,
      "parent": null,
      "start_ms": 40,
      "end_ms": 40
    },
    "29": {
      "title": "واختلفوا في المتصارفين يبعثان أو أحدهما من1 يرى أحد الثمنين",
      "level": 1,
      "parent": null,
      "start_ms": 40,
      "end_ms": 41
    },
    "30": {
      "title": "واختلفوا في الأجرة على صياغة الذهب والفضة",
      "level": 1,
      "parent": null,
      "start_ms": 41,
      "end_ms": 42
    },
    "31": {
      "title": "واختلفوا في مراطلة الذهب الجيدة والرديئة بالذهب الرديئة",
      "level": 1,
      "parent": null,
      "start_ms": 42,
      "end_ms": 43
    },
    "32": {
      "title": "كتاب السلم",
      "level": 1,
      "parent": null,
      "start_ms": 43,
      "end_ms": 43
    },
    "33": {
      "title": "ذكر اختلاف العلماء في بيع الغائب المضمون بالصفة",
      "level": 1,
      "parent": null,
      "start_ms": 43,
      "end_ms": 45
    },
    "34": {
      "title": "ذكر اختلاف مجوزي السلم في فروعه: واختلفوا في الثمن هل يجوز أن يكون مجهولا؟",
      "level": 1,
      "parent": null,
      "start_ms": 45,
      "end_ms": 45
    },
    "35": {
      "title": "واختلفوا في السلم إلى الأجل المجهول وفي الشي حالا",
      "level": 1,
      "parent": null,
      "start_ms": 45,
      "end_ms": 46
    },
    "36": {
      "title": "واختلفوا فيه إذا لم يبين المكان الذي يقضي فيه",
      "level": 1,
      "parent": null,
      "start_ms": 46,
      "end_ms": 47
    },
    "37": {
      "title": "واختلفوا فيه إذا أصيب في الثمن شيء رديء بعد التفرق",
      "level": 1,
      "parent": null,
      "start_ms": 47,
      "end_ms": 48
    },
    "38": {
      "title": "واختلفوا فيمن أسلم في صنفين من الأشياء ولم يبين كل واحد منهما أو في صنف واحد إلى أجلين مختلفين بثمن",
      "level": 1,
      "parent": null,
      "start_ms": 48,
      "end_ms": 50
    },
    "39": {
      "title": "ثم واختلفوا في ذلك إن أصاب بعضا ولم يصب بعضا",
      "level": 1,
      "parent": null,
      "start_ms": 50,
      "end_ms": 52
    },
    "40": {
      "title": "واختلفوا فيه إذا أسلم إليه في جنس فحل عليه فقضاه أجود مما أسلم إليه من جنسه أو أردأ",
      "level": 1,
      "parent": null,
      "start_ms": 52,
      "end_ms": 57
    },
    "41": {
      "title": "واختلفوا إذا كان السلم غير الطعام",
      "level": 1,
      "parent": null,
      "start_ms": 57,
      "end_ms": 58
    },
    "42": {
      "title": "واختلفوا في المسلم يشرك بعد وجوب السلم",
      "level": 1,
      "parent": null,
      "start_ms": 58,
      "end_ms": 61
    },
    "43": {
      "title": "واختلفوا في الرهن والكفيل في السلم",
      "level": 1,
      "parent": null,
      "start_ms": 61,
      "end_ms": 63
    },
    "44": {
      "title": "واختلفوا فيما يجوز فيه السلم",
      "level": 1,
      "parent": null,
      "start_ms": 63,
      "end_ms": 64
    },
    "45": {
      "title": "واختلفوا في أشياء من الموزون والمكيل فمن ذلك السلم في الفاكهة الرطبة",
      "level": 1,
      "parent": null,
      "start_ms": 64,
      "end_ms": 65
    },
    "46": {
      "title": "واختلفوا في السلم فيما خلط بغيره",
      "level": 1,
      "parent": null,
      "start_ms": 65,
      "end_ms": 67
    },
    "47": {
      "title": "واختلفوا في السلم فيما بعد",
      "level": 1,
      "parent": null,
      "start_ms": 67,
      "end_ms": 68
    },
    "48": {
      "title": "واختلفوا في السلم في السمك",
      "level": 1,
      "parent": null,
      "start_ms": 68,
      "end_ms": 68
    },
    "49": {
      "title": "واختلفوا في السلم في اللحم",
      "level": 1,
      "parent": null,
      "start_ms": 68,
      "end_ms": 69
    },
    "50": {
      "title": "واختلفوا في السلم في الرؤوس",
      "level": 1,
      "parent": null,
      "start_ms": 69,
      "end_ms": 70
    },
    "51": {
      "title": "واختلفوا في السلم في اللؤلؤ والزبرجد والياقوت والحجارة التي تكون حليا",
      "level": 1,
      "parent": null,
      "start_ms": 70,
      "end_ms": 71
    },
    "52": {
      "title": "كتاب المزارعة والمساقاة",
      "level": 1,
      "parent": null,
      "start_ms": 71,
      "end_ms": 71
    },
    "53": {
      "title": "مدخل",
      "level": 1,
      "parent": null,
      "start_ms": 71,
      "end_ms": 71
    },
    "54": {
      "title": "ثم اختلفوا في الرجل يدفع نقله إلى رجل يقوم عليه من سقيه وإصلاحه",
      "level": 1,
      "parent": null,
      "start_ms": 71,
      "end_ms": 75
    },
    "55": {
      "title": "واختلفوا في كراء الأرض البيضاء بشيء من جنس المكترى له بعد إجماعهم على أنها إذا اكتريت بالذهب والورق فجائز",
      "level": 1,
      "parent": null,
      "start_ms": 75,
      "end_ms": 75
    },
    "56": {
      "title": "واختلفوا في حكم المزارع على الأرض البيضاء إذا حاكم رب الأرض وقد زرع",
      "level": 1,
      "parent": null,
      "start_ms": 75,
      "end_ms": 78
    },
    "57": {
      "title": "وأجمع الذين أجازوا المساقاة على إجازتها في النخل والكرم ثم اختلفوا في إجازتها في غيرهما من الغروس والزرع",
      "level": 1,
      "parent": null,
      "start_ms": 78,
      "end_ms": 79
    },
    "58": {
      "title": "واختلفوا في المعاملة ببعض تمر المساقى عليه بعد بدو الصلاح ووقت جواز البيع",
      "level": 1,
      "parent": null,
      "start_ms": 79,
      "end_ms": 80
    },
    "59": {
      "title": "واختلفوا في حكمها إذا دفع إليه نخلا أو شجرا قد علق في الأرض ولم يطعم على أن ما خرج من شيء فبينهما على ما اشترطا",
      "level": 1,
      "parent": null,
      "start_ms": 80,
      "end_ms": 81
    },
    "60": {
      "title": "واختلفوا في حكم الدافع أرضه إلى رجل على أن يغرس المدفوعة إليه الأرض على أن ما أخرج الله من غرس فبينهما",
      "level": 1,
      "parent": null,
      "start_ms": 81,
      "end_ms": 83
    },
    "61": {
      "title": "واختلف الذين أجازوا المعاملة على النخل والأصول فيما يجوز اشتراطه على العدل",
      "level": 1,
      "parent": null,
      "start_ms": 83,
      "end_ms": 85
    },
    "62": {
      "title": "ثم اختلفوا في فسخ ما تعاقدا من ذلك بينهما إذا كان المريد للفسخ أحدهما دون صاحبه",
      "level": 1,
      "parent": null,
      "start_ms": 85,
      "end_ms": 87
    },
    "63": {
      "title": "واختلفوا في حكمهما إن باعا الثمرة قبل الجداد أو مات أحدهما استحقت الثمرة",
      "level": 1,
      "parent": null,
      "start_ms": 87,
      "end_ms": 88
    },
    "64": {
      "title": "كتاب الغصب",
      "level": 1,
      "parent": null,
      "start_ms": 88,
      "end_ms": 88
    },
    "65": {
      "title": "مدخل",
      "level": 1,
      "parent": null,
      "start_ms": 88,
      "end_ms": 90
    },
    "66": {
      "title": "واختلفوا في حكم المغصوب يجني عليه في يد الغاصب أو1 يجني أو2 يصيبها ما ينقصها",
      "level": 1,
      "parent": null,
      "start_ms": 90,
      "end_ms": 92
    },
    "67": {
      "title": "واختلفوا في حكم غلة المغصوب",
      "level": 1,
      "parent": null,
      "start_ms": 92,
      "end_ms": 93
    },
    "68": {
      "title": "واختلفوا في حكم المغصوب إذا خلطه الغاصب بشيء لا يتميز من ماله",
      "level": 1,
      "parent": null,
      "start_ms": 93,
      "end_ms": 95
    },
    "69": {
      "title": "واختلفوا حكم الغاصب يتلف ما غصب بسببه على يدي مالكه أو في مال مالكه",
      "level": 1,
      "parent": null,
      "start_ms": 95,
      "end_ms": 96
    },
    "70": {
      "title": "واختلفوا في حكم المسلم يتلف خمر الذمي",
      "level": 1,
      "parent": null,
      "start_ms": 96,
      "end_ms": 97
    },
    "71": {
      "title": "كتاب الضمان والكفالة والحوالة",
      "level": 1,
      "parent": null,
      "start_ms": 97,
      "end_ms": 97
    },
    "72": {
      "title": "مدخل",
      "level": 1,
      "parent": null,
      "start_ms": 97,
      "end_ms": 102
    },
    "73": {
      "title": "القول في الكفالة بالمال إلى الأجال",
      "level": 1,
      "parent": null,
      "start_ms": 102,
      "end_ms": 106
    },
    "74": {
      "title": "القول في الجماعة يضمنون عن رجل عليه لاخر مال ثم يضمن ذلك الضمناء له بعضهم عن بعض",
      "level": 1,
      "parent": null,
      "start_ms": 106,
      "end_ms": 117
    },
    "75": {
      "title": "أحكام الكفالة بالنفس",
      "level": 1,
      "parent": null,
      "start_ms": 117,
      "end_ms": 121
    },
    "76": {
      "title": "واختلف موجبو اخذ الكفيل بالنفس بالمكفول به إذا طلب ذلك المكفول له بما يجوز الكفالة بالنفس فيه",
      "level": 1,
      "parent": null,
      "start_ms": 121,
      "end_ms": 128
    },
    "77": {
      "title": "واختلف القائلون بإجازة الكفالة بالنفس 1فيما يكون براءة للكفيل بالنفس من كفالته",
      "level": 1,
      "parent": null,
      "start_ms": 128,
      "end_ms": 130
    },
    "78": {
      "title": "واختلفوا في الرجل يكفل1 بنفس غريم له على انه يوافيه به في وقت يسميه له مما عليه من شيء فهو عليه أفعليه كذا من المال",
      "level": 1,
      "parent": null,
      "start_ms": 130,
      "end_ms": 133
    },
    "79": {
      "title": "واختلفوا في اللازم كفيلا بنفس رجل لرجل على أن يدفعه إليه في موضع يسميه له أو في وقت يوقته له إذا خالف ما شرط عليه من ذلك وما الذي يبرئه إذا لم يشرط عليه ذلك",
      "level": 1,
      "parent": null,
      "start_ms": 133,
      "end_ms": 138
    },
    "80": {
      "title": "واختلفوا في حكم الرجل يكفل بنفس رجل لرجل عليه حق والمكفول له به غير حاضر.",
      "level": 1,
      "parent": null,
      "start_ms": 138,
      "end_ms": 140
    },
    "81": {
      "title": "القول في الألفاظ التي تصح بها1 الكفالة وتلزم",
      "level": 1,
      "parent": null,
      "start_ms": 140,
      "end_ms": 143
    },
    "82": {
      "title": "واختلفوا في حكمه إن قال له بايعه فما وجب لك عليه من شيء فهو لك علي",
      "level": 1,
      "parent": null,
      "start_ms": 143,
      "end_ms": 150
    },
    "83": {
      "title": "القول في حكم الرجل يأمر رجلا أن ينقد رجلا عنه مالا محدود المبلغ",
      "level": 1,
      "parent": null,
      "start_ms": 150,
      "end_ms": 153
    },
    "84": {
      "title": "القول في كفالة العبد بنفس رجل لرجل وضمانه له مالا له عليه",
      "level": 1,
      "parent": null,
      "start_ms": 153,
      "end_ms": 158
    },
    "85": {
      "title": "القول في كفالة متكفل بنفس صبي",
      "level": 1,
      "parent": null,
      "start_ms": 158,
      "end_ms": 161
    },
