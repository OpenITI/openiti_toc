      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "62": {
      "title": ": لعل بينك وبينه شيئا، قالت: نعم غضب فخرج إلى المسجد فأتى رسول الله صلى الله عليه وسلم",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "63": {
      "title": "27-",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 11
    },
    "64": {
      "title": ": لم آل أن أزوجك خير أهلي.",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "65": {
      "title": "28-",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "66": {
      "title": ": لما تزوجت فاطمة رضي الله عنها قلت: يا رسول الله ما أبيع فرسي أو درعي؟ قال: بع درعك،",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "67": {
      "title": "29-",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "68": {
      "title": ": هل عندك شيء؟ قلت: لا قال: فأين درعك الحطمية التي أعطيتك يوم كذا وكذا؟ قلت: عندي قال:",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
