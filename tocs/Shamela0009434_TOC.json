      "start_ms": 5,
      "end_ms": 5
    },
    "33": {
      "title": "هل عندك شيء تغدينيه؟ قالت: لا والذي أكرم أبي بالنبوة ما عندي شيء أغديكه ولا كان لنا بعدك",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 6
    },
    "34": {
      "title": "[ص: 30]",
      "level": 1,
