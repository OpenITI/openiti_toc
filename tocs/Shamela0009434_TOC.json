      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "19": {
      "title": "أنى سيدة نساء أهل الجنة بعد مريم بنت عمران فضحكت.",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "20": {
      "title": "9-",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 4
    },
    "21": {
      "title": ": أنت أول أهلي لحوقا بي وأنت رفيقتي في الجنة.",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "22": {
      "title": "10-",
      "level": 1,
