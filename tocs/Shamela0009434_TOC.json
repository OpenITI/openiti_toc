      "start_ms": 2,
      "end_ms": 2
    },
    "9": {
      "title": ": وأنت سيدة نساء أهل الجنة إلا مريم بنت عمران فضحكت.",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
