      "start_ms": 8,
      "end_ms": 8
    },
    "44": {
      "title": "بني هشام بن المغيرة استأذنوني أن يزوجوا عليا ألا لا آذن إلا أن يريد ابن أبي طالب يطلق",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "45": {
      "title": "19-",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "46": {
      "title": "فاطمة بضعة مني يؤذيني ما آذاها ويريبني ما أرابها.",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "47": {
      "title": "20-",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "48": {
      "title": "بني هشام بن المغيرة استأذنوني في أن ينكحوا ابنتهم علي بن أبي طالب فلا آذن ثم لا آذن إلا",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "49": {
      "title": "21-",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "50": {
      "title": "فاطمة بضعة مني يؤذيني ما آذاها ويغضبني ما أغضبها.",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "51": {
      "title": "22-",
      "level": 1,
