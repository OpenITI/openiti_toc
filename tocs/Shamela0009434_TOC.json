      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "37": {
      "title": ": {إنما يريد الله ليذهب عنكم الرجس أهل البيت ويطهركم تطهيرا} .",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "38": {
      "title": "16-",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "39": {
      "title": ": أنا حرب لمن حاربتم وسلم لمن سالمتم.",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "40": {
      "title": "17-",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 8
    },
    "41": {
      "title": ": إنما فاطمة بضعة مني يؤذيني ما آذاها وينصبني ما أنصبها.",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "42": {
      "title": "18-",
