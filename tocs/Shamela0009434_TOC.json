      "start_ms": 4,
      "end_ms": 4
    },
    "25": {
      "title": ": إن فاطمة حصنت فرجها فحرمها الله وذريتها عن النار.",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "26": {
      "title": "12-",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "27": {
      "title": "فاطمة رضي الله عنها أحصنت فرجها فحرمها الله وذريتها على النار.",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "28": {
      "title": "13-",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "29": {
      "title": "فاطمة مريضة فهل لك أن تعودها؟ قال: قلت: فداك أبي وأمي وأي شرف أشرف من هذا؟ قال: فانطلق.",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "30": {
      "title": "[ص: 27]",
      "level": 1,
