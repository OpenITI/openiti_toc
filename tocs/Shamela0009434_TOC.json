      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "11": {
      "title": ": أرأيت حين أكببت على رسول الله صلى الله عليه وسلم فبكيت ثم ضحكت قالت: أخبرني أنه ميت من",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "12": {
      "title": "[ص: 21]",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "13": {
      "title": "6-",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 3
    },
    "14": {
      "title": ": أخبرني النبي صلى الله عليه وسلم أنه مقبوض فبكيت ثم أخبرني أن بني سيصيبهم بعدي شدة فبكيت",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "15": {
      "title": "7-",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "16": {
      "title": ": دعا النبي صلى الله عليه وسلم فاطمة عليها السلام في مرضه الذي توفي فيه فسارها بشيء فبكت ثم",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "17": {
      "title": "[ص: 22]",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
