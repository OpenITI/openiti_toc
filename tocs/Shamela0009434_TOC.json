      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "84": {
      "title": ": انتظر بها القضاء ثم خطب إليه عمر رضي الله عنه فقال: انتظر بها القضاء ثم خطب إليه علي",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
