    "52": {
      "title": "[ص: ms08 38]",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "53": {
      "title": ": بنت عدو الله لا تجتمع على بنت رسول الله صلى الله عليه وسلم.",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "54": {
      "title": "23-",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "55": {
      "title": "أنكحت أبا العاص بن الربيع فحدثني فصدقني وإن فاطمة بنت محمد بضعة مني وإنما أكره أن تفتنوها",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "56": {
      "title": "24-",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "57": {
      "title": "فاطمة بضعة مني، وإنما أكره أن تفتنوها، ثم ذكر أبا العاص بن الربيع فأحسن عليه الثناء ثم",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "58": {
      "title": "25-",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 10
    },
    "59": {
      "title": ": حرم الله على علي رضي الله عنه أن ينكح على فاطمة حياتها لقول الله تعالى: {وما آتاكم الرسول",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
