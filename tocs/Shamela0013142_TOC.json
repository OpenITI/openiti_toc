      "start_ms": 4,
      "end_ms": 5
    },
    "40": {
      "title": ": «اللهم اغفر لأحيائنا ولأمواتنا، وصغيرنا وكبيرنا، وأبنائنا، وشاهدنا وغائبنا ، اللهم من",
      "level": 1,
