      "title": "9 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "18": {
      "title": ": «الخيل معقود في نواصيها الخير إلى يوم القيامة»",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
