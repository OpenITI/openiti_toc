      "start_ms": 23,
      "end_ms": 24
    },
    "250": {
      "title": "الله يطلع ليلة النصف من شعبان، فيغفر للمؤمنين، ويملي للكافرين، ويدع أهل الحقد بحقدهم حتى يدعوه \"",
      "level": 1,
      "parent": null,
      "start_ms": 24,
      "end_ms": 24
    },
    "251": {
      "title": "88 -",
      "level": 1,
      "parent": null,
      "start_ms": 24,
      "end_ms": 24
    },
    "252": {
      "title": "[ص: 490]",
      "level": 1,
      "parent": null,
      "start_ms": 24,
      "end_ms": 24
    },
    "253": {
      "title": ": أنا الذي صدقتكم وعدي، وأتممت عليكم نعمتي، وهذا محل كرامتي , فاسألوني. قال: فيسألونه الرضا. قال: فليسوا إلى شيء أحوج منهم إلى يوم الجمعة ليزدادوا النظر إلى وجه ربهم عز وجل \"",
      "level": 1,
      "parent": null,
      "start_ms": 24,
      "end_ms": 24
    },
    "254": {
      "title": "89 -",
      "level": 1,
      "parent": null,
      "start_ms": 24,
      "end_ms": 24
    },
    "255": {
      "title": "[ص: 492]",
      "level": 1,
      "parent": null,
      "start_ms": 24,
      "end_ms": 24
    },
    "256": {
      "title": ": \" يطلع الله إلى الزرع في أول ليلة من نيسان , فيقول: ليلحق آخرك بأولك \"",
      "level": 1,
      "parent": null,
      "start_ms": 24,
      "end_ms": 24
    },
