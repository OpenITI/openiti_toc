    "43": {
      "title": ": \" ممن فوقهن من الثقل \" قال: وقرأها خصيف، ينفطرن",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "44": {
      "title": "14 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "45": {
      "title": "[ص: 340]",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "46": {
      "title": "، {السماء منفطر به} [المزمل: 18] قال: \" بالله عز وجل \"",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "47": {
      "title": "15 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "48": {
      "title": "[ص: 342]",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "49": {
      "title": "، {يتفطرن من فوقهن} [الشورى: 5] قال: \" ينفطرن من عظمة الله وجلاله \"",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "50": {
      "title": "16 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "51": {
      "title": "[ص: 343]",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "52": {
      "title": ": \" تفكروا في كل شيء ولا تفكروا في الله، فإن بين السماء السابعة إلى كرسيه ألف نور وهو فوق ذلك \"",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "53": {
      "title": "17 -",
      "level": 1,
      "parent": null,
