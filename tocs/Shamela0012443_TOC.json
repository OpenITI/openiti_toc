      "title": "[ص: 451]",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "198": {
      "title": ": ما أنا بأعلم بذلك منك، إنما أكون تحت العرش فيلقى إلي صكاك فيها أسماء \"",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "199": {
      "title": "70 -",
      "level": 1,
