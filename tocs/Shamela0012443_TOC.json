    "234": {
      "title": "[ص: 478]",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 22
    },
    "235": {
      "title": ": \" هبط إلي جبريل فأخبرني أن الله باهى بي وبك يا عباس وبك يا علي حملة العرش، وباهى المهاجرين والأنصار أهل السماء العليا \"",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 22
    },
    "236": {
      "title": "83 -",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 22
    },
    "237": {
      "title": "[ص: 479]",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 23
    },
    "238": {
      "title": ": انظروا إلى عبادي شعثا غبرا \"",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 23
    },
    "239": {
      "title": "84 -",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 23
    },
    "240": {
      "title": "[ص: 481]",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 23
    },
    "241": {
      "title": "85 -",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 23
    },
    "242": {
      "title": "[ص: 482]",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 23
    },
    "243": {
      "title": ": انظروا إلى عبادي شعثا غبرا جاءوا من كل فج عميق، جاءوني يرجون مغفرتي، ولو كان عليك من الذنوب مثل رمل عالج وعدد قطر السماء وأيام الدنيا، لغفرها الله لك \"",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 23
    },
    "244": {
      "title": "86 -",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 23
    },
