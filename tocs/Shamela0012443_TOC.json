      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "204": {
      "title": ": \" مكتوب في سقف العرش، رحمتي سبقت غضبي \"",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
