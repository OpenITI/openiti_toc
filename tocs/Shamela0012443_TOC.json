    },
    "100": {
      "title": ": \" ثمانية صفوف من الملائكة لا يعلم عدتهم إلا الله \"",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "101": {
      "title": "34 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "102": {
      "title": ": \" من أسرج في مسجد من مساجد الله بسراج لم يزل الملائكة وحملة العرش يستغفرون له ما دام في ذلك المسجد ضوء من ذلك السراج \"",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "103": {
      "title": "35 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "104": {
      "title": "[ص: 386]",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "105": {
      "title": "موسى بن عمران، إني آمر حملة العرش أن يمسكوا عن العبادة إذا دخل شهر رمضان، وأن كلما دعا صائمو شهر رمضان أن يقولوا: آمين، فإني آليت على نفسي أن لا أرد دعوة صائم شهر رمضان \"",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "106": {
      "title": "36 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 11
    },
    "107": {
      "title": "[ص: 388]",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "108": {
      "title": ": \" ما من عبد يقول أربع مرات: اللهم إني أشهدك وكفى بك شهيدا، وأشهد حملة عرشك , وملائكتك , وجميع خلقك، وأنا أشهد أن لا إله إلا أنت وحدك لا شريك لك، وأن محمدا عبدك ورسولك، إلا كتب الله له فكاكا من النار \"",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "109": {
      "title": "37 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "110": {
      "title": "[ص: 390]",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "111": {
      "title": "[ص: 391]",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "112": {
      "title": "38 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 12
    },
    "113": {
      "title": "[ص: 392]",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "114": {
      "title": "[ص: 393]",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "115": {
      "title": "39 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "116": {
      "title": "[ص: 396]",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "117": {
      "title": "40 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "118": {
      "title": "[ص: 399]",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "119": {
      "title": ": \" لما أهبط آدم إلى الأرض قال الله: يا آدم، إني مهبط معك بيتا يطاف حوله كما يطاف حول عرشي، ويصلى عنده كما يصلى عند عرشي. قال: فلم يزل كذلك حتى كان الطوفان رفع، فكانت الأنبياء تحجه , فيأتونه , ولا يعرفون موضعه، حتى بوأه الله لإبراهيم الخليل عليه السلام \"",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "120": {
      "title": "41 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "121": {
      "title": "[ص: 401]",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "122": {
      "title": "فصعق من في السموات ومن في الأرض إلا من شاء الله قال: \" هم الشهداء ثنية الله حول العرش متقلدي السيوف \"",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "123": {
      "title": "42 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 13
    },
    "124": {
      "title": "[ص: 403]",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "125": {
      "title": ": فصعق من في السماوات ومن في الأرض إلا من شاء الله قال: \" الذين استثنى الله: جبريل وميكائيل وحملة العرش وملك الموت قال: فيأتي ملك الموت فيقبض أرواح هؤلاء حتى لا يبقى غيره ورب العزة جل وعز، فيقول: يا ملك الموت، مت فيموت، فذلك قوله: {كل من عليها فان} [الرحمن: 26] {ويبقى وجه ربك ذو الجلال والإكرام} [الرحمن: 27] , وذلك قوله: {كل شيء هالك إلا وجهه} [القصص: 88] \"",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "126": {
      "title": "43 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "127": {
      "title": "سبحان الله , والحمد لله , ولا إله إلا الله , والله أكبر لهن دوي حول العرش كدوي النحل، يذكرن بصاحبهن، والعمل الصالح في الخزائن \"",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "128": {
      "title": "44 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "129": {
      "title": "[ص: 407]",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "130": {
      "title": "للكلام الطيب حول العرش دويا كدوي النحل يذكر بصاحبه \"",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "131": {
      "title": "45 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "132": {
      "title": "[ص: 408]",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "133": {
      "title": ": \" ما السموات والأرض في العرش إلا مثل حلقة في أرض فلاة \"",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "134": {
      "title": "46 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "135": {
      "title": "[ص: 410]",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "136": {
      "title": ": \" آتي باب الجنة , فآخذ بحلقة الباب فأقرع الباب، فيقال لي: من أنت؟ فأقول: أنا محمد، فيفتح لي، فيتجلى لي ربي عز وجل فأخر له ساجدا وهو على سريره، أو على كرسيه - شك حماد -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "137": {
      "title": "47 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "138": {
      "title": ": \" أخبرت أن العرش ياقوتة حمراء \"",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "139": {
      "title": "48 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 14
    },
    "140": {
      "title": ": \" اهتز عرش الله لموت سعد بن معاذ \"",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "141": {
      "title": "49 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "142": {
      "title": "[ص: 417]",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "143": {
      "title": ": \" اهتز العرش لحب لقاء الله سعدا \"",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "144": {
      "title": "50 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "145": {
      "title": "[ص: 418]",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "146": {
      "title": ": \" لا يرقأ دمعك ويذهب حزنك، فإن ابنك أول من ضحك الله له واهتز له عرش الرحمن \"",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "147": {
      "title": "51 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "148": {
      "title": "[ص: 423]",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "149": {
      "title": "أتى رسول الله صلى الله عليه وسلم حين قبض سعد بن معاذ من جوف الليل معتجرا بعمامة من إستبرق، فقال: يا محمد، من هذا الميت الذي فتحت له أبواب السماء واهتز له العرش؟، فقام رسول الله صلى الله عليه وسلم سريعا يجر ثوبه إلى سعد فوجده قد مات",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "150": {
      "title": "52 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "151": {
      "title": "53 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "152": {
      "title": "[ص: 425]",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "153": {
      "title": "سأل جبريل أي الليل أفضل؟ قال: \" ما أدري، إلا أن العرش يهتز من آخر السحر \"",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "154": {
      "title": "54 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "155": {
      "title": "[ص: 427]",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 15
    },
    "156": {
      "title": "رجلا من بني إسرائيل كانت له امرأة جميلة فأولع به رجل يخبره عنها أنها كذا وكذا بالفحش قال: كيف أصنع ولها علي دين؟ قال: فأنا أسلفك ما عليك، فطلقها ثم تزوجها بعد ذلك، فلما تزوجها أخذه بحقه فاشتد عليه، فقال: اتق الله، فإنك لم تزل بي حتى فعلت الذي فعلت، ثم تزوجت امرأتي. قال: فلم يقلع عنه حتى أجره نفسه، فبينما هو ذات يوم وأكلا طعاما , فجعل يصب عليهما الماء , فبكى , فاهتز العرش، فقال تبارك وتعالى: \" إن رحمتي سبقت غضبي \"",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "157": {
      "title": "55 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "158": {
      "title": "[ص: 428]",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "159": {
      "title": "{إن كتاب الأبرار لفي عليين} [المطففين: 18] قال: \" في قائمة العرش اليمين \"",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "160": {
      "title": "56 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "161": {
      "title": "[ص: 430]",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "162": {
      "title": ": \" سبعة يظلهم الله في ظل عرشه يوم لا ظل إلا ظله، الإمام العادل ورجل لقي رجلا , فقال: والله إني لأحبك في الله، وقال الآخر مثل ذلك، ورجل قلبه معلق بالمساجد من حبها، ورجل جعل شبابه ونشاطه فيما يحب الله ويرضاه، ورجل دعته امرأة ذات جمال إلى نفسها , فتركها من خشية الله، ورجل إذا أعطى صدقته بيمينه كاد أن يخفيها من شماله، ورجل إذا ذكر الله فاضت عيناه من خشية الله تعالى \"",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "163": {
      "title": "57 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "164": {
      "title": "[ص: 432]",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "165": {
      "title": "58 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "166": {
      "title": "[ص: 433]",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 16
    },
    "167": {
      "title": ": \" آية الكرسي، ما السماوات السبع في الكرسي إلا كحلقة ملقاة بأرض فلاة، وفضل العرش على الكرسي كفضل تلك الفلاة على تلك الحلقة \"",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "168": {
      "title": "59 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "169": {
      "title": ": \" ما السماوات والأرض إلا كحلقة ملقاة بالفلاة، وما أخذت من الكرسي إلا كما أخذت تلك الحلقة من الأرض \"",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "170": {
      "title": "60 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "171": {
      "title": "[ص: 436]",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "172": {
      "title": "[ص: 437]",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "173": {
      "title": ": \" الكرسي موضع القدمين، وله أطيط كأطيط الرحل \"",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "174": {
      "title": "61 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "175": {
      "title": "[ص: 438]",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "176": {
      "title": ": \" الكرسي موضع القدمين والعرش لا يقدر أحد قدره \"",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "177": {
      "title": "62 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "178": {
      "title": "[ص: 440]",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "179": {
      "title": ": \" العرش مسيرة خمسين ألف سنة \"",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "180": {
      "title": "63 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "181": {
      "title": "[ص: 441]",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "182": {
      "title": ": \" اقرأ بهاتين الآيتين من آخر سورة البقرة؛ فإن الله أعطانيها من تحت العرش \"",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "183": {
      "title": "64 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "184": {
      "title": "[ص: 443]",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 17
    },
    "185": {
      "title": ": \" من كنز تحت العرش: لو أن لابن آدم مائة ألف، لم يصل إلى الحج حتى ينادي مناد من السماء: إن الله قد أكرم فلانا العام بالحج، ولو أن له مائة ألف لم يصل إلى العمرة حتى ينادي مناد من السماء: إن الله قد أكرم فلانا بالعمرة، ولو أن رجلا دخل فيما بين صفين , فضرب مائة ألف ضربة بالسيف لم يرزق الشهادة حتى ينادي مناد من السماء: قد أكرم الله فلانا بالشهادة \"",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "186": {
      "title": "65 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "187": {
      "title": ": \" البحر بحر السماء الذي تحت العرش، المحبوس عن العباد \"",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "188": {
      "title": "66 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "189": {
      "title": "[ص: 446]",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "190": {
      "title": "67 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "191": {
      "title": "[ص: 447]",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "192": {
      "title": "[ص: 448]",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 18
    },
    "193": {
      "title": "68 -",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "194": {
      "title": "[ص: 450]",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "195": {
      "title": ": \" العرش على ملك من لؤلؤة في صورة ديك، رجلاه في التخوم السفلى وعنقه مثنية تحت العرش، وجناحاه في المشرق والمغرب، فإذا سبح الله ذلك الملك لم يبق شيء إلا سبح \"",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "196": {
      "title": "69 -",
      "level": 1,
