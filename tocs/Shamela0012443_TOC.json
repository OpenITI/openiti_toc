    },
    "217": {
      "title": ": \" ما من خلقي أحد أقرب إلي من جبريل وميكائيل وإسرافيل، وإن بيني وبينهم مسيرة ألف عام \"",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
