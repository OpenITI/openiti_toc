    },
    "12": {
      "title": "AUTO غيرهم فغاية الأمر أن نظن أنهم صالحون فنرجو لهم ومنها انا لو",
      "level": 1,
      "parent": null,
      "start_ms": 120,
      "end_ms": 127
    },
    "13": {
      "title": "AUTO قال المصنف وفيه معرفة قدر الشرك في قلوب المؤمنين كيف صبر على",
