      "start_ms": 7,
      "end_ms": 7
    },
    "66": {
      "title": ": «من صلى الصبح فهو في ذمة الله، فاتقوا الله أن يطلبكم بشيء من ذمته» ،",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
