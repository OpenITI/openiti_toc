      "end_ms": 8
    },
    "74": {
      "title": ": «إذا لم تغتبقوا ولم تحتفئوا بقلا، فكلوا عارضتكم إن شئتم»",
      "level": 1,
      "parent": null,
      "start_ms": 8,
