      "end_ms": 5
    },
    "42": {
      "title": "19 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "43": {
      "title": ": «ما من أهل بيت لم يغز منهم غاز أو يجهز غازيا، أو يخلفوا غازيا في أهله إلا أصابهم الله",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
