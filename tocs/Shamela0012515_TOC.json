    },
    "7": {
      "title": ": \" قدم علينا رسول الله صلى ms1 الله عليه وسلم، فكان أسن أصحابه أبو بكر، فغلفها بالحناء والكتم،",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
