    },
    "62": {
      "title": "28 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "63": {
      "title": ": «صل الصلاة لميقاتها، واجعل صلاتك معهم سبحة»",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
