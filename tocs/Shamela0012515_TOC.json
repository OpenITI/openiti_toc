      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "18": {
      "title": ": فكيف إذا تباغضت قلوبهم، وتلاعنت ألسنتهم، وضرب بعضهم رقاب بعض، ثم قال:",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "19": {
      "title": "9 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
