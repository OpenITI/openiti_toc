      "end_ms": 8
    },
    "69": {
      "title": ": «إن الله بعثني بالسيف بين يدي الساعة حتى يعبد الله لا يشرك به، وجعل رزقي تحت ظل رمحي، وجعل",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
