      "start_ms": 8,
      "end_ms": 8
    },
    "76": {
      "title": ": \" ثلاثة لا ينفع اثنتان دون الثالثة: الإيمان بالله، والصلاة المكتوبة، ولزوم",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
