      "end_ms": 6
    },
    "57": {
      "title": "[ص: 12]",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "58": {
      "title": "صلى على وجهه حين دخل بين العمودين عن يمينه، ثم ألا أكون سألته: كم صلى رسول الله صلى الله",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "59": {
      "title": "27 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "60": {
      "title": ": \" ستصالحون الروم صلحا آمنا حتى تغزوا أنتم وهم عدوا من ورائهم، أو من ورائكم، فينتصرون",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 7
    },
    "61": {
      "title": "[ص: 13]",
      "level": 1,
      "parent": null,
      "start_ms": 7,
