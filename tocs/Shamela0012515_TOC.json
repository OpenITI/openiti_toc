      "title": "20 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "45": {
      "title": "يرفع يديه مع كل تكبيرة»",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
