    "2": {
      "title": ": اللهم إني آمنت بك، وهاجرت إلى رسولك، فإذا أنزلت بي شدة شديدة دعوتك، ففرجتها، فأسألك اللهم",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "3": {
