    },
    "2": {
      "title": ": «ما لي وللدنيا , وما للدنيا ومالي , والذي نفسي بيده ما مثلي ومثل الدنيا إلا كراكب سار في",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "3": {
      "title": "2 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 2
    },
    "4": {
      "title": "وما شبع من خبز بر مرتين في يوم حتى لقي الله»",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "5": {
      "title": "3 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "6": {
      "title": ": «ما بال أقوام بلغهم أني أترخص في الأمر فيدعونه، والله إني لأعلمهم بالله وأشدهم له",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "7": {
      "title": "4 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "8": {
      "title": ": «من اشتاق إلى الجنة سابق إلى الخيرات , ومن أشفق من النار لهى عن الشهوات , ومن ترقب الموت",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "9": {
      "title": "5 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 3
    },
    "10": {
      "title": ": «ما من عبد يحب الله ورسوله إلا للفقر أسرع إليه من جرية السيل من رأس الجبل إلى وجهه",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "11": {
      "title": "6 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "12": {
      "title": "«حق على الله أن لا يرفع من الدنيا شيئا إلا وضعه»",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "13": {
      "title": "7 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "14": {
      "title": "يصوم الشهر حتى نقول: لا يريد أن يفطر منه شيئا , أو يفطر الشهر حتى نقول: لا يريد أن يصوم",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "15": {
      "title": "8 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "16": {
      "title": "يصلي، ولجوفه أزيز كأزيز المرجل» .",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "17": {
      "title": "9 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "18": {
      "title": ": «إني أحب أن أسمعه من غيري» .",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 4
    },
    "19": {
      "title": "10 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "20": {
      "title": ": «ما أمسى عند آل محمد صاع من بر , ولا صاع من حب» .",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "21": {
      "title": "11 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "22": {
      "title": ": «توفي رسول الله صلى الله عليه وسلم ودرعه رهن بثلاثين صاعا من شعير كان أخذه لأهله من",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "23": {
      "title": "12 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "24": {
      "title": ": «ما أعرف منكم اليوم شيئا مما أدركت عليه أصحابي إلا هذه الصلاة , ولقد صنعتم فيها ما لا",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "25": {
      "title": "13 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "26": {
      "title": "مثل أصحابي في أمتي كالملح في الطعام , لا يصلح الطعام إلا بالملح» .",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "27": {
      "title": "14 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 5
    },
    "28": {
      "title": ": «لا يؤمن أحدكم حتى يحب لأخيه ما يحب لنفسه »",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "29": {
      "title": "15 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "30": {
      "title": ": \" يخرج في آخر الزمان رجال يختلون الدنيا بالدين , يلبسون جلود الضأن من اللين , ألسنتهم أحلى",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "31": {
      "title": "16 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "32": {
      "title": ": «اتقوا الله, وعليكم بالقرآن؛ فإنه نور الظلمة وهدى النهار , فخذوا به على ما كان من جهد",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "33": {
      "title": "17 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 6
    },
    "34": {
      "title": ": \" لا تزول قدما العبد يوم القيامة حتى يسأل عن أربع: عن عمره فيما أفناه , وعن شبابه فيما",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "35": {
      "title": "18 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "36": {
      "title": ": «استحيوا من الله حق الحياء» .",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "37": {
      "title": "19 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "38": {
      "title": ": «احفظ الله يحفظك , احفظ الله تجده أمامك , إذا سألت فاسأل الله , وإذا استعنت فاستعن بالله",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 7
    },
    "39": {
      "title": "20 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "40": {
      "title": ": «ما تواد اثنان في الإسلام ففرق بينهما إلا من ذنب يحدثه أحدهما»",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "41": {
      "title": "21 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "42": {
      "title": ": «كيف أنعم وصاحب القرن شاخص ببصره , منحن ظهره , ينتظر متى يؤمر» .",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "43": {
      "title": "22 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "44": {
      "title": ": «كيف أنعم وصاحب القرن قد التقم القرن , واستمع الأذان متى يؤمر فينفخ» , فاشتد ذلك على أصحاب",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "45": {
      "title": "23 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "46": {
      "title": ": «لو أن رجلا ارتبط فرسا فنتجت عنده مهرا حين يرى أول الآيات ما يركب حتى",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "47": {
      "title": "24 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "48": {
      "title": ": «الآيات كلها في ثلاثة أشهر»",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "49": {
      "title": "25 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "50": {
      "title": ": \" إنكم محشورون إلى الله حفاة عراة غرلا: {كما بدأنا أول خلق نعيده وعدا علينا إنا كنا فاعلين}",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 8
    },
    "51": {
      "title": "26 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "52": {
      "title": ": «إني أرى ما لا ترون، وأسمع ما لا تسمعون , أطت السماء وحق لها أن تئط؛ ما فيها موضع أربع",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "53": {
      "title": "27 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "54": {
      "title": "أمامكم عقبة كئودا، لا يجوزها إلا المتخففون، وإني أحب أن أتخفف لها»",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "55": {
      "title": "28 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "56": {
      "title": ": «من مشى لأخيه المسلم في حاجة كتب الله له بكل خطوة سبعين حسنة، ومحا عنه بكل خطوة سبعين",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "57": {
      "title": "29 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 9
    },
    "58": {
      "title": ": «من أمسى وأصبح وليس المؤمنون والمؤمنات والمسلمون والمسلمات من همه فليس مني ولست",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "59": {
      "title": "30 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "60": {
      "title": ": \" أوحى الله تبارك وتعالى إلى نبي من الأنبياء: «قل لفلان العابد أما زهدك في الدنيا فتعجلت",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "61": {
      "title": "31 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "62": {
      "title": ": \" من قرأ: قل هو الله أحد.",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "63": {
      "title": "32 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 10
    },
    "64": {
      "title": "33 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "65": {
      "title": "تختم باليمين تكن من المقربين» .",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "66": {
      "title": "34 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "67": {
      "title": "من أحب أن ينظر إلى آدم في خلقه، وأنا في خلقي، وإلى إبراهيم في خلقه، وإلى موسى في مناجاته",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 11
    },
    "68": {
      "title": "35 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "69": {
      "title": "الأعمال بالنية، وإنما لامرئ ما نوى , فمن كانت هجرته إلى الله وإلى رسوله , فهجرته إلى الله",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "70": {
      "title": "36 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "71": {
      "title": ": \" الغزو غزوان: غزو يبتغى به وجه الله تنفق فيه الكريمة ويحتسب فيه العمل , ويياسر فيه الشريك،",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "72": {
      "title": "37 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "73": {
      "title": ": «النظر إلى وجه علي بن أبي طالب عبادة»",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "74": {
      "title": "38 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "75": {
      "title": ": «النظر إلى وجه علي عبادة»",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "76": {
      "title": "39 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 12
    },
    "77": {
      "title": ": «يحشر الجبارون والمتكبرون على صور الذر , يجاء بالجبارين والمتكبرين رجالا في صور الذر يطؤهم",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "78": {
      "title": "40 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "79": {
      "title": ": «إني قمت على باب الجنة فإذا عامة من دخلها المساكين , ونظرت إلى النار فإذا عامة من دخلها",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "80": {
      "title": "41 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "81": {
      "title": ": \" يأخذ الجبار سمواته وأرضه بيده، وقبض يده فجعل يقبضها ويبسطها , ويقول: «أنا الجبار أنا",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "82": {
      "title": "42 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "83": {
      "title": "، قطع في مجن قيمته ثلاثة دراهم»",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "84": {
      "title": "43 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "85": {
      "title": ": \" لا حسد إلا في اثنتين: رجل أتاه الله مالا وسلطه على هلكته في الحق , ورجل أتاه الله علما",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "86": {
      "title": "44 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 13
    },
    "87": {
      "title": "تسبح عند منامها ثلاثا وثلاثين، وتكبر أربعا وثلاثين، وتحمد ثلاثا",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "88": {
      "title": "45 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "89": {
      "title": "يقول في ركوعه: «سبوح قدوس رب الملائكة والروح»",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "90": {
      "title": "46 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "91": {
      "title": "أخف الناس الصلاة في تمام»",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "92": {
      "title": "47 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "93": {
      "title": ": «البزاق في المسجد خطيئة، وكفارتها دفنها»",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "94": {
      "title": "48 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "95": {
      "title": ": «لا يؤمن أحدكم حتى أكون أحب إليه من ولده ووالده والناس أجمعين»",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "96": {
      "title": "49 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "97": {
      "title": ": «تعلموا ما شئتم أن تعلموا من العلم , فإن الله لا يأجركم على العلم حتى تعملوا به، إن",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "98": {
      "title": "50 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 14
    },
    "99": {
      "title": ": «الإيمان بضع وستون أو بضع وسبعون بابا , أعلاها لا إله إلا الله , وأدناها إماطة الأذى عن",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "100": {
      "title": "51 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "101": {
      "title": ": «من شهد جنازة وصلى عليها وصبر حتى تدفن كان له من الأجر قيراطان، أصغرهما مثل جبل",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "102": {
      "title": "52 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "103": {
      "title": "ابن عمك عليا قد خطبك , فماذا تقولين؟» فبكت , وقالت: كأنك يا أبت ادخرتني لفقير قريش , فقال:",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "104": {
