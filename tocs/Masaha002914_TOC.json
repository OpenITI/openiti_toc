    "124": {
      "title": "اللطيفة الاولى (من هذه الالقاب المنسوب إليها ما اشترك بين القبائل المشهورة)",
      "level": 3,
      "parent": null,
      "start_ms": 151,
      "end_ms": null
    },
    "125": {
      "title": "اللطيفة الثانية محمد الباقر أكثر أسباط الحسينية عقبا. وعبد الله ديباجة بني هاشم أكثر الحسنيين عقبا،",
      "level": 3,
      "parent": 124,
      "start_ms": 151,
      "end_ms": 151
    },
    "126": {
      "title": "اللطيفة الثالثة قد اتفق في الانساب الانتساب الى رجل مشهور، والمعنى به الانتساب الى أحد أولاده فحسب،",
      "level": 3,
      "parent": 124,
      "start_ms": 151,
      "end_ms": 152
    },
    "127": {
      "title": "المرتبة الاولى [ان يكون الانتساب من ابنه فحسب]",
      "level": 3,
      "parent": 124,
      "start_ms": 152,
      "end_ms": 155
    },
    "128": {
      "title": "المرتبة الثانية (وهو تخلل رجلين)",
      "level": 3,
      "parent": 124,
      "start_ms": 155,
      "end_ms": 157
    },
    "129": {
      "title": "المرتبة الثالثة (وهو ان يكون الانتهاء الى الثالث من الاحفاد)",
      "level": 3,
      "parent": 124,
      "start_ms": 157,
      "end_ms": 159
    },
    "130": {
      "title": "المرتبة الرابعة (وهو أن يكون الانتهاء الى الرابع من الاولاد) ms158",
      "level": 3,
      "parent": 124,
      "start_ms": 159,
      "end_ms": 159
    },
    "131": {
      "title": "المرتبة الخامسة حمزة بن حمزة بن موسى الكاظم عليه السلام المراد منه النقيب ببلخ",
      "level": 3,
      "parent": 124,
      "start_ms": 159,
      "end_ms": 159
    },
    "132": {
      "title": "المرتبة السادسة ابراهيم الوردي ابن أبي عبد الله محمد بن عبيد الله الامير ابن الحسن بن جعفر الخطيب،",
      "level": 3,
      "parent": 124,
      "start_ms": 159,
      "end_ms": 159
    },
    "133": {
      "title": "اللطيفة الرابعة وهي مما استفدته من حضرت سيدنا ومولانا (1) أفضل العالم فخر الملة والدين،",
      "level": 3,
      "parent": 124,
      "start_ms": 159,
      "end_ms": 160
    },
    "134": {
      "title": "اللطيفة الخامسة وقد استفدته من حضرت مولانا أيضا أدام الله جلاله:",
      "level": 3,
      "parent": 124,
      "start_ms": 160,
      "end_ms": 160
    },
    "135": {
      "title": "اللطيفة السادسة قال البخاري: أعقب الحسن عليه السلام من رجلين وامرأة، وأعقب الحسين عليه السلام من رجل وامرأتين.",
      "level": 3,
      "parent": 124,
      "start_ms": 160,
      "end_ms": 160
    },
    "136": {
      "title": "اللطيفة السابعة في أحد أسباط الحسين عليه السلام الموسوية، وهم بنو موسى الكاظم عليه السلام. وفي أحد أسباط الحسن أيضا الموسوية،",
      "level": 3,
      "parent": 124,
      "start_ms": 160,
      "end_ms": 160
    },
    "137": {
      "title": "اللطيفة الثامنة الموسوية الحسينية أربعة عشر سبطا. والحسنية كانوا أيضا كذلك،",
      "level": 3,
      "parent": 124,
      "start_ms": 160,
      "end_ms": 161
    },
    "138": {
      "title": "اللطيفة التاسعة أمير المؤمنين وجعفر الطيار وعقيل هم أول هاشمي ولده هاشم مرتين.",
      "level": 3,
      "parent": 124,
      "start_ms": 161,
      "end_ms": 161
    },
    "139": {
      "title": "اللطيفة العاشرة محمد الباقر عليه السلام وعبد الله الباهر أول حسيني اجتمع له ولادة الحسن والحسين عليهما السلام",
      "level": 3,
      "parent": 124,
      "start_ms": 161,
      "end_ms": 161
    },
    "140": {
      "title": "اللطيفة الحادية عشر عبد الله ديباجة بني هاشم، وابراهيم الغمر، والحسن المثلث، أول حسني اجتمع له ولادة الحسن والحسين عليهما السلام.",
      "level": 3,
      "parent": 124,
      "start_ms": 161,
      "end_ms": 161
    },
    "141": {
      "title": "اللطيفة الثانية عشر اتفق في القرن الثاني من الاسباط الاثنى عشر الستة الحسنية مع الستة الحسينية في العدد،",
      "level": 3,
      "parent": 124,
      "start_ms": 161,
      "end_ms": 162
    },
    "142": {
      "title": "اللطيفة الثالثة عشر (اتفاق الاسماء من المعقبين فحسب)",
      "level": 3,
      "parent": 124,
      "start_ms": 162,
      "end_ms": 162
    },
    "143": {
