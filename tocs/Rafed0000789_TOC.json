    "202": {
      "title": "ثورة الحسين عليه السلام",
      "level": 5,
      "parent": null,
      "start_ms": 72,
      "end_ms": 90
    },
    "203": {
      "title": "موقف الحسين عليه السلام من البيعة ليزيد :",
      "level": 4,
      "parent": 202,
      "start_ms": 72,
      "end_ms": 73
    },
    "204": {
      "title": "** ويلي عليك يابن الزرقاء ، أنت تأمر بضرب عنقي؟ كذبت ولؤمت",
      "level": 4,
      "parent": 202,
      "start_ms": 73,
      "end_ms": 73
    },
    "205": {
      "title": "** أيها الأمير ، إنا أهل بيت النبوة ، ومعدن الرسالة ، ومختلف",
      "level": 4,
      "parent": 202,
      "start_ms": 73,
      "end_ms": 73
    },
    "206": {
      "title": "** شارب الخمر ، قاتل النفس المحترمة معلن بالفسق والفجور ، ومثلي",
      "level": 4,
      "parent": 202,
      "start_ms": 73,
      "end_ms": 74
    },
    "207": {
      "title": "بواعث الثورة عند الحسين عليه السلام :",
      "level": 4,
      "parent": 202,
      "start_ms": 74,
      "end_ms": 74
    },
    "208": {
      "title": "** إني لم أخرج أشرا ، ولا بطرا ولا مفسدا ، ولا ظالما ، وإنما",
      "level": 4,
      "parent": 202,
      "start_ms": 74,
      "end_ms": 75
    },
    "209": {
      "title": "** أيها الناس إن رسول الله",
      "level": 4,
      "parent": 202,
      "start_ms": 75,
      "end_ms": 75
    },
    "210": {
      "title": "** قال : من رأى سلطانا جائرا ، مستحلا لحرام الله ناكثا لعهد",
      "level": 4,
      "parent": 202,
      "start_ms": 75,
      "end_ms": 75
    },
    "211": {
      "title": "** مدخله .. ألا وأن هؤلاء قد لزموا طاعة الشيطان وتركوا طاعة",
      "level": 4,
      "parent": 202,
      "start_ms": 75,
      "end_ms": 75
    },
    "212": {
      "title": "** نفسي مع أنفسكم ، وأهلي مع أهليكم ، فلكم في أسوة. وإن لم",
      "level": 4,
      "parent": 202,
      "start_ms": 75,
      "end_ms": 76
    },
    "213": {
      "title": "** وأنا الحسين بن علي وابن فاطمة بنت رسول الله",
      "level": 4,
      "parent": 202,
      "start_ms": 76,
      "end_ms": 76
    },
    "214": {
      "title": "** نفسي مع أنفسكم ، وأهلي مع أهليكم ، فلكم في أسوة",
      "level": 4,
      "parent": 202,
      "start_ms": 76,
      "end_ms": 76
    },
    "215": {
      "title": "بواعث الثورة لدى الرأي العام",
      "level": 4,
      "parent": 202,
      "start_ms": 76,
      "end_ms": 76
    },
    "216": {
      "title": "** أما بعد أيها الناس؛ فإنكم إن تتقوا الله ، وتعرفوا الحق لأهله",
      "level": 4,
      "parent": 202,
      "start_ms": 76,
      "end_ms": 76
    },
    "217": {
      "title": "** ما أتتني به كتبكم. وقدمت به علي رسلكم انصرفت عنكم",
      "level": 4,
      "parent": 202,
      "start_ms": 76,
      "end_ms": 77
    },
    "218": {
      "title": "** يا عقبة بن سمعان أخرج الخرجين ms076 اللذين فيهما كتبهم إلي",
      "level": 4,
      "parent": 202,
      "start_ms": 77,
      "end_ms": 77
    },
    "219": {
      "title": "تحطيم الإطار الديني :",
      "level": 4,
      "parent": 202,
      "start_ms": 77,
      "end_ms": 79
    },
    "220": {
      "title": "** أيها الناس اسمعوا قولي ، ولا تعجلوني حتى أعظكم بما يجب لكم",
      "level": 4,
      "parent": 202,
      "start_ms": 79,
      "end_ms": 79
    },
    "221": {
      "title": "** أما بعد. فانسبوني ، فانظروا من أنا ، ثم ارجعوا إلى أنفسكم",
      "level": 4,
      "parent": 202,
      "start_ms": 79,
      "end_ms": 79
    },
    "222": {
      "title": "** ، وابن وصيه وابن عمه ، وأول المؤمنين بالله ، والمصدق لرسوله",
      "level": 4,
      "parent": 202,
      "start_ms": 79,
      "end_ms": 79
    },
    "223": {
      "title": "** قال لي ولأخي : «هذان سيدا شباب أهل الجنة»؟ فإن صدقتموني بما",
      "level": 4,
      "parent": 202,
      "start_ms": 79,
      "end_ms": 80
    },
    "224": {
      "title": "** لي ولأخي ، أفما في هذا حاجز لكم عن سفك دمي",
      "level": 4,
      "parent": 202,
      "start_ms": 80,
      "end_ms": 80
    },
    "225": {
      "title": "** فإن كنتم في شك من هذا القول أفتشكون في أني ابن بنت نبيكم؟",
      "level": 4,
      "parent": 202,
      "start_ms": 80,
      "end_ms": 80
    },
    "226": {
      "title": "** يا شبث بن ربعي ، ويا حجار بن أبجر ، ويا قيس بن الأشعث ، ويا",
      "level": 4,
      "parent": 202,
      "start_ms": 80,
      "end_ms": 80
    },
    "227": {
      "title": "** سبحان الله! بلى والله ، لقد فعلتم",
      "level": 4,
      "parent": 202,
      "start_ms": 80,
      "end_ms": 80
    },
    "228": {
      "title": "** أيها الناس : إذا كرهتموني فدعوني أنصرف عنكم إلى مأمني من الأرض.",
      "level": 4,
      "parent": 202,
      "start_ms": 80,
      "end_ms": 80
    },
    "229": {
      "title": "** أنت أخو أخيك ، أتريد أن يطلبك بنو هاشم باكثر من دم مسلم بن عقيل",
      "level": 4,
      "parent": 202,
      "start_ms": 80,
      "end_ms": 80
    },
    "230": {
      "title": "** لا والله لا أعطيهم بيدي إعطاء الذليل ، ولا أقر إقرار العبيد.",
      "level": 4,
      "parent": 202,
      "start_ms": 80,
      "end_ms": 80
    },
    "231": {
      "title": "** إني عذت بربي وربكم أن ترجمون. أعوذ بربي وربكم من كل متكبر لا",
      "level": 4,
      "parent": 202,
      "start_ms": 80,
      "end_ms": 90
    },
    "232": {
      "title": "ثورة التوابين",
      "level": 5,
      "parent": 231,
      "start_ms": 81,
      "end_ms": 83
