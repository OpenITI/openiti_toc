    },
    "2": {
      "title": "إذا كبر للصلاة رفع يديه حذو منكبيه، فإذا رفع فعل مثل ذلك، ولا يفعل ذلك بين",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "3": {
      "title": "2 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "4": {
      "title": ": «البزاق في المسجد خطيئة وكفارتها أن تواريه»",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "5": {
      "title": "3 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 2
    },
    "6": {
      "title": "الذي يرجع في عطيته: «كمثل الكلب أكل حتى إذا شبع قاء ثم عاد فأكله»",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "7": {
      "title": "4 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "8": {
      "title": ": فتلت قلائد هدي رسول الله صلى الله عليه وسلم بيدي، ثم قلدها وأشعرها فلم يحرم عليه شيء كان",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "9": {
      "title": "5 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "10": {
      "title": ": «على كل باب مسجد يوم الجمعة ملائكة يكتبون مجيء الرجل فإذا جلس الإمام طويت الصحف , فالمهجر",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "11": {
      "title": "6 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "12": {
      "title": ": أتيت رسول الله صلى الله عليه وسلم من آخر الليل فصليت خلفه فأخذ بيدي فجرني حتى جعلني",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "13": {
      "title": "7 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "14": {
      "title": "ينقل معهم الحجارة للكعبة وعليه إزاره، فقال له العباس عمه: \" يا ابن أخي لو حللت إزارك فجعلته",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "15": {
      "title": "8 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 3
    },
    "16": {
      "title": "جلود الميتة، قال: «إن دباغه قد أذهب بخبثه أو نجسه أو برجسه»",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "17": {
      "title": "9 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "18": {
      "title": ": أتي عبيد الله بن زياد برأس الحسين بن علي عليه السلام، فجعل في طست فجعل ينكت عليه، وقال:",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "19": {
      "title": "10 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "20": {
      "title": ": فزع الناس، فركب رسول الله صلى الله عليه وسلم فرسا لأبي طلحة بطيئا , ثم خرج يركض وحده،",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "21": {
      "title": "11 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "22": {
      "title": ": «تسموا باسمي , ولا تكنوا بكنيتي»",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "23": {
      "title": "12 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "24": {
      "title": ": «إذا كفن أحدكم أخاه فليحسن كفنه»",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "25": {
      "title": "13 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "26": {
      "title": "جارية بكرا أتت النبي صلى الله عليه وسلم، فذكرت أن أباها زوجها وهي كارهة،",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "27": {
      "title": "14 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "28": {
      "title": ": \" أخذ الله الميثاق من ظهر آدم عليه السلام بنعمان يعني عرفة، فأخرج من صلبه كل ذرية ذرأها",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 4
    },
    "29": {
      "title": "15 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "30": {
      "title": ": «سيكون بعدي هنات وهنات وهنات ممدودة فمن رأيتموه يفرق أمة محمد صلى الله عليه وسلم وهي جميع",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "31": {
      "title": "16 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "32": {
      "title": "يقرأ في الركعة الأولى من صلاة الفجر: ق والقرءان المجيد ولا أدري ما قرأ في",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "33": {
      "title": "17 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "34": {
      "title": ": «يمن الخيل في شقرها»",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "35": {
      "title": "18 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "36": {
      "title": ": «لما عرج بي رأيت إدريس عليه السلام في السماء الرابعة»",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "37": {
      "title": "19 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "38": {
      "title": "رجلا، قال: يا رسول الله كيف يحشر الكافر على وجهه يوم القيامة؟ فقال نبي الله عليه السلام:",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "39": {
      "title": "20 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "40": {
      "title": ": لما نزلت: {يأيها الذين آمنوا صلوا عليه وسلموا تسليما} [الأحزاب: 56] جاء رجل إلى النبي",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 5
    },
    "41": {
      "title": "21 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "42": {
      "title": ": رخص رسول الله صلى الله عليه وسلم في العرايا أن تباع بخرصها تمرا \"",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "43": {
      "title": "22 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "44": {
      "title": ": «ما منكم من أحد إلا قد كتب مقعده من الجنة ومقعده من النار» .",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "45": {
      "title": "23 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "46": {
      "title": "«أتى سباطة قوم فبال قائما» .",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "47": {
      "title": "24 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "48": {
      "title": ": «أرحم أمتي أبو بكر، وأشدها في دين الله عمر، وأصدقها حياء عثمان، وأفرضهم زيد، وأقرؤهم أبي،",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "49": {
      "title": "25 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "50": {
      "title": ": «من نوقش الحساب هلك» .",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "51": {
      "title": "26 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 6
    },
    "52": {
      "title": "رفع عقصة، فقال: سمعت رسول الله صلى الله عليه وسلم، يقول: «عذبت أمة من بني إسرائيل؛ لأن",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "53": {
      "title": "27 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "54": {
      "title": ": «ما تركت استلام الحجر في رخاء ولا شدة منذ رأيت رسول الله صلى الله عليه وسلم",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "55": {
      "title": "28 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "56": {
      "title": ": «أفطر الحاجم والمحجوم»",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "57": {
      "title": "29 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "58": {
      "title": ": جاء ماعز بن مالك إلى النبي عليه السلام، فقال: يا رسول الله طهرني.",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 7
    },
    "59": {
      "title": "30 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "60": {
      "title": "«قسم غنما فجعل لكل عشرة من أصحابه شاة، وأنها كانت نهبة» , قال: «وقد أمر رسول الله صلى الله",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "61": {
      "title": "31 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "62": {
      "title": "يتختم في يمينه ونقشه محمد رسول الله»",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "63": {
      "title": "32 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "64": {
      "title": "أراد أن يكتب إلى كسرى وقيصر فقيل له: إنهم لا يقبلون كتابك إلا بخاتم.",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "65": {
      "title": "33 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "66": {
      "title": "إذا رفع رأسه من الركوع لم يحن أحد منا ظهره حتى يضع رسول الله صلى الله عليه",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "67": {
      "title": "34 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 8
    },
    "68": {
      "title": ": \" أتانا رسول الله صلى الله عليه وسلم فوضع رجله بيني وبين فاطمة، فعلمنا ما نقول إذا أخذنا",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "69": {
      "title": "35 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "70": {
      "title": "احتجم وهو صائم محرم»",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "71": {
      "title": "36 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "72": {
      "title": ": «المؤمن يأكل في معى واحد , والكافر يأكل في سبعة أمعاء»",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "73": {
      "title": "37 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "74": {
      "title": ": «نهى رسول الله صلى الله عليه وسلم أن ترمى جمرة العقبة يوم النحر حتى تطلع",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "75": {
      "title": "38 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "76": {
      "title": "يصلي ركعتين خفيفتين قبل الفجر»",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "77": {
      "title": "39 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "78": {
      "title": ": «إذا شككتم في طريق فاجعلوه سبعة أذرع تختلف فيه الحاملتان»",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "79": {
      "title": "40 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 9
    },
    "80": {
      "title": ": «ما تعنون بالجد؟» فقالوا: الرجل يكون له الإبل والخيل فتنمى، فقال: فقام النبي صلى الله عليه ms08",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "81": {
      "title": "41 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "82": {
      "title": ": «سيكون عليكم أئمة يميتون الصلاة , فصلوا الصلاة لوقتها , واجعلوا صلواتكم معهم",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "83": {
      "title": "42 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "84": {
      "title": "المسح على الخفين ثلاثة أيام للمسافر ولياليهن، وللمقيم يوم وليلة»",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "85": {
      "title": "43 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "86": {
      "title": "المؤمن يؤجر في هدايته السبيل، وإماطته الأذى عن الطريق , وفي تعبيره بلسانه عن الأعجمي،",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "87": {
      "title": "44 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "88": {
      "title": "«أهدى في بدنة بعيرا كان لأبي جهل في أنفه برة من فضة»",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "89": {
      "title": "45 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "90": {
      "title": ": «ساق النبي عليه السلام مائة بدنة , فيها جمل لأبي جهل عليه برة من فضة»",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "91": {
      "title": "46 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 10
    },
    "92": {
      "title": ": «يدخل الفقراء الجنة قبل ms09 الأغنياء بخمسمائة عام، نصف يوم»",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "93": {
      "title": "47 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "94": {
      "title": ": «طوبى لعيش بعد المسيح , طوبى لعيش بعد المسيح، يؤذن للسماء في القطر، ويؤذن للأرض في النبات",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "95": {
      "title": "48 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "96": {
      "title": ": أكان عمر يقنت؟ قال: «ومن خير من عمر»",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "97": {
      "title": "49 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "98": {
      "title": "، لا تهلكن عن آية الرجم , قد نزلت وقرأناها الشيخ والشيخة فارجموهما البتة، وقد رجم رسول الله",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "99": {
      "title": "50 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "100": {
      "title": ": «لعن الله الواصلة والمستوصلة، والواشمة والمستوشمة»",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "101": {
      "title": "51 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "102": {
      "title": "أراد أن يصدر , فقيل له: إن صفية قد حاضت.",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "103": {
      "title": "52 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 11
