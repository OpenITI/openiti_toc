      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "108": {
      "title": "55 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "109": {
      "title": "ما أفطر أحد منهم على طعام قط وحده , إن وجد من يأكل معه أكل , وإلا أخرج طعامه إلى المسجد",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "110": {
      "title": "56 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "111": {
      "title": "لا يأكل طعاما إلا ويقيم معه على مائدته يتيم»",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "112": {
      "title": "57 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "113": {
      "title": "أسرع صدقة تصعد إلى السماء أن يصنع الرجل طعاما طيبا ثم يجمع عليه ناسا من",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "114": {
      "title": "58 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "115": {
      "title": ": «لا , بل أقره»",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "116": {
      "title": "59 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "117": {
      "title": "يدعو إخوانه فيصنع لهم الطعام , ويجيزهم بالدراهم",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "118": {
      "title": "60 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "119": {
      "title": ": ما رأيت مجلسا قط أكرم من مجلس ابن عباس , أكثر فقها , وأعظم جفنة , إن أصحاب القرآن عنده",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "120": {
      "title": "61 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 11
    },
    "121": {
      "title": ": لا , حتى تصيبوا من طعامنا , فيجب علينا حقكم وذمامكم , قال: فأصبنا من طعامه , فأمر لنا",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "122": {
      "title": "62 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "123": {
      "title": "سخيا على الطعام , جوادا بالدنانير والدراهم",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "124": {
      "title": "63 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "125": {
      "title": ": لم يكن بالكوفة أسخى على طعام ومال من حماد بن أبي سليمان , ومن بعده خلف بن",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "126": {
      "title": "64 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "127": {
      "title": ": الكرم , والبذلة , والاحتمال",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "128": {
      "title": "65 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "129": {
      "title": "فقدم إلينا مرقا ما فيه لحم",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "130": {
      "title": "66 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "131": {
      "title": "فأطعمتنا رطبا , وسقتنا سلتا , وقالت: نعم , ثم قصت الحديث",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "132": {
      "title": "67 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "133": {
      "title": "يفطر كل ليلة في شهر رمضان مائة إنسان , فإذا كان ليلة الفطر كساهم ثوبا ثوبا , وأعطاهم مائة",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "134": {
      "title": "68 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "135": {
      "title": "فكان يطعم على مائدته لونا واحدا , لا يزيد على ذلك",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "136": {
      "title": "69 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 12
    },
    "137": {
      "title": ": «ليس معي غيره ليس يحضرني الآن غيره»",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "138": {
      "title": "70 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "139": {
      "title": ": فقد أمرت له بخمسة ألف درهم , ولا يبذل وجهي إليه , قال: جزاك الله خيرا , فهذا أكثر مما أمل",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "140": {
      "title": "[ص: 58]",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "141": {
      "title": "71 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "142": {
      "title": ": انظر الذي تحت الوسادة , فمرهم أن ينتفعوا به , قال: فأجد الدارهم",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "143": {
      "title": "72 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "144": {
      "title": ": اذهب , فاشتر بها لزهير سكرا",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "145": {
      "title": "73 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 13
    },
    "146": {
      "title": "فدفع إليه صرة كانت فيها ثلاثون دينارا , وأثوابا كانت معه , فقال: تجهز بها إلى",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": null
    }
