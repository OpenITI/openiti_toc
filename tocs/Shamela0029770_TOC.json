    "2": {
      "title": "يصوم شعبان كله , حتى يصله برمضان»",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "3": {
      "title": "2 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "4": {
      "title": "«ما رأيت رسول الله صلى الله عليه وسلم يصوم شهرا قط إلا شعبان , ثم رمضان»",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "5": {
      "title": "3 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 2
    },
    "6": {
      "title": ": \" هل صمت من سرر شعبان شيئا؟ قال: لا.",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "7": {
      "title": "4 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "8": {
      "title": ": «إذا كان النصف من شعبان فأفطروا حتى رمضان»",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "9": {
      "title": "5 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "10": {
      "title": ": «إذا انتصف شعبان فكفوا عن الصوم»",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "11": {
      "title": "6 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "12": {
      "title": "الله تعالى يطلع ليلة النصف من شعبان إلى عباده فيغفر للمؤمنين ويملي للكافرين ويدع أهل",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "13": {
      "title": "7 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 3
    },
    "14": {
      "title": ": «يطلع الله تعالى إلى خلقه ليلة النصف من شعبان فيغفر لجميع خلقه إلا لمشرك أو",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "15": {
      "title": "8 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "16": {
      "title": "الله تعالى يطلع على خلقه ليلة النصف من شعبان فيغفر لهم إلا مشركا أو",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "17": {
      "title": "9 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "18": {
      "title": "الله تعالى ليلة النصف من شعبان يعتق من النار عدد شعر يعني غنم كلب وينزل أرزاق السنة ويكتب",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 4
    },
    "19": {
      "title": "10 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "20": {
      "title": "جاءكم شهر رمضان، شهر مبارك فرض الله عليكم صيامه تفتح فيه أبواب الجنة وتغلق فيه أبواب",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "21": {
      "title": "11 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "22": {
      "title": ": «هذا رمضان قد جاء تفتح فيه أبواب الجنان وتغلق فيه أبواب النار وتغل فيه الشياطين بعد من",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "23": {
      "title": "12 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 5
    },
    "24": {
      "title": ": «من صام رمضان إيمانا واحتسابا غفر له ما كان قبل ذلك من عمل»",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "25": {
      "title": "13 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "26": {
      "title": ": «من صام رمضان إيمانا واحتسابا غفر له ما تقدم من ذنبه»",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "27": {
      "title": "14 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "28": {
      "title": "أجود الناس بالخير وكان أجود ما يكون في شهر رمضان حين يلقى جبريل وكان جبريل عليه السلام",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "29": {
      "title": "15 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "30": {
      "title": ": «هذا شهر رمضان فمن صامه إيمانا واحتسابا غفر له ما تقدم من ذنبه»",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "31": {
      "title": "16 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 6
    },
    "32": {
      "title": ": «من لم يبيت الصيام قبل طلوع الفجر فلا صيام له»",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "33": {
      "title": "17 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "34": {
      "title": ": «لا صيام لمن لم يجمع الصيام قبل الفجر»",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "35": {
      "title": "18 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "36": {
      "title": ": «لا صيام لمن لم يجمع الصيام من الليل»",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "37": {
      "title": "19 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "38": {
      "title": ": \" هل يعجل أهل الشام الإفطار؟ قال: نعم.",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "39": {
      "title": "20 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "40": {
      "title": ": «لا يزال الناس بخير ما عجلوا الفطر فإن اليهود والنصارى يؤخرون»",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "41": {
      "title": "21 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 7
    },
    "42": {
      "title": ": دعاني رسول الله صلى الله عليه وسلم إلى السحور في رمضان فقال: «هلم إلى الغداء",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "43": {
      "title": "22 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "44": {
      "title": "، يدعو في شهر رمضان، وهو يقول: «هلموا إلى الغداء المبارك»",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "45": {
      "title": "23 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "46": {
      "title": ": «من أخلاق الأنبياء تأخير السحور وتعجيل الإفطار ووضع اليمين على الشمال»",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "47": {
      "title": "24 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "48": {
      "title": ": «من أخلاق النبوة تعجيل الإفطار وتأخير السحور ووضع اليمين الأيدي على الأيدي في",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "49": {
      "title": "25 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "50": {
      "title": ": «نعم غداء المؤمن السحور إن الله وملائكته يصلون على المتسحرين»",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "51": {
      "title": "26 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 8
    },
    "52": {
      "title": ": «تسحروا ولو بحبة»",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "53": {
      "title": "27 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "54": {
      "title": ": «تسحروا ولو بجرعة ماء»",
      "level": 1,
