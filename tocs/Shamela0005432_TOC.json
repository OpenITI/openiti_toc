      "start_ms": 49,
      "end_ms": 52
    },
    "19": {
      "title": "ففيه تجنيس اللفظ والخط: بيهب. وتجنيس التورية بها أيضا لأنه مدح بإيجاب وبنفي وأتى",
      "level": 1,
      "parent": null,
      "start_ms": 52,
      "end_ms": 52
    },
