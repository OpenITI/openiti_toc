    "42": {
      "title": "إذا زوج الأبعد من غير عذر للأقرب أو أجنبي،",
      "level": 1,
      "parent": null,
      "start_ms": 184,
      "end_ms": 185
    },
    "43": {
      "title": ": المحرمات بالنسب،",
      "level": 1,
      "parent": null,
      "start_ms": 185,
      "end_ms": 185
    },
    "44": {
      "title": ": المحرمات بالمصاهرة،",
      "level": 1,
      "parent": null,
      "start_ms": 185,
      "end_ms": 193
    },
    "45": {
      "title": "وللأب تزويج ابنته البكر والثيب بدون صداق مثلها،",
      "level": 1,
      "parent": null,
      "start_ms": 193,
      "end_ms": 203
    },
    "46": {
      "title": "إن كانت المرأة صغيرة أو آيسة، أو غير مدخول بها،",
      "level": 1,
      "parent": null,
      "start_ms": 203,
      "end_ms": 207
    },
    "47": {
      "title": "إن قال: أنت طالق طلقة في اثنتين،",
      "level": 1,
      "parent": null,
      "start_ms": 207,
      "end_ms": 208
    },
    "48": {
      "title": "إذا قال: أنت طالق أمس، أو قبل أن أنكحك،",
      "level": 1,
      "parent": null,
      "start_ms": 208,
      "end_ms": 216
    },
    "49": {
      "title": "إن حلف لا يفعل شيئا، ففعل بعضه،",
      "level": 1,
      "parent": null,
      "start_ms": 216,
      "end_ms": 220
    },
