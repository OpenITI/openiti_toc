    "53": {
      "title": "وطء المظاهر منها قبل التكفير،",
      "level": 1,
      "parent": null,
      "start_ms": 224,
      "end_ms": 226
    },
    "54": {
      "title": "إسقاط الحد باللعان.",
      "level": 1,
      "parent": null,
      "start_ms": 226,
      "end_ms": 235
    },
    "55": {
      "title": "يحرم من الرضاع ما يحرم من النسب،",
      "level": 1,
      "parent": null,
      "start_ms": 235,
      "end_ms": 236
    },
    "56": {
      "title": "الثاني: أن يرتضع خمس رضعات",
      "level": 1,
      "parent": null,
      "start_ms": 236,
      "end_ms": 244
    },
    "57": {
      "title": "الرابع: ألقاه في ماء يغرقه، أو نار لا يمكنه التخلص منها.",
      "level": 1,
      "parent": null,
      "start_ms": 244,
      "end_ms": 244
    },
    "58": {
      "title": "الثامن: أن يقتله بسحر يقتل مثله غالبا.",
      "level": 1,
      "parent": null,
      "start_ms": 244,
      "end_ms": 252
    },
    "59": {
      "title": "من أتلف إنسانا، أو جزءا منه بمباشرة، أو سبب فعليه ديته.",
      "level": 1,
      "parent": null,
      "start_ms": 252,
      "end_ms": 284
    },
    "60": {
      "title": "كفارة اليمين",
      "level": 1,
      "parent": null,
      "start_ms": 284,
      "end_ms": 311
    },
    "61": {
      "title": "من كانت عنده شهادة لآدمي يعلمها",
      "level": 1,
      "parent": null,
      "start_ms": 311,
      "end_ms": 313
    },
    "62": {
      "title": "باب شروط من تقبل شهادته",
      "level": 1,
      "parent": null,
      "start_ms": 313,
      "end_ms": 315
    },
    "63": {
      "title": "باب موانع الشهادة.",
      "level": 1,
      "parent": null,
      "start_ms": 315,
      "end_ms": 316
    },
    "64": {
      "title": "باب أقسام المشهود به",
      "level": 1,
      "parent": null,
      "start_ms": 316,
      "end_ms": 323
    },
    "65": {
      "title": "قال: له علي ألف زيوف. وفسره بما لا فضة فيه",
      "level": 1,
      "parent": null,
      "start_ms": 323,
      "end_ms": 325
    },
