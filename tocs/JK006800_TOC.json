      "parent": 87,
      "start_ms": 339,
      "end_ms": 347
    },
    "95": {
      "title": "جماع أبواب ( صدقة الأموال التي يمر بها على العاشر من أهل الإسلام والذمة والحرب )",
      "level": 2,
      "parent": 72,
      "start_ms": 347,
      "end_ms": 362
    },
    "96": {
      "title": "( باب ذكر العاشر وصاحب المكس وما فيه من الشدة والتغليظ )",
      "level": 3,
      "parent": 95,
      "start_ms": 347,
      "end_ms": 351
    },
    "97": {
      "title": "( باب ما يأخذ العاشر من صدقة المسلمين وعشور أهل الذمة والحرب )",
      "level": 3,
      "parent": 95,
      "start_ms": 351,
      "end_ms": 358
    },
    "98": {
      "title": "( باب العشر على بني وتضعيف الصدقة عليهم )",
      "level": 3,
      "parent": 95,
      "start_ms": 358,
      "end_ms": 362
    },
    "99": {
      "title": "( هذا جماع أبواب ( مخارج الصدقة وسبلها التي توضع فيها )",
      "level": 2,
      "parent": 72,
      "start_ms": 362,
      "end_ms": null
    },
    "100": {
      "title": "( باب ذكر أهل الصدقة الذين يطيب لهم أخذها وفرق بين من تحل له الصدقة أو تحرم عليه )",
      "level": 3,
      "parent": 99,
      "start_ms": 362,
      "end_ms": 370
    },
    "101": {
      "title": "( باب أدنى ما ms369 يعطى الرجل الواحد من الصدقة وكم ) ( أكثر ما يطيب له منها )",
