      "parent": 87,
      "start_ms": 334,
      "end_ms": 342
    },
    "95": {
      "title": "جماع أبواب ( صدقة الأموال التي يمر بها على العاشر من أهل الإسلام والذمة والحرب )",
      "level": 2,
      "parent": 72,
      "start_ms": 342,
      "end_ms": 356
    },
    "96": {
      "title": "( باب ذكر العاشر وصاحب المكس وما فيه من الشدة والتغليظ )",
      "level": 3,
      "parent": 95,
      "start_ms": 342,
      "end_ms": 346
    },
    "97": {
      "title": "( باب ما يأخذ العاشر من صدقة المسلمين وعشور أهل الذمة والحرب )",
      "level": 3,
      "parent": 95,
      "start_ms": 346,
      "end_ms": 352
    },
    "98": {
      "title": "( باب العشر على بني وتضعيف الصدقة عليهم )",
      "level": 3,
      "parent": 95,
      "start_ms": 352,
      "end_ms": 356
    },
    "99": {
      "title": "( هذا جماع أبواب ( مخارج الصدقة وسبلها التي توضع فيها )",
      "level": 2,
      "parent": 72,
      "start_ms": 356,
      "end_ms": null
    },
    "100": {
      "title": "( باب ذكر أهل الصدقة الذين يطيب لهم أخذها وفرق بين من تحل له الصدقة أو تحرم عليه )",
      "level": 3,
      "parent": 99,
      "start_ms": 356,
      "end_ms": 364
    },
    "101": {
      "title": "( باب أدنى ما يعطى الرجل الواحد من الصدقة وكم ) ( أكثر ما يطيب له منها )",
      "level": 3,
      "parent": 99,
      "start_ms": 364,
      "end_ms": 369
    },
    "102": {
      "title": "( باب دفع الصدقة إلى الأمراء واختلاف العلماء في ذلك )",
      "level": 3,
      "parent": 99,
      "start_ms": 369,
      "end_ms": 375
    },
    "103": {
      "title": "( باب تفريق الصدقة في الأصناف الثمانية وإعطائها بعضهم دون بعض )",
      "level": 3,
      "parent": 99,
      "start_ms": 375,
      "end_ms": 378
    },
    "104": {
      "title": "( باب دفع الصدقة إلى الأقارب ومن يكون لها منهم موضعا أولا يكون )",
      "level": 3,
      "parent": 99,
      "start_ms": 378,
      "end_ms": 381
    },
    "105": {
      "title": "( باب إعطاء المرأة زوجها من صدقة مالها )",
      "level": 3,
      "parent": 99,
      "start_ms": 381,
      "end_ms": 383
    },
    "106": {
      "title": "( باب تعجيل الصدقة وإخراجها قبل أوانها )",
      "level": 3,
      "parent": 99,
      "start_ms": 383,
      "end_ms": 386
    },
    "107": {
      "title": "( باب قسم الصدقة في بلدها وحملها إلى بلد سواه ومن أولى ) ( بأن يبدأ به منها )",
      "level": 3,
      "parent": 99,
      "start_ms": 386,
      "end_ms": 391
    },
    "108": {
      "title": "( باب الرجل يخرج الصدقة فتضيع أو يدفعها إلى غني وهو لا يشعر )",
      "level": 3,
      "parent": 99,
      "start_ms": 391,
      "end_ms": 392
    },
    "109": {
      "title": "( باب سهم الفقراء والمساكين من الصدقة والفصل بينهما في التأويل )",
      "level": 3,
      "parent": 99,
      "start_ms": 392,
      "end_ms": 393
    },
    "110": {
      "title": "( باب سهم العاملين على الصدقة والمؤلفة قلوبهم )",
      "level": 3,
      "parent": 99,
      "start_ms": 393,
      "end_ms": 395
    },
    "111": {
      "title": "( باب سهم الرقاب والغارمين في الصدقة )",
      "level": 3,
      "parent": 99,
      "start_ms": 395,
      "end_ms": 397
    },
    "112": {
      "title": "( باب سهم الغزاة في سبيل الله وابن السبيل )",
      "level": 3,
      "parent": 99,
      "start_ms": 397,
      "end_ms": 398
    },
    "113": {
      "title": "( باب إعطاء أهل الذمة من الصدقة وما يجزى من ذلك مما لا يجزى )",
      "level": 3,
      "parent": 99,
      "start_ms": 398,
      "end_ms": null
    }
