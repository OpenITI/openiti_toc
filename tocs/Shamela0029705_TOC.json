    "2": {
      "title": "يمكث في ركوعه وسجوده بقدر ما يقول: سبحان الله وبحمده ثلاثا \"",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "3": {
      "title": "2 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 2
    },
    "4": {
      "title": ": «نهى أن ms1 يرفع الرجل صوته بالقراءة قبل العشاء وبعدها يغلط أصحابه وهم",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "5": {
      "title": "3 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "6": {
      "title": ": «حببوا الله إلى الناس يحببكم الله»",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "7": {
      "title": "4 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "8": {
      "title": "عن المعصفر، يعني المسبغ، وأن يحمل فرس على أتان، وعن الميثرة الحمراء»",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "9": {
      "title": "5 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "10": {
      "title": ": «لا تدعوا ركعتي الفجر وإن طردتكم الخيل»",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "11": {
      "title": "6 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "12": {
      "title": ": «إذا فسا أحدكم فليتوضأ، ولا تأتوا النساء في أستاهها، فإن الله لا يستحي من",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "13": {
      "title": "7 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "14": {
      "title": ": «الشعر كلام بمنزلة الكلام، حسنه حسن الكلام، وقبيحه قبيح الكلام»",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "15": {
      "title": "8 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 3
    },
    "16": {
      "title": ": «الرجل أحق بمجلسه، فإن قام إلى حاجته ms2 ثم رجع فهو أحق بمجلسه»",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "17": {
      "title": "9 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "18": {
      "title": ": «عورة المؤمن ما بين سرته إلى ركبته»",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "19": {
      "title": "10 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "20": {
      "title": ": «من تطهر في بيته، ثم أتى مسجد جماعة، فسبح فيه سبحة الضحى، كتب الله له كأجر المعتمر المحرم،",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "21": {
      "title": "11 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "22": {
      "title": ": \" {أطيعوا الله وأطيعوا الرسول وأولي الأمر منكم} [النساء: 59] , قال: أولوا الأمر أولوا",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "23": {
      "title": "12 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "24": {
      "title": ": «ساووا بين أولادكم في العطية، فلو كنت مفضلا أحدا لفضلت النساء»",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "25": {
      "title": "13 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 4
    },
    "26": {
      "title": ": «ما أبكي على دنياكم هذه، ولكن أبكي على بعد سفري وقلة زادي، وأني أمسيت في صعود مهبوطة على",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "27": {
      "title": "14 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "28": {
      "title": "مسح على الخفين والخمار",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "29": {
      "title": "15 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "30": {
      "title": "توضأ فخلل لحيته من فضل وجهه، ومسح برأسه من فضل ذراعيه، ولم يستأنف لهما",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "31": {
      "title": "16 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "32": {
      "title": "الكيل والميزان: «إنكم وليتم أمرا أهلكت فيه الأمم السابقة قبلكم»",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "33": {
      "title": "17 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "34": {
      "title": ": «من باع سلعة فأفلس المبتاع , فوجدها بعينها ولم يقبض من ثمنها شيئا فهي له، فإن قبض من ثمنها",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "35": {
      "title": "18 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 5
    },
    "36": {
      "title": ": «استعينوا بقائلة النهار على قيام الليل، وبأكلة السحر على صيام النهار»",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "37": {
      "title": "19 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "38": {
      "title": "إن علمت ليلة القدر أي ليلة هي، ما أسأل ربي؟ قال: \" تقولين: اللهم إنك عفو تحب العفو فاعف",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "39": {
      "title": "20 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "40": {
      "title": ": «لعن رسول الله صلى الله عليه وسلم المخنثين من الرجال، والمترجلات من النساء» , قال: قلت له:",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "41": {
      "title": "21 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "42": {
      "title": "إذا سمع الرعد، قال: «سبحان من سبحت له»",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "43": {
      "title": "22 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "44": {
      "title": "أن نفشي السلام» , فقال رجل: ومن أمرنا؟ فقال أبو أمامة: «رسول الله أمرنا»",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "45": {
      "title": "23 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "46": {
      "title": ": «ما من رجل ينظر إلى محاسن امرأة أول مرة، ثم يغض بصره، إلا أحدث الله له عبادة يجد حلاوتها",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "47": {
      "title": "24 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "48": {
      "title": "عن الذهب إلا مقطوعا، وعن ركوب النمور»",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "49": {
      "title": "25 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 6
    },
    "50": {
      "title": "الرجل ليدرك درجة الصائم القائم بالحلم، وإنه ليكتب جبارا وما يملك إلا أهل",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "51": {
      "title": "26 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "52": {
      "title": "لا يرى بأسا بالحجامة للصائم , حدثنا خالد: ثنا خالد، عن حميد، عن أبي المتوكل، عن أبي سعيد",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "53": {
      "title": "27 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "54": {
      "title": ": «لا تمش قدام أبيك، ولا تجلس قبله، ولا تدعوه باسمه، ولا تسب له ولا تستب»",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "55": {
      "title": "28 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "56": {
      "title": ": «إن ذا الرحم شاجن من الله يوم القيامة يقيض لها فما تنطق به , لا يدخل الجنة قاطعها، فليعمل",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "57": {
      "title": "29 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "58": {
      "title": ": «من قاد مكفوفا أربعين ذراعا كانت له عدل رقبة»",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "59": {
      "title": "30 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "60": {
      "title": ": «إن المرأة مثل الضلع إن جئت تقومها كسرتها»",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": null
    }
