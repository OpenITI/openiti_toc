    "47": {
      "title": ": \" إن الله عز وجل زوى لي الأرض، فرأيت مشارقها ومغاربها",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 5
    },
    "48": {
      "title": "[ص: 47]",
      "level": 1,
      "parent": null,
