      "title": "[ص: 28]",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "6": {
      "title": ": \" ضعوا عنها فإنها ملعونة \"",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "7": {
      "title": "2 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "8": {
      "title": ": \" خذوا متاعكم عنها ودعوها فإنها ملعونة \"",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "9": {
      "title": "3 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "10": {
      "title": "أعتق ستة أعبد له عند موته",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 2
    },
    "11": {
      "title": "[ص: 31]",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "12": {
      "title": "4 -",
