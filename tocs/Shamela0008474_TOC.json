      "end_ms": 2
    },
    "13": {
      "title": "[ص: 32]",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "14": {
      "title": ": \" نأخذك بجريرة حلفائك",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "15": {
      "title": "5 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "16": {
      "title": "[ص: 34]",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "17": {
      "title": ": \" لو قلتها وأنت تملك نفسك لأفلحت كل الفلاح \"",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "18": {
      "title": "6 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "19": {
      "title": "[ص: 35]",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 3
    },
    "20": {
      "title": "7 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "21": {
      "title": "[ص: 36]",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "22": {
      "title": ": \" إن أخاكم قد مات فقوموا \"",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "23": {
      "title": "8 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "24": {
      "title": ": \" لا نذر في معصية الله ولا نذر في ما لا يملك ابن آدم \"",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "25": {
      "title": "9 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "26": {
      "title": ": \" ألقوا عنها جهازها فإنها ملعونة \"",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "27": {
      "title": "10 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "28": {
      "title": ": أما تقرأ في ثمان؟",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "29": {
      "title": "11 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "30": {
      "title": "، جعل للمرأة سهما وللأم سهما وللأب سهمين",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "31": {
      "title": "12 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "32": {
      "title": ": \" أيما امرأة سألت زوجها الطلاق في غير ما بأس فحرام عليها رائحة الجنة \"",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "33": {
      "title": "13 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "34": {
      "title": "[ص: 41]",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "35": {
      "title": "14 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 4
    },
    "36": {
      "title": ": \" أفضل دينار دينار ينفقه الرجل على عياله ودينار ينفقه على دابته في سبيل الله ودينار ينفقه على أصحابه في سبيل الله \"",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "37": {
      "title": "[ص: 42]",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "38": {
      "title": "15 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "39": {
      "title": "16 -",
      "level": 1,
