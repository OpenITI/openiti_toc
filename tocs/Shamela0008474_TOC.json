      "end_ms": 8
    },
    "77": {
      "title": "[ص: 59]",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "78": {
      "title": ": \" أفطر الحاجم والمحجوم \"",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "79": {
      "title": "33 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "80": {
      "title": "[ص: 60]",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "81": {
      "title": "34 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "82": {
      "title": "35 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "83": {
      "title": "[ص: 61]",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "84": {
      "title": "أفطر الحاجم والمحجوم \"",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "85": {
      "title": "36 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "86": {
      "title": ": \" إن الله محسن فأحسنوا وإذا قتلتم فأحسنوا قتلتكم",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "87": {
      "title": "37 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "88": {
      "title": ": من أصابته جنابة من الليل فأراد أن ينام فليتوضأ فإن الوضوء نصف الجنابة",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "89": {
      "title": "38 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "90": {
      "title": "[ص: 65]",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 9
    },
    "91": {
      "title": "[ص: 66]",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "92": {
      "title": ": \" إني والله إن شاء الله لا أحلف يمينا فأرى غيرها خيرا منها إلا أتيت الذي هو خير وتحللتها،",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "93": {
      "title": "39 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "94": {
      "title": "[ص: 68]",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "95": {
      "title": ": \" والله ما نسيت ولكن من حلف على يمين فرأى غيرها خيرا منها فليأت الذي هو خير وليكفر عن يمينه \"",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "96": {
      "title": "40 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "97": {
      "title": ": \" ما من مسلم من المسلمين يموت يصلي عليه أمة من الناس يبلغون أن يكونوا مائة إلا شفعوا فيه \"",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "98": {
      "title": "41 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 10
    },
    "99": {
      "title": ": \" اللهم هذا قسمتي فيما أملك فلا تلمني فيما تملك ولا أملك \"",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "100": {
      "title": "42 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "101": {
      "title": "[ص: 71]",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "102": {
      "title": "وضع عن المسافر الصيام وشطر الصلاة وعن الحامل وعن المرضع \"",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "103": {
      "title": "43 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "104": {
      "title": ": \" اجلس فأصب من طعامنا \"",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "105": {
      "title": "[ص: 73]",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "106": {
      "title": "44 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "107": {
      "title": "[ص: 74]",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "108": {
      "title": "فيقال له: كيف أقرأك رسول الله",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "109": {
      "title": "45 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 11
    },
    "110": {
      "title": ": قد كنا نحيض فلا نؤمر بقضائها",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "111": {
      "title": "46 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "112": {
      "title": "[ص: 76]",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "113": {
      "title": "[ص: 77]",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "114": {
      "title": ": \" يا أبا ذر، الصعيد كافيك ولو إلى عشر حجج، فإذا وجدت الماء فأمسه جلدك أو بشرتك \"",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "115": {
      "title": "47 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "116": {
      "title": "[ص: 79]",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "117": {
      "title": ": \" يسلم قلبك لله عز وجل ويسلم المسلمون من لسانك",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 12
    },
    "118": {
      "title": "48 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "119": {
      "title": "[ص: 81]",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "120": {
      "title": "كان يمسح على الخفين والخمار",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "121": {
      "title": "49 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "122": {
      "title": "أنا أنهى عنهما وأضرب عليهما",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "123": {
      "title": "50 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "124": {
      "title": "[ص: 84]",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "125": {
      "title": ": \" من رمى بسهم في سبيل الله فهو كعدل رقبة \"",
