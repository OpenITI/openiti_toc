      "title": "24 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "61": {
      "title": "سيكون من أمتي كذابون ثلاثون كلهم يزعم أنه نبي",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "62": {
      "title": "25 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "63": {
      "title": "[ص: 53]",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "64": {
      "title": "26 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "65": {
      "title": ": \" إن لم تجدوا غيرها فارحضوها بالماء \"",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "66": {
      "title": "[ص: 54]",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "67": {
      "title": "27 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "68": {
      "title": "28 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 7
    },
    "69": {
      "title": "ينهى عن بيع الذهب بالذهب والورق بالورق",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "70": {
      "title": "[ص: 56]",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "71": {
      "title": "29 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "72": {
      "title": ": \" هو وأصحابه على الهدى \"",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "73": {
      "title": "30 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
