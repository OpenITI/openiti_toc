      "start_ms": 5,
      "end_ms": 5
    },
    "50": {
      "title": "20 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "51": {
      "title": ": \" ولن تزال طائفة من أمتي على الحق لا يضرهم من خذلهم",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "52": {
      "title": "[ص: 49]",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "53": {
      "title": "21 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "54": {
      "title": ": \" زوي لي الأرض فرأيت مشارقها ومغاربها",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "55": {
      "title": "[ص: 50]",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "56": {
      "title": "22 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 6
    },
    "57": {
      "title": "[ص: 51]",
      "level": 1,
