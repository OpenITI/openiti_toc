    "26": {
      "title": "كسب الحجام، قال: نا قتادة، عن أبي طالب، قال: قال ابن عباس: «لو كان حراما لم",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
