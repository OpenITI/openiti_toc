    },
    "28": {
      "title": "أن أبيع غلامين أخوين، فبعتهما، وفرقت بينهما، فذكرت ذلك للنبي صلى الله عليه وسلم , فقال:",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
