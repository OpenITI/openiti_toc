      "start_ms": 6,
      "end_ms": 7
    },
    "62": {
      "title": ": «إذا أتي أحدكم بالطيب فليصب منه»",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "63": {
      "title": "32 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "64": {
      "title": ": \" ألا تقولوا: سبحان الله وبحمده، فبكل واحدة عشرة، وبكل عشرة مائة، وبكل مائة ألف، ومن زاد",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "65": {
      "title": "33 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "66": {
      "title": ": «لا يدخل الجنة من كان في قلبه مثقال حبة من خردل من كبر» .",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "67": {
      "title": "34 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "68": {
      "title": ": «كل بيعين لا بيع بينهما حتى يتفرقا إلا بيع الخيار»",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "69": {
      "title": "35 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 8
    },
    "70": {
      "title": ": «على سلامى ابن آدم ثلاث مائة وستون عطاء , عليه في كل يوم لكل عظم صدقة، فأمره بالمعروف",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "71": {
      "title": "36 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "72": {
      "title": ": \" جعلت لي الأرض كلها مسجدا وطهورا، وبعثت إلى الأحمر والأسود، ونصرت بالرعب على عدوي مسيرة",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "73": {
      "title": "37 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "74": {
      "title": ": «من صلى صلاتنا واستقبل قبلتنا وأكل ذبيحتنا فهو المسلم، له ما لنا وعليه ما",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "75": {
      "title": "38 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "76": {
      "title": "يقرأ في صلاة المغرب ليلة الجمعة ب قل يأيها الكافرون وقل هو الله أحد , وكان يقرأ في صلاة",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "77": {
      "title": "39 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "78": {
      "title": ": «كلكم راع وكلكم مسئول، والأمير راع على الناس ومسئول عنهم، والرجل راع على أهل بيته ومسئول",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 9
    },
