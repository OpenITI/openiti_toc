      "end_ms": 6
    },
    "49": {
      "title": "25 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "50": {
      "title": ": «لا يزال أهل المغرب ظاهرين على الحق حتى تقوم الساعة»",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "51": {
      "title": "26 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "52": {
      "title": "رضا الرب عز وجل من رضا الوالد، وسخط الله عز وجل من سخط الوالد»",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "53": {
      "title": "27 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "54": {
      "title": ": «لو تعلمون ما أعلم لضحكتم قليلا ولبكيتم كثيرا»",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "55": {
      "title": "28 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "56": {
      "title": "الركعتين قبل المغرب، فقال: «ما رأيت أحدا صلاهما على عهد رسول الله صلى الله عليه وسلم ولا",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "57": {
      "title": "29 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "58": {
      "title": ": «تسموا باسمي، ولا تكنوا بكنيتي»",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "59": {
      "title": "30 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "60": {
      "title": ": \" قام النبي صلى الله عليه وسلم حتى هممت هم السوء، قلت: وما هممت؟ يعني أن أجلس",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
