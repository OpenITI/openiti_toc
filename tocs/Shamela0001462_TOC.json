      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "107": {
      "title": "52 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "108": {
      "title": "تقبل شفاعة محمد الكبرى، وارفع درجته العليا وأعطه سؤله في الآخرة والأولى كما آتيت إبراهيم",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "109": {
      "title": "53 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "110": {
      "title": ": \" من قال: اللهم صل على محمد وأنزله المقعد المقرب منك يوم القيامة، وجبت له",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "111": {
      "title": "54 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "112": {
      "title": ": «ما جلس قوم مجلسا لم يذكروا الله، ولم يصلوا على نبيهم، إلا كان مجلسهم عليهم ترة يوم",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "113": {
      "title": "55 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "114": {
      "title": ": ما من قوم يقعدون ثم يقومون ولا يصلون على النبي صلى الله عليه وسلم إلا كان عليهم يوم",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "115": {
      "title": "56 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 11
    },
    "116": {
      "title": "صل على محمد وعلى آل محمد كما صليت على آل إبراهيم إنك حميد مجيد \"",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "117": {
      "title": "57 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "118": {
      "title": "صل على محمد وعلى آل محمد كما صليت على إبراهيم وآل إبراهيم إنك حميد مجيد وبارك على محمد",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "119": {
      "title": "58 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "120": {
      "title": "صل على محمد وعلى آل محمد كما صليت على إبراهيم وآل إبراهيم إنك حميد مجيد \". قال: ونحن نقول:",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "121": {
      "title": "59 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "122": {
      "title": "[ص: 58]",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "123": {
      "title": "صل على محمد النبي الأمي وعلى آل محمد كما صليت على إبراهيم وعلى آل إبراهيم وبارك على محمد",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 12
    },
    "124": {
      "title": "60 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "125": {
      "title": "[ص: 59]",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "126": {
      "title": "صل على محمد النبي الأمي، عليه السلام",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "127": {
      "title": "61 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "128": {
      "title": "[ص: 60]",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "129": {
      "title": "62 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "130": {
      "title": "وصل على محمد وعلى آل محمد كما صليت على إبراهيم وعلى آل إبراهيم",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "131": {
      "title": "63 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 13
    },
    "132": {
      "title": "صل على محمد وعلى آل محمد كما صليت على آل إبراهيم وبارك على محمد وعلى آل محمد كما باركت",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "133": {
      "title": "[ص: 62]",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "134": {
      "title": "64 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "135": {
      "title": "صل على عبدك ورسولك وأهل بيته كما صليت على آل إبراهيم إنك حميد مجيد , وبارك عليه وأهل بيته",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "136": {
      "title": "65 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "137": {
      "title": "[ص: 63]",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "138": {
      "title": "اجعل صلواتك وبركاتك على آل محمد كما جعلتها على آل إبراهيم إنك حميد",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "139": {
      "title": "66 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "140": {
      "title": "[ص: 64]",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "141": {
      "title": "67 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "142": {
      "title": "صل على محمد عبدك ورسولك كما صليت على إبراهيم وبارك على محمد وآل محمد كما باركت على",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "143": {
      "title": "68 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 14
    },
    "144": {
      "title": "صل على محمد كما صليت على إبراهيم إنك حميد مجيد، وبارك على محمد وعلى آل محمد كما باركت على",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "145": {
      "title": "69 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "146": {
      "title": ": \" صلوا علي وقولوا: اللهم بارك على محمد وعلى آل محمد كما باركت على إبراهيم وآل إبراهيم إنك",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "147": {
      "title": "70 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "148": {
      "title": ": اللهم صل على محمد وأزواجه وذريته كما صليت على آل إبراهيم، وبارك على محمد وأزواجه كما",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "149": {
      "title": "71 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "150": {
      "title": "صل على آل محمد، كما صليت على آل إبراهيم، وبارك على آل محمد، كما باركت على آل",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "151": {
      "title": "72 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "152": {
      "title": "[ص: 68]",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "153": {
      "title": "73 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 15
    },
    "154": {
      "title": "صل على آل محمد، كما صليت على آل إبراهيم، اللهم بارك على محمد، كما باركت على آل",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "155": {
      "title": "74 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "156": {
      "title": "[ص: 69]",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "157": {
      "title": ": ما من دعوة لا يصلى على النبي صلى الله عليه وسلم قبلها إلا كانت معلقة بين السماء",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "158": {
      "title": "75 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "159": {
      "title": ": «لا تصلوا صلاة على أحد إلا على النبي صلى الله عليه وسلم، ولكن يدعى للمسلمين والمسلمات",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "160": {
      "title": "76 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "161": {
      "title": "[ص: 70]",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "162": {
      "title": "صلاتهم على النبيين ودعاؤهم للمسلمين عامة، ويدعوا ما سوى ذلك»",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "163": {
      "title": "77 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "164": {
      "title": ": «صلى الله عليك وعلى زوجك»",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "165": {
      "title": "78 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "166": {
      "title": "[ص: 72]",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "167": {
      "title": "79 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 16
    },
    "168": {
      "title": "يستحب للرجل إذا فرغ من تلبيته أن يصلي على النبي صلى الله عليه وسلم»",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "169": {
      "title": "80 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "170": {
      "title": ": «إذا مررتم بالمساجد فصلوا على النبي صلى الله عليه وسلم»",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "171": {
      "title": "81 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "172": {
      "title": "فطوفوا بالبيت سبعا، وصلوا عند المقام ركعتين، ثم ائتوا الصفا، فقوموا من حيث ترون البيت،",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "173": {
      "title": "82 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "174": {
      "title": "[ص: 74]",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "175": {
      "title": "صل على محمد، وعلى آل محمد، واغفر لنا، وسهل لنا أبواب رحمتك، فإذا فرغت، فقولي مثل ذلك، غير",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "176": {
      "title": "83 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "177": {
      "title": "[ص: 75]",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "178": {
      "title": "85 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 17
    },
    "179": {
      "title": ": صلى الله وملائكته على محمد، السلام عليك أيها النبي ورحمة الله وبركاته",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "180": {
      "title": "86 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "181": {
      "title": ": «صلى الله وملائكته على محمد، السلام عليك أيها النبي ورحمة الله» ، قلت من حدثك؟ أنت سمعته؟",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "182": {
      "title": "87 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "183": {
      "title": ": «لا إله إلا الله وحده لا شريك له، له الملك وله الحمد، وهو على كل شيء قدير، ثم يصلي على",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "184": {
      "title": "88 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "185": {
      "title": "فتكبر تكبيرة تفتتح بالصلاة، وتحمد ربك، وتصلي على النبي محمد صلى الله عليه وسلم، ثم تدعو",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "186": {
      "title": "[ص: 78]",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "187": {
      "title": "89 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "188": {
      "title": "90 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 18
    },
    "189": {
      "title": "فحمد الله وأثنى عليه، وصلى على النبي صلى الله عليه وسلم، ودعا بدعوات، ثم قام فصلى",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "190": {
      "title": "91 -",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "191": {
      "title": ": «أول تكبيرة من الصلاة على الجنازة ثناء على الله عز وجل، والثانية صلاة على النبي، والثالثة",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "192": {
      "title": "92 -",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "193": {
      "title": "بارك فيه وصل عليه واغفر له وأورده حوض نبيك صلى الله عليه وسلم",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "194": {
      "title": "93 -",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "195": {
      "title": "[ص: 80]",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "196": {
      "title": "كبرت وحمدت الله وصليت على نبيه صلى الله عليه وسلم ثم أقول: اللهم هذا عبدك ابن عبدك وابن",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "197": {
      "title": "94 -",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "198": {
      "title": "[ص: 81]",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "199": {
      "title": "يقرأ بفاتحة الكتاب، ويصلي على النبي صلى الله عليه وسلم، ثم يخلص الدعاء للميت متى يفرغ،",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "200": {
      "title": "95 -",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "201": {
      "title": ": «صلاة الله عز وجل عليه ثناؤه عليه، وصلاة الملائكة عليه الدعاء»",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "202": {
      "title": "96 -",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 19
    },
    "203": {
      "title": ": \" صلاة الله: رحمته، وصلاة الملائكة: الدعاء \"",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "204": {
      "title": "97 -",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "205": {
      "title": ": \" صلاة الله: مغفرته، وصلاة الملائكة: الدعاء \"",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "206": {
      "title": "98 -",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "207": {
      "title": "يقف على قبر النبي ويصلي على النبي صلى الله عليه وسلم وأبي بكر وعمر رضي الله",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "208": {
      "title": "99 -",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "209": {
      "title": ": «السلام عليك يا رسول الله، السلام على أبي بكر، السلام على أبي، ويصلي",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "210": {
      "title": "100 -",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
