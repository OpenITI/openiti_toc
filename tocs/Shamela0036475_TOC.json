    "27": {
      "title": "قال علماء ما وراء النهر رحمهم الله: إن الخلفاء الثلاثة قد شرفهم الله تعالى برضوانه",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 15
    },
    "28": {
      "title": "قال علماء ما وراء النهر: قد سمى الله تعالى الصديق صاحبا للنبي - صلى الله عليه وسلم - وصاحبه لا يكون قابلا للعن",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 16
    },
    "29": {
      "title": "قال علماء ما وراء النهر: تسليم علي رضي الله عنه الخلافة للخلفاء الثلاثة رضي الله عنهم",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 19
    },
    "30": {
      "title": "قال علماء ما وراء النهر رحمهم الله: لما جوزت الشيعة لعن الشيخين وذي النورين رضي الله عنهم وبعض الأزواج الطاهرات كفروا بذلك كفرا ظاهرا",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": null
    }
