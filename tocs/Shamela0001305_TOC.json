{
  "filename": "0331IbnMukhalladCattar.Fawaid.Shamela0001305-ara1",
  "sections": {
    "1": {
      "title": "1 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "2": {
      "title": "\" كان يقوم في الجنازة ثم يجلس بعد\"",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "3": {
      "title": "2 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "4": {
      "title": ": \" لا يموت لأحد من المسلمين ثلاثة من الولد فتمسه النار إلا تحلة القسم \"",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "5": {
      "title": "3 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "6": {
      "title": ": \" إن الناس يحبسون يوم القيامة ما شاء الله أن يحبسوا فيهتم المؤمنون فيجتمعون فيقولون: انظروا",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 2
    },
    "7": {
      "title": "4 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "8": {
      "title": "خرج من الخلاء فأتي بطعام فعرض عليه الوضوء فقال: \" أصلي فأتوضأ \"",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "9": {
      "title": "5 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "10": {
      "title": ": لو جمعناهم على رجل واحد كان أمثل، فجمعهم على أبي بن كعب ثم خرج وهم يصلون خلف أبي بن كعب",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "11": {
      "title": "6 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "12": {
      "title": ": اعضض بهن أبيك، ولم يكن، فكأن الناس استنكروا ذلك، فقال أبي: إني قد أرى الذي في وجوههم، إني",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "13": {
      "title": "7 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 3
    },
    "14": {
      "title": ": \" بشر هذه الأمة بالسنا والرفعة، فمن عمل منهم عمل الآخرة للدنيا لم يكن له في الآخرة",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "15": {
      "title": "8 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "16": {
      "title": "متى تنقطع معرفة العبد من الناس، قال: \" إذا عاين \"",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "17": {
      "title": "9 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "18": {
      "title": "، لا تقتلوا عثمان واستعتبوه، فوالذي نفسي بيده ما قتلت أمة نبيها فأصلح الله ذات بينهم حتى",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "19": {
      "title": "10 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 4
    },
    "20": {
      "title": ": \" المتطوع بالخيار، إن شاء صام، وإن شاء أفطر \"",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "21": {
      "title": "11 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "22": {
      "title": "كبر على ابنه أربعا \" قال الشيخ أبو بكر: عطاء هو عطاء بن عجلان.",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "23": {
      "title": "12 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "24": {
      "title": "، أن النبي صلى الله عليه وسلم كان يحب التيمن في وضوئه والترجل والانتعال",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "25": {
      "title": "13 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "26": {
      "title": ": ألا أخبركم بخير، هذه الأمة بعد نبيها صلى الله عليه وسلم: أبو بكر وعمر، وقد كانت منا أشياء",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "27": {
      "title": "14 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 5
    },
    "28": {
      "title": ": \" والله لا أزال بين أظهركم يطئون عقبي وينازعوني ردائي، ويصيبني غبارهم حتى يكون الله يريحني",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "29": {
      "title": "15 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "30": {
      "title": ": \" إن أخاكم النجاشي توفي فصلوا عليه \" قال: فصفنا صفين فصلى عليه",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "31": {
      "title": "16 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "32": {
      "title": ": \" دعه فهو أحق بمكانه منك \"، ادن يا حذيفة: \" من شهد أن لا إله إلا الله وحده لا شريك له وأن محمدا",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "33": {
      "title": "17 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "34": {
      "title": ": يد الله على رأس المؤذن حتى يفرغ من أذانه، وإنه ليغفر له مد صوته \"",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "35": {
      "title": "18 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "36": {
      "title": ": \" من شرب نبيذا فاقشعر منه مفرق رأسه فالحسو منه حرام \"",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "37": {
      "title": "19 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 6
    },
    "38": {
      "title": ": من كان له على رسول الله صلى الله عليه وسلم دين أو عدة فليقم، فقمت فقلت: أنا أتيت رسول",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "39": {
      "title": "20 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "40": {
      "title": ": \" والشاة إن رحمتها رحمك الله \"",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "41": {
      "title": "21 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "42": {
      "title": "لبيك عمرة وحجا، قال: فحججت فلقيت ابن عمر فقلت له: وأخبرته فقال: أهللنا بالحج، فأخبرته",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "43": {
      "title": "22 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "44": {
      "title": ": \" أيما عبد أبق من مواليه فقد كفر \"",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "45": {
      "title": "23 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "46": {
      "title": "يقرأ يوم الجمعة في صلاة الفجر الم تنزيل السجدة وهل أتى على الإنسان أخبرنا محمد، ثنا محمد",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "47": {
      "title": "25 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 7
    },
    "48": {
      "title": "كان يفتتح القراءة ب {الحمد لله رب العالمين} [الفاتحة: 2] قال الأعمش: قلت لشعبة: لو كان",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "49": {
      "title": "26 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "50": {
      "title": ": \" إن الله يحب المؤمن المحترف \"",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "51": {
      "title": "27 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "52": {
      "title": ": \" طلب الحلال جهاد، وإن الله عز وجل ليحب المؤمن المحترف \"",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "53": {
      "title": "28 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "54": {
      "title": ": \" من مشى بحقه إلى أخيه يقضيه إياه، كان له بكل خطوة درجة، ومن أماط الأذى عن الطريق كان له به",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "55": {
      "title": "29 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "56": {
      "title": ": \" لا يمنع أحدكم جاره أن يضع خشبته على جداره \"",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "57": {
      "title": "30 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 8
    },
    "58": {
      "title": ": أوصاني أبو القاسم صلى الله عليه وسلم بحب المساكين والدنو منهم، وأن أنظر إلى من دوني ولا",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "59": {
      "title": "31 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "60": {
      "title": ": امشوا إلى الصلاة فقد مشى إليها من هو خير منكم، رسول الله صلى الله عليه وسلم وأبو بكر وعمر",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "61": {
      "title": "32 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "62": {
      "title": ": شر الليالي والأيام والشهور والأزمنة أقربها إلى الساعة، وقال في ذهاب العلماء: يذهب العالم",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "63": {
      "title": "33 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "64": {
      "title": ": أي العمل أفضل يا جبريل؟ قال: لا أدري إلا أني أعلم أن العرش تهتز من",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "65": {
      "title": "34 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "66": {
      "title": ": إن الله خلق جنة عدن من ياقوتة حمراء، ثم قال: لها تزيني ثم قال: لها تكلمي فقالت: طوبى لمن",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 9
    },
    "67": {
      "title": "35 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "68": {
      "title": ": أنا أكبر من قتادة بسنتين",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "69": {
      "title": "36 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "70": {
      "title": ": كان آية من الآيات",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": null
    }
  },
