      "end_ms": 3
    },
    "18": {
      "title": ": «من أحيا سنة من سنتي قد أميتت بعدي فإن له من الأجر مثل أجر من عمل بها من السابقين المسلمين",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "19": {
      "title": "10 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "20": {
      "title": ": «إن الدين ليأرز إلى المدينة كما تأرز الحية إلى جحرها , وليعقلن الدين من الحجاز معقل",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "21": {
