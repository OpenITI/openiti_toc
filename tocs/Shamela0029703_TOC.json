    "30": {
      "title": ": «ما من أحد يغدو ويروح إلى المسجد ويؤثره على ما سواه إلا وله عند الله نزل تعد له في الجنة",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
