      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "22": {
      "title": ": «في الجمعة ساعة من نهار لا يسأله فيها عبد شيئا إلا أعطاه سؤله» .",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
