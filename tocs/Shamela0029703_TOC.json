      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "25": {
      "title": "13 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 4
    },
    "26": {
      "title": ": \" تنكح المرأة على إحدى خصال ثلاث: تنكح المرأة على جمالها، وتنكح المرأة على مالها، وتنكح",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "27": {
      "title": "14 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "28": {
      "title": "تعلموا الفرائض وعلموه؛ فإنه نصف العلم؛ وإنه ينسى , وإنه أول ما ينتزع من",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
