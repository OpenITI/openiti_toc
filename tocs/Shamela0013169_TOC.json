    },
    "107": {
      "title": ": كانت في كل أربعين شاة شاة إلى عشرين ومائة، فإذا زادت فشاتان إلى مائتين، فإذا زادت فثلاث",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "108": {
      "title": "53 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "109": {
      "title": "54 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 10
    },
    "110": {
      "title": ": «كل مسكر خمر، وكل مسكر حرام»",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "111": {
      "title": "55 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "112": {
      "title": ": كان يوما يعظمه أهل الجاهلية",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "113": {
      "title": "56 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "114": {
      "title": ": «ما حق امرئ مسلم له شيء يوصي فيه يبيت ليلتين إلا وعنده وصية»",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "115": {
      "title": "57 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "116": {
      "title": "إذا كان في السفر في الليلة الباردة أو الليلة المطيرة، فينادي بالصلاة صلاة العشاء، ثم",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "117": {
      "title": "58 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "118": {
      "title": ": «من خلع يدا من طاعة لقي الله لا حجة له، ومن مات ليس في رقبته بيعة مات موتة",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "119": {
      "title": "59 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "120": {
      "title": "[ص: 38]",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "121": {
      "title": "رجم يهوديا ويهودية",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "122": {
      "title": "60 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "123": {
      "title": "يجمع بين صلاة المغرب والعشاء الآخرة في السفر وهو على ظهر، ويقول ابن عمر: كان رسول الله",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "124": {
      "title": "61 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "125": {
      "title": ": «من ترك صلاة يعني العصر، حتى تفوته فكأنما وتر أهله وماله» ، وكان ابن عمر يصليها والشمس بيضاء",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 11
    },
    "126": {
      "title": "62 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "127": {
      "title": ": «صلاة الليل ركعتين ركعتين، فإن خفت الصبح فأوتر بواحدة»",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "128": {
      "title": "63 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "129": {
      "title": "[ص: 39]",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "130": {
      "title": ": «من حمل علينا السلاح فليس منا»",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "131": {
      "title": "64 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "132": {
      "title": ": رأيت رسول الله صلى الله عليه وسلم يبرز بين لبنتين وهو مستقبل القبلة وهو على ظهر بيت، قال",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "133": {
      "title": "65 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "134": {
      "title": ": «مثنى مثنى، فإذا خفت الصبح فأوتر بواحدة توتر لك صلاتك»",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "135": {
      "title": "66 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "136": {
      "title": ": «إني قد اتخذت خاتما، وإني نقشت فيه محمد رسول الله صلى الله عليه وسلم فلا ينقش أحد",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "137": {
      "title": "67 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "138": {
      "title": "نهى عن تلقي السلع حتى يهبط بها الأسواق، ونهى عن التناجش",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "139": {
      "title": "68 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "140": {
      "title": "نهى عن البرنس؟",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "141": {
      "title": "69 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 12
    },
    "142": {
      "title": ": «اللهم بارك لنا في مكتنا، وبارك لنا في مدينتنا، وبارك لنا في شامنا، وبارك لنا في يمننا،",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "143": {
      "title": "70 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "144": {
      "title": ": «سيكون بعدي أمراء، فمن صدقهم بكذبهم وأعانهم على ظلمهم فليس مني، ولست منه، ولا يرد على",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "145": {
      "title": "[ص: 41]",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "146": {
      "title": "71 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "147": {
      "title": ": «لعل هوام رأسك آذتك؟» قال: نعم، قال: «احلق رأسك وافتد» قال: فافتديت ببقرة وقلدتها",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "148": {
      "title": "72 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "149": {
      "title": ": ما الإسلام؟ قال: \" شهادة أن لا إله إلا الله وأن محمدا رسول الله صلى الله عليه وسلم، وتصلي",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 13
    },
    "150": {
      "title": "[ص: 42]",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "151": {
      "title": "73 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "152": {
      "title": ": يا ابن آدم، اثنتان لم يكن لك واحدة منهما: جعلت لك نصيبا من مالك حين أخذت بكظمك لأطهرك به",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "153": {
      "title": "74 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "154": {
      "title": ": «لا يحل لامرأة تؤمن بالله واليوم الآخر، وتؤمن بالله ورسوله أن تحد على ميت فوق ثلاثة أيام",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "155": {
      "title": "75 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "156": {
      "title": "[ص: 43]",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "157": {
      "title": ": «لبيك اللهم لبيك، لا شريك لك لبيك، إن الحمد والنعمة لك والملك لا شريك",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "158": {
      "title": "76 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "159": {
      "title": ": «الليل مثنى مثنى، فإذا خشيت الصبح فواحدة توتر ما قبلها»",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "160": {
      "title": "77 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "161": {
      "title": "فص خاتم رسول الله صلى الله عليه وسلم في كفه",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "162": {
      "title": "78 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 14
    },
    "163": {
      "title": "اتخذ خاتما من ذهب فلبسه ثلاثة أيام، ففشت الخواتيم على أصحابه، فرمى به واتخذ خاتما من ورق",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "164": {
      "title": "79 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "165": {
      "title": "[ص: 44]",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "166": {
      "title": ": «البيعان بالخيار ما لم يتفرقا، إلا أن يكونا اشترطا الخيار»",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "167": {
      "title": "80 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "168": {
      "title": ": «إن من الفطرة قص الشارب وحلق العانة»",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "169": {
      "title": "81 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "170": {
      "title": "ينحر يوم الأضحى بالمدينة، وكان إذا لم ينحر يذبح",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "171": {
      "title": "82 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "172": {
      "title": ": «لا يلبس القميص، ولا العمامة، ولا البرنس، ولا السراويل، ولا الخفين، إلا أن لا يجد نعلين،",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "173": {
      "title": "83 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "174": {
      "title": ": «لا يأكل أحدكم من أضحيته فوق ثلاثة أيام» ، فكان عبد الله إذا غابت الشمس من اليوم الثالث لا",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "175": {
      "title": "84 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 15
    },
    "176": {
      "title": ": \" خمس يقتلهن المحرم: الفأرة، والكلب العقور ، والحدأة، والغراب، والعقرب \"",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "177": {
      "title": "85 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "178": {
      "title": "إذا أعجله السير أخر المغرب حتى يجمع بينهما وبين العشاء الآخرة، وقد فعله ابن عمر وأنا",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "179": {
      "title": "86 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "180": {
      "title": "[ص: 46]",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "181": {
      "title": ": «بينما ثلاثة يمشون إذ أخذتهم السماء فأووا إلى غار في جبل فوقعت عليهم صخرة» وذكر الحديث",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "182": {
      "title": "87 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "183": {
      "title": "نهى عن قتل النساء والولدان يوم فتح مكة",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "184": {
      "title": "88 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "185": {
      "title": ": من السنة أن تأكل قبل أن تصلي",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "186": {
      "title": "89 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "187": {
      "title": ": «من شرب الخمر في الدنيا لم يشربها في الآخرة، إلا أن يتوب»",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "188": {
      "title": "90 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "189": {
      "title": "يصلي راكبا، كذلك ويوتر راكبا، وقد زعم موسى، عن نافع، أن ابن عمر قال: إنه رأى النبي صلى",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "190": {
      "title": "91 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "191": {
      "title": ": «أسامة أحب الناس إلي، ما حاشا فاطمة، ولا غيرها»",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 16
    },
    "192": {
      "title": ": \" يدخل أهل الجنة الجنة، ويدخل أهل النار النار، فيقوم مؤذن بينهم فيقول: يا أهل الجنة لا موت،",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "193": {
      "title": "93 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "194": {
      "title": ": «أيما عبد تزوج بغير إذن مواليه فهو زان»",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "195": {
      "title": "94 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "196": {
      "title": "نهى أن ينبذ البسر والرطب جميعا، والبسر والتمر جميعا",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "197": {
      "title": "95 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "198": {
      "title": ": «من عمر ميسرة المسجد كان له كفلان من الأجر»",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "199": {
      "title": "96 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "200": {
      "title": "لغة النبي صلى الله عليه وسلم: أتحسب ويحسبون",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "201": {
      "title": "97 -",
      "level": 1,
