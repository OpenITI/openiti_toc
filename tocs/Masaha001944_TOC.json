      "level": 3,
      "parent": 3,
      "start_ms": 5,
      "end_ms": 7
    },
    "7": {
      "title": "[كلام النبي عن الميت وشجرة الزقوم.]",
      "level": 3,
      "parent": 3,
      "start_ms": 7,
      "end_ms": 8
    },
    "8": {
      "title": "[في المؤمن المذنب يوم القيامة.]",
      "level": 3,
      "parent": 3,
      "start_ms": 8,
      "end_ms": 8
    },
    "9": {
      "title": "[ولادة أمير المؤمنين فى البيت الحرام.]",
      "level": 3,
      "parent": 3,
      "start_ms": 8,
      "end_ms": 10
    },
    "10": {
      "title": "[قول النبي لعلي تختم في اليمين.]",
      "level": 3,
      "parent": 3,
      "start_ms": 10,
      "end_ms": 10
    },
    "11": {
      "title": "[النبي يكني عليا أبا تراب.]",
      "level": 3,
      "parent": 3,
      "start_ms": 10,
      "end_ms": 11
    },
    "12": {
      "title": "[اعتراف معاوية بفضل علي (عليه السلام)وأبيات محمد بن عبد الله الحميري في فضل على (ع).]",
      "level": 3,
      "parent": 3,
      "start_ms": 11,
      "end_ms": 13
    },
    "13": {
      "title": "[إخبار الباقر (ع) شيعته بحبه لهم وبشارته من الخير.]",
      "level": 3,
      "parent": 3,
      "start_ms": 13,
      "end_ms": 16
    },
    "14": {
      "title": "[بشارة النبي (ص) لعلي وشيعته بالجنة.]",
      "level": 3,
      "parent": 3,
      "start_ms": 16,
      "end_ms": 17
    },
    "15": {
      "title": "[قول النبي من أحب أن يركب سفينة النجاة. فليوال عليا (ع)]",
      "level": 3,
      "parent": 3,
      "start_ms": 17,
      "end_ms": 18
    },
    "16": {
      "title": "[قول النبي (ص) أن عليا وصيي وخليفتي وزوجته سيدة نساء العالمين. والحسن والحسين سيدا شباب أهل الجنة.]",
      "level": 3,
      "parent": 3,
      "start_ms": 18,
      "end_ms": 19
    },
    "17": {
      "title": "[قول رسول الله (ص) أربعة أنا لهم شفيع يوم القيامة لو أتوني بذنوب أهل الأرض.]",
      "level": 3,
      "parent": 3,
      "start_ms": 19,
      "end_ms": 20
    },
    "18": {
      "title": "[قول النبى (ص) حبى وحب أهل بيتى نافع في سبع مواطن.]",
      "level": 3,
      "parent": 3,
      "start_ms": 20,
      "end_ms": 20
    },
    "19": {
      "title": "[قول النبى (ص) المخالف على علي بن أبي طالب كافر. والمحب له مؤمن.]",
      "level": 3,
      "parent": 3,
      "start_ms": 20,
      "end_ms": 21
    },
    "20": {
      "title": "[قول النبى (ص) لعلي يا علي شيعتك هم الفائزون يوم القيامة.]",
      "level": 3,
      "parent": 3,
      "start_ms": 21,
      "end_ms": 22
    },
    "21": {
      "title": "[قول النبي (صلى الله عليه وآله وسلم) في علي خصال لو كانت واحدة منها في جميع الناس لأكتفوا بها فضلا. وقول النبى (ص) حب علي إيمان وبغضه كفر.]",
      "level": 3,
      "parent": 3,
      "start_ms": 22,
      "end_ms": 23
    },
    "22": {
      "title": "[قول النبى ألا أبشرك يا علي قال بلى، قال أنا وأنت وفاطمة والحسن والحسين خلقنا من طينة واحدة.]",
      "level": 3,
      "parent": 3,
      "start_ms": 23,
      "end_ms": 24
    },
    "23": {
      "title": "[قول النبي (صلى الله عليه وآله وسلم) أن الروح والراحة والبشر والبشارة لمن إئتم بعلي وتولاه.]",
      "level": 3,
      "parent": 3,
      "start_ms": 24,
      "end_ms": 27
    },
    "24": {
      "title": "[قول النبي لعلي أنت أخي ووصيي ووارثي وخليفتي على أمتي في حياتي وبعد وفاتي.]",
      "level": 3,
      "parent": 3,
      "start_ms": 27,
      "end_ms": 27
    },
    "25": {
      "title": "[قال رسول الله (ص) إن الله تبارك وتعالى آخى بيني وبين علي بن أبي طالب.]",
      "level": 3,
      "parent": 3,
      "start_ms": 27,
      "end_ms": 27
    },
    "26": {
      "title": "[إن أفضل الأعياد اليوم الذي نصب عليا بغدير خم.]",
      "level": 3,
      "parent": 3,
      "start_ms": 27,
      "end_ms": 29
    },
    "27": {
      "title": "[وصية أمير المؤمنين (ع) لكميل بن زياد (رض).]",
      "level": 3,
      "parent": 3,
      "start_ms": 29,
      "end_ms": 38
    },
    "28": {
      "title": "[في أخذ النبى (صلى الله عليه وآله وسلم) بيد الحسن والحسين وقوله (ص): من أحب هذين وأباهما وأمهما كان معي فى درجتي يوم القيامة.]",
      "level": 3,
      "parent": 3,
      "start_ms": 38,
      "end_ms": 38
    },
    "29": {
      "title": "[إن الله تبارك وتعالى يبعث أناسا وجوههم من نور على كراسي من نور. الخ]",
      "level": 3,
      "parent": 3,
      "start_ms": 38,
      "end_ms": 38
    },
    "30": {
      "title": "[قول النبي (صلى الله عليه وآله وسلم) لعلي (ع) أنا مدينة الحكمة وأنت بابها. ولن تؤت المدينة إلا من قبل الباب.]",
      "level": 3,
      "parent": 3,
      "start_ms": 38,
      "end_ms": 39
    },
    "31": {
      "title": "[قول الصادق (ع) إذا كان يوم القيامة وجمع الله الأولين والآخرين في صعيد واحد.]",
      "level": 3,
      "parent": 3,
      "start_ms": 39,
      "end_ms": 40
    },
    "32": {
      "title": "[قول النبى (صلى الله عليه وآله وسلم) لأصحابه إن الله جعل عليا علما بين الإيمان والنفاق فمن أحبه كان مؤمنا. ومن أبغضه كان كافرا.]",
      "level": 3,
      "parent": 3,
      "start_ms": 40,
      "end_ms": 40
    },
    "33": {
      "title": "[قول النبي (ص) من سره أن يجوز على الصراط. ويلج الجنة بغير حساب فليتول علي بن أبي طالب.]",
      "level": 3,
      "parent": 3,
      "start_ms": 40,
      "end_ms": 40
    },
    "34": {
      "title": "[قول النبى أنا سيد الأنبياء والمرسلين. وأوصيائي سادة الأوصياء وذريتي أفضل ذريات النبيين]",
      "level": 3,
      "parent": 3,
      "start_ms": 40,
      "end_ms": 41
    },
    "35": {
      "title": "[قول النبى (ص) لعلي يا علي أنت إمام المسلمين وأمير المؤمنين وقائد الغر المحجلين وحجة الله على الخلق أجمعين.]",
      "level": 3,
      "parent": 3,
      "start_ms": 41,
      "end_ms": 42
    },
    "36": {
      "title": "[الجزء الثاني]",
      "level": 1,
      "parent": null,
      "start_ms": 42,
      "end_ms": 134
    },
    "37": {
      "title": "[فى قول رسول الله (ص) أربعة أنا لهم شفيع يوم القيامة المكرم لذريتي. والقاضي لهم حوائجهم. والساعي في أمورهم. والمحب لهم.]",
      "level": 3,
      "parent": null,
      "start_ms": 42,
      "end_ms": 134
    },
    "38": {
      "title": "[سؤال ابن عمر من النبى (ص) عن علي بن أبي طالب (ع) وقوله ما بال أقوام يذكرون منزلة من له منزلة كمنزلتي.]",
      "level": 3,
      "parent": 37,
      "start_ms": 43,
      "end_ms": 44
    },
    "39": {
      "title": "[قول مصنف هذا الكتاب هذا الخبر يدل على وجوب الولاية لأولياء الله. والبراءة من أعداء الله.]",
      "level": 3,
      "parent": 37,
      "start_ms": 44,
      "end_ms": 45
    },
    "40": {
      "title": "[قول الصادق (ع) عن المحب لعلي (عليه السلام)من أهل المعاصي.]",
      "level": 3,
      "parent": 37,
      "start_ms": 45,
      "end_ms": 46
    },
    "41": {
      "title": "[عن أبي هريرة قال: قال رسول الله (ص) خيركم خيركم لأهلى من بعدي.]",
      "level": 3,
      "parent": 37,
      "start_ms": 46,
      "end_ms": 46
    },
    "42": {
      "title": "[قول النبى (ص) ما قبض الله نبيا حتى أمره أن يوصي إلى أفضل عترته. فأمرني الله أن أوصي إلى ابن عمي علي (ع).]",
      "level": 3,
      "parent": 37,
      "start_ms": 46,
      "end_ms": 47
    },
    "43": {
      "title": "[قول النبي (ص) أنا شجرة وفاطمة فرعها وعلى لقاحها والحسن والحسين ثمرها ومحبوبهم من امتي ورقها.]",
      "level": 3,
      "parent": 37,
      "start_ms": 47,
      "end_ms": 48
    },
    "44": {
      "title": "[أبيات (يا حبذا دوحة في الخلد نابتة)]",
      "level": 3,
      "parent": 37,
      "start_ms": 48,
      "end_ms": 49
    },
    "45": {
      "title": "[سرور الملائكة باستخلاف الله عليا.]",
      "level": 3,
      "parent": 37,
      "start_ms": 49,
      "end_ms": 51
    },
    "46": {
      "title": "[استظهار المؤلف وجوب طاعة الإمام علي (ع).]",
      "level": 3,
      "parent": 37,
      "start_ms": 51,
      "end_ms": 52
    },
    "47": {
      "title": "[كتاب أمير المؤمنين (ع) إلى محمد بن أبي بكر بولاية مصر.]",
      "level": 3,
      "parent": 37,
      "start_ms": 52,
      "end_ms": 55
    },
    "48": {
      "title": "[من فوائد موالاة علي (ع) ستر العورة عند ما يخرجون من القبور.]",
      "level": 3,
      "parent": 37,
      "start_ms": 55,
      "end_ms": 57
    },
    "49": {
      "title": "[إرشاد النبى (ص) صفية بنت حي بن أخطب بالرجوع إلى علي (ع).]",
      "level": 3,
      "parent": 37,
      "start_ms": 57,
      "end_ms": 58
    },
    "50": {
      "title": "[محاورة لطيفة بين الأعمش وأبي حنيفة عن التحدث في فضائل علي (ع).]",
      "level": 3,
      "parent": 37,
      "start_ms": 58,
      "end_ms": 60
    },
    "51": {
      "title": "[اعتراف كعب الأحبار بفضل شيعة علي (ع). والتسنيم نهر لشيعة علي (ع).]",
      "level": 3,
      "parent": 37,
      "start_ms": 60,
      "end_ms": 63
    },
    "52": {
      "title": "[بيان المراد من الموالاة في حديث الغدير.]",
      "level": 3,
      "parent": 37,
      "start_ms": 63,
      "end_ms": 63
    },
    "53": {
      "title": "[اعتراض السيد الحميري على بيت جعفر بن عفان فى حق أهل البيت وهو (ما بال بيتكم يخرب سقفه).]",
      "level": 3,
      "parent": 37,
      "start_ms": 63,
      "end_ms": 65
    },
    "54": {
      "title": "[النهي عن الاستخفاف بفقراء الشيعة.]",
      "level": 3,
      "parent": 37,
      "start_ms": 65,
      "end_ms": 67
    },
    "55": {
      "title": "[حديث النظر الى علي عبادة. قصة لطيفة.]",
      "level": 3,
      "parent": 37,
      "start_ms": 67,
      "end_ms": 68
    },
    "56": {
      "title": "[لا يحب أهل البيت (عليهم السلام)إلا من طابت ولادته.]",
      "level": 3,
      "parent": 37,
      "start_ms": 68,
      "end_ms": 69
    },
    "57": {
      "title": "[حديث أم سلمة مع مولاها. الساب لعلي (ع) وتوبته.]",
      "level": 3,
      "parent": 37,
      "start_ms": 69,
      "end_ms": 72
    },
    "58": {
      "title": "[حديث زينوا مجالسكم بذكر علي (ع).]",
      "level": 3,
      "parent": 37,
      "start_ms": 72,
      "end_ms": 72
    },
    "59": {
      "title": "[حديث أحبوا أهل بيتي لحبي لهم.]",
      "level": 3,
      "parent": 37,
      "start_ms": 72,
      "end_ms": 73
    },
    "60": {
      "title": "[حديث الركبان يوم القيامة أربعة.]",
      "level": 3,
      "parent": 37,
      "start_ms": 73,
      "end_ms": 74
    },
    "61": {
      "title": "[حديث ما من عبد قطرت عيناه فينا قطرة أو دمعت دمعة إلا بوأه الله حقبا في الجنة.]",
      "level": 3,
      "parent": 37,
      "start_ms": 74,
      "end_ms": 78
    },
    "62": {
      "title": "[كشف لجابر بصره حين تشرف بلقيا الإمام الباقر عليه السلام.]",
      "level": 3,
      "parent": 37,
      "start_ms": 78,
      "end_ms": 83
    },
    "63": {
      "title": "[قول الإمام الرضا (ع) الناس عبيد لنا في الطاعة.]",
      "level": 3,
      "parent": 37,
      "start_ms": 83,
      "end_ms": 85
    },
    "64": {
      "title": "[قصة الجارية المتعلقة بأستار الكعبة. القائلة لا وحق المنتجب بالوصية. الخ وبيتان لأمير المؤمنين (ع) أولهما (ما إن تأوهت من شيء رزيت به).]",
      "level": 3,
      "parent": 37,
      "start_ms": 85,
      "end_ms": 86
    },
    "65": {
      "title": "[في قول رسول الله (صلى الله عليه وآله وسلم) أول عنوان صحيفة المؤمن ما يقول الناس فيه إن خيرا فخير وإن شرا فشر.]",
      "level": 3,
      "parent": 37,
      "start_ms": 86,
      "end_ms": 87
    },
    "66": {
      "title": "[جواب الباقر (ع) (ما أقل الحاج) لمن قال ما أكثر الحاج.]",
      "level": 3,
      "parent": 37,
      "start_ms": 87,
      "end_ms": 88
    },
    "67": {
      "title": "[دعاء الرسول (ص) من أحبني فارزقه العفاف والكفاف. ومن أبغضني فأكثر ماله وولده.]",
      "level": 3,
      "parent": 37,
      "start_ms": 88,
      "end_ms": 88
    },
    "68": {
      "title": "[مجيء جابر الأنصاري لزيارة الحسين (ع).]",
      "level": 3,
      "parent": 37,
      "start_ms": 88,
      "end_ms": 91
    },
    "69": {
      "title": "[قصيدة السيد الحميري في فضل علي (ع) ومواليه.]",
      "level": 3,
      "parent": 37,
      "start_ms": 91,
      "end_ms": 93
    },
    "70": {
      "title": "[أبيات الإمام الرضا (ع) في الصبر والقبول العذر.]",
      "level": 3,
      "parent": 37,
      "start_ms": 93,
      "end_ms": 94
    },
    "71": {
      "title": "[وصية النبى (ص) بالإمامة للحسن والحسين (ع).]",
      "level": 3,
      "parent": 37,
      "start_ms": 94,
      "end_ms": 95
    },
    "72": {
      "title": "[ابيات أبي نؤاس الرائية في مدح الرضا (ع).]",
      "level": 3,
      "parent": 37,
      "start_ms": 95,
      "end_ms": 96
    },
    "73": {
      "title": "[قبول الأعمال بولاية أهل البيت عليهم السلام.]",
      "level": 3,
      "parent": 37,
      "start_ms": 96,
      "end_ms": 97
    },
    "74": {
      "title": "[قول النبي أنا سيد النبيين ووصيي سيد الوصيين إلخ.]",
      "level": 3,
      "parent": 37,
      "start_ms": 97,
      "end_ms": 102
    },
    "75": {
      "title": "[ظاهر الفضل بن دكين التشيع وله بيتان فى ذلك.]",
      "level": 3,
      "parent": 37,
      "start_ms": 102,
      "end_ms": 103
    },
    "76": {
      "title": "[حديث ميثم التمار عن فضل أهل البيت عليهم السلام.]",
      "level": 3,
      "parent": 37,
      "start_ms": 103,
      "end_ms": 105
    },
    "77": {
      "title": "[البلاء إلى الأئمة وشيعتهم أسرع من السيل في الوادي.]",
      "level": 3,
      "parent": 37,
      "start_ms": 105,
      "end_ms": 107
    },
    "78": {
      "title": "[إخبار الرسول بأن لحم علي من لحمه ودمه من دمه.]",
      "level": 3,
      "parent": 37,
      "start_ms": 107,
      "end_ms": 107
    },
    "79": {
      "title": "[ان الله تعالى يتولى حساب المؤمن سترا عليه.]",
      "level": 3,
      "parent": 37,
      "start_ms": 107,
      "end_ms": 109
    },
    "80": {
      "title": "[ضمان الله تعالى لمن أقر لعلي بالولاية الجنة.]",
      "level": 3,
      "parent": 37,
      "start_ms": 109,
      "end_ms": 110
    },
    "81": {
      "title": "[حديث رشيد الهجري مع ابن زياد.]",
      "level": 3,
      "parent": 37,
      "start_ms": 110,
      "end_ms": 112
    },
    "82": {
      "title": "[حب علي (ع) حسنة لا يضر معها سيئة.]",
      "level": 3,
      "parent": 37,
      "start_ms": 112,
      "end_ms": 113
    },
    "83": {
      "title": "[الناس يوم القيامة يدعون بأسماء أمهاتهم إلا شيعة علي عليه السلام.]",
      "level": 3,
      "parent": 37,
      "start_ms": 113,
      "end_ms": 115
    },
    "84": {
      "title": "[حديث الأصبغ مع علي (ع) يظهر منه جلالته.]",
      "level": 3,
      "parent": 37,
      "start_ms": 115,
      "end_ms": 116
    },
    "85": {
      "title": "[قول عمر بن الخطاب بخ بخ لك يا علي.]",
      "level": 3,
      "parent": 37,
      "start_ms": 116,
      "end_ms": 117
