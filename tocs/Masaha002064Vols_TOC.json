    "158": {
      "title": ".../ 653/ الفصل السادس في ذكر أسامي المرتضى (سلام الله عليه):",
      "level": 3,
      "parent": 135,
      "start_ms": 373,
      "end_ms": 374
    },
    "159": {
      "title": "فأما الأسماء التي كان المرتضى فيها سمي الله تعالى فهو: المؤمن والمولى والهادى والسيد والولي والحليم والأول وعلي",
      "level": 3,
      "parent": 135,
      "start_ms": 374,
      "end_ms": 381
    },
    "160": {
      "title": "وأما الأسماء التي كان المرتضى رضوان الله عليه فيها سمي المصطفى (عليه السلام) فهي الصاحب وعبد الله والأخ وسيد العرب (1)؛ والحبيب:",
      "level": 3,
      "parent": 135,
      "start_ms": 381,
      "end_ms": 382
    },
    "161": {
      "title": "وأما الحبيب فإنه:",
      "level": 3,
      "parent": 135,
      "start_ms": 382,
      "end_ms": 383
    },
    "162": {
      "title": "وأما الأسماء التي كان المرتضى- رضوان الله عليه- فيها سمي الله تعالى وسمي رسوله محمد (صلى الله عليه وآله وسلم) فإنها",
      "level": 3,
      "parent": 135,
      "start_ms": 383,
      "end_ms": 384
    },
    "163": {
      "title": "504- فأما سيد العرب",
      "level": 3,
      "parent": 135,
      "start_ms": 384,
      "end_ms": 384
    },
    "164": {
      "title": "وأما سيد البررة وقاتل الفجرة فإنهما يجمعهما حديث واحد:",
      "level": 3,
      "parent": 135,
      "start_ms": 384,
      "end_ms": 385
    },
    "165": {
      "title": "وأما اليعسوب والصديق الأكبر والفاروق:",
      "level": 3,
      "parent": 135,
      "start_ms": 385,
