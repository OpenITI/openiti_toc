      "level": 3,
      "parent": 135,
      "start_ms": 387,
      "end_ms": 388
    },
    "171": {
      "title": "/ 683/ وأما [نعته (عليه السلام) ب] خير الأوصياء:",
      "level": 3,
      "parent": 135,
      "start_ms": 388,
      "end_ms": 389
    },
    "172": {
      "title": "وأما الخليل والوزير وثلاثة بعدها فيجمعها حديث واحد (3):",
      "level": 3,
      "parent": 135,
      "start_ms": 389,
      "end_ms": 390
    },
    "173": {
      "title": "وأما [تسميته (عليه السلام) ب] باب مدينة العلم:",
      "level": 3,
      "parent": 135,
      "start_ms": 390,
      "end_ms": 390
    },
    "174": {
      "title": "وأما [تسميته (عليه السلام) ب] باب دار الحكمة:",
      "level": 3,
      "parent": 135,
      "start_ms": 390,
      "end_ms": 391
    },
    "175": {
      "title": "وأما [كونه (عليه السلام) ملقبا ب] ولي الله، فإنه [يدل عليه ما]:",
      "level": 3,
      "parent": 135,
      "start_ms": 391,
      "end_ms": 392
    },
    "176": {
      "title": "وأما السعيد والصالح:",
      "level": 3,
      "parent": 135,
      "start_ms": 392,
      "end_ms": 392
    },
    "177": {
      "title": "وأما [توصيفه (عليه السلام) ب] الذائد:",
      "level": 3,
      "parent": 135,
      "start_ms": 392,
      "end_ms": 392
    },
    "178": {
      "title": "وأما الاسم الذي سماه به رضوان خازن الجنة وأمين الله جبرئيل (عليهما السلام) فهو الفتى",
      "level": 3,
      "parent": 135,
      "start_ms": 392,
      "end_ms": 392
    },
    "179": {
      "title": "وأما [الاسم الذي] ذكر [ه له] جبرئيل (عليه السلام):",
      "level": 3,
      "parent": 135,
      "start_ms": 392,
      "end_ms": 392
    },
    "180": {
      "title": "وأما الاسم الذي هو مكتوب على باب الجنة فإنه أمير المؤمنين [على ما]:",
      "level": 3,
      "parent": 135,
      "start_ms": 392,
      "end_ms": 393
    },
    "181": {
      "title": "وأما الاسمان اللذان سماه بهما أصحاب الرسول (عليه السلام) فإنهما المرتضى وخير البشر:",
      "level": 3,
      "parent": 135,
      "start_ms": 393,
      "end_ms": 393
    },
    "182": {
      "title": "وأما الأسماء التي سماه بها ابن عمه حبر الأمة وبحرها عبد الله بن عباس رضى الله عنه فإنها [ما]:",
      "level": 3,
      "parent": 135,
      "start_ms": 393,
      "end_ms": 396
    },
    "183": {
      "title": "وأما الاسم الذي سماه به والده فإنه علي، والذي سمته به والدته فأسد",
      "level": 3,
      "parent": 135,
      "start_ms": 396,
      "end_ms": 396
    },
    "184": {
      "title": "وأما الأسماء التي هو مذكور بها في القرآن فالوالي والولي والراكع والركع السجد والمؤمن والنسب والصهر والمصلي",
      "level": 3,
      "parent": 135,
      "start_ms": 396,
      "end_ms": 397
    },
    "185": {
      "title": "وأما الأسماء التي يسمى هو بها فإنها والتي ذكرناها [آنفا] يجمعها حديث واحد وهو ما:",
      "level": 3,
      "parent": 135,
      "start_ms": 397,
      "end_ms": 398
    },
    "186": {
      "title": "/ 699/ وأما الاسم الذي سماه به أبو حكيم الطائي القاص فإنه:",
      "level": 3,
      "parent": 135,
      "start_ms": 398,
      "end_ms": 411
    },
    "187": {
      "title": "وأما الكنى",
      "level": 3,
      "parent": 135,
      "start_ms": 411,
      "end_ms": 411
    },
    "188": {
      "title": "أما أبو تراب:",
      "level": 3,
      "parent": 135,
      "start_ms": 411,
      "end_ms": 412
    },
    "189": {
      "title": "وأما أبو السبطين (1):",
      "level": 3,
      "parent": 135,
      "start_ms": 412,
      "end_ms": 412
    },
    "190": {
      "title": "وأما الكنية التي كناه بها والده وقد دعاه بها رسول الله (صلى الله عليه وآله وسلم) فإنها أبو الحسن (1).",
      "level": 3,
      "parent": 135,
      "start_ms": 412,
      "end_ms": null
    }
