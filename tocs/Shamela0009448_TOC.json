{
  "filename": "0576AbuTahirSilafi.HadithCanHakimKufa.Shamela0009448-ara1",
  "sections": {
    "1": {
      "title": "1 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "2": {
      "title": ": \" صليت مع رسول الله صلى الله عليه وسلم ليلة، فافتتح البقرة، فقلت: يركع عند المائة، فمضى،",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "3": {
      "title": "2 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "4": {
      "title": "في صلاة الظهر، يرفع يديه إذا ركع، وإذا رفع رأسه من الركوع»",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "5": {
      "title": "3 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "6": {
      "title": "أنا لكم مثل الوالد، فإذا ذهب أحدكم إلى الغائط، فلا يستقبل القبلة، ولا يستدبرها بغائط ولا",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 2
    },
    "7": {
      "title": "4 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "8": {
      "title": ": «إذا تبايع الرجلان، فكل واحد منهما بالخيار ما لم يتفرقا وكانا جميعا، أو يخير أحدهما الآخر،",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "9": {
      "title": "5 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "10": {
      "title": ": «لو يعلم الناس ما في الصف الأول لكانت قرعة» .",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "11": {
      "title": "6 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "12": {
      "title": "، تنوق في قريش فتدعنا؟ قال: فقال: هل عندك شيء؟ قلت: نعم، ابنة حمزة، قال: إنها لا تحل لي،",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "13": {
      "title": "7 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 3
    },
    "14": {
      "title": "سيكون في آخر الزمان ناس من أمتي يحدثونكم بما لم تسمعوا أنتم، ولا آباؤكم، فإياكم",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "15": {
      "title": "8 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "16": {
      "title": ": \" لا عدوى ولا طيرة، ويعجبني الفأل الصالح: الكلمة الحسنة \".",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "17": {
      "title": "9 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "18": {
      "title": ": «من وطئه خيلاء، وطئه في النار»",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "19": {
      "title": "10 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "20": {
      "title": ": \" لا حسد إلا في اثنتين: رجل آتاه الله مالا، فسلطه على هلكته في الحق، ورجل آتاه الله حكمة،",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "21": {
      "title": "11 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 4
    },
    "22": {
      "title": ": «لا يزال الله عز وجل مقبلا على عبده في صلاته ما لم يلتفت، فإذا التفت صرف وجهه",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "23": {
      "title": "12 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "24": {
      "title": "دخل يوم الفتح مكة، وعلى رأسه المغفر، فقالوا: هذا ابن خطل متعلق بأستار",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "25": {
      "title": "13 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "26": {
      "title": "، فوجدت ليده بردا وريحا، كأنما أخرجها من جؤنة عطار \".",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "27": {
      "title": "14 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "28": {
      "title": ": \" مثلي ومثل الأنبياء، كمثل رجل بنى دارا، فأكملها وأتممها، إلا موضع لبنة، فجعل الناس",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "29": {
      "title": "15 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 5
    },
    "30": {
      "title": ": \" ما سئل رسول الله صلى الله عليه وسلم شيئا قط، فقال: لا \"",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "31": {
      "title": "16 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "32": {
      "title": ": \" جاء رجل إلى النبي صلى الله عليه وسلم، فقال: يا خير البرية، فقال: ذاك",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "33": {
      "title": "17 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "34": {
      "title": ": \" لا تسافر امرأة مسيرة يومين، أو ليلتين، إلا ومعها ذو محرم، أو زوجها، ولا صوم يومين: يوم",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "35": {
      "title": "18 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "36": {
      "title": "\" صبرك على ما تكره، يعقبك الظفر بما تحب، وكان يقال: شكر النعمة عصمة من النقمة، وأشرف الغنى",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "37": {
      "title": "19 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "38": {
      "title": "20 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "39": {
      "title": "21 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 6
    },
    "40": {
      "title": ": \" معاتبة الأخ خير من فقده، وخير لك من أخيك كله، خذ ms5 من أخيك وهب له، أو قال: دع له، ولا تطع",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": null
    }
