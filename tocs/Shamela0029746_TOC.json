    },
    "109": {
      "title": ": هبط علي جبريل، فقال: يا محمد إن الله يقرئ عليك السلام، ويقول لك: «حبيبي، إني كسوت حسن وجه",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "110": {
      "title": "55 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "111": {
      "title": ": «من عشق وكتم وعف، ثم مات مات شهيدا»",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "112": {
      "title": "56 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "113": {
      "title": ": «من جاء منكم الجمعة فليغتسل»",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "114": {
      "title": "57 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "115": {
      "title": ": «لا يزال أهل الغرب ظاهرين لا يضرهم من خذلهم حتى تقوم الساعة»",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "116": {
      "title": "58 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "117": {
      "title": ": «لا يزال أهل الغرب ظاهرين لا يضرهم من خذلهم حتى يأتي أمر الله»",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "118": {
      "title": "59 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "119": {
      "title": ": «لا تزال طائفة من أمتي على الحق لا يضرهم من خذلهم حتى تقوم الساعة»",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "120": {
      "title": "60 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 12
    },
    "121": {
      "title": ": إنك تواصل، قال: «إني لست كأحدكم، إني أبيت يطعمني ربي ويسقيني»",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "122": {
      "title": "61 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "123": {
      "title": "يرمي الجمرة على ناقة صهباء، لا ضرب ولا طرد ولا جلد، ولا إليك إليك»",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "124": {
      "title": "62 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "125": {
      "title": ": «من أخذ أرضا بغير حقها، كلف أن يحمل ترابها إلى المحشر»",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "126": {
      "title": "63 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "127": {
      "title": ": «لا يحل لامرأة تؤمن بالله واليوم الآخر تسافر في الإسلام يومين أو ثلاثة إلا مع ذي",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "128": {
      "title": "64 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "129": {
      "title": ": «اللهم طهر قلبي من النفاق وعملي من الرياء ولساني من الكذب وعيني من الخيانة، فإنك تعلم",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "130": {
      "title": "65 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 13
    },
    "131": {
      "title": ": «إن استطعت أن تكون أبدا على وضوء فافعل؛ فإن ملك الموت إذا قبض روح العبد وهو على وضوء كتبت",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "132": {
      "title": "66 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "133": {
      "title": ": «أنزلت صحف إبراهيم أول ليلة من رمضان، وأنزلت التوراة لست مضين من رمضان، وأنزل الإنجيل",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "134": {
      "title": "67 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "135": {
      "title": ": «لا تسافر امرأة سفرا ثلاثة أيام فصاعدا إلا مع زوجها، أو ابنها، أو أخيها، أو مع ذي",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "136": {
      "title": "68 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "137": {
      "title": "عن بيع الثمر حتى يخرج»",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "138": {
      "title": "69 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 14
    },
    "139": {
      "title": ": «لا يتوارث أهل ملتين»",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "140": {
      "title": "70 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "141": {
      "title": ": «من جمع مالا من مأثم فوصل به رحما أو تصدق به أو جاهد في سبيل الله جمع جميعه فقذف به في",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "142": {
      "title": "71 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "143": {
      "title": ": «من كان موسرا ولم يحج وعنده مال تجب فيه الزكاة ولم تشغله حاجة ظاهرة ولا مرض حابس ولا سلطان",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "144": {
      "title": "72 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "145": {
      "title": ": «من عد غدا من أجله فقد أساء صحبة الموت»",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "146": {
      "title": "73 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "147": {
      "title": ": \" أربع من سعادة المرء: أن تكون زوجته موافقة، وأولاده أبرارا، وإخوانه صالحين، وأن يكون رزقه",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "148": {
      "title": "74 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 15
    },
    "149": {
      "title": ": «تسحروا؛ فإن في السحور بركة»",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "150": {
      "title": "75 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "151": {
      "title": ": \" تقول جهنم للمؤمن يوم القيامة: جز يا مؤمن فقد أطفأ نورك لهبي \"",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "152": {
      "title": "76 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "153": {
      "title": ": «من قرأ آية الكرسي دبر كل صلاة مكتوبة لم يمنعه من دخول الجنة إلا الموت»",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "154": {
      "title": "77 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "155": {
      "title": ": «لا يزال صيام العبد معلقا بين السماء والأرض حتى يؤدي زكاة فطره»",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "156": {
      "title": "78 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "157": {
      "title": "إذا ركع عدل ظهره، حتى لو صب على ظهره ماء ركد»",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "158": {
      "title": "79 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "159": {
      "title": ": «لا فرع ولا عتيرة في الإسلام» .",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 16
    },
    "160": {
      "title": "80 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "161": {
      "title": ": «بينما ثلاثة دخلوا الغار فانطبقت عليهم الصخرة» .",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "162": {
      "title": "81 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "163": {
      "title": ": «ما من صاحب سيئ إلا وله توبة، إلا صاحب سوء الخلق، فإنه لا يتوب من شيء إلا عاد في شر",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "164": {
      "title": "82 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "165": {
      "title": ": «إذا قعد بين شعبها الأربع وألزق الختان بالختان فقد وجب الغسل»",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "166": {
      "title": "83 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "167": {
      "title": "من حسن الإسلام تركه ما لا يعنيه»",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "168": {
      "title": "84 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "169": {
      "title": ": «البزاق في المسجد خطيئة، وكفارتها دفنها»",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "170": {
      "title": "85 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 17
    },
    "171": {
      "title": ": «يأتي على أمتي زمان يحسد الفقهاء بعضهم بعضا، ويغار بعضهم على بعض كغائر التيوس بعضها على",
      "level": 1,
