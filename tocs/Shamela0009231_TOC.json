    },
    "2": {
      "title": "مقدمة تفسير الراغب الأصفهاني",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "3": {
      "title": "\" فصل \" في بيان ما وقع فيه الاشتباه من الكلام المفرد والمركب \"",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 2
    },
    "4": {
      "title": "(فصل في أوصاف اللفظ المشترك)",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 3
    },
    "5": {
      "title": "(فصل: الاشتراك في اللفظ يقع لأحد وجوه)",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 5
    },
    "6": {
      "title": "(فصل في الآفات المانعة من فهم المخاطب مراد المخاطب)",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "7": {
      "title": "(فصل في عامة ما يوقع الاختلاف ويكثر الشبه)",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 6
    },
    "8": {
      "title": "(فصل في أقسام ما ينطوي عليه القرآن من أنواع الكلام)",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 7
    },
    "9": {
      "title": "(فصل في كيفية بيان القرآن)",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 8
    },
    "10": {
      "title": "(فصل في الفرق بين التفسير والتأويل)",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 10
    },
    "11": {
      "title": "(فصل في الوجوه التي بها يعبر عن المعنى وبها يبين)",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 11
    },
    "12": {
      "title": "(فصل في الحقيقة والمجاز)",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 13
    },
    "13": {
      "title": "(فصل في العموم والخصوص من جهة المعنى)",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "14": {
      "title": "(فصل في تبيين الوجوه التي يجعل لأجلها الاسم فاعلا في اللفظ)",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 16
    },
    "15": {
      "title": "(فصل في بيان الألفاظ التي تجيء متنافية في الظاهر)",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 18
    },
    "16": {
      "title": "(فصل في بيان انطواء كلام الله تعالى على الحكم كلها علميها وعمليها)",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 19
    },
    "17": {
      "title": "(فصل في انطواء القرآن على البراهين والأدلة)",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 20
    },
    "18": {
      "title": "(فصل في الأحكام التي عليها مدار الأديان وما يجوز فيه النسخ وما لا يجوز فيه من الأحكام)",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 23
    },
    "19": {
      "title": "(فصل فيما يحتاج إليه في التفسير من الفرق بين النسخ والتخصيص)",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 24
    },
    "20": {
      "title": "(فصل في أنه هل في القرآن ما لا تعلم الأمة تأويله)",
      "level": 1,
      "parent": null,
      "start_ms": 24,
      "end_ms": 25
    },
    "21": {
      "title": "(فصل في بيان حكمة الله تعالى في جعله بعض الآيات متشابها)",
      "level": 1,
      "parent": null,
      "start_ms": 25,
      "end_ms": 26
    },
