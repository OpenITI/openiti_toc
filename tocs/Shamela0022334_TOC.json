    "13": {
      "title": ": \" إذا أخذت مضجعك فقل: اللهم أسلمت نفسي إليك، ووجهت وجهي إليك وفوضت أمري إليك، وألجأت ظهري",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
