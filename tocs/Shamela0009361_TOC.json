    "2": {
      "title": ": \" آتي يوم القيامة إلى الجنة فأستفتح، فيقول لي الخازن: من أنت؟ فأقول: محمد، فيقول: بك أمرت",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "3": {
      "title": "2 -",
      "level": 1,
