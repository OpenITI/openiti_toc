{
  "filename": "0344IbnSammak.Fawaid.Shamela0029940Vols-ara1",
  "sections": {
    "1": {
      "title": "1 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "2": {
      "title": "، كان أبواك، تعني أبا بكر رضي الله عنه والزبير من \" {الذين استجابوا لله والرسول من بعد ما",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 2
    },
    "3": {
      "title": "2 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "4": {
      "title": ": \" {أرنا الله جهرة} [النساء: 153] ، يقول: عيانا \"",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "5": {
      "title": "3 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "6": {
      "title": ": \" بعثني النبي صلى الله عليه وسلم حين نزلت براءة: أن لا يطوف بالبيت عريان \"",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "7": {
      "title": "4 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "8": {
      "title": ": مر النبي صلى الله عليه وسلم في ثماني عشرة من رمضان على رجل يحتجم، فقال: «أفطر الحاجم",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "9": {
      "title": "5 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "10": {
      "title": "يقف على بعير له بعرفات من بين قومه، حتى يدفع معهم توفيقا من الله عز وجل",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "11": {
      "title": "6 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "12": {
      "title": ": «تقرءون خلف الإمام؟» فقلنا: إن فينا من يقرأ.",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "13": {
      "title": "7 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "14": {
      "title": ": «لا يموتن أحدكم إلا وهو حسن الظن بالله»",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "15": {
      "title": "8 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 3
    },
    "16": {
      "title": ": «القاص ينتظر اللعنة، والمستمع ينتظر الرحمة، والتاجر ينتظر الرزق، والمحتكر ينتظر اللعنة",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "17": {
      "title": "9 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "18": {
      "title": ": «لا تتخذوا الضيعة فترغبوا في الدنيا» .",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "19": {
      "title": "10 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "20": {
      "title": ": «للجنة أقرب إلى أحدكم من شراك نعله، والنار مثل ذلك»",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "21": {
      "title": "11 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "22": {
      "title": ": «لا صلاة لمن لا وضوء له، ولا وضوء لمن لم يذكر اسم الله عليه، ولا يؤمن بالله إلا من يؤمن",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "23": {
      "title": "12 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "24": {
      "title": ": «من مات في طريق مكة حاجا، لم يعرضه الله يوم القيامة، ولم يحاسبه»",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "25": {
      "title": "13 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 4
    },
    "26": {
      "title": ": «إذا أراد أحدكم أن يتزوج امرأة فليسأل عن شعرها كما يسأل عن وجهها، فإن الشعر أحد",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "27": {
      "title": "14 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "28": {
      "title": ": \" ما من أمتي من أحد تولد له جارية فلم يسخط ما خلق الله إلا هبط ملك من السماء، له جناحان",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "29": {
      "title": "15 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "30": {
      "title": ": «خيركم من تعلم القرآن وعلمه» .",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "31": {
      "title": "16 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "32": {
      "title": ": \" كان رجل من بني إسرائيل لا يأتيه أحد يستسلفه شيئا إلا أسلفه إياه بكفيل، فأتاه رجل، فقال:",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 5
    },
    "33": {
      "title": "17 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "34": {
      "title": ": «من قاد مكفوفا أربعين ذراعا كان كعدل عتاق رقبة»",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "35": {
      "title": "18 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "36": {
      "title": ": «النظر إلى علي عبادة»",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "37": {
      "title": "19 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "38": {
      "title": "القوم يقرأ عندهم القرآن فيصعقون؟ قال: «ذاك فعل الخوارج»",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "39": {
      "title": "20 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "40": {
      "title": ": رأيت النبي صلى الله عليه وسلم عند الصفا وهو مقبل على شخص في صورة الفيل، وهو يلعنه.",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 6
    },
    "41": {
      "title": "21 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "42": {
      "title": ": «أتاني جبريل فأمرني أن آمر أصحابي أن يرفعوا أصواتهم بالإهلال»",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "43": {
      "title": "22 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "44": {
      "title": "رفاعة طلقني وبت طلاقي، فتزوجت عبد الرحمن بن الزبير، فإنما معه مثل هدبة الثوب.",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "45": {
      "title": "23 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "46": {
      "title": ": «هذا شهر زكواتكم، فمن كان عليه دين فليقضه، وزكوا بقية أموالكم»",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "47": {
      "title": "24 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "48": {
      "title": "، إنك رجل قوي، وإنك تزاحم على الركن فتؤذي الضعيف، فإذا رأيت خلوة فاستلمه، وإلا فكبر",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "49": {
      "title": "25 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 7
    },
    "50": {
      "title": ": \" من كانت له إلى الله تعالى حاجة، فليصم الأربعاء والخميس والجمعة، فإذا كان يوم الجمعة تطهر",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "51": {
      "title": "26 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 8
    },
    "52": {
      "title": ": «الله أكبر الله أكبر، بسم الله على ديني ونفسي، بسم الله على ولدي وأهلي، بسم الله على كل",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "53": {
      "title": "27 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 9
    },
    "54": {
      "title": ": هذا دحية يا رسول الله.",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "55": {
      "title": "28 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "56": {
      "title": ": \" لما طردت هاجر أم إسماعيل سارة، وضعها إبراهيم بمكة، عطشت هاجر أم إسماعيل، فنزل جبريل عليها",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "57": {
      "title": "29 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "58": {
      "title": "أهل الدرجات العلا ليراهم من تحتهم، كما يرى الكوكب الدري بالأفق من آفاق السماوات، وإن أبا",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "59": {
      "title": "30 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 10
    },
    "60": {
      "title": ": «من مات لا يشرك بالله شيئا دخل الجنة» .",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "61": {
      "title": "31 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "62": {
      "title": ": \" قال رجل من أهل الكتاب: إن الله تعالى يحمل الخلائق على إصبع، والشجر على إصبع، والثرى على",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "63": {
      "title": "32 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "64": {
      "title": ": {والأرض جميعا قبضته يوم القيامة} [الزمر: 67] .",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "65": {
      "title": "33 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "66": {
      "title": ": أدركت أنا ورجل من الأنصار رجلا، فلما شهرنا عليه السيف، قال: لا إله إلا الله.",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "67": {
      "title": "34 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "68": {
      "title": ": «يضرب على آذانهم في القبور أربعين» .",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "69": {
      "title": "35 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 11
    },
    "70": {
      "title": ": «لولا أن تضعفوا عن السواك لأمرتكم به عند كل صلاة»",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "71": {
      "title": "36 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "72": {
      "title": "رأى رجلا منبطحا على وجهه، فقال: «إن هذه لضجعة ما يحبها الله تعالى»",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "73": {
      "title": "37 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "74": {
      "title": "، علمني عملا يقربني من الجنة ويباعدني من النار.",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "75": {
      "title": "38 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "76": {
      "title": ": {فليس عليكم جناح أن تقصروا من الصلاة إن خفتم} [النساء: 101] .",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "77": {
      "title": "39 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "78": {
      "title": ": أبصر علي رسول الله صلى الله عليه وسلم يوما ثيابا خلقانا، قال: «ألك مال؟» .",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "79": {
      "title": "40 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "80": {
      "title": ": إن رجلا مر بي فأقريته، فمررت به فلم يقرني، أفأقريه؟ قال: «نعم»",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "81": {
      "title": "41 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "82": {
      "title": ": «إذا أنفقت المرأة في بيت زوجها غير مفسدة كان لها أجرة، وللزوج مثل ذلك في اكتسابه، وللخازن",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "83": {
      "title": "42 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 12
    },
    "84": {
      "title": "، آذنك على أن ترفع الحجاب، وأن تستمع سوادي حتى أنهاك»",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "85": {
      "title": "43 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "86": {
      "title": ": «لعن الله السارق يسرق الحبل فتقطع يده، ويسرق البيضة فتقطع يده»",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "87": {
      "title": "44 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "88": {
      "title": ": إن لي عبدا قد رضيت دينه وأمانته، وإني أريد أن أتزوجه.",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "89": {
      "title": "45 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "90": {
      "title": ": «لأن أقول سبحان الله ولا إله إلا الله والله أكبر أحب إلي مما طلعت عليه",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "91": {
      "title": "46 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "92": {
      "title": ": «ما أدري أي النعمتين لله علي أفضل، هداني إلى الإسلام، وأعفاني عن الهوى» .",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "93": {
      "title": "47 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 13
    },
    "94": {
      "title": ": «من قضى لأخيه المؤمن حاجة فكأنما خدم الله تعالى عمره »",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "95": {
      "title": "48 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "96": {
      "title": ": «أنا محمد وأحمد والحاشر والمقفى ونبي الرحمة»",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "97": {
      "title": "49 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "98": {
      "title": ": \" إني لي أسماء: أنا محمد وأحمد، والماحي يمحو الله تعالى بي الكفر، والحاشر أحشر الناس على",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "99": {
      "title": "50 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "100": {
      "title": ": «أصبحوا بالصبح؛ فإنه أعظم الأجر»",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "101": {
      "title": "51 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 14
    },
    "102": {
      "title": ": «إذا صمت من الشهر فصم ثلاث عشرة وأربع عشرة وخمس عشرة»",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 15
    },
    "103": {
      "title": "52 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "104": {
