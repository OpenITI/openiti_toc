    },
    "11": {
      "title": "ومنهم : وجيه الدولة أبوالمطاع ذو القرنين بن حسن ابن حمد ن ناصر الدولة",
      "level": 3,
      "parent": 5,
      "start_ms": 40,
      "end_ms": 41
    },
    "12": {
      "title": "ومنهم : ولى الدولة أبو محمد أحمد بن على بن خيران",
      "level": 3,
      "parent": 5,
      "start_ms": 41,
      "end_ms": 42
    },
    "13": {
      "title": "ومنهم : صفى الدولة القائد أبو عبد الله محمد",
      "level": 3,
      "parent": 5,
      "start_ms": 42,
      "end_ms": 43
    },
    "14": {
      "title": "ومنهم صديقنا وعشيرنا الأمير مهذب الدولة ذو البلاغتين الحسن بن أحمد الكاتب المعروف بابن الخياط",
      "level": 3,
      "parent": 5,
      "start_ms": 43,
      "end_ms": 55
    },
    "15": {
      "title": "ومنهم : ابو الحسن احمد بن عباس بن أحمد ابن الخياط",
      "level": 3,
      "parent": 5,
      "start_ms": 55,
      "end_ms": 61
    },
    "16": {
      "title": "فجابه أبوالحسن أحمد بن العباس الكاتب المعروف بابن الخياط",
      "level": 3,
      "parent": 5,
      "start_ms": 61,
      "end_ms": 63
    },
    "17": {
      "title": "وأجاب أيضا ابو تراب النوج أبا الحسن على بن الحسين الكرخى الكاتب عن رسالته التي أجابه عنها أبو الحسن أحمد يبن العباس بن الخياط بهذا الجواب أيضا ، وهو :",
      "level": 3,
      "parent": 5,
      "start_ms": 63,
      "end_ms": 68
    },
    "18": {
      "title": "ومنهم أبو طالب زيد بن أحمد بن السندى الكاتب ، وله شعر صالح ، فمماكتب به إلى أنى عبد الله محمد بن جعفر الأنصلرى الكاتب بعقب أبيات كتب بها إليه بن جعر ، وهى :",
      "level": 3,
      "parent": 5,
      "start_ms": 68,
      "end_ms": 68
    },
    "19": {
      "title": "ومنهم أبو القاسم عبد الرحمن بن أعين المتطبب فمما وقع إلى من شعره قوله يرثى السيدة الشريفة فدس الله روحها:",
      "level": 3,
      "parent": 5,
      "start_ms": 68,
      "end_ms": 70
    },
    "20": {
      "title": "ومنهم المعروف بالبطاط فإنه كتب إلى يسألنى فى السعى له فى تصرف طلبه :",
      "level": 3,
      "parent": 5,
      "start_ms": 70,
      "end_ms": 71
    },
    "21": {
      "title": "ومنهم على بن حبيب الرانى الذلال على السفلى فى قيسارية الوزير، وله شعر صالح فمما رقع من شعره قوله فى صبى يهودى :",
      "level": 3,
      "parent": 5,
      "start_ms": 71,
      "end_ms": 74
    },
    "22": {
      "title": "ومنهم ابو القاسم عبد العزيز بن أبي الكرام وهو مطبوع صالح الشعر فمن قوله فى الغزل:",
      "level": 3,
      "parent": 5,
      "start_ms": 74,
      "end_ms": 75
    },
    "23": {
      "title": "ومنهم أبو القاسم الحسن بن على المعرى فمن قوله فى الغزل :",
      "level": 3,
      "parent": 5,
      "start_ms": 75,
      "end_ms": 82
    },
    "24": {
      "title": "واستهل شعبان بيوم الاربعاء",
