      "start_ms": 2,
      "end_ms": 3
    },
    "6": {
      "title": ": «لا يزال هذا الأمر في قريش ما بقي في الناس اثنان» .",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "7": {
      "title": "4 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "8": {
      "title": ": \" ألقى علي رسول الله صلى الله عليه وسلم الأذان حرفا حرفا: الله أكبر، الله أكبر، أشهد أن لا",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "9": {
      "title": "5 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 4
    },
    "10": {
      "title": ": «غزوت مع رسول الله صلى الله عليه وسلم ست عشرة غزوة» .",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "11": {
      "title": "6 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "12": {
      "title": ": «من أعتق رقبة أعتق الله عز وجل بكل عضو منها عضوا منه من النار حتى فرجه بفرجه» .",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "13": {
      "title": "7 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "14": {
      "title": ": \" قال أبو جهل: {اللهم إن كان هذا هو الحق من عندك فأمطر علينا حجارة من السماء أو ائتنا بعذاب",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 5
    },
    "15": {
      "title": "8 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "16": {
      "title": "، «فلم ينكره رسول الله صلى الله عليه وسلم» .",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "17": {
      "title": "9 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "18": {
      "title": "«يأكل القثاء بالرطب» .",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "19": {
      "title": "10 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 6
    },
    "20": {
      "title": ": «فرض الله عز وجل الصلاة على لسان نبيكم صلى الله عليه وسلم، في الحضر أربعا، وفي السفر",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "21": {
      "title": "11 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "22": {
      "title": ": «ائتوه فصلوا فيه» .",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "23": {
      "title": "12 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "24": {
      "title": ": \" فسطاط المسلمين يوم الملحمة إلى جانب مدينة، يقال لها: دمشق، من خير مدائن",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
