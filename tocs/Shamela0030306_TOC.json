      "title": "13 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 7
    },
    "26": {
      "title": ": «ليس من البر الصوم في السفر»",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "27": {
      "title": "14 -",
      "level": 1,
