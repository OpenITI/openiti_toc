      "start_ms": 58,
      "end_ms": 59
    },
    "128": {
      "title": "الخامس والعشرون: الميلان الأخضران اللذان يهرول الساعى بينهما فى سعيه بين الصفاء والمروة",
      "level": 3,
      "parent": 2,
      "start_ms": 59,
      "end_ms": 60
    },
    "129": {
      "title": "السادس والعشرون: نمرة",
      "level": 3,
      "parent": 2,
      "start_ms": 60,
      "end_ms": 60
    },
    "130": {
      "title": "الباب الثالث والعشرون فيما بمكة من المدارس، والربط، والسقايات، والبرهك المسبلة، والآبار، والعيون، والمطاهر، وغير ذلك من المآثر، وما فى حرمها من ذلك",
      "level": 3,
      "parent": 2,
      "start_ms": 60,
      "end_ms": 60
    },
    "131": {
      "title": "أما المدارس الموقوفة:",
      "level": 3,
      "parent": 2,
      "start_ms": 60,
      "end_ms": 61
    },
    "132": {
      "title": "وأما الربط:",
      "level": 3,
      "parent": 2,
      "start_ms": 61,
      "end_ms": 63
    },
    "133": {
      "title": "وبمكة أوقاف كثيرة على جهات من البر",
      "level": 3,
      "parent": 2,
      "start_ms": 63,
      "end_ms": 64
    },
    "134": {
      "title": "وأما السقايات- وهى السبل",
      "level": 3,
      "parent": 2,
      "start_ms": 64,
      "end_ms": 64
    },
    "135": {
      "title": "وأما البرك المسبلة:",
      "level": 3,
      "parent": 2,
      "start_ms": 64,
      "end_ms": 64
    },
    "136": {
      "title": "أما الآبار التى بمكة:",
      "level": 3,
      "parent": 2,
      "start_ms": 64,
      "end_ms": 64
    },
    "137": {
      "title": "وأما الآبار التى فيما بين مكة ومنى:",
      "level": 3,
      "parent": 2,
      "start_ms": 64,
      "end_ms": 65
    },
    "138": {
      "title": "وأما الآبار التى بمنى:",
      "level": 3,
      "parent": 2,
      "start_ms": 65,
      "end_ms": 65
    },
    "139": {
      "title": "وأما الآبار التى بمزدلفة:",
      "level": 3,
      "parent": 2,
      "start_ms": 65,
      "end_ms": 65
    },
    "140": {
      "title": "وأما الآبار التى بعرفة:",
      "level": 3,
      "parent": 2,
      "start_ms": 65,
      "end_ms": 65
    },
    "141": {
      "title": "وفيما بين عرفة ومزدلفة بئر يقال لها: السقيا",
      "level": 3,
      "parent": 2,
      "start_ms": 65,
      "end_ms": 65
    },
    "142": {
      "title": "وأما الآبار التى بظاهر مكة من أعلاها",
      "level": 3,
      "parent": 2,
      "start_ms": 65,
      "end_ms": 65
    },
    "143": {
      "title": "وأما الآبار التى بأسفل مكة فى جهة التنعيم:",
      "level": 3,
      "parent": 2,
      "start_ms": 65,
      "end_ms": 65
    },
    "144": {
      "title": "وآما العيون التى أجريت بمكة وبظاهرها:",
      "level": 3,
      "parent": 2,
      "start_ms": 65,
      "end_ms": 66
    },
    "145": {
      "title": "وأما المطاهر:",
      "level": 3,
      "parent": 2,
      "start_ms": 66,
      "end_ms": 67
    },
    "146": {
      "title": "الباب الرابع والعشرون فى ذكر شىء من خبر بنى المحض بن جندل ملوهك مكة ونسبهم، وذكر شىء من أخبار العماليق ملوهك مكة ونسبهم، وذكر ولاية طسم للبيت الحرام",
      "level": 3,
      "parent": 2,
      "start_ms": 67,
      "end_ms": 67
    },
    "147": {
      "title": "أما بنو المحض:",
      "level": 3,
      "parent": 2,
      "start_ms": 67,
      "end_ms": 67
    },
    "148": {
      "title": "وأما العماليق:",
      "level": 3,
      "parent": 2,
      "start_ms": 67,
      "end_ms": 68
    },
    "149": {
      "title": "وأما ولاية طسم:",
      "level": 3,
      "parent": 2,
      "start_ms": 68,
      "end_ms": 68
    },
    "150": {
      "title": "الباب الخامس والعشرون فى ذكر شىء خبر جرهم ولاة مكة ونسبهم",
      "level": 3,
      "parent": 2,
      "start_ms": 68,
      "end_ms": 68
    },
    "151": {
      "title": "أما نسبهم:",
      "level": 3,
      "parent": 2,
      "start_ms": 68,
      "end_ms": 69
    },
    "152": {
      "title": "الباب السادس والعشرون فى ذكر شىء من خبر إسماعيل (عليه السلام)، وذكر ذبح إبراهيم لإسماعيل (عليهما السلام)",
      "level": 3,
      "parent": 2,
      "start_ms": 69,
      "end_ms": 71
    },
    "153": {
      "title": "الباب السابع والعشرون فى ذكر شىء من خبرها جرأم إسماعيل (عليه السلام)، وذكر أسماء أولاد إسماعيل، وفوائد تتعلق بهم، وذكر شىء من خبر بنى إسماعيل، وذكر ولاية نابت بن إسماعيل للبيت الحرام",
      "level": 3,
      "parent": 2,
      "start_ms": 71,
      "end_ms": 71
    },
    "154": {
      "title": "أما هاجر:",
      "level": 3,
      "parent": 2,
      "start_ms": 71,
      "end_ms": 71
    },
    "155": {
      "title": "وأما أولاد إسماعيل (عليه السلام):",
      "level": 3,
      "parent": 2,
      "start_ms": 71,
      "end_ms": 72
    },
    "156": {
      "title": "وأما ولاية نابت بن إسماعيل للبيت الحرام:",
      "level": 3,
      "parent": 2,
      "start_ms": 72,
      "end_ms": 72
    },
    "157": {
      "title": "الباب الثامن والعشرون فى ذكر ولاية إياد بن نزار بن معد بن عدنان للكعبة، وشىء من خبره وذكر ولاية بنى إياد بن نزار الكعبة، وشىء من خبرهم، وخبر مضر، ومن ولى الكعبة من مضر قبل قريش",
      "level": 3,
      "parent": 2,
      "start_ms": 72,
      "end_ms": 72
    },
    "158": {
      "title": "أما ولاية إياد:",
      "level": 3,
      "parent": 2,
      "start_ms": 72,
      "end_ms": 73
    },
    "159": {
      "title": "وأما ولاية بنى إياد بن نزار الكعبة:",
      "level": 3,
      "parent": 2,
      "start_ms": 73,
      "end_ms": 73
    },
    "160": {
      "title": "الباب التاسع والعشرون فى ذكر من ولى الإجازة بالناس من عرفة ومزدلفة ومنى من العرب فى ولاية جرهم، وفى ولاية خزاعة وقريش على مكة",
      "level": 3,
      "parent": 2,
      "start_ms": 73,
      "end_ms": 74
    },
    "161": {
      "title": "الباب الثلاثون فى ذكر من ولى إنساء الشهور من العرب بمكة، وذكر صفة الإنساء، وذكر الحمس، والحلة، والطلس",
      "level": 3,
      "parent": 2,
      "start_ms": 74,
      "end_ms": 74
    },
    "162": {
      "title": "وأما صفة الإنساء:",
      "level": 3,
      "parent": 2,
      "start_ms": 74,
      "end_ms": 75
    },
    "163": {
      "title": "وأما الحمس:",
      "level": 3,
      "parent": 2,
      "start_ms": 75,
      "end_ms": 75
    },
    "164": {
      "title": "[واما الحلة:]",
      "level": 3,
      "parent": 2,
      "start_ms": 75,
      "end_ms": 75
    },
    "165": {
      "title": "وأما الطلس:",
      "level": 3,
      "parent": 2,
      "start_ms": 75,
      "end_ms": 75
    },
    "166": {
      "title": "الباب الحادى والثلاثون فى ذكرى شىء من خبر خزاعة ولاة مكة فى الجاهلية ونسبهم، ومدة ولايتهم لمكة، وأول ملوكهم لها، وغير ذلك من خبرهم، وشىء من خبر عمرو بن عامر ماء السماء الذى تنسب إليه خزاعة على ما قيل، وشىء من خبر بنيه وغير ذلك",
      "level": 3,
      "parent": 2,
      "start_ms": 75,
      "end_ms": 75
    },
    "167": {
      "title": "أما نسب خزاعة:",
      "level": 3,
      "parent": 2,
      "start_ms": 75,
      "end_ms": 76
    },
    "168": {
      "title": "وأما ولاية خزاعة لمكة:",
      "level": 3,
      "parent": 2,
      "start_ms": 76,
      "end_ms": 76
    },
    "169": {
      "title": "وأما مدة ولاية خزاعة لمكة:",
      "level": 3,
      "parent": 2,
      "start_ms": 76,
      "end_ms": 76
    },
    "170": {
      "title": "وأما أول من ولى البيت ومكة:",
      "level": 3,
      "parent": 2,
      "start_ms": 76,
      "end_ms": 76
    },
    "171": {
      "title": "وأما آخر من ولى ذلك من خزاعة:",
      "level": 3,
      "parent": 2,
      "start_ms": 76,
      "end_ms": 77
    },
    "172": {
      "title": "الباب الثانى والثلاثون فى ذكر شىء من أخبار قريش بمكة فى الجاهلية، وشىء من فضلهم، وما وصفوا به، وبيان نسبهم وسبب تسميتهم بقريش، وابتداء ولايتهم الكعبة وأمر مكة",
      "level": 3,
      "parent": 2,
      "start_ms": 77,
      "end_ms": 77
    },
    "173": {
      "title": "[فضل قريش:]",
      "level": 3,
      "parent": 2,
      "start_ms": 77,
      "end_ms": 77
    },
    "174": {
      "title": "وأما ما وصفت به بطون قريش",
      "level": 3,
      "parent": 2,
      "start_ms": 77,
      "end_ms": 77
    },
    "175": {
      "title": "وأما نسب قريش:",
      "level": 3,
      "parent": 2,
      "start_ms": 77,
      "end_ms": 78
    },
    "176": {
      "title": "وأما سبب تسميتهم بقريش:",
      "level": 3,
      "parent": 2,
      "start_ms": 78,
      "end_ms": 78
    },
    "177": {
      "title": "وأما ابتداء ولاية قريش للكعبة المعظمة وأمر مكة:",
      "level": 3,
      "parent": 2,
      "start_ms": 78,
      "end_ms": 79
    },
    "178": {
      "title": "الباب الثالث والثلاثون فى ذكر شىء من خبر بنى قصي بن كلاب، وتوليتهم لما كان بيده من الحجابة، والسقاية، والرفادة، والندوة، واللواء، والقيادة، وتفسير ذلك",
      "level": 3,
      "parent": 2,
      "start_ms": 79,
      "end_ms": 80
    },
    "179": {
      "title": "الباب الرابع والثلاثون فى ذكر شىء من خبر الفجار والأحابيش",
      "level": 3,
      "parent": 2,
      "start_ms": 80,
      "end_ms": 80
    },
    "180": {
      "title": "[سبب حرب الفجار:]",
      "level": 3,
      "parent": 2,
      "start_ms": 80,
      "end_ms": 80
    },
    "181": {
      "title": "وأما الأحابيش:",
      "level": 3,
      "parent": 2,
      "start_ms": 80,
      "end_ms": 81
    },
    "182": {
      "title": "الباب الخامس والثلاثون فى ذكر حلف الفضول، وخبر ابن جدعان الذى كان هذا الحلف فى داره، وذكر أجواد قريش وحكامهم فى الجاهلية، وتملك عثمان بن الحويرث ابن أسد بن عبد العزى بن قصى عليهم، وشىء من خبره",
      "level": 3,
      "parent": 2,
      "start_ms": 81,
      "end_ms": 83
    },
    "183": {
      "title": "الباب السادس والثلاثون فى ذكر شىء من فتح مكة المشرفة، وفوائد تتعلق بذلك",
      "level": 3,
      "parent": 2,
      "start_ms": 83,
      "end_ms": 88
    },
    "184": {
      "title": "الباب السابع والثلاثون فى ذكر ولاة مكة المشرفة فى الإسلام",
      "level": 3,
      "parent": 2,
      "start_ms": 88,
      "end_ms": 105
    },
    "185": {
      "title": "الباب الثامن والثلاثون فى ذكر شىء من الحوادث المتعلقة بمكة فى الإسلام",
      "level": 3,
      "parent": 2,
      "start_ms": 105,
      "end_ms": 120
    },
    "186": {
      "title": "الباب التاسع والثلاثون فى ذكر شيء من أمطار مكة وسيولها فى الجاهلية والإسلام، وشيء من أخبار الصواعق بمكة، وذكر شيء من أخبار الرخص والغلاء والوباء بمكة",
      "level": 3,
      "parent": 2,
      "start_ms": 120,
      "end_ms": 120
    },
    "187": {
      "title": "أما أمطار مكة وسيولها، فى الجاهلية والإسلام:",
      "level": 3,
      "parent": 2,
      "start_ms": 120,
      "end_ms": 120
    },
    "188": {
      "title": "منها فى الجاهلية:",
      "level": 3,
      "parent": 2,
      "start_ms": 120,
      "end_ms": 120
    },
    "189": {
      "title": "ومنها: سيول فى الإسلام",
      "level": 3,
      "parent": 2,
      "start_ms": 120,
      "end_ms": 121
    },
    "190": {
      "title": "ومن سيولها فى الإسلام مما كان قبل الأزرقى",
      "level": 3,
      "parent": 2,
      "start_ms": 121,
      "end_ms": 121
    },
    "191": {
      "title": "ومن أمطار مكة وسيولها بعد الأزرقى:",
      "level": 3,
      "parent": 2,
      "start_ms": 121,
      "end_ms": 123
    },
    "192": {
      "title": "وأما أخبار الرخص والغلاء والوباء بمكة:",
      "level": 3,
      "parent": 2,
      "start_ms": 123,
      "end_ms": 123
    },
    "193": {
      "title": "فمن أخبار الرخاء:",
      "level": 3,
      "parent": 2,
      "start_ms": 123,
      "end_ms": 124
    },
    "194": {
      "title": "ومن أخبار الوباء:",
      "level": 3,
      "parent": 2,
      "start_ms": 124,
      "end_ms": 125
    },
    "195": {
      "title": "الباب الأربعون فى ذكر الأصنام التى كانت بمكة وحولها وشىء من خبرها، وذكر شىء من خبر أسواق مكة فى الجاهلية والإسلام، وذكر شىء مما قيل من الشعر فى الشوق إلى مكة الشريفة، وذكر معالمها المنيفة",
      "level": 3,
      "parent": 2,
      "start_ms": 125,
      "end_ms": 125
    },
    "196": {
      "title": "أما الأصنام المشار إليها:",
      "level": 3,
      "parent": 2,
      "start_ms": 125,
      "end_ms": 126
    },
    "197": {
      "title": "وأما أسواق مكة فى الجاهلية",
      "level": 3,
      "parent": 2,
      "start_ms": 126,
      "end_ms": 127
