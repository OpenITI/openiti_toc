      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 4
    },
    "8": {
      "title": "إن نزل بي كرب أو شدائد أقولهن: «لا إله إلا الله الكريم الحليم، وسبحانه، وتبارك الله رب",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "9": {
      "title": "5 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "10": {
      "title": "إن نزل بي كرب أن أقولهن: «لا إله إلا الله الحليم الكريم، سبحانه، وتبارك الله رب العرش",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "11": {
      "title": "6 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "12": {
      "title": ": \" إذا دخل بك فقولي: لا إله إلا الله الحليم الكريم، سبحان الله رب العرش العظيم، الحمد لله رب",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "13": {
      "title": "7 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 5
    },
    "14": {
      "title": ": \" إذا دخل عليك فقولي: لا إله إلا الله العلي العظيم، سبحان الله رب العرش العظيم، والحمد لله",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "15": {
      "title": "8 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "16": {
      "title": "كلمات أقولها عند الكرب: الله ربي لا أشرك به شيئا \"",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "17": {
      "title": "9 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "18": {
      "title": "إذا راعه أمر قال: «الله ربي لا أشرك به شيئا»",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "19": {
      "title": "10 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "20": {
      "title": "إذا راعه أمر، قال: «هو الله لا شريك له» .",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 6
    },
    "21": {
      "title": "11 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "22": {
      "title": ": \" ما أصاب أحدا قط هم ولا حزن، فقال: اللهم إني عبدك، وابن عبدك، وابن أمتك، ناصيتي بيدك، ماض",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 7
    },
    "23": {
      "title": "12 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "24": {
      "title": ": \" اللهم إني أسألك بأن لك الحمد لا إله إلا أنت، المنان يا بديع السماوات والأرض، يا ذا الجلال",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "25": {
      "title": "13 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "26": {
      "title": "14 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 8
    },
    "27": {
      "title": ": اللهم إني أسألك بأن لك الحمد لا إله إلا أنت، يا منان، يا بديع السماوات والأرض، ذا الجلال،",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "28": {
      "title": "15 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "29": {
      "title": ": \" اللهم إني أسألك بأن لك الحمد، لا إله إلا أنت وحدك لا شريك لك، أنت المنان بديع السماوات",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 9
    },
    "30": {
      "title": "16 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "31": {
      "title": "دعوت الله باسمه الذي إذا دعي به أجاب، وإذا سئل به أعطى، ولو دعوت لجميع أمة محمد أن يغفر",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "32": {
      "title": "17 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "33": {
      "title": ": \" اللهم إني أسألك بأنك أنت الله، لا إله إلا أنت الأحد الصمد، الذي لم تلد ولم تولد، ولم يكن",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 10
    },
    "34": {
      "title": "18 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "35": {
      "title": "كلمة لا يقولها مكروب إلا فرج الله كربه، كلمة أخي يونس عليه السلام، {فنادى في الظلمات أن",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "36": {
      "title": "19 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 11
    },
    "37": {
      "title": ": \" اللهم إني أسألك بالله الواحد الصمد الذي لم يلد ولم يولد ولم يكن له كفوا أحد، أن تغفر لي",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "38": {
      "title": "20 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "39": {
      "title": "، دعوة ذي النون، إذا نادى ربه في بطن الحوت: {لا إله إلا أنت سبحانك إني كنت من الظالمين}",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "40": {
      "title": "21 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 12
    },
    "41": {
      "title": ": \" لو دعي به على كل شيء بين المشرق والمغرب، في ساعة من يوم الجمعة لاستجيب لصاحبه: سبحانك لا",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "42": {
      "title": "، يا بديع السماوات والأرض، يا ذا الجلال والإكرام \"",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "43": {
      "title": "22 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "44": {
      "title": ": «يا بديع السماوات والأرض، يا ذا الجلال والإكرام»",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "45": {
      "title": "23 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 13
    },
    "46": {
      "title": "دعاء تدعو به لو كان عليك مثل جبل دينا لأداه الله عنك قل يا معاذ اللهم مالك الملك، تؤتي",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "47": {
      "title": "24 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "48": {
      "title": "كلمات علمنيهن رسول الله صلى الله عليه وسلم لو كان عليك مثل جبل صير دنانير لأداه الله عنك،",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "49": {
      "title": "25 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 14
    },
    "50": {
      "title": ": «اللهم عافني في بدني، اللهم عافني في سمعي، اللهم عافني في بصري، لا إله إلا أنت، تعيدها",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "51": {
      "title": "100 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "52": {
      "title": ": \" دعوات المكروب: اللهم رحمتك أرجو، فلا تكلني إلى نفسي طرفة عين، وأصلح لي شأني كله، لا إله",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "53": {
      "title": "26 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "54": {
      "title": ": \" اسم الله الأعظم في ما بين الآيتين: {وإلهكم إله واحد} [البقرة: 163] و {الم {1} الله لا إله",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "55": {
      "title": "27 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "56": {
      "title": ": \" اسم الله الأعظم في ما بين الآيتين: {وإلهكم إله واحد} [البقرة: 163] و {الم {1} الله لا إله",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "57": {
      "title": "28 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 15
    },
    "58": {
      "title": ": \" من كانت له حاجة إلى الله تعالى، أو إلى أحد من بني آدم فليتوضأ، فليحسن الوضوء، ثم ليصل",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "59": {
      "title": "29 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 16
    },
    "60": {
      "title": ": \" ائت الميضاة فتوضأ، ثم ائت المسجد فصلي فيه ركعتين، ثم قل: اللهم إني أسألك وأتوجه إليك",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 17
    },
    "61": {
      "title": "30 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "62": {
      "title": "لكلمات سمعتهن من رسول الله صلى الله عليه وسلم، من قالها أول النهار لم تصبه مصيبة حتى",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "63": {
      "title": "31 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 18
    },
    "64": {
      "title": ": اللهم رب الأرواح الفانية، والأجساد البالية، أسألك بطاعة الأرواح الراجعة إلى أجسادها،",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "65": {
      "title": "32 -",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 19
    },
    "66": {
      "title": ": يا ودود، يا ذا العرش المجيد، يا فعال لما تريد، أسألك بعزك الذي لا يرام، وملكك الذي لا",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "67": {
      "title": "33 -",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "68": {
      "title": ": \" ما أنعم الله على عبد نعمة في أهل، أو مال، أو ولد، فقال: ما شاء الله لا قوة إلا بالله،",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "69": {
      "title": "34 -",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 20
    },
    "70": {
      "title": ": إذا طلبت حاجة فأحببت أن تنجح، فقل: \" لا إله إلا الله وحده لا شريك له العلي العظيم، لا إله",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "71": {
      "title": "35 -",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 21
    },
    "72": {
      "title": "أقول إذا أصبحت: آمنت بالله العظيم، وكفرت بالجبت والطاغوت، واستمسكت بالعروة الوثقى لا",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "73": {
      "title": "36 -",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "74": {
      "title": ": «آمنت بالله العظيم وحده، وكفرت بالجبت والطاغوت، واعتصمت بالعروة الوثقى، التي لا انفصام",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "75": {
      "title": "37 -",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "76": {
      "title": "رجلا أصابه ذلك الداء يعني الجذام، حتى ظن أهله أنه ليس عليهم بأس أن يخرجوه، فظن هو أنه لا",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "77": {
      "title": "38 -",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 22
    },
    "78": {
      "title": ": «يا علي يا عظيم، يا حليم يا عليم.",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 22
    },
    "79": {
      "title": "39 -",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 22
    },
    "80": {
      "title": ": \" رأيت رجلا في المنام قائما، فقال لي: قل.",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 22
    },
    "81": {
      "title": "40 -",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 22
    },
    "82": {
      "title": ": \" هذه الكلمات لو دعوتهن على حلقة حديد لفصمتهن: يا بادئ لا بدء لك، يا دائم لا نفاد لك، يا حي",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 22
    },
    "83": {
      "title": "41 -",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 22
    },
    "84": {
      "title": ": \" خرجت يوما لحاجة، فأسمع قائلا يقول: ورائي ولا أرى أحدا: اللهم أنت المليك، وأنت على كل شيء",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 23
    },
    "85": {
      "title": "42 -",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 23
    },
    "86": {
      "title": ": «اللهم رب السماوات السبع، ورب الأرضين السبع، ورب العرش العظيم، بألا إله إلا أنت، بما مننت",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 23
    },
    "87": {
      "title": "43 -",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 23
    },
    "88": {
      "title": ": \" من كانت له إلى الله حاجة فليصم الأربعاء والخميس والجمعة، فإذا كان يوم الجمعة تطهر، وراح",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 24
    },
    "89": {
      "title": "44 -",
      "level": 1,
      "parent": null,
      "start_ms": 24,
      "end_ms": 24
    },
    "90": {
      "title": "هل من الدعاء شيء لا يرد؟ قال: نعم، تقول: «أسألك باسم الأعلى الأعز الأجل",
      "level": 1,
      "parent": null,
      "start_ms": 24,
      "end_ms": 24
    },
    "91": {
      "title": "45 -",
      "level": 1,
      "parent": null,
      "start_ms": 24,
      "end_ms": 24
    },
    "92": {
      "title": ": قال لقمان لابنه: \" إذا أصابتك شدة فاذهب إلى فلاة من الأرض، وصل ركعتين، ثم ضع وجهك على",
      "level": 1,
      "parent": null,
      "start_ms": 24,
      "end_ms": 24
    },
    "93": {
      "title": "46 -",
      "level": 1,
      "parent": null,
      "start_ms": 24,
      "end_ms": 25
    },
    "94": {
      "title": "من الدعاء الذي لا يرد، أن يصلي العبد ثنتي عشرة ركعة، يقرأ في كل ركعة بأم القرآن، وآية",
      "level": 1,
      "parent": null,
      "start_ms": 25,
      "end_ms": 25
    },
    "95": {
      "title": "47 -",
      "level": 1,
      "parent": null,
      "start_ms": 25,
      "end_ms": 25
    },
    "96": {
      "title": ": \" اسم الله الأعظم هو الله عز وجل، ألم تروا أنه يبدأ به في القرآن قبل الأشياء",
      "level": 1,
      "parent": null,
      "start_ms": 25,
      "end_ms": 25
    },
    "97": {
      "title": "48 -",
      "level": 1,
      "parent": null,
      "start_ms": 25,
      "end_ms": 26
