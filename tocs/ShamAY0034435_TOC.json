    "17": {
      "title": "AUTO الباب الثاني: من تزوجهن رسول الله صلى الله عليه وسلم ولم يدخل بهن",
      "level": 1,
      "parent": null,
      "start_ms": 24,
      "end_ms": 34
    },
    "18": {
      "title": "AUTO [الكلابية]",
      "level": 2,
      "parent": 17,
      "start_ms": 24,
      "end_ms": 24
    },
    "19": {
      "title": "AUTO فالمشهور منهن:",
      "level": 2,
      "parent": 17,
      "start_ms": 24,
      "end_ms": 25
    },
    "20": {
      "title": "AUTO وقيل: إن الضحاك عرض ابنته فاطمة عليه، وقال: إنها لم تصدع قط،",
      "level": 2,
      "parent": 17,
      "start_ms": 25,
      "end_ms": 25
    },
    "21": {
      "title": "AUTO وروي عن ابن عمر: كان في نساء النبي صلى الله عليه وسلم ، شماء",
      "level": 2,
      "parent": 17,
      "start_ms": 25,
      "end_ms": 25
    },
    "22": {
      "title": "AUTO من بني عامر، يقال لها: عمرة بنت يزيد بن عبيد بن رواس،",
      "level": 2,
      "parent": 17,
      "start_ms": 25,
      "end_ms": 25
    },
    "23": {
      "title": "AUTO فمكثت عنده دهرا ثم طلقها.",
      "level": 2,
      "parent": 17,
      "start_ms": 25,
      "end_ms": 25
    },
    "24": {
      "title": "AUTO [أسماء الجونية]",
      "level": 2,
      "parent": 17,
      "start_ms": 25,
      "end_ms": 26
    },
    "25": {
      "title": "AUTO وقال قتادة: لما دخل عليها رسول الله صلى الله عليه وسلم ،",
      "level": 2,
      "parent": 17,
      "start_ms": 26,
      "end_ms": 26
    },
    "26": {
      "title": "AUTO ثم خرج رسول الله صلى الله عليه وسلم ثم قال: يا أبا أسيد،",
      "level": 2,
      "parent": 17,
      "start_ms": 26,
      "end_ms": 27
    },
    "27": {
      "title": "AUTO [قتيلة]",
      "level": 2,
      "parent": 17,
      "start_ms": 27,
      "end_ms": 28
    },
    "28": {
      "title": "AUTO وكان عروة بن الزبير ينكر ذلك ويقول: لم يتزوج النبي، صلى الله",
      "level": 2,
      "parent": 17,
      "start_ms": 28,
      "end_ms": 28
    },
    "29": {
      "title": "AUTO قال الشعبي: تزوج امرأة من كندة، فجيء بها بعدما مات. ذكر ذلك",
      "level": 2,
      "parent": 17,
      "start_ms": 28,
      "end_ms": 28
    },
    "30": {
      "title": "AUTO قال ابن عبد البر: وفي سبب فراقها اختلاف، ولا ثبت فيها شيء.",
      "level": 2,
      "parent": 17,
      "start_ms": 28,
      "end_ms": 29
    },
    "31": {
      "title": "AUTO وعن الزهري مثل ذلك.",
      "level": 2,
      "parent": 17,
      "start_ms": 29,
      "end_ms": 29
    },
    "32": {
      "title": "AUTO قال محمد بن عمر: وأصحابنا ينكرون ذلك، ويقولون: لم يتزوج رسول",
      "level": 2,
      "parent": 17,
      "start_ms": 29,
      "end_ms": 29
    },
    "33": {
      "title": "AUTO ذكر هذه الترجمة وكل ذلك، أبو الفرج بن الجوزي في ((التلقيح))،",
      "level": 2,
      "parent": 17,
      "start_ms": 29,
      "end_ms": 30
    },
    "34": {
      "title": "AUTO وكانت ربتها خالتها خرنق بنت خليفة، أخت دحية بن خليفة الكلبي،",
      "level": 2,
      "parent": 17,
      "start_ms": 30,
      "end_ms": 30
    },
    "35": {
      "title": "AUTO وقال ابن عبد البر: هلكت قبل دخوله بها.",
      "level": 2,
      "parent": 17,
      "start_ms": 30,
      "end_ms": 30
    },
    "36": {
      "title": "AUTO فقالت: يا رسول الله، ما دونك سر.",
      "level": 2,
      "parent": 17,
      "start_ms": 30,
      "end_ms": 31
    },
    "37": {
      "title": "AUTO فقال لها رسول الله، صلى الله عليه وسلم : وإن كان لم يكن يؤذن",
      "level": 2,
      "parent": 17,
      "start_ms": 31,
      "end_ms": 32
    },
    "38": {
      "title": "AUTO وذكر أيضا عن ابن أبي عون، أن ليلى بنت الخطيم وهبت نفسها",
      "level": 2,
      "parent": 17,
      "start_ms": 32,
      "end_ms": 32
    },
    "39": {
      "title": "AUTO [أم شريك]",
      "level": 2,
      "parent": 17,
      "start_ms": 32,
      "end_ms": 34
    },
    "40": {
      "title": "AUTO ومنها: فرار الناس من الدجال في الجبال. قيل: يا رسول الله،",
      "level": 2,
      "parent": 17,
      "start_ms": 34,
      "end_ms": 34
    },
    "41": {
      "title": "AUTO الباب الثالث: [من خطبهن، صلى الله عليه وسلم ، ولم يتفق",
      "level": 1,
      "parent": null,
      "start_ms": 34,
      "end_ms": 38
    },
    "42": {
      "title": "AUTO وأما من خطبهن النبي، صلى الله عليه وسلم ، ولم يتفق تزويجهن فثلاث:",
      "level": 2,
      "parent": 41,
      "start_ms": 34,
      "end_ms": 35
    },
    "43": {
      "title": "AUTO وولدت أم هانئ لهبيرة: جعدة وعمرا ويوسف وهانئا، بني هبيرة.",
      "level": 2,
      "parent": 41,
      "start_ms": 35,
      "end_ms": 36
    },
    "44": {
      "title": "AUTO فرجع إلى النبي صلى الله عليه وسلم ، فسكت عنه.",
      "level": 2,
      "parent": 41,
      "start_ms": 36,
      "end_ms": 36
    },
    "45": {
      "title": "AUTO [جمرة بنت الحارث]",
      "level": 2,
      "parent": 41,
      "start_ms": 36,
      "end_ms": 36
    },
    "46": {
      "title": "AUTO وهي أم شبيب بن البرصاء الشاعر.",
      "level": 2,
      "parent": 41,
      "start_ms": 36,
      "end_ms": 36
    },
    "47": {
      "title": "AUTO ذكرها والتي قبلها ابن الجوزي رحمه الله، في كتابه",
      "level": 2,
      "parent": 41,
      "start_ms": 36,
      "end_ms": 36
    },
    "48": {
      "title": "AUTO [خبر أمامة بنت حمزة]",
      "level": 2,
      "parent": 41,
      "start_ms": 36,
      "end_ms": 37
    },
    "49": {
      "title": "AUTO وعرضت عليه أمامة بنت حمزة بن عبد المطلب، وقيل: إنها عمارة،",
      "level": 2,
      "parent": 41,
      "start_ms": 37,
      "end_ms": 38
    },
    "50": {
      "title": "AUTO وأم سلمة بنت أبي أمية، رضي الله عنها، وأم حبيبة بنت أبي",
      "level": 2,
      "parent": 41,
      "start_ms": 38,
      "end_ms": 38
    },
    "51": {
      "title": "AUTO الباب الرابع: أسلافه صلى الله عليه وسلم PageV01P121",
      "level": 1,
