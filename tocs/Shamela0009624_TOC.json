      "start_ms": 21,
      "end_ms": 21
    },
    "107": {
      "title": ": «من قتل معاهدا في غير كنهه، حرم الله عليه الجنة» ، رواه الإمام أحمد، عن",
      "level": 1,
      "parent": null,
