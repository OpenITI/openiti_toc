  "filename": "0413ShaykhMufid.AhkamNisa.Masaha000974-ara1",
  "sections": {
    "1": {
      "title": "المقدمة",
      "level": 3,
      "parent": null,
      "start_ms": 1,
      "end_ms": null
    },
    "2": {
      "title": "باب ما يعم كافة المكلفين فرضه ولا يسقط عنهم مع كمال عقولهم",
      "level": 3,
      "parent": null,
      "start_ms": 1,
      "end_ms": null
    },
    "3": {
      "title": "باب ما يخص فرضه بمن كلفه الله وأمره ونهاه من النساء الأحرار والإماء على الجملة لذلك والتفصيل",
      "level": 3,
      "parent": 2,
      "start_ms": 2,
      "end_ms": 2
    },
    "4": {
      "title": "فصل ومن احتلم من الرجال أو جامع وأنزل الماء كان عليه أن يستبرئ بالبول قبل الغسل",
      "level": 3,
      "parent": 2,
      "start_ms": 2,
      "end_ms": 2
    },
    "5": {
      "title": "باب الحيض",
      "level": 3,
      "parent": 2,
      "start_ms": 2,
      "end_ms": 3
    },
    "6": {
      "title": "فصل وأقل زمان الحيض ثلاثة أيام بلياليها وأكثرها عشرة أيام بلياليها",
      "level": 3,
      "parent": 2,
      "start_ms": 3,
      "end_ms": 4
    },
    "7": {
      "title": "فصل فالمرأة إذا استحاضت فعليها الاستبراء وغسل الفرج بالماء وحشوه بالقطن وشده بالخرق",
      "level": 3,
      "parent": 2,
      "start_ms": 4,
      "end_ms": 5
    },
    "8": {
      "title": "فصل وإذا التبس على المرأة دم الحيض من دم الاستحاضة اعتبرت ذلك بلون الدم وكثافته ورقته وبرودته وحرارته.",
      "level": 3,
      "parent": 2,
      "start_ms": 5,
      "end_ms": 5
    },
    "9": {
      "title": "فصل وليس على الحائض أن تقضي ما فاتها من الصلاة لكنها تقضي ما فاتها من الصوم المفروض.",
      "level": 3,
      "parent": 2,
      "start_ms": 5,
      "end_ms": 5
    },
    "10": {
      "title": "فصل فإذا حاضت المرأة وهي صائمة أفطرت وقت حيضها وقضت ذلك اليوم",
      "level": 3,
      "parent": 2,
      "start_ms": 5,
      "end_ms": 6
    },
    "11": {
      "title": "باب أحكام النساء في الصلوات",
      "level": 3,
      "parent": 2,
      "start_ms": 6,
      "end_ms": 8
    },
    "12": {
      "title": "فصل وللحرة أن تؤم النساء",
      "level": 3,
      "parent": 2,
      "start_ms": 8,
      "end_ms": 9
    },
    "13": {
      "title": "باب أحكام النساء في الصيام",
      "level": 3,
      "parent": 2,
      "start_ms": 9,
      "end_ms": 9
    },
    "14": {
      "title": "باب أحكام النساء في الزكوات والصدقات",
      "level": 3,
      "parent": 2,
      "start_ms": 9,
      "end_ms": 9
    },
    "15": {
      "title": "فصل ويكره للمرأة أن تتبرع بشيء من الصدقة إلا بإذن زوجها على ما قدمناه.",
      "level": 3,
      "parent": 2,
      "start_ms": 9,
      "end_ms": 9
    },
    "16": {
      "title": "باب أحكام النساء في الحج والعمرة",
      "level": 3,
      "parent": 2,
      "start_ms": 9,
      "end_ms": 12
    },
    "17": {
      "title": "باب أحكام النساء في النكاح",
      "level": 3,
      "parent": 2,
      "start_ms": 12,
      "end_ms": 15
    },
    "18": {
      "title": "باب أحكام النساء في الطلاق والفراق ووفاة الأزواج",
      "level": 3,
      "parent": 2,
      "start_ms": 15,
      "end_ms": 16
    },
    "19": {
      "title": "فصل وإن راجعها بعد التطليقة الأولى قبل خروجها من العدة وأقام معها",
      "level": 3,
      "parent": 2,
      "start_ms": 16,
      "end_ms": 16
    },
    "20": {
      "title": "فصل والمباراة لا تكون إلا وكل واحد من الزوجين كاره لصاحبه",
      "level": 3,
      "parent": 2,
      "start_ms": 16,
      "end_ms": 18
    },
    "21": {
      "title": "فصل وإذا مات الرجل عن المرأة أو قتل فعليها العدة أربعة أشهر وعشرا",
      "level": 3,
      "parent": 2,
      "start_ms": 18,
      "end_ms": 20
    },
    "22": {
      "title": "باب أحكام النساء في الشهادات والبينات",
      "level": 3,
      "parent": 2,
      "start_ms": 20,
      "end_ms": 20
    },
    "23": {
      "title": "باب أحكام النساء في القود والقصاص والديات",
      "level": 3,
      "parent": 2,
      "start_ms": 20,
      "end_ms": 21
    },
    "24": {
      "title": "باب أحكام النساء في الحدود والآداب",
      "level": 3,
      "parent": 2,
      "start_ms": 21,
      "end_ms": 22
    },
    "25": {
      "title": "باب من أحكام النساء في آداب الشريعة وما هو واجب من ذلك ومندوب إليه",
      "level": 3,
      "parent": 2,
      "start_ms": 22,
      "end_ms": 24
    },
    "26": {
      "title": "باب أحكام النساء في الاحتضار للموت والغسل والكفن والصلاة عليهن",
      "level": 3,
      "parent": 2,
      "start_ms": 24,
      "end_ms": null
    }
