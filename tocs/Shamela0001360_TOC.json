    },
    "222": {
      "title": "112 -",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 22
    },
    "223": {
      "title": ": \" قيدوا العلم بالكتاب \"",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 22
    },
    "224": {
      "title": "113 -",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 22
    },
    "225": {
      "title": ": \" آخر آية نزلت: {قل الله يفتيكم في الكلالة} [النساء: 176]",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 22
    },
    "226": {
      "title": "114 -",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 23
    },
    "227": {
      "title": ": \" إذا ولغ الكلب في إناء أحدكم فليغسله سبع مرات , وإذا انقطع شسع أحدكم فلا يمش في أحد ms22",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 23
    },
    "228": {
      "title": "115 -",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 23
    },
    "229": {
      "title": ": \" من أقام مع المشركين فقد برئت منه الذمة \"",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 23
    },
    "230": {
      "title": "116 -",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 23
    },
    "231": {
      "title": ": \" من سئل عن علم , قد علمه فكتمه جيء يوم القيامة ملجما بلجام من نار \"",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 23
    },
    "232": {
      "title": "117 -",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 23
    },
    "233": {
      "title": "ضرب رجلي فقبضتهما",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 23
    },
    "234": {
      "title": "118 -",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 23
    },
    "235": {
      "title": ": \" أنزلت المائدة من السماء خبز ولحم , وأمروا أن لا يخبوا ولا يدخروا , ولا ترفعوا لغد",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 23
    },
    "236": {
      "title": "119 -",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 23
    },
    "237": {
      "title": ": \" إذا حضرتم موتاكم فأغمضوا موتاكم , فإن البصر يتبع الروح , وقولوا خيرا؛ فإنه يؤمن على ما",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 23
    },
    "238": {
      "title": "120 -",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 23
    },
    "239": {
      "title": "يشدها بالذهب",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 24
    },
    "240": {
      "title": "121 ms23 -",
      "level": 1,
      "parent": null,
      "start_ms": 24,
      "end_ms": 24
    },
    "241": {
      "title": ": {قل لا أسألكم عليه أجرا إلا المودة في القربى} [الشورى: 23] قال النبي صلى الله عليه وسلم: \"",
      "level": 1,
      "parent": null,
      "start_ms": 24,
      "end_ms": 24
    },
    "242": {
      "title": "122 -",
      "level": 1,
      "parent": null,
      "start_ms": 24,
      "end_ms": 24
    },
    "243": {
      "title": ": \" اهجهم - أو هاجهم يعني المشركين - \" وجبريل معك \"",
      "level": 1,
      "parent": null,
      "start_ms": 24,
      "end_ms": 24
    },
    "244": {
      "title": "123 -",
      "level": 1,
      "parent": null,
      "start_ms": 24,
      "end_ms": 24
    },
    "245": {
      "title": "لم يكره الكحل للصائم , وكره له السعوط أو يصب في أذنه شيء",
      "level": 1,
      "parent": null,
      "start_ms": 24,
      "end_ms": 24
    },
    "246": {
      "title": "124 -",
      "level": 1,
      "parent": null,
      "start_ms": 24,
      "end_ms": 24
    },
    "247": {
      "title": ": \" إياكم والدين فإنه هم بالليل ومذلة بالنهار \"",
      "level": 1,
      "parent": null,
      "start_ms": 24,
      "end_ms": 24
    },
    "248": {
      "title": "125 -",
      "level": 1,
      "parent": null,
      "start_ms": 24,
      "end_ms": 24
    },
    "249": {
      "title": ": \" إذا جاء أحدكم المسجد نهارا فلينظر في أسفل نعليه , وإذا جاء ليلا فليدلكهما , بالأرض قبل أن",
      "level": 1,
      "parent": null,
      "start_ms": 24,
      "end_ms": 24
    },
    "250": {
      "title": "126 -",
      "level": 1,
      "parent": null,
      "start_ms": 24,
      "end_ms": 25
    },
    "251": {
      "title": ": \" لا تعادوا , لا تباغضوا ms24 , ولا تنافسوا , وكونوا عباد الله إخوانا \"",
      "level": 1,
      "parent": null,
      "start_ms": 25,
      "end_ms": 25
    },
    "252": {
      "title": "127 -",
      "level": 1,
      "parent": null,
      "start_ms": 25,
      "end_ms": 25
    },
    "253": {
      "title": ": \" من كان يؤمن بالله واليوم الآخر فليقل خيرا أو ليصمت \"",
      "level": 1,
      "parent": null,
      "start_ms": 25,
      "end_ms": 25
    },
    "254": {
      "title": "128 -",
      "level": 1,
      "parent": null,
      "start_ms": 25,
      "end_ms": 25
    },
    "255": {
      "title": ": \" كل شيء بقدر حتى العجز والكيس. أو الكيس والعجز \"",
      "level": 1,
      "parent": null,
      "start_ms": 25,
      "end_ms": 25
    },
    "256": {
      "title": "129 -",
      "level": 1,
      "parent": null,
      "start_ms": 25,
      "end_ms": 25
    },
    "257": {
      "title": ": \" هذا أمين هذه الأمة \"",
      "level": 1,
      "parent": null,
      "start_ms": 25,
      "end_ms": 25
    },
    "258": {
      "title": "130 -",
      "level": 1,
      "parent": null,
      "start_ms": 25,
      "end_ms": 25
    },
    "259": {
      "title": ": \" لا يزني الزاني حين يزني وهو مؤمن , ولا يشرب الخمر حين يشرب وهو مؤمن , ولكن باب التوبة",
      "level": 1,
      "parent": null,
      "start_ms": 25,
      "end_ms": 25
    },
    "260": {
      "title": "131 -",
      "level": 1,
      "parent": null,
      "start_ms": 25,
      "end_ms": 25
    },
    "261": {
      "title": ": \" ليس الغنى عن كثرة العرض , ولكن الغنى غنى النفس \"",
      "level": 1,
      "parent": null,
      "start_ms": 25,
      "end_ms": 25
    },
    "262": {
      "title": "132 -",
      "level": 1,
      "parent": null,
      "start_ms": 25,
      "end_ms": 26
    },
    "263": {
      "title": ": حرمت الخمر بعينها قليلها وكثيرها , والسكر ms25 من كل شراب \"",
      "level": 1,
      "parent": null,
      "start_ms": 26,
      "end_ms": 26
    },
    "264": {
      "title": "133 -",
      "level": 1,
      "parent": null,
      "start_ms": 26,
      "end_ms": 26
    },
    "265": {
      "title": ": \" إذا أقيمت الصلاة فأتوها وعليكم السكينة , فصلوا ما أدركتم , واقضوا ما",
      "level": 1,
      "parent": null,
      "start_ms": 26,
      "end_ms": 26
    },
    "266": {
      "title": "134 -",
      "level": 1,
      "parent": null,
      "start_ms": 26,
      "end_ms": 26
    },
    "267": {
      "title": ": \" من نفس عن مؤمن كربة من كرب الدنيا نفس الله عنه كربة من كرب الآخرة , والله في عون العبد ما",
      "level": 1,
      "parent": null,
      "start_ms": 26,
      "end_ms": 26
    },
    "268": {
      "title": "135 -",
      "level": 1,
      "parent": null,
      "start_ms": 26,
      "end_ms": 26
    },
    "269": {
      "title": "فصلى وأقامني عن يمينه وذكر الحديث كذا في الأصل",
      "level": 1,
      "parent": null,
      "start_ms": 26,
      "end_ms": 26
    },
    "270": {
      "title": "136 -",
      "level": 1,
      "parent": null,
      "start_ms": 26,
      "end_ms": 26
    },
    "271": {
      "title": ": \" عليكم بالباه فمن لم يستطع فعليه بالصوم فإنه له وجاء \"",
      "level": 1,
      "parent": null,
      "start_ms": 26,
      "end_ms": 26
    },
    "272": {
      "title": "137 -",
      "level": 1,
      "parent": null,
      "start_ms": 26,
      "end_ms": 26
    },
    "273": {
      "title": ": \" الذبيح إسحاق \"",
      "level": 1,
      "parent": null,
      "start_ms": 26,
      "end_ms": 26
    },
    "274": {
      "title": "138 -",
      "level": 1,
      "parent": null,
      "start_ms": 26,
      "end_ms": 26
    },
    "275": {
      "title": ": \" من بنى لله مسجدا ولو كمفحص قطاة بنى الله له بيتا في الجنة \"",
      "level": 1,
      "parent": null,
      "start_ms": 26,
      "end_ms": 26
    },
    "276": {
      "title": "139 -",
      "level": 1,
      "parent": null,
      "start_ms": 26,
      "end_ms": 27
    },
    "277": {
      "title": ": \" من بنى لله مسجدا ولو مفحص قطاة بنى الله له بيتا في الجنة \"",
      "level": 1,
      "parent": null,
      "start_ms": 27,
      "end_ms": 27
    },
    "278": {
      "title": "140 -",
      "level": 1,
      "parent": null,
      "start_ms": 27,
      "end_ms": 27
    },
    "279": {
      "title": ": \" تفضل الصلاة التي يستاك لها على الصلاة التي لا يستاك لها سبعين ضعفا , ويفضل الذكر الخفي",
      "level": 1,
      "parent": null,
      "start_ms": 27,
      "end_ms": 27
    },
    "280": {
      "title": "141 -",
      "level": 1,
      "parent": null,
      "start_ms": 27,
      "end_ms": 27
    },
    "281": {
      "title": ": \" إذا سألتم الله فسلوه ببطون أكفكم ولا تسلوه بظهورها \"",
      "level": 1,
      "parent": null,
      "start_ms": 27,
      "end_ms": 27
    },
    "282": {
      "title": "142 -",
      "level": 1,
      "parent": null,
      "start_ms": 27,
      "end_ms": 27
    },
    "283": {
      "title": ": \" من خير الناس بعد رسول الله صلى الله عليه وسلم؟ قال: أبو بكر ثم عمر \"",
      "level": 1,
      "parent": null,
      "start_ms": 27,
      "end_ms": 27
    },
    "284": {
      "title": "143 -",
      "level": 1,
      "parent": null,
      "start_ms": 27,
      "end_ms": 27
    },
    "285": {
      "title": ": \" لا يقض القاضي بين اثنين وهو غضبان \"",
      "level": 1,
      "parent": null,
      "start_ms": 27,
      "end_ms": 27
    },
    "286": {
      "title": "144 -",
      "level": 1,
      "parent": null,
      "start_ms": 27,
      "end_ms": 27
    },
    "287": {
      "title": ": \" ثلاثة من الإيمان: الإنفاق من الإقتار , وإنصاف الناس من نفسك , وبذل السلام للعالم \" أخبرنا",
      "level": 1,
      "parent": null,
      "start_ms": 27,
      "end_ms": 28
    },
    "288": {
      "title": "146 -",
      "level": 1,
      "parent": null,
      "start_ms": 28,
      "end_ms": 28
    },
    "289": {
      "title": "فقد خرق ستر الله",
      "level": 1,
      "parent": null,
      "start_ms": 28,
      "end_ms": 28
    },
    "290": {
      "title": "147 -",
      "level": 1,
      "parent": null,
      "start_ms": 28,
      "end_ms": 28
    },
    "291": {
      "title": ": \" من أمن رجلا على نفسه فقتله فأنا بريء من القاتل وولي المقتول \"",
      "level": 1,
      "parent": null,
      "start_ms": 28,
      "end_ms": 28
    },
    "292": {
      "title": "148 -",
      "level": 1,
      "parent": null,
      "start_ms": 28,
      "end_ms": 28
    },
    "293": {
      "title": ": \" ما سابقت أبا بكر إلى خير قط , إلا سبقني إليه \"",
      "level": 1,
      "parent": null,
      "start_ms": 28,
      "end_ms": 28
    },
    "294": {
      "title": "149 -",
      "level": 1,
      "parent": null,
      "start_ms": 28,
      "end_ms": 28
    },
    "295": {
      "title": ": \" إن كففت عني وإلا قئتها \"",
      "level": 1,
      "parent": null,
      "start_ms": 28,
      "end_ms": 28
    },
    "296": {
      "title": "150 -",
      "level": 1,
      "parent": null,
      "start_ms": 28,
      "end_ms": null
