    },
    "2": {
      "title": ": \" إذا قرأ القارئ: {ولا الضالين} [الفاتحة: 7] قال: الذين خلفه: آمين , فوافق قولهم قول أهل",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "3": {
      "title": "2 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "4": {
      "title": ": \" الحج المبرور ليس له جزاء إلا الجنة , والعمرة إلى العمرة تكفر ما بينهما \"",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "5": {
      "title": "3 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "6": {
      "title": ": \" ألا أدلكم على كنز من كنوز الجنة؟ \" قالوا: بلى يا رسول الله , قال: \" تكثرون من قول: لا حول ولا",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "7": {
      "title": "4 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "8": {
      "title": ": \" الحج جهاد كل ضعيف \"",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "9": {
      "title": "5 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 2
    },
    "10": {
      "title": ": \" من ادان دينا وهو ينوي قضاءه كان له من الله عون فأنا ألتمس ذلك العون",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "11": {
      "title": "6 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "12": {
      "title": ": \" من أدرك ركعة من صلاة الفجر قبل أن تطلع الشمس فلم تفته , ومن أدرك ركعة من صلاة العصر قبل",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "13": {
      "title": "7 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "14": {
      "title": ": \" خيركم من تعلم القرآن وعلمه \" وأخذ بيدي فأقعدني في مجلسي أقرئ",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "15": {
      "title": "8 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "16": {
      "title": ": \" لينتقون كما ينتقى التمر من أغفاله , وليذهبن خياركم , وليبقين شراركم فموتوا إن",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "17": {
      "title": "9 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "18": {
      "title": ": يا ليتني كنت مكانك \". أبو حميد هذا اسمه عبد الرحمن بن سعد الأعرج المقعد , حدث عنه الزهري",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "19": {
      "title": "10 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 3
    },
    "20": {
      "title": ": {عن صلاتهم , ساهون} [الماعون: 5] قال: \" الترك لها \"",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "21": {
      "title": "11 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "22": {
      "title": "يأمرنا أن لا ننزعه ثلاثا إلا من جنابة ولكن من غائط أو بول أو نوم. قال: وجاءه رجل فناداه",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "23": {
      "title": "12 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "24": {
      "title": ": {فلولا أنه كان من المسبحين} [الصافات: 143] قال: من المصلين",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "25": {
      "title": "13 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "26": {
      "title": ": \" الصلاة في السفر ركعتان , من ترك الصلاة فقد كفر \"",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "27": {
      "title": "14 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "28": {
      "title": ": صلاة الجمعة ركعتان , والفطر ركعتان , والنحر ركعتان , والسفر ركعتان , تمام غير قصر على",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "29": {
      "title": "15 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 4
    },
    "30": {
      "title": ": قنت علي عليه السلام شهرا ثم أمسك , فسألته: يا أمير المؤمنين: لم أمسكت؟ فقال: ms03 ما كنت",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "31": {
      "title": "16 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "32": {
      "title": ": {ادعوني أستجب لكم} [غافر: 60] قال: \" يعني وحدوني بالربوبية أغفر لكم",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "33": {
      "title": "17 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "34": {
      "title": ": \" لا تنزلوا عبادي العارفين الموحدين المذنبين الجنة ولا النار حتى أكون أنا الله الذي أنزلهم",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "35": {
      "title": "18 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "36": {
      "title": ": \" ما من قوم فيهم رجل يعمل بالمعاصي , وهم أعز منه وأمنع لا يغيرون إلا أصابهم الله",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "37": {
      "title": "19 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "38": {
      "title": "نمسح على خفافنا لا نرى بذلك بأسا. فقال ابن عمر: وإن جاء من الغائط؟ قال:",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "39": {
      "title": "20 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 5
    },
    "40": {
      "title": ": \" أبو بكر في الجنة , وعمر في الجنة , وعلي في الجنة , وعثمان في الجنة , وسعد بن مالك في",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "41": {
      "title": "21 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "42": {
      "title": ": \" صلاة الجماعة أفضل من صلاة الفذ بسبع وعشرين درجة \"",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "43": {
      "title": "22 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "44": {
      "title": "قتل والله عثمان على غير وجه الحق \"",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "45": {
      "title": "23 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "46": {
      "title": ": \" ليس من أتى الإسلام طائعا كمن عصب رأسه بالسيف \"",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "47": {
      "title": "24 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 6
    },
    "48": {
      "title": ": \" ثلاث تستجاب لهم: الصائم حتى يفطر , والإمام العادل , ودعوة المظلوم ترفع فوق السحاب , ويقول",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "49": {
      "title": "25 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "50": {
      "title": ": \" تكفل الله لمن جاهد في سبيل الله لا يخرجه من بيته إلا الجهاد في سبيله , وتصديق كلمته أن",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "51": {
      "title": "26 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "52": {
      "title": "لوددت أنني أقاتل في سبيل الله فأقتل , ثم أحيا فأقتل , ثم أحيا فأقتل \". فقال أبو هريرة يقول",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "53": {
      "title": "27 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "54": {
      "title": ": \" يضحك الله إلى رجلين يقتل أحدهما الآخر , كلاهما يدخل الجنة , يقاتل هذا في سبيل الله فيقتل",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "55": {
      "title": "28 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "56": {
      "title": "لا يكلم أحد في سبيل الله - والله أعلم بمن يكلم في سبيله - إلا جاء يوم القيامة وجرحه يثعب",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "57": {
      "title": "29 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 7
    },
    "58": {
      "title": ": نهى النبي صلى الله عليه وسلم أن يجلس الرجل بين الرجلين إلا بإذنهما",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "59": {
      "title": "30 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "60": {
      "title": ": \" تخرج عنق من النار يوم القيامة فتقول: إني وكلت بكل جبار عنيد وبالمصورين \"",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "61": {
      "title": "31 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "62": {
      "title": ": تشددوا فإني أريد أن أقرأ عليكم ثلث القرآن قال: فيتمكن الرجل في مجلسه , ويشد من حبوته , ثم",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "63": {
      "title": "32 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "64": {
      "title": ": \" إنما أمرتم أن تطوفوا , فإن تيسر لكم فاستلموا \"",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "65": {
      "title": "33 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "66": {
      "title": ": \" لقد كان ناس يلتمسون أن يروه بعد السجدة فما يروه إلا قائما",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "67": {
      "title": "34 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "68": {
      "title": "اشترى من يهودي طعاما إلى سنة - هكذا في أصل كتابي - فرهنه درعا من حديد",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "69": {
      "title": "35 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 8
    },
    "70": {
      "title": ": \" إذا عطس أحدكم فليشمت ثلاثا , فما زاد فهو زكام \"",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "71": {
      "title": "36 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "72": {
      "title": ": \" ما أدركت أحدا ممن كنا نأخذ منه كان يفضل على أبي بكر وعمر أحدا بعد النبي صلى الله عليه",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "73": {
      "title": "37 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "74": {
      "title": ": \" لا يبولن أحدكم في الماء الدائم ثم يتوضأ منه \"",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "75": {
      "title": "38 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "76": {
      "title": ": \" أحب الطعام إلى الله ما كثرت عليه الأيدي \"",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "77": {
      "title": "39 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "78": {
      "title": "خلوا له عن جيرانه \"",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "79": {
      "title": "40 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "80": {
      "title": "فجوز في خطبته",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "81": {
      "title": "41 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 9
    },
    "82": {
      "title": ": \" أبهذا أمرتم؟ أم بهذا أرسلت لكم؟ إنما هلك من كان قبلكم حين تنازعوا في هذا الأمر. عزمت",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "83": {
      "title": "42 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "84": {
      "title": "وسترون بعدي أثرة في القسم والأمر , فاصبروا حتى تلقوني على الحوض \"",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "85": {
      "title": "43 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 10
    },
    "86": {
      "title": ": \" إذا شرب الخمرة فاضربوه , ثم إن عاد فاضربوه , ثم إن عاد الرابعة فاقتلوه \"",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "87": {
      "title": "44 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "88": {
      "title": "فرآهم يصنعون كما نراهم الآن فلم ينههم",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "89": {
      "title": "45 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "90": {
      "title": ": \" من صلى أربعا قبل الظهر وأربعا بعدها حرم على النار أن تأكله أبدا \"",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "91": {
      "title": "46 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "92": {
      "title": "قام من الليل , ثم توضأ وصلى ركعتين حتى صلى ست ركعات , ثم أوتر بثلاث",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "93": {
      "title": "47 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 11
    },
    "94": {
      "title": ": \" إنكم سترون ربكم كما ترون القمر ليلة البدر لا تضامون في رؤيته \"",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "95": {
      "title": "48 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "96": {
      "title": "يعتم بعمامة سوداء",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "97": {
      "title": "49 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "98": {
      "title": ": \" اللهم اغفر لي خطيئتي , وإسرافي في أمري , وما أنت أعلم به مني , اللهم اغفر لي هزلي وخطئي",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "99": {
      "title": "50 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "100": {
      "title": "لا ينتطح فيها عنزان \" فأرسلها مثلا",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "101": {
      "title": "51 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 12
    },
    "102": {
      "title": "\" الضبع صيد , فإذا أصابه المحرم ففيه كبش مسن وتؤكل \"",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "103": {
      "title": "52 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "104": {
      "title": ": لعن رسول الله صلى الله عليه وسلم زائرات القبور , والمتخذين عليها المساجد",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "105": {
      "title": "53 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "106": {
      "title": ": \" أفطر الحاجم والمحجوم \"",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "107": {
      "title": "54 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "108": {
      "title": ": \" إذا صلى أحدكم فليصل في نعليه , فإن خلعهما فليجعلهما بين رجليه , ولا يؤذ بهما",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "109": {
      "title": "55 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "110": {
      "title": "يوجز ويتم",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "111": {
      "title": "56 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "112": {
      "title": ": \" أيما امرأة أصابت بخورا فلا تشهد معنا العشاء الآخرة \"",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "113": {
      "title": "57 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "114": {
      "title": "صلى يجمع المغرب والعشاء بإقامة واحدة ثلاث ركعات وركعتين , ثم قال: رأيت رسول الله صلى الله",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 13
    },
    "115": {
      "title": "58 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "116": {
      "title": "يأكل البطيخ بالرطب",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "117": {
      "title": "59 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "118": {
      "title": ": \" من قال حين يصبح أو يمسي: اللهم إني أصبحت أشهدك وأشهد حملة عرشك وملائكتك وجميع خلقك أنك",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "119": {
      "title": "60 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "120": {
      "title": ": \" عرفة كلها موقف , فارفعوا عن بطن عرنة , والمزدلفة كلها موقف , فارفعوا عن بطن",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "121": {
      "title": "61 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "122": {
      "title": ": \" من كذب بعذاب القبر عذبه الله , ومن كذب بالحوض فلا سقاه الله منه , ومن كذب بشفاعتي فلا",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "123": {
      "title": "62 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 14
    },
    "124": {
      "title": ": \" إن الله يغار , والمؤمن يغار , وغيرة الله أن يأتي المؤمن ما حرم الله ms13 \"",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "125": {
      "title": "63 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "126": {
      "title": "سلوا الله العفو والعافية \"",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "127": {
      "title": "64 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "128": {
      "title": ": \" ما قبض نبي إلا دفن حيث يقبض \"",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "129": {
      "title": "65 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "130": {
      "title": "نهى أن يبال في الماء الدائم ويغتسل فيه من الجنابة",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "131": {
      "title": "66 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "132": {
      "title": ": كأني أنظر إلى وبيض خاتم رسول الله صلى الله عليه وسلم في يده اليسرى وهو",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "133": {
      "title": "67 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 15
    },
    "134": {
      "title": "فلا يغمس يده في وضوئه؛ فإنه لا يدري أين باتت يده ms14 \"",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "135": {
      "title": "68 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "136": {
      "title": "إذا ولغ فيه الكلب أن يغسله سبع مرات أولاهن بالتراب \"",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "137": {
      "title": "69 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "138": {
      "title": ": \" لبيك اللهم لبيك , لبيك لا شريك لك لبيك , إن الحمد والنعمة لك والملك , لا شريك",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "139": {
      "title": "70 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "140": {
      "title": "نهى عن الوصال في الصوم",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "141": {
      "title": "71 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "142": {
      "title": ": \" إذا كان النصف من شعبان فلا تصوموا \"",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "143": {
      "title": "72 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "144": {
      "title": ": \" صل الصلاة لوقتها , ثم ائتهم فإن كانوا قد صلوا كنت قد أحرزت صلاتك , وإن لم يكونوا صلوا",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "145": {
      "title": "73 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "146": {
      "title": "نهيتكم عن نبيذ الجر، وإني كنت نهيتكم عن زيارة القبور، وإني كنت نهيتكم عن لحوم الأضاحي،",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 16
    },
    "147": {
      "title": "74 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "148": {
      "title": "في ثوب واحد",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "149": {
      "title": "75 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "150": {
      "title": ": \" مهنة إحداكن في بيتها تدرك بها عمل المجاهدين في سبيل الله \"",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "151": {
      "title": "76 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "152": {
      "title": "فانتشل عظما منها فأكل ثم صلى ولم يتوضأ",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "153": {
      "title": "فبال قائما ثم توضأ ومسح على خفيه",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "154": {
      "title": "78 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "155": {
      "title": "-: \" ألا إني لا أحل المسجد لجنب ولا حائض إلا لمحمد وأزواجه , وعلي وفاطمة , ألا هل بينت لكم",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "156": {
      "title": "79 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 17
    },
    "157": {
      "title": "قضى في السيل المهزور أن يمسك ms16 حتى يبلغ الكعبين ثم يرسل الأعلى على",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "158": {
      "title": "80 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "159": {
      "title": ": \" رأيت الجنة والنار دون هذا الحائط فلم أر مثل الخير والشر \"",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "160": {
      "title": "81 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "161": {
      "title": ": \" من شرب الخمر لم يقبل الله له صلاة سبعا , فإن مات فيها مات كافرا , وإن أذهبت عقله عن شيء",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "162": {
      "title": "82 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "163": {
      "title": "{له دعوة الحق} [الرعد: 14] قال: \" لا إله إلا الله \"",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "164": {
      "title": "83 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "165": {
      "title": ": {هل يستوي الأعمى والبصير} [الأنعام: 50] قال: \" المؤمن والكافر \"",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "166": {
      "title": "84 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "167": {
      "title": ": \" من السنة إذا جلس الرجل أن يخلع نعليه فيضعهما بجنبه \"",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "168": {
      "title": "85 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 18
    },
    "169": {
      "title": "تقود الخيل بأزمتها \"",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "170": {
      "title": "86 -",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "171": {
      "title": ": \" ليس الخبر كالمعاينة \"",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "172": {
      "title": "87 -",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "173": {
      "title": ": أحب للناس ما تحب لنفسك \"",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "174": {
      "title": "88 -",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "175": {
      "title": "\" لا يؤمن أحدكم حتى يحب لأخيه ما يحب لنفسه \"",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "176": {
      "title": "89 -",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "177": {
      "title": "نأكل ونحن نمشي ونشرب ونحن قيام",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "178": {
      "title": "90 -",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "179": {
      "title": "خير أهل السماوات وخير أهل الأرض , وخير الأولين وخير الآخرين إلا المؤمنين",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "180": {
      "title": "91 -",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 19
    },
    "181": {
      "title": ": \" علي أقضى أمتي بكتاب الله فمن أحبني فليحبه , فإن العبد لا ينال ولايتي إلا بحب علي عليه",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "182": {
      "title": "92 -",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "183": {
      "title": ": \" لو رأيتم معاوية لقلتم هذا المهدي \"",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "184": {
      "title": "93 -",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "185": {
      "title": "ويأكل من طعامه , فأتى النبي صلى الله عليه وسلم يوما وعنده عائشة ورأسه في حجرها فقال له",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "186": {
      "title": "94 -",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "187": {
      "title": "وأكلت معه خبزا ولحما - أو قال: ثريدا - فقلت: غفر الله لك يا رسول الله قال: \" ولك \" قال: فقلت",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "188": {
      "title": "95 -",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "189": {
      "title": ": \" الشؤم في الفرس والدار والمرأة \"",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "190": {
      "title": "96 -",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 20
    },
    "191": {
      "title": ": \" من فطر صائما في رمضان من كسب حلال صلت عليه الملائكة أيام رمضان كلها , وصافحه جبريل ليلة",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "192": {
      "title": "97 -",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "193": {
      "title": "كان يسدل العمامة بين كتفيه",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "194": {
      "title": "98 -",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "195": {
      "title": "صيام يوم الجمعة إلا بيوم قبله أو بيوم بعده",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "196": {
      "title": "99 -",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "197": {
      "title": "يتلقى الجلب , فإن تلقاه متلق فصاحبه بالخيار إذا دخل السوق",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "198": {
      "title": "100 -",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "199": {
      "title": ": \" الناس تبع لقريش , خيارهم تبع لخيارهم , وشرارهم تبع لشرارهم \"",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "200": {
      "title": "101 -",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "201": {
      "title": ": \" لا تقوم الساعة حتى يكثر المال ويقبض العلم , ويخرج الرجل زكاة ماله فلا يجد من يقبلها منه",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 21
    },
    "202": {
      "title": "102 -",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "203": {
      "title": "باع مدبرا",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "204": {
      "title": "103 -",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "205": {
      "title": "أنه جمع بين الصلاتين بجمع وقال: رأيت النبي صلى الله عليه وسلم فعله",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "206": {
      "title": "104 -",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "207": {
      "title": ": \" إن أحب الأعمال إلى الله ما دام صاحبه وإن قل \"",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "208": {
      "title": "105 -",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "209": {
      "title": ": \" عسقلان أحد العروسين , يبعث الله منها يوم القيامة سبعين ألفا وفودا شهداء إلى الله , وبها",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "210": {
      "title": "106 -",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "211": {
      "title": ": \" إذا دعوتم الله فاعزموا , ولا يقل قائلكم , يا رب إن شئت \"",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "212": {
      "title": "107 -",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 22
    },
    "213": {
      "title": "نهى ms21 عن النجش",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 22
    },
    "214": {
