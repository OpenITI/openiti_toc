{
  "filename": "0329IbnMuhammadMarwaziHamid.Muntaqa.Shamela0005776-ara1",
  "sections": {
    "1": {
      "title": "من",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "2": {
      "title": "الجزء",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "3": {
      "title": "1 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "4": {
      "title": "-: \" إنها لحابستنا؟ \" قالت عائشة: إنها قد أفاضت. قال: فلتنفر إذا \".",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "5": {
      "title": "2 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "6": {
      "title": "- قال: \" ليس على المرء المسلم في فرسه ولا مملوكه صدقة \".",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "7": {
      "title": "3 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "8": {
      "title": "-، قالوا: قال رسول الله -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "9": {
      "title": "4 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "10": {
      "title": "- \" لبس خاتما نقشه: محمد",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 2
    },
    "11": {
      "title": "-، فكان إذا دخل الخلاء وضعه \". قال: وقال طاوس: إنما لبسه يوما واحدا .",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "12": {
      "title": "5 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "13": {
      "title": "- أن يعجل قبل رمضان بصوم يوم أو يومين.",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "14": {
      "title": "6 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "15": {
      "title": "- \" نهى أن يتنفس في الإناء، وأن يمس الرجل ذكره بيمينه، وأن يستطيب بيمينه \".",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "16": {
      "title": "7 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "17": {
      "title": "- والناس يسألونه، فقال رجل: يا رسول الله {ذبحت قبل أن أحلق، قال: \" لا حرج \"، وكان يقول: \" لا حرج، لا حرج \". فقال رجل: يا رسول الله} ما خير ما أعطي الناس؟ قال: \" خلق حسن \". قالوا: نتداوى؟ ! قال: نعم؛ إن الله لم ينزل داء إلا أنزل",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "18": {
      "title": "8 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "19": {
      "title": "-: \" ابردوا بالظهر في الحر \".",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "20": {
      "title": "9 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "21": {
      "title": "- \" نهى عن الدباء، والنقير، والمزفت \".",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "22": {
      "title": "10 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "23": {
      "title": "يتبدى",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "24": {
      "title": "11 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 3
    },
    "25": {
      "title": "- لم يجعل لها سكنى ولا نفقة. فأخذ الأسود حصى فحصبه ثم قال: تحدث بمثل هذا؟ قال عمر: لا نترك كتاب ربنا وسنة نبينا لقول امرأة حفظت أم نسيت. لها السكنى والنفقة؛ قال الله تبارك وتعالى: {لا تخرجوهن من بيوتهن ولا يخرجن إلا أن يأتين بفاحشة",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "26": {
      "title": "12 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "27": {
      "title": "- صدقة رمضان، صاع من شعير، أو صاع من تمر. قال ابن عمر: فعدل المسلمون ذلك بمدين من قمح.",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "28": {
      "title": "13 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "29": {
      "title": "أن: لا تنتفعوا من الميتة بإهاب ولا عصب",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "30": {
      "title": "14 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "31": {
      "title": "-: \" اللحد لنا، والشق لغيرنا.",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "32": {
      "title": "15 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "33": {
      "title": "- خرج على أرض بهم فقال: \" لمن هذه؟ \" فقالوا: اكتراها فلان. قال: \" أما إنه لو منحها إياه كان خيرا له من أن يأخذ عليها خرجا معلوما \".",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "34": {
      "title": "16 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 4
    },
    "35": {
      "title": "- قال: \" إن أخاكم النجاشي قد مات، فصلوا عليه \". فقام رسول الله -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "36": {
      "title": "17 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "37": {
      "title": "-: \" لا نذر في معصية الله عز وجل، وكفارته كفارة يمين \".",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "38": {
      "title": "18 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "39": {
      "title": "-: \" إذا صلى أحدكم فلم يدر كم صلى أثلاثا أم أربعا، فليصل ركعة ثم يسجد سجدتين وهو جالس، فإن كانت الركعة خامسة كانت السجدتان ترغيما للشيطان \".",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "40": {
      "title": "19 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "41": {
      "title": "وهو يبول، فلم يرد عليه السلام حتى توضأ",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "42": {
      "title": "20 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "43": {
      "title": "يقرأ يوم الجمعة في الفجر ب \" تنزيل السجدة وهل أتى ة على الإنسان \".",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "44": {
      "title": "21 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "45": {
      "title": "- نحوه.",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "46": {
      "title": "22 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 5
    },
    "47": {
      "title": "23 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "48": {
      "title": "- فقال: يا رسول الله!",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "49": {
      "title": "-: \" تم صومك؛ فإن الله أطعمك وسقاك \".",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "50": {
      "title": "24 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "51": {
      "title": "- قال: \" رؤيا المؤمن جزء من سبعين جزءا من النبوة \".",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "52": {
      "title": "25 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "53": {
      "title": "لم",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "54": {
      "title": "- قال: \" أيما نخل بيع أصولها، فثمرتها للذي أبرها، إلا أن يشترط المبتاع \".",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "55": {
      "title": "26 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "56": {
      "title": "لم",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 6
    },
    "57": {
      "title": "- ثم قال لنا: \" إن الله قد أتم صلاتكم \"، فقالوا: يا رسول الله {إن فلانا لم يصل معنا. قال: فقال: \" ما منعك أن تصلي؟ \" قال: يا رسول الله} أصابتني جنابة. قال: \" فتيمم الصعيد فصله، فإذا قدرت على الماء فاغتسل \". قال: وبعث رسول الله -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "58": {
      "title": "- ابتدرناه بالماء.",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "59": {
      "title": "قالت: أمجنون قريش؟ قالوا: إنه ليس بمجنون، ولكنه رسول الله -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "60": {
      "title": "فأمر بالبعير فأنيخ، وحل المزادة من أعلاها، ثم دعا بإناء عظيم فملأ من الماء، ثم دفعه إلى الجنب، فقال: \" اذهب فاغتسل \"، فقال: \" وأيم الله ما ترك لنا من مزادة ولا قربة ولا إداوة ولا إناء إلا ملأه من الماء وهي تنظر. ثم قال: \" شدوا",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 7
    },
    "61": {
      "title": "- يغير على من حولهم وهم آمنون، فقالت المرأة لقومها: أي قوم! والله ما أرى هذا الرجل إلا قد شكر لكم ما أخذ من مائكم؛ ألا ترون أنه يغار على ما حولكم وأنتم آمنون لا يغار عليكم؟ هل لكم في خير؟ قالوا: وما هو؟ قالت: نأتي رسول الله -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "62": {
      "title": "فأسلموا",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "63": {
      "title": "27 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "64": {
      "title": "- احتجم وأعطى الحجام أجره، ولو كان خبيثا لم يعطه.",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "65": {
      "title": "28 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "66": {
      "title": "-، فأتاه عين المشركين، فجلس يتغدى مع رسول الله -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "67": {
      "title": "- وانطلق هاربا. فقال: \" من أدركه فله سلبه \". قال سلمة: وكنت رجلا حسن العدو، فاتبعته حتى أخذت بخطام الناقة فقلت: إخ إخ. فبركت به، وقد كرهت أن أعقرها، فضربته ثم احتززت رأسه، فجئت به رسول الله -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "68": {
      "title": "29 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "69": {
      "title": "- كان يفتح القراءة \" بالحمد لله رب العالمين \".",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "70": {
      "title": "30 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "71": {
      "title": "31 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 8
    },
    "72": {
      "title": "-: \" يرحم الله عبدا سمع مقالتي فحملها؛ فرب حامل فقه ليس بفقيه، ورب حامل فقه إلى من هو أفقه منه. ثلاث لا يغل عليهن قلب مؤمن: إخلاص العمل لله، ومناصحة ولاة المسلمين، ولزوم جماعة المسلمين \".",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "73": {
      "title": "32 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "74": {
      "title": "-، لا أحتاج فيهما إلى أحد من الناس: صلاة الإمام خلف رجل من رعيته؛ وقد رأيت رسول الله -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "75": {
      "title": "- يفعله \".",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "76": {
      "title": "33 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "77": {
      "title": "- قنت في المغرب والفجر.",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "78": {
      "title": "34 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "79": {
      "title": "- قال: \" لا نذر في معصية الله عز وجل \".",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "80": {
      "title": "35 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "81": {
      "title": "- إليهم وهم رافعو أيديهم في الصلاة؛ فقال: \" مالكم رافعو أيديكم كأنها أذناب خيل شمس {} اسكنوا في الصلاة \".",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "82": {
      "title": "36 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 9
    },
    "83": {
      "title": "- قال: \" لينتهين أقوام يرفعون أبصارهم إلى السماء أو لا ترجع إليهم \".",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "84": {
      "title": "37 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "85": {
      "title": "-: \" ألا تصفون كما تصف الملائكة عند ربهم؟ \"، قال: \" يتمون الصفوف، ويتراصون في الصف \".",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "86": {
      "title": "38 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "87": {
      "title": "- على قبر منبوذ فصلى عليه وصليت معه.",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "88": {
      "title": "39 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "89": {
      "title": "- صلى؛ فقام في الركعتين، فسبحوا، فلما فرغ من صلاته سجد سجدتين السهو، ثم سلم.",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "90": {
      "title": "40 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "91": {
      "title": "- قال: \" لا سمر بعد العشاء إلا لمصل أو مسافر \".",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "92": {
      "title": "41 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "93": {
      "title": "- يضحي بالمدينة بالجزور وبالكبش إذا لم يكن جزور.",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "94": {
      "title": "42 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "95": {
      "title": "-، فما نؤمر بشيء إلا فعلناه.",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "96": {
      "title": "43 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "97": {
      "title": "- قال: \" إذا حضرت الصلاة وحضر العشاء فابدءوا بالعشاء \".",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "98": {
      "title": "44 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 10
    },
    "99": {
      "title": "- قال: \" صلاة الليل مثنى مثنى، والوتر ركعة، وصلاة المغرب وتر النهار \".",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "100": {
      "title": "45 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "101": {
      "title": "-: \" يقطع الصلاة الكلب الأسود، والحمار، والمرأة \".",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "102": {
      "title": "46 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "103": {
      "title": "- استسقى، فاستقبل القبلة وحول رداءه الأيمن الأيسر، وجعل الأيسر الأيمن.",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "104": {
      "title": "47 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "105": {
      "title": "- وقف على الجمرة القصوى، فسئل عن رجل زار البيت قبل أن يرمي. قال: يرمي ولا حرج \". وسئل عن رجل حلق قبل أن يذبح، فقال: يذبح ولا حرج \". فما سئل يومئذ عن شيء قدم ولا أخر إلا قال: \" لا حرج \".",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "106": {
      "title": "48 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "107": {
      "title": "-: \" لا طلاق إلا بعد ملك، ولا عتاق إلا من بعد ملك \".",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "108": {
      "title": "49 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "109": {
      "title": "-، فأمر رسول الله -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 11
    },
    "110": {
      "title": "50 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "111": {
      "title": "- عام الفتح من الثنية العليا التي أعلى مكة.",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "112": {
      "title": "51 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "113": {
      "title": "- قال: \" اعتدلوا في السجود، ولا يبسط أحدكم ذراعيه بسط الكلب \".",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "114": {
      "title": "52 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "115": {
      "title": "-، فيكون لكم المهنى وعلي الإثم؟ أشهد لسمعت رسول الله -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "116": {
      "title": "53 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "117": {
      "title": "- \" \" ليس في حب ولا تمر صدقة [حتى يبلغ خمسة أوسق، ولا فيما دون خمس ذود صدقة، ولا فيما دون خمس أواق صدقة] \".",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "118": {
      "title": "ومن",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "119": {
      "title": "الجزء",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "120": {
      "title": "1 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "121": {
      "title": "- كتب إلى الضحاك بن سفيان أن يورث امرأة أشيم الضبابي من ديته.",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "122": {
      "title": "2 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 12
    },
    "123": {
      "title": "- من إناء واحد.",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "124": {
      "title": "3 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "125": {
      "title": "-: \" إزرة المؤمن إلى أنصاف الساق، وأسفل من ذلك إلى فوق الكعبين، فما كان أسفل من الكعبين ففي النار \".",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "126": {
      "title": "4 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "127": {
      "title": "5 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "128": {
      "title": "- قال له: يا رسول الله {ما الإيمان؟ قال: \" تشهد أن لا إله إلا الله وأن محمدا رسول الله، وتقيم الصلاة، وتؤتي الزكاة، وتحج البيت، وتحب للمسلم ما تحب لنفسك وأهل بيتك، وتكره للمسلمين ما تكره بنفسك \".",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "129": {
      "title": "6 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "130": {
      "title": "-: \" لا حلب ولا جنب في الرهان، ولا شعار. ومن انتهب فليس مني \".",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "131": {
      "title": "7 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 13
    },
    "132": {
      "title": "- كان يسمع الصبي وهو في الصلاة فيخفف.",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "133": {
      "title": "8 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "134": {
      "title": "- قال: \" إن أدنى أهل النار عذابا من يجعل له نعلان من نار، يغلي منهما دماغه \".",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "135": {
      "title": "9 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "136": {
      "title": "- قال: \" من كان يؤمن بالله واليوم الآخر فليكرم ضيفه، من كان يؤمن بالله واليوم الآخر فليكرم جاره، من كان يؤمن بالله واليوم الآخر فليقل خيرا أو يسكت \".",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "137": {
      "title": "10 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "138": {
      "title": "-: \" ذروني ما تركتكم؛ فإنما أهلك من كان قبلكم بسؤالهم واختلافهم، فما نهيتكم عنه، فانتهوا، وما أمرتكم به فخذوا ما استطعتم \".",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "139": {
      "title": "11 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "140": {
      "title": "- قال: \" إذا تصدقت المرأة من بيت زوجها كتب لها أجر وللزوج مثل ذلك \".",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "141": {
      "title": "12 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "142": {
      "title": "-؛ أنه ركع دون الصف، فقال له النبي -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "143": {
      "title": "13 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "144": {
      "title": "- يقول: \" إذا كان بأحدكم رز فليتوضأ \".",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "145": {
      "title": "14 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "146": {
      "title": "-: \" إن بلالا يؤذن بليل، فكلوا واشربوا حتى يؤذن ابن أم مكتوم \".",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "147": {
      "title": "15 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 14
    },
    "148": {
      "title": "16 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "149": {
      "title": "- نهى عن المثلة.",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "150": {
      "title": "17 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "151": {
      "title": "- كان يفتتح القراءة \" بالحمد لله رب العالمين \".",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "152": {
      "title": "18 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "153": {
      "title": "- في عمره رمضان، فأفطر النبي -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "154": {
      "title": "-[وأتممت] ، فلما قدمنا قلت: يا رسول الله",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "155": {
      "title": "-: \" أحسنت يا عائشة \".",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "156": {
      "title": "19 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "157": {
      "title": "-: \" إن الذي يتخطى رقاب الناس يوم الجمعة ويفرق بين اثنين والإمام يخطب، كالجار قصبه في النار \".",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "158": {
      "title": "20 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "159": {
      "title": "- عن بيع الحيوان نسيئة.",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "160": {
      "title": "21 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "161": {
      "title": "- قال: \" إذا استجمر أحدكم فليستجمر ثلاثا \".",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "162": {
      "title": "22 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 15
    },
    "163": {
      "title": "- يقول: \" من أوى إلى فراشه طاهرا يذكر الله عز وجل حتى يدركه النعاس، لم ينقلب ساعة من الليل يسأل الله عز وجل فيها شيئا من خير الدنيا والآخرة، إلا أعطاه إياه \".",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "164": {
      "title": "23 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "165": {
      "title": "- الألد الخصم.",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "166": {
      "title": "24 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "167": {
      "title": "-: \" بادروا بالأعمال ستا قبل طلوع الشمس من مغربها، والدجال، والدخان، ودابة الأرض، وخويصة أحدكم، وأمر العامة \".",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "168": {
      "title": "25 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "169": {
      "title": "- قال: \" من يعمل سوءا يجز به \" في آخر الأمر \"، فجدع ابن الزبير، فقلت: إن يك ذا.",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "170": {
      "title": "26 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "171": {
      "title": "- ربه في الدنيا.",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "172": {
      "title": "27 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "173": {
      "title": "- ربه بقلبه.",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "174": {
      "title": "28 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "175": {
      "title": "- قال: \" لا نذر في معصية الله \".",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "176": {
      "title": "29 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 16
    },
    "177": {
      "title": "30 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "178": {
      "title": "31 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "179": {
      "title": "-: \" لا حلب ولا جنب في الرهان، ولا شعار. ومن انتهب فليس مني \".",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "180": {
      "title": "32 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "181": {
      "title": "33 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "182": {
      "title": "34 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "183": {
      "title": "35 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 17
    },
    "184": {
      "title": "36 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "185": {
      "title": "37 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "186": {
      "title": "-: \" كل مسكر حرام \".",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "187": {
      "title": "38 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "188": {
      "title": "-: \" إذا صليت فلا تبزقن بين يديك ولا عن يمينك، ولكن تلقاء شمالك إن كان فارغا أو تحت نعلك \".",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "189": {
      "title": "39 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "190": {
      "title": "-: \" ثلاث من فعلهن ثقة بالله واحتسابا، كان حقا على الله أن يعينه وأن يبارك له: من سعى في فكاك رقبة ثقة بالله واحتسابا كان حقا على الله أن يعينه وأن يبارك له، ومن تزوج ثقة بالله واحتسابا كان حقا على الله أن يعينه وأن يبارك له، ومن",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "191": {
      "title": "40 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "192": {
      "title": "-: \" أنا لك كأبي زرع لأم زرع \".",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "193": {
      "title": "41 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "194": {
      "title": "- نهى عن المثلة.",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "195": {
      "title": "42 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 18
    },
    "196": {
      "title": "- أمر بقطع الجرس.",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "197": {
      "title": "43 -",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "198": {
      "title": "44 -",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "199": {
      "title": "- في عمرة رمضان، فأفطر النبي -",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "200": {
      "title": "- وأتممت، فلما قدمنا قلت: يا رسول الله -",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": null
    }
  },
