    },
    "3": {
      "title": "[2] قطب [تقسيمات الواجب]",
      "level": 3,
      "parent": 2,
      "start_ms": 2,
      "end_ms": 3
    },
    "4": {
      "title": "[3] قطب السنة والندب والتطوع والمستحب والنفل والفضل والإحسان ألفاظ مترادفة،",
      "level": 3,
      "parent": 2,
      "start_ms": 3,
      "end_ms": 5
    },
    "5": {
      "title": "[4] قطب الوقت نفسه قد يكون سببا،",
      "level": 3,
      "parent": 2,
      "start_ms": 5,
      "end_ms": 7
    },
    "6": {
      "title": "[5] قطب متعلق الحكم مقصدان: نفس المصلحة أو المفسدة في نفسه، ووسيلة هي الطريق المفضي إلى أحدهما،",
      "level": 3,
      "parent": 2,
      "start_ms": 7,
      "end_ms": 8
    },
    "7": {
      "title": "[6] قطب البناء على الأصل متعين،",
      "level": 3,
      "parent": 2,
      "start_ms": 8,
      "end_ms": 8
    },
    "8": {
      "title": "[7] قطب كون المشقة سببا في اليسر جاءت له الرخص الشرعية كلها كالتقية،",
      "level": 3,
      "parent": 2,
      "start_ms": 8,
      "end_ms": 9
    },
    "9": {
      "title": "[8] قطب نفي الضرر سبب لشرعية الحكم، كصلح الكفار عند العجز عن المقاومة،",
      "level": 3,
      "parent": 2,
      "start_ms": 9,
      "end_ms": 10
    },
    "10": {
      "title": "[9] قطب اللفظ اما دال على الكلي أو على الكل، فاما في الثبوت أو النفي.",
      "level": 3,
      "parent": 2,
      "start_ms": 10,
      "end_ms": 12
    },
    "11": {
      "title": "[10] قطب إذا اختلف السبب والحكم في المطلق والمقيد فلا حمل إجماعا،",
      "level": 3,
      "parent": 2,
      "start_ms": 12,
      "end_ms": 15
    },
    "12": {
      "title": "[11] قطب وقع في كثير من الأحكام العمل بالأصلين المتنافيين،",
      "level": 3,
      "parent": 2,
      "start_ms": 15,
      "end_ms": 16
    },
    "13": {
      "title": "[12] قطب قصر الحكم على مدلول اللفظ من قضايا الأصل فلا يعدي عنه،",
      "level": 3,
      "parent": 2,
      "start_ms": 16,
      "end_ms": 18
    },
    "14": {
      "title": "[13] قطب الإنشاء: قول يوجبه مدلوله في نفس الأمر، ويوجد المراد به .",
      "level": 3,
      "parent": 2,
      "start_ms": 18,
      "end_ms": 19
    },
    "15": {
      "title": "[14] قطب إذا تعلق الأمر بالأعيان ذوات الأجزاء وجب استيعابها،",
      "level": 3,
      "parent": 2,
      "start_ms": 19,
      "end_ms": 21
    },
    "16": {
      "title": "[15] قطب حمل المطلق على المقيد اعمال للدليلين،",
      "level": 3,
      "parent": 2,
      "start_ms": 21,
      "end_ms": 22
    },
    "17": {
      "title": "[16] قطب الخبر المحتف بالقرائن يصح الاعتماد عليه لأجل القرينة المنضمة اليه،",
      "level": 3,
      "parent": 2,
      "start_ms": 22,
      "end_ms": 24
    },
    "18": {
      "title": "[17] قطب كل حكم شرعي قصد منه الآخرة لجلب نفع أو دفع ضرر عبادة،",
      "level": 3,
      "parent": 2,
      "start_ms": 24,
      "end_ms": 25
    },
    "19": {
      "title": "[18] قطب الجزم في النية وجميع مشخصاتها واجب، فيبطلها الترديد إجماعا،",
      "level": 3,
      "parent": 2,
      "start_ms": 25,
      "end_ms": 27
    },
    "20": {
      "title": "[19] قطب يصح إيقاع نية عبادة في أثناء اخرى،",
      "level": 3,
      "parent": 2,
      "start_ms": 27,
      "end_ms": 29
    },
    "21": {
      "title": "[20] قطب التحرز من الرياء واجب،",
      "level": 3,
      "parent": 2,
      "start_ms": 29,
      "end_ms": 31
    },
    "22": {
      "title": "[21] قطب اكتفاء الشارع بالاستجمار في إزالة نجاسة المخرج من باب الرخصة",
      "level": 3,
      "parent": 2,
      "start_ms": 31,
      "end_ms": 34
    },
    "23": {
      "title": "[22] قطب قد عرفت انقسام الخطاب الى تكليف ووضع، هو نصب الأسباب،",
      "level": 3,
      "parent": 2,
      "start_ms": 34,
      "end_ms": 36
    },
    "24": {
      "title": "[23] قطب الموالاة في الصلاة شرط في صحتها إجماعا،",
      "level": 3,
      "parent": 2,
      "start_ms": 36,
      "end_ms": 38
    },
    "25": {
      "title": "[24] قطب الزكاة ان لم تتعلق بالمال ففطرة،",
      "level": 3,
      "parent": 2,
      "start_ms": 38,
      "end_ms": 40
    },
    "26": {
      "title": "[25] قطب لا يقر أحد من أهل الكفر على دينه،",
      "level": 3,
      "parent": 2,
      "start_ms": 40,
      "end_ms": 41
    },
    "27": {
      "title": "[26] قطب يجب الأمر بالمعروف والنهي عن المنكر إجماعا،",
      "level": 3,
      "parent": 2,
      "start_ms": 41,
      "end_ms": 43
    },
    "28": {
      "title": "[27] قطب المداهنة من أعظم المعاصي،",
      "level": 3,
      "parent": 2,
      "start_ms": 43,
      "end_ms": 44
    },
    "29": {
      "title": "[28] قطب تحريم الغيبة ثابت بالنص،",
      "level": 3,
      "parent": 2,
      "start_ms": 44,
      "end_ms": 46
    },
    "30": {
      "title": "[29] قطب إذا تزاحمت الحقوق فحق المؤقتة مقدم عند ضيق وقتها على الكل،",
      "level": 3,
      "parent": 2,
      "start_ms": 46,
      "end_ms": 49
    },
    "31": {
      "title": "[30] قطب لا يجوز ان يبنى على فعل الغير في العبادة إلا في ما يقبل النيابة.",
      "level": 3,
      "parent": 2,
      "start_ms": 49,
      "end_ms": 51
    },
    "32": {
      "title": "[31] قطب الملك: حكم شرعي مقدر في عين أو منفعة،",
      "level": 3,
      "parent": 2,
      "start_ms": 51,
      "end_ms": 53
    },
    "33": {
      "title": "[32] قطب انما يقع اثر العقد في الأعيان والمنافع إذا صدر عن مالك له،",
      "level": 3,
      "parent": 2,
      "start_ms": 53,
      "end_ms": 55
    },
    "34": {
      "title": "[33] قطب اللزوم في العقود أصل معتبر في جميعها،",
      "level": 3,
      "parent": 2,
      "start_ms": 55,
      "end_ms": 57
    },
    "35": {
      "title": "[34] قطب البيع قد يوصف بالوجوب فيما إذا توقف عليه واجب،",
      "level": 3,
      "parent": 2,
      "start_ms": 57,
      "end_ms": 61
    },
    "36": {
      "title": "[35] قطب القرض عقد مستقل شرعي مجمع على صحته،",
      "level": 3,
      "parent": 2,
      "start_ms": 61,
      "end_ms": 62
    },
    "37": {
      "title": "[36] قطب الأمانة نسبة حكمية إلى يد غير المالك مقتضاها عدم الضمان،",
      "level": 3,
      "parent": 2,
      "start_ms": 62,
      "end_ms": 65
    },
    "38": {
      "title": "[37] قطب تعلق الشيء بغيره في الأحكام: اما لأخذه منه، أو لاستيثاقه به.",
      "level": 3,
      "parent": 2,
      "start_ms": 65,
      "end_ms": 68
    },
    "39": {
      "title": "[38] قطب النكاح تلحقه الأحكام الخمسة:",
      "level": 3,
      "parent": 2,
      "start_ms": 68,
      "end_ms": 73
    },
    "40": {
      "title": "[39] قطب يترتب على البكارة ثبوت الولاية على قول، واستحباب انكاحها،",
      "level": 3,
      "parent": 2,
      "start_ms": 73,
      "end_ms": 76
    },
    "41": {
      "title": "[40] قطب أسباب الفرقة: الطلاق، والخلع، والمبارأة، والفسوخ بأسبابها.",
      "level": 3,
      "parent": 2,
      "start_ms": 76,
      "end_ms": 78
    },
    "42": {
      "title": "[41] قطب الموروث هو المال وما يتبعه، وحقوق العقوبات والمنافع.",
      "level": 3,
      "parent": 2,
      "start_ms": 78,
      "end_ms": 83
    },
    "43": {
      "title": "[42] قطب الوطء المحرم المقترن بعلم التحريم يوجب الحد،",
      "level": 3,
      "parent": 2,
      "start_ms": 83,
      "end_ms": 86
    },
    "44": {
      "title": "[43] قطب العافي عن القصاص إلى الدية قد يعرض له ما يمنعه عن أخذها،",
      "level": 3,
      "parent": 2,
      "start_ms": 86,
      "end_ms": 89
    },
    "45": {
      "title": "[44] قطب إذا تعذر الحاكم فهل للآحاد تولية آحاد الأحكام؟ اشكال.",
      "level": 3,
      "parent": 2,
      "start_ms": 89,
      "end_ms": 92
    },
    "46": {
      "title": "[45] قطب المدعى قد يكون حقا ولكن ينفع فيه، ففي سماعه حينئذ إشكال،",
      "level": 3,
      "parent": 2,
      "start_ms": 92,
      "end_ms": 95
    },
    "47": {
      "title": "[46] قطب اليمين الواجبة على المدعي بنكول المنكر،",
