    "20": {
      "title": "باب الرجل يرى المنكر الغليظ فلا يقدر أن ينهي عنه، ويرى منكرا صغيرا يقدر أن ينهي عنه، كيف العمل فيهما؟",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "21": {
      "title": "باب ما ينبغي للرجل أن يفعل ويعدل في أمره ونهيه في القريب والبعيد",
