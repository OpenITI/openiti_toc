      "start_ms": 2,
      "end_ms": 2
    },
    "13": {
      "title": ": \" صنفان لا تنالهما شفاعتي: إمام غشوم ظلوم وكل غال مارق \"",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "14": {
      "title": "وعدني أن يدخل من أمتي الجنة سبعين ألفا بغير حساب» فقال يزيد بن الأخنس «والله يا رسول الله",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "15": {
      "title": "[ص: 58]",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 3
    },
    "16": {
      "title": "من الشعر حكمة»",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "17": {
      "title": ": «من الشعر حكمة»",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "18": {
      "title": "من الشعر حكمة»",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "19": {
      "title": ": «ثلاثة لا ينظر الله إليهم يوم القيامة رجل باع رجلا مرابحة فكذبه , ورجل حلف على يمين كاذبة",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "20": {
      "title": ": «من يشتري مني العبد» فلما عرف أن رسول الله صلى الله عليه وسلم لم يأل أن يلصق ظهره ببطن رسول",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "21": {
      "title": ": «لئن عشت لأخرجن اليهود والنصارى من جزيرة العرب حتى لا أدع إلا مسلما»",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "22": {
      "title": "75 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 4
    },
    "23": {
      "title": "يكره السدل في الصلاة وذكر أن النبي صلى الله عليه وسلم كان يكرهه \"",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "24": {
      "title": ": «السلام اسم من أسماء الله وضعه في الأرض فأفشوه بينكم»",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "25": {
      "title": ": «كل مسكر حرام»",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "26": {
      "title": ": «حبب إلي النساء والطيب وجعل قرة عيني في الصلاة»",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "27": {
      "title": ": «نعم الرجل عبد الله لو كان يصلي من الليل» قال فكان بعد لا ينام من الليل إلا",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "28": {
      "title": "89 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 5
    },
    "29": {
      "title": ": «لا يحتكر إلا خاطئ»",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "30": {
      "title": ": «لا يحتكر إلا خاطئ»",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "31": {
      "title": ": «من تربص بالطعام أربعين يوما فقد برئ من الله وبرئ الله منه»",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "32": {
      "title": ": كيف بكم إذا نزل راكب بين أظهركم فحال بين اليتامى والأرامل ما أفاء الله على رسوله صلى الله",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "33": {
      "title": "لو رأيتنا ورسول الله صلى الله عليه وسلم بين أظهرنا وقد أصابنا المطر حسبت أن ريحنا ريح",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "34": {
      "title": ": «تبسمك في وجه أخيك صدقة»",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "35": {
      "title": ": «ما كان خلق أبغض إلى رسول الله صلى الله عليه وسلم من الكذب إن كان الرجل ليكذب عنده الكذبة",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "36": {
      "title": ": «في كل إشارة الصلاة عشر حسنات»",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 6
    },
    "37": {
      "title": ": «من ألقى جلباب الحياء فلا غيبة له» قال مؤمل: فلما اختلط رواد رفع هذا الحديث ودلسوا",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "38": {
      "title": ": «سبحانك اللهم وبحمدك وتبارك اسمك وتعالى جدك ولا إله غيرك»",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "39": {
      "title": ": «من رأى منكرا فليغيره بيده فإن لم يستطع فبلسانه فإن لم يستطع فبقلبه وذلك أضعف الإيمان»",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
