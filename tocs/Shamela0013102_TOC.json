      "start_ms": 6,
      "end_ms": 6
    },
    "43": {
      "title": ": «أدركت الناس بالبصرة ولا يحلق قفاه إلا مخنث»",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "44": {
      "title": "كره أن يزن بالشعير \"",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 7
    },
    "45": {
      "title": ": «يقتل ابن مريم الدجال بباب لد»",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "46": {
      "title": ": «إذا ملك عتيق العرب وعتيق الروم كانت الملاحم على أيديهما»",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "47": {
      "title": ": «سيكون بمصر رجل من بني أمية أخنس يلي سلطانا ثم غلب عليه أو ينزع منه فيفر إلى الروم فيأتي",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "48": {
      "title": ": \" رأيت كأن في يدي سوارين من ذهب، فأهمني شأنهما، فأوحي إلي أن انفخهما، فنفختهما فطارا،",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 8
    },
    "49": {
      "title": ": «بين يدي الدجال نيف وسبعون دجالا»",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "50": {
      "title": ": «على أنقاب المدينة ملائكة لا يدخلها الدجال ولا الطاعون»",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "51": {
      "title": ": \" ليس من بلد إلا سيطؤه الدجال إلا مكة والمدينة ليس نقب من أنقابها إلا عليه الملائكة صافين",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": null
    }
