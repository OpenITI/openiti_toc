  "sections": {
    "1": {
      "title": "الباب الأول: البيان والإعراب عما بأرض مصر من الأعراب",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "2": {
      "title": "الحمد لله ذي النعم الجزيلة والآلاء الجمة الجليلة، أحمده على ما علم",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 3
    },
    "3": {
      "title": "معاوية بن جرول. والى قنة هذا ينسب معالى بن فريج مقدم سنبس،",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 5
    },
    "4": {
      "title": "بنى حبيس، وبنو عمرو بن مطرود بن كعب بن على بن سعد بن أبامة بن غطفان،",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 10
    },
    "5": {
      "title": "الله عنه فكتب إلى عامل الشام أن يسير ثلث قضاعة إلى مصر فنظروا فإذا بلى",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 15
    },
    "6": {
      "title": "ان بني داود هؤلاء ينسبون إلى داود بن يوسف بن جعفر بن إبراهيم، وقيل",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 17
    },
    "7": {
      "title": "مدة ثم خالف على بعض أهله. وكانت عيذاب لبني يونس من ربيعة ملوكها عند",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 19
    },
    "8": {
      "title": "القاهرة في قليوب وما حولها وبهم عرفت البلدة المسماة بخراب فزارة. وبأرض",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 21
    },
    "9": {
      "title": "لهذه الفرقة التي نزلت بالجيزية \" حد وخاص \" وللفرقة التي نزلت",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 24
    },
    "10": {
      "title": "محدتين \" إلى منحدر دير الجميزة في البر الشرقي. ومنهم بنو حدان وهم بنو",
      "level": 1,
      "parent": null,
      "start_ms": 24,
      "end_ms": 26
    },
    "11": {
      "title": "أمير المؤمنين أطال الله بقاءه قد شرف هذا الحي من قيس ونعشهم ورفع من",
      "level": 1,
      "parent": null,
      "start_ms": 26,
      "end_ms": 28
    },
    "12": {
      "title": "عمر، ومنهم البداري أيضا، ومنهم السهاونة والجلدة وأولاد أحمد، ومنازلهم",
      "level": 1,
      "parent": null,
      "start_ms": 28,
      "end_ms": 30
    },
