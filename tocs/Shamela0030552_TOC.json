      "title": "60 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 13
    },
    "120": {
      "title": ": «إذا صلى أحدكم فليصل إلى سترة فإن مر عليه فليمنع , فإن عاد فليقاتله فإنه",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
