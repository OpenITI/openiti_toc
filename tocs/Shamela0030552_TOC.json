      "title": "68 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 15
    },
    "136": {
      "title": ": «الحمد لله نحمده ونستعينه ونعوذ به من شرور أنفسنا , وسيئات أعمالنا , من يهده الله فلا مضل",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
