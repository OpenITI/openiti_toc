      "title": "[ص: 44]",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "108": {
      "title": "43 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "109": {
      "title": "[ص: 45]",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "110": {
      "title": "، وإذا أصحابه كأن على رءوسهم الطير، وإذا الإبل قد وضعت جرانها، فإذا أنا بخيال، فإذا معاذ بن",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "111": {
      "title": "44 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 13
    },
    "112": {
      "title": ": «أتاني آت من ربي آنفا، فخيرني بين أن يدخل نصف أمتي الجنة، وبين الشفاعة، فاخترت",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "113": {
      "title": "45 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "114": {
      "title": "[ص: 46]",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "115": {
      "title": "«خيرت بين الشفاعة، وبين أن يدخل شطر أمتي الجنة، فاخترت الشفاعة، لأنها أعم وأكفى، أفترونها",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "116": {
      "title": "46 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "117": {
      "title": ": «خيرت بين الشفاعة، وبين أن يدخل نصف أمتي الجنة، فاخترت الشفاعة، لأنها أعم وأكفى، أترونها",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "118": {
      "title": "47 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "119": {
      "title": "[ص: 47]",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "120": {
      "title": "ربي خيرني بين خصلتين: بين أن يدخل نصف أمتي الجنة، وبين الشفاعة لأمتي، فاخترت",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "121": {
      "title": "48 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "122": {
      "title": "[ص: 48]",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "123": {
      "title": "، فاخترت لهم الشفاعة إلى يوم القيامة»",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "124": {
      "title": "49 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 14
    },
    "125": {
      "title": "[ص: 49]",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "126": {
      "title": "لكل نبي دعوة يدعو بها لأمته، وإني اختبأت دعوتي شفاعة لأمتي يوم القيامة»",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "127": {
      "title": "50 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "128": {
      "title": "اغفر لكل مسلم يؤمن بك، لا يشرك بك شيئا» قال أبو بكر بن أبي داود: قوله: يقول: يعني النبي",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "129": {
      "title": "51 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "130": {
      "title": "[ص: 50]",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "131": {
      "title": "الله وعدني أن يدخل من أمتي الجنة أربع مائة ألف» ، فقال أبو بكر: زدنا يا رسول الله. قال:",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "132": {
      "title": "52 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "133": {
      "title": "[ص: 51]",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "134": {
      "title": "ناسا من أهل لا إله إلا الله يدخلون النار بذنوبهم، فيقول لهم أهل اللات والعزى: ما أغنى",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 15
    },
    "135": {
      "title": "53 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "136": {
      "title": "رحمتي سبقت غضبي، وأنا أرحم الراحمين، فيخرج من النار مثل أهل الجنة - أو - مثلي أهل الجنة \"",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "137": {
      "title": "54 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "138": {
      "title": ": \" يدخل قوم جهنم، ثم يخرجون منها، فيدخلون الجنة، فيعرفون فيها بأسمائهم يقال لهم:",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "139": {
      "title": "55 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "140": {
      "title": ": \" يؤتى بالموت يوم القيامة في صورة كبش أملح، فيذبح بين الجنة والنار، ثم يقال: يا أهل الجنة",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "141": {
      "title": "56 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 16
    },
    "142": {
      "title": "ما يحشرون على أقدامهم، ولا يساقون سوقا، ولكنهم يؤتون بنوق من الجنة، لم ينظر الخلائق إلى",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "143": {
      "title": "57 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "144": {
      "title": ": \" احتجت الجنة والنار، فقالت النار: يدخلني الجبارون والمتكبرون، وقالت الجنة: يدخلني الفقراء",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "145": {
      "title": "58 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "146": {
      "title": ": «من اتقى الله دخل الجنة، ينعم فيها، ولا ييأس، ويحيا فيها فلا يموت، ولا تبلى ثيابه، ولا",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "147": {
      "title": "59 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "148": {
      "title": ": «جنتان من ذهب , آنيتهما وما فيهما، وجنتان من فضة، آنيتهما وما فيهما، وما بين القوم، وبين",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "149": {
      "title": "60 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "150": {
      "title": ": «للنار سبعة أبواب، وللجنة ثمانية أبواب»",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "151": {
      "title": "61 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 17
    },
    "152": {
      "title": ": «ما بين كل مصراعين من مصاريع الجنة مسيرة سبع سنين»",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "153": {
      "title": "62 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "154": {
      "title": ": «الجنة مائة درجة، ما بين كل درجتين مسيرة خمسمائة عام»",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "155": {
      "title": "63 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "156": {
      "title": ": «لو أن ما أقل ظفر من الجنة برز من الدنيا لتزخرفت له ما بين السماء",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "157": {
      "title": "64 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "158": {
      "title": ": \" يدخل أهل الجنة الجنة جردا، مردا، بيضا، جعادا، مكحلين، أبناء ثلاثة وثلاثين، على خلق آدم:",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "159": {
      "title": "65 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "160": {
      "title": ": «يبعث أهل الجنة على صورة آدم، في ميلاد ثلاث وثلاثين سنة، جردا، مردا، مكحلين، ثم يذهب بهم",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "161": {
      "title": "66 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "162": {
      "title": ": «ما في الجنة شجرة، إلا ساقها من ذهب»",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "163": {
      "title": "67 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 18
    },
    "164": {
      "title": "في الجنة شجرة، يسير الراكب في ظلها، مائة سنة»",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "165": {
      "title": "68 -",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "166": {
      "title": ": «شجرة في الجنة، مسيرة مائة سنة , ثياب أهل الجنة تخرج من أكمامها»",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "167": {
      "title": "69 -",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "168": {
      "title": ": «في الجنة قصر من لؤلؤة، ليس فيها صدع، ولا وهي، أعده الله لخليله إبراهيم عليه السلام",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "169": {
      "title": "70 -",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "170": {
      "title": "الله يجعل مكان كل شوكة منها ثمرة مثل خصوة التيس الملبود - يعني الخصى - فيها سبعون لونا من",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "171": {
      "title": "71 -",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "172": {
      "title": ": «في الجنة بحر الماء، وبحر اللبن، وبحر الخمر، وبحر العسل، ثم تنفجر الأنهار",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "173": {
      "title": "72 -",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "174": {
      "title": "[ص: 61]",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "175": {
      "title": "الجنة لا خطر لها هي ورب الكعبة نور يتلألأ، وريحانة تهتز، وقصر مشيد، ونهر مطرد، وثمرة",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 19
    },
    "176": {
      "title": "73 -",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "177": {
      "title": "أهل الجنة ليتراءون الغرفة في الجنة، كما يتراءون الكوكب الدري الغابر في الأفق الشرقي، أو",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "178": {
      "title": "74 -",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "179": {
      "title": "[ص: 62]",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "180": {
      "title": "أهل الجنة ليتراءون أهل الغرف فوقهم كما يتراءون الكوكب الدري الغابر في الأفق من المشرق",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "181": {
      "title": "75 -",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "182": {
      "title": "في الجنة لغرفا يرى ظهورها من بطونها، وبطونها من ظهورها» ، فقام أعرابي، فقال: يا رسول الله",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "183": {
      "title": "76 -",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "184": {
      "title": "الحور في الجنة يتغنين، يقلن: نحن الحور الحسان، خبين لأزواج كرام \"",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "185": {
      "title": "77 -",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "186": {
      "title": "[ص: 64]",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 20
    },
    "187": {
      "title": ": \" لا تؤذي امرأة زوجها في الدنيا، إلا قالت زوجته من الحور العين: لا تؤذيه قاتلك الله، فإنما",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "188": {
      "title": "78 -",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "189": {
      "title": "أدنى أهل الجنة منزلة الذي له ثمانون ألف خادم، واثنتان وسبعون زوجة، وتنصب له قبة من لؤلؤ،",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "190": {
      "title": "79 -",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "191": {
      "title": ": «من مات من أهل الجنة من صغير، أو كبير يردون بني ثلاثة وثلاثين سنة في الجنة، لا يزيدون",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "192": {
      "title": "80 -",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "193": {
      "title": ": «لو أن امرأة من نساء أهل الجنة أشرفت إلى أهل الأرض لملأت الأرض ريح مسك، ولأذهبت ضوء الشمس",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "194": {
      "title": "81 -",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "195": {
      "title": "[ص: 66]",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "196": {
      "title": "الرجل في الجنة ليتكئ سبعين سنة قبل أن يتحول، ثم تأتيه امرأة , فتضرب على منكبه، فينظر وجهه",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": null
    }
