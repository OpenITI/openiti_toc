      "title": "ورقة في معنى كلمة التوحيد لكاتب مجهول",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "4": {
      "title": "ذكر ما في الورقة: قال: الحمد لله المتوحد بجميع الجهات",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "5": {
      "title": "غلط كثير من الطوائف في مسمى التوحيد",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 5
    },
    "6": {
      "title": "الرد على تفسير الورقة لكلمة إله",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 8
    },
    "7": {
      "title": "قول الورقة إن الإله مشتق من ألهه",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 11
    },
    "8": {
      "title": "النفي والإثبات في كلمة التوحيد",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 13
    },
    "9": {
      "title": "زعم عدم تحقق العبادة إلا بعد استحقاق المعبود لها",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 14
    },
    "10": {
      "title": "قوله إن المعبودات الباطلة سميت آلهة من حيث اعتقاد عبادها",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "11": {
      "title": "…",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "12": {
      "title": "…",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "13": {
      "title": "وقوله: (كما ورد في أكثر موارد القرآن)",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 15
    },
    "14": {
      "title": "وأما قوله: (فمدفوع بأن إطلاقه عليها بالنظر إلى اعتقاد عبادها) .",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 16
    },
    "15": {
      "title": "الإله المنفي في كلمة الإخلاص",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 17
    },
    "16": {
      "title": "إعراب لا إله إلا الله",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 18
    },
    "17": {
      "title": "ما يقتضيه إعراب المعترض لها من الفساد",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "18": {
      "title": "وجوب تحقيق معنى لا إله إلا الله",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 19
    },
    "19": {
      "title": "أقوال كبار المتكلمين في معنى لا إله إلا الله وإعرابها",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 22
    },
    "20": {
      "title": "عود الآيات في معنى لا إله إلا الله",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 23
    },
    "21": {
      "title": "اقتضاء كلمة التوحيد إبطال عبادة كل ما عبد من دون الله",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 24
    },
    "22": {
      "title": "شكوى قريش لأبي طالب من النبي وكلامه",
      "level": 1,
      "parent": null,
      "start_ms": 24,
      "end_ms": 24
    },
    "23": {
      "title": "زعم أن كلمة التوحيد لا تنفي إلا مفهوما كليا",
      "level": 1,
      "parent": null,
      "start_ms": 24,
      "end_ms": 25
    },
    "24": {
      "title": "الوجوه المبطلة للقول بأن نفي الكلي ليس له أفراد في الخارج",
      "level": 1,
      "parent": null,
      "start_ms": 25,
      "end_ms": 28
    },
    "25": {
      "title": "الإله هوالمعبود. والعبادة حق الله وحده بالإجماع",
      "level": 1,
      "parent": null,
      "start_ms": 28,
      "end_ms": 28
    },
    "26": {
      "title": "رد قول أن المنفي بلا إله إلا الله كلي منوي",
      "level": 1,
      "parent": null,
      "start_ms": 28,
      "end_ms": 29
    },
    "27": {
      "title": "الزعم بأن المستثنى بها هو المفهوم العام",
      "level": 1,
      "parent": null,
      "start_ms": 29,
      "end_ms": 30
    },
    "28": {
      "title": "قول أفلاطون وأتباعه إن الله هو الوجود المطلق",
      "level": 1,
      "parent": null,
      "start_ms": 30,
      "end_ms": 31
    },
    "29": {
      "title": "رد الشيخ على أفلاطون",
      "level": 1,
      "parent": null,
      "start_ms": 31,
      "end_ms": 32
    },
    "30": {
      "title": "الرد على تفسير الورقة لكلمة التوحيد",
      "level": 1,
      "parent": null,
      "start_ms": 32,
      "end_ms": 33
    },
    "31": {
      "title": "المنفي بكلمة التوحيد كل ما عبد ويعبد من دون الله",
      "level": 1,
      "parent": null,
      "start_ms": 33,
      "end_ms": 34
    },
    "32": {
      "title": "التوحيد هو الكفر بالطواغيت والأصنام وإخلاص العبادة لله وحده",
      "level": 1,
      "parent": null,
      "start_ms": 34,
      "end_ms": 35
    },
    "33": {
      "title": "ونشير إلى ما ذكره بعض العلماء في أصل هذه المقالة وبطلانها.",
      "level": 1,
      "parent": null,
      "start_ms": 35,
      "end_ms": 36
    },
    "34": {
      "title": "الرد على من صرف كلمة التوحيد عن معناها",
      "level": 1,
      "parent": null,
      "start_ms": 36,
      "end_ms": 37
    },
    "35": {
      "title": "المنفي في كلمة التوحيد الإلهية الكثيرة الموجودة في الخارج",
      "level": 1,
      "parent": null,
      "start_ms": 37,
      "end_ms": 38
    },
    "36": {
      "title": "وضع الأسماء الشرعية للمسميات البدعية",
      "level": 1,
      "parent": null,
      "start_ms": 38,
      "end_ms": 39
    },
