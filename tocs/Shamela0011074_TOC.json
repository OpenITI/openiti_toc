  "sections": {
    "1": {
      "title": "بيان كلمة التوحيد والرد على الكشميري عبد المحمود",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "2": {
      "title": "(أما بعد)",
      "level": 1,
