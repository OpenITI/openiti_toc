      "title": "151 -",
      "level": 1,
      "parent": null,
      "start_ms": 65,
      "end_ms": 65
    },
    "296": {
      "title": "«أمره أن يخضبها بالحناء».",
      "level": 1,
      "parent": null,
      "start_ms": 65,
      "end_ms": 66
    },
