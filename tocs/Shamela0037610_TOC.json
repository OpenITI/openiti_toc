      "end_ms": 38
    },
    "73": {
      "title": "درجة الحديث:",
      "level": 1,
      "parent": null,
      "start_ms": 38,
      "end_ms": 38
    },
    "74": {
      "title": ": \"كان يغدو إلى المصلى، يوم الفطر، إذا طلعت الشمس\".",
      "level": 1,
      "parent": null,
      "start_ms": 38,
      "end_ms": 38
    },
    "75": {
      "title": "تخريجه:",
      "level": 1,
      "parent": null,
      "start_ms": 38,
      "end_ms": 38
    },
    "76": {
      "title": "دراسة إسناده:",
      "level": 1,
      "parent": null,
      "start_ms": 38,
      "end_ms": 38
    },
    "77": {
