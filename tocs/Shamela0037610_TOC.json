      "start_ms": 18,
      "end_ms": 20
    },
    "40": {
      "title": "درجة الحديث",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 21
    },
    "41": {
      "title": "- \"كان إذا خرج إلى العيد، سلك طريقا، ورجع من طريق آخر\".",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "42": {
      "title": "تخريجه",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "43": {
      "title": "دراسة إسناده",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 23
    },
    "44": {
      "title": "درجة الحديث",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 23
    },
    "45": {
      "title": ": \"كان النبي - صلى الله عليه وسلم -، إذا كان يوم الفطر، لم يخرج، حتى يطعم، فإذا كان يوم النحر، لم يأكل، حتى يذبح\".",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 23
    },
    "46": {
      "title": "تخريجه",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 23
    },
    "47": {
      "title": "دراسة إسناده",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 25
    },
    "48": {
      "title": "درجة الحديث:",
      "level": 1,
      "parent": null,
      "start_ms": 25,
      "end_ms": 25
    },
    "49": {
      "title": "-: \"فرض زكاة الفطر من رمضان، على الناس، صاعا من تمر، أو صاعا من شعير، على كل حر، أو عبد، ذكر، أوأنثى، من المسلمين\".",
      "level": 1,
      "parent": null,
      "start_ms": 25,
      "end_ms": 25
    },
    "50": {
      "title": "تخريجه:",
      "level": 1,
      "parent": null,
      "start_ms": 25,
      "end_ms": 26
    },
    "51": {
      "title": "دراسة إسناده:",
      "level": 1,
      "parent": null,
      "start_ms": 26,
      "end_ms": 27
    },
    "52": {
      "title": "درجة الحديث:",
      "level": 1,
      "parent": null,
      "start_ms": 27,
      "end_ms": 28
    },
    "53": {
      "title": "-: \"كان يخرج زكاة الفطر، صاعا من تمر، أو صاعا، من شعير، وكان ابن عمر، يقول: جعل الناس عدله، مدين من حنطة\".",
      "level": 1,
      "parent": null,
      "start_ms": 28,
      "end_ms": 28
    },
    "54": {
      "title": "تخريجه:",
      "level": 1,
      "parent": null,
      "start_ms": 28,
      "end_ms": 28
    },
    "55": {
      "title": "دراسة إسناده:",
      "level": 1,
      "parent": null,
      "start_ms": 28,
      "end_ms": 29
    },
    "56": {
      "title": "درجة الحديث:",
      "level": 1,
      "parent": null,
      "start_ms": 29,
      "end_ms": 29
    },
    "57": {
      "title": ": \"فرض رسول الله - صلى الله عليه وسلم -، زكاة رمضان، على كل صغير وكبير، وحر وعبد، ذكر وأنثى، صاعا من تمر، أو صاعا من شعير، وكان ابن عمر: يؤدي عن غلمان له، وهم غيب \".",
      "level": 1,
      "parent": null,
      "start_ms": 29,
      "end_ms": 29
    },
    "58": {
      "title": "تخريجه:",
      "level": 1,
      "parent": null,
      "start_ms": 29,
      "end_ms": 29
    },
    "59": {
      "title": "دراسة إسناده:",
      "level": 1,
      "parent": null,
      "start_ms": 29,
      "end_ms": 29
    },
    "60": {
      "title": "....",
      "level": 1,
      "parent": null,
      "start_ms": 29,
      "end_ms": 30
    },
    "61": {
      "title": "درجة الحديث:",
      "level": 1,
      "parent": null,
      "start_ms": 30,
      "end_ms": 30
    },
    "62": {
      "title": ": \"أمر رسول الله - صلى الله عليه وسلم -، صايحا، فصاح إن صدقة الفطر، حق واجب، على كل مسلم، ذكر أو أنثى، صغير أو كبير، حر أومملوك، حاضر أو باد، مدان من بر، أو صاع من شعير، أوتمر \".",
      "level": 1,
      "parent": null,
      "start_ms": 30,
      "end_ms": 30
    },
    "63": {
      "title": "تخريجه:",
      "level": 1,
      "parent": null,
      "start_ms": 30,
      "end_ms": 30
    },
    "64": {
      "title": "دراسة إسناده:",
      "level": 1,
      "parent": null,
      "start_ms": 30,
      "end_ms": 33
    },
    "65": {
      "title": "درجة الحديث:",
      "level": 1,
      "parent": null,
      "start_ms": 33,
      "end_ms": 33
    },
    "66": {
      "title": ": \"فرض رسول الله - صلى الله عليه وسلم -،صدقة الفطر لجبرالصيام، من اللغو والرفث، وطعمة للمساكين، فمن أداها قبل الصلاة فهي زكاة مقبولة، ومن أداها بعد الصلاة، فهي صدقة من الصدقات\".",
      "level": 1,
      "parent": null,
      "start_ms": 33,
      "end_ms": 33
    },
    "67": {
      "title": "تخريجه:",
      "level": 1,
      "parent": null,
      "start_ms": 33,
      "end_ms": 33
    },
    "68": {
      "title": "دراسة إسناده:",
