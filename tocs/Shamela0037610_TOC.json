      "parent": null,
      "start_ms": 35,
      "end_ms": 36
    },
    "70": {
      "title": "-: \"كان يطعم قبل أن يخرج إلى الجبان يوم الفطر، ويأمر به\".",
      "level": 1,
      "parent": null,
      "start_ms": 36,
      "end_ms": 36
    },
    "71": {
      "title": "تخريجه:",
      "level": 1,
      "parent": null,
      "start_ms": 36,
      "end_ms": 36
    },
    "72": {
      "title": "دراسة إسناده:",
