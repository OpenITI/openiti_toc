      "title": "درجة الحديث:",
      "level": 1,
      "parent": null,
      "start_ms": 42,
      "end_ms": 42
    },
    "90": {
      "title": ": \"كانت للنبي - صلى الله عليه وسلم -، حلة يلبسها في العيدين، ويوم الجمعة \".",
      "level": 1,
      "parent": null,
      "start_ms": 42,
      "end_ms": 42
    },
