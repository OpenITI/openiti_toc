      "end_ms": 48
    },
    "102": {
      "title": "-: \"كانت تركز بين يديه عنزة بالمصلى، وذلك أن المصلى كانت في فضاء\".",
      "level": 1,
      "parent": null,
      "start_ms": 48,
      "end_ms": 48
    },
