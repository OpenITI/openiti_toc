      "level": 1,
      "parent": null,
      "start_ms": 70,
      "end_ms": 70
    },
    "147": {
      "title": ": شهدت العيد مع عمر بن الخطاب، رضي الله عنه فصلى بالناس قبل الخطبة،",
      "level": 1,
      "parent": null,
