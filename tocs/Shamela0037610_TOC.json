    },
    "35": {
      "title": "دراسة إسناده ms015",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 17
    },
    "36": {
      "title": "درجة الحديث",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 18
    },
    "37": {
      "title": "-: \"كان يخرج إلى العيد ماشيا في طريق، ويرجع ماشيا في طريق غيره\".",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "38": {
      "title": "تخريجه",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "39": {
      "title": "دراسة إسناده",
