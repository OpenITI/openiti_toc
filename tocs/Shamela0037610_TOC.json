      "start_ms": 97,
      "end_ms": 98
    },
    "227": {
      "title": "\"أن الحبشة لعبوا عند رسول الله - صلى ms097 الله عليه وسلم - يوم عيد، فقامت عائشة رضي الله عنها، فجعل يريها، وهي واضعة يدها، على عاتقه حتى فرغوا\".",
      "level": 1,
      "parent": null,
      "start_ms": 98,
      "end_ms": 98
    },
    "228": {
      "title": "تخريجه:",
      "level": 1,
      "parent": null,
      "start_ms": 98,
      "end_ms": 98
    },
    "229": {
      "title": "دراسة إسناده:",
      "level": 1,
      "parent": null,
      "start_ms": 98,
      "end_ms": 99
    },
    "230": {
      "title": "درجة الحديث:",
      "level": 1,
      "parent": null,
      "start_ms": 99,
      "end_ms": 99
    },
    "231": {
      "title": ": \"كنا نقول لعمر بن عبد العزيز في العيدين، تقبل الله منا ومنك، يا أمير المؤمنين، فلا ينكر ذلك علينا\".",
      "level": 1,
      "parent": null,
      "start_ms": 99,
      "end_ms": 99
    },
    "232": {
      "title": "تخريجه:",
      "level": 1,
      "parent": null,
      "start_ms": 99,
      "end_ms": 99
    },
    "233": {
      "title": "دراسة إسناده:",
      "level": 1,
      "parent": null,
      "start_ms": 99,
      "end_ms": 100
    },
    "234": {
      "title": "درجة الحديث:",
      "level": 1,
      "parent": null,
      "start_ms": 100,
      "end_ms": 101
    },
    "235": {
      "title": "....",
      "level": 1,
      "parent": null,
      "start_ms": 101,
      "end_ms": 101
    },
    "236": {
      "title": ": لقيت واثلة بن الأسقع، رضي الله عنه في يوم عيد، فقلت: \"تقبل الله منا ومنك\"، فقال: \"تقبل الله منا ومنك \".",
      "level": 1,
      "parent": null,
      "start_ms": 101,
      "end_ms": 101
    },
    "237": {
      "title": "تخريجه:",
      "level": 1,
      "parent": null,
      "start_ms": 101,
      "end_ms": 101
    },
    "238": {
      "title": "دراسة إسناده:",
      "level": 1,
      "parent": null,
      "start_ms": 101,
      "end_ms": 102
    },
    "239": {
      "title": "درجة الحديث:",
      "level": 1,
      "parent": null,
      "start_ms": 102,
      "end_ms": 103
    },
    "240": {
      "title": "،في الرجل يلقى الرجل يوم عيد، فيقول: \"تقبل الله منا ومنك، فقال: لا بأس به\".",
      "level": 1,
      "parent": null,
      "start_ms": 103,
      "end_ms": 103
    },
    "241": {
      "title": "تخريجه:",
      "level": 1,
      "parent": null,
      "start_ms": 103,
      "end_ms": 103
    },
    "242": {
      "title": "دراسة إسناده:",
      "level": 1,
      "parent": null,
      "start_ms": 103,
      "end_ms": 103
    },
    "243": {
      "title": "درجة الحديث:",
      "level": 1,
      "parent": null,
      "start_ms": 103,
      "end_ms": 104
    },
    "244": {
      "title": ": \"ما هذا فعل من همه قبول يومه عنه أو رده عليه، تقدم أقوام ففازوا، وتأخر آخرون فخابوا، والعجب من الضاحك اللاعب، ولا يدري في أي الزمرتين هو؟ \".",
      "level": 1,
      "parent": null,
      "start_ms": 104,
      "end_ms": 104
    },
    "245": {
      "title": "تخريجه:",
      "level": 1,
      "parent": null,
      "start_ms": 104,
      "end_ms": 104
    },
    "246": {
      "title": "دراسة إسناده:",
      "level": 1,
      "parent": null,
      "start_ms": 104,
      "end_ms": 104
    },
    "247": {
      "title": "درجة الأثر",
      "level": 1,
      "parent": null,
      "start_ms": 104,
      "end_ms": 105
    },
    "248": {
      "title": ": \"خمس ليال لا يرد فيهن الدعاء، ليلة الجمعة، وأول ليلة من رجب، وليلة النصف من شعبان، وليلتا العيد \".",
      "level": 1,
      "parent": null,
      "start_ms": 105,
      "end_ms": 105
    },
    "249": {
      "title": "تخريجه:",
      "level": 1,
      "parent": null,
      "start_ms": 105,
      "end_ms": 105
    },
    "250": {
      "title": "دراسة إسناده:",
      "level": 1,
      "parent": null,
      "start_ms": 105,
      "end_ms": 106
    },
    "251": {
      "title": "درجة الحديث:",
      "level": 1,
      "parent": null,
      "start_ms": 106,
      "end_ms": 106
    },
    "252": {
      "title": ": \" تصدقن فإن أكثركن حطب جهنم \"،",
      "level": 1,
      "parent": null,
      "start_ms": 106,
      "end_ms": 106
    },
    "253": {
      "title": "تخريجه:",
      "level": 1,
      "parent": null,
      "start_ms": 106,
      "end_ms": 107
    },
    "254": {
      "title": "دراسة إسناده:",
      "level": 1,
      "parent": null,
      "start_ms": 107,
      "end_ms": 107
    },
    "255": {
      "title": "درجة الحديث:",
      "level": 1,
      "parent": null,
      "start_ms": 107,
      "end_ms": 108
    },
    "256": {
      "title": ": \"أن ms107 الحبشة كانوا يلعبون عند رسول الله - صلى الله عليه وسلم -، في يوم عيد،",
      "level": 1,
      "parent": null,
      "start_ms": 108,
      "end_ms": 108
    },
    "257": {
      "title": "تخريجه:",
      "level": 1,
      "parent": null,
      "start_ms": 108,
      "end_ms": 108
    },
    "258": {
      "title": "دراسة إسناده:",
      "level": 1,
      "parent": null,
      "start_ms": 108,
      "end_ms": 108
    },
    "259": {
      "title": "درجة الحديث:",
      "level": 1,
      "parent": null,
      "start_ms": 108,
      "end_ms": 108
    },
    "260": {
      "title": ": \"كان رسول الله - صلى الله عليه وسلم - يسترني بردائه، وأنا أنظر إلى الحبشة كيف يلعبون",
      "level": 1,
      "parent": null,
      "start_ms": 108,
      "end_ms": 108
    },
    "261": {
      "title": "تخريجه:",
      "level": 1,
      "parent": null,
      "start_ms": 108,
      "end_ms": 108
    },
    "262": {
      "title": "دراسة إسناده:",
      "level": 1,
      "parent": null,
      "start_ms": 108,
      "end_ms": 109
    },
    "263": {
      "title": "درجة الحديث:",
      "level": 1,
      "parent": null,
      "start_ms": 109,
      "end_ms": 109
    },
    "264": {
      "title": ": \"كان النبي - صلى الله عليه وسلم -، إذا خرج يوم العيد في طريق، رجع في غيره \".",
      "level": 1,
      "parent": null,
      "start_ms": 109,
      "end_ms": 109
    },
    "265": {
      "title": "تخريجه:",
      "level": 1,
      "parent": null,
      "start_ms": 109,
      "end_ms": 109
    },
    "266": {
      "title": "دراسة إسناده:",
      "level": 1,
      "parent": null,
      "start_ms": 109,
      "end_ms": 110
    },
    "267": {
      "title": "درجة الحديث:",
      "level": 1,
      "parent": null,
      "start_ms": 110,
      "end_ms": 110
    },
    "268": {
      "title": ": \" كان النبي - صلى الله عليه وسلم -، إذا خرج إلى العيد في طريق، لم يرجع فيه \".",
      "level": 1,
      "parent": null,
      "start_ms": 110,
      "end_ms": 110
    },
    "269": {
      "title": "تخريجه:",
      "level": 1,
      "parent": null,
      "start_ms": 110,
      "end_ms": 110
    },
    "270": {
      "title": "دراسة إسناده:",
      "level": 1,
      "parent": null,
      "start_ms": 110,
      "end_ms": 111
    },
    "271": {
      "title": "درجة الحديث:",
      "level": 1,
      "parent": null,
      "start_ms": 111,
      "end_ms": 111
    },
    "272": {
      "title": "-: \"إن الله بنى جنانا كلها من ياقوت أحمر،",
      "level": 1,
      "parent": null,
      "start_ms": 111,
      "end_ms": 112
    },
    "273": {
      "title": "تخريجه:",
      "level": 1,
      "parent": null,
      "start_ms": 112,
      "end_ms": 112
    },
    "274": {
      "title": "دراسة إسناده:",
      "level": 1,
      "parent": null,
      "start_ms": 112,
      "end_ms": 112
    },
    "275": {
      "title": "....",
      "level": 1,
      "parent": null,
      "start_ms": 112,
      "end_ms": 113
    },
    "276": {
      "title": "درجة الحديث:",
      "level": 1,
      "parent": null,
      "start_ms": 113,
      "end_ms": 114
    },
    "277": {
      "title": ": \"أيها الناس قد أصبتم خيرا كثيرا، من أحب أن ينصرف فلينصرف، ومن أحب أن يقيم حتى يسمع الخطبة، فليقم\".",
      "level": 1,
      "parent": null,
      "start_ms": 114,
      "end_ms": 114
    },
    "278": {
      "title": "تخريجه:",
      "level": 1,
      "parent": null,
      "start_ms": 114,
      "end_ms": 114
    },
    "279": {
      "title": "دراسة إسناده:",
      "level": 1,
      "parent": null,
      "start_ms": 114,
      "end_ms": 115
    },
    "280": {
      "title": "درجة الحديث:",
      "level": 1,
      "parent": null,
      "start_ms": 115,
      "end_ms": 116
    },
    "281": {
      "title": ": \"كلكم قد أصاب خيرا، فمن أراد أن يسمع الخطبة، ومن أراد أن ينصرف - يعني - فليفعل\".",
      "level": 1,
      "parent": null,
      "start_ms": 116,
      "end_ms": 116
    },
