    "86": {
      "title": "-: \"ما على أحدكم، أن يكون- يعني -له ثوبان، سوى ثوبي مهنته، لجمعه أو لعيده\".",
      "level": 1,
      "parent": null,
      "start_ms": 40,
      "end_ms": 40
    },
