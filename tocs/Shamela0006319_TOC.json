    },
    "16": {
      "title": "فصل في الخبر إذا كان مقتضاه بخلاف مقتضى العقل",
      "level": 1,
      "parent": null,
      "start_ms": 550,
      "end_ms": 550
    },
    "17": {
      "title": "فصل في خبر الواحد إذا رفع مقتضى الكتاب أو سنة متواترة",
      "level": 1,
      "parent": null,
      "start_ms": 550,
      "end_ms": 552
    },
    "18": {
      "title": "فصل في الحكم إذا اقتضى عموم الكتاب فيه خلاف ما يقتضيه خبر الواحد",
      "level": 1,
      "parent": null,
      "start_ms": 552,
      "end_ms": 559
    },
    "19": {
      "title": "فصل في الحكم إذا اقتضى قياس الاصول فيه خلاف ما اقتضاه خبر الواحد",
      "level": 1,
      "parent": null,
      "start_ms": 559,
      "end_ms": 564
    },
    "20": {
      "title": "فصل في فائدة خبر الواحد إذا كان البلوى به عاما هل يرد له خبر الواحد الوارد فيه أم لا",
      "level": 1,
      "parent": null,
      "start_ms": 564,
      "end_ms": 567
    },
    "21": {
      "title": "فصل في خبر الواحد إذا فعل النبي صلى الله عليه وسلم خلاف مقتضاه",
