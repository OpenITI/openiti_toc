    "10": {
      "title": "فصل في أن الخبر لا يرد إذا كان راويه واحدا",
      "level": 1,
      "parent": null,
      "start_ms": 534,
      "end_ms": 536
    },
    "11": {
      "title": "فصل في الخبر إذا أسنده من أرسل غيره من الأحاديث هل يقبل أم لا",
      "level": 1,
      "parent": null,
      "start_ms": 536,
      "end_ms": 537
    },
    "12": {
      "title": "فصل في رواية الحديث بغير لفظ النبي صلى الله عليه وسلم هل يرد له الحديث أم لا",
      "level": 1,
      "parent": null,
      "start_ms": 537,
      "end_ms": 538
    },
    "13": {
      "title": "فصل في الرواية من كتاب",
      "level": 1,
      "parent": null,
      "start_ms": 538,
      "end_ms": 548
    },
    "14": {
      "title": "فصل في الحديث إذا أرسل مرة وأسند مرة اخرى أو ألحق بالنبي مرة وجعل موقوفا على صحابي مرة",
