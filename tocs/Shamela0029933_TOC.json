      "end_ms": 13
    },
    "102": {
      "title": ": \" لا يحل دم امرئ مسلم إلا بإحدى ثلاث: رجل ارتد بعد إسلامه فعليه القتل، أو زنى بعد إحصانه",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "103": {
      "title": "52 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "104": {
      "title": ": \" خيركم قال يحيى: وقال الآخر: أفضلكم من تعلم القرآن وعلمه \"",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "105": {
      "title": "53 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "106": {
      "title": ": «خيركم أو أفضلكم من تعلم القرآن وعلمه» .",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "107": {
      "title": "54 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 14
    },
    "108": {
      "title": ": «إن أفضلكم من تعلم القرآن وعلمه»",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "109": {
      "title": "55 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "110": {
      "title": ": «خيركم من تعلم القرآن وعلمه» .",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "111": {
      "title": "56 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "112": {
      "title": ": «من قال علي ما لم أقل فليتبوأ مقعده من النار»",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "113": {
      "title": "57 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "114": {
      "title": ": «من كذب علي متعمدا فليتبوأ مقعده من النار»",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "115": {
      "title": "58 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "116": {
      "title": "أنا لك كأبي زرع لأم زرع» .",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 16
    },
    "117": {
      "title": "59 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "118": {
      "title": ": «صلاة في مسجدي هذا أحب إلي من ألف صلاة لا تكون عند البيت»",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "119": {
      "title": "60 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "120": {
      "title": "الرجل يجامع امرأته ولا يمني، فقال عثمان: «يتوضأ كما يتوضأ للصلاة، ويغسل ذكره» .",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "121": {
      "title": "61 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 17
    },
    "122": {
      "title": "الرجل يجامع فلا ينزل، قال: «ليس عليه الغسل إلا الطهور» .",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "123": {
      "title": "62 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "124": {
      "title": "، حين قال لها أهل الإفك ما قالوا , فبرأها الله عز وجل , وذكر الحديث، ولم يذكر فيه",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "125": {
      "title": "63 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "126": {
      "title": "أمرنا أن ننزل الناس منازلهم»",
