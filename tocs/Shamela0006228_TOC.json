      "level": 1,
      "parent": null,
      "start_ms": 67,
      "end_ms": 67
    },
    "59": {
      "title": "باب ما يتعلق بالميت مع غسل وغيره",
      "level": 1,
      "parent": null,
      "start_ms": 67,
      "end_ms": 68
    },
    "60": {
      "title": "- قد صلى عليه وهو أفضل الخلق.",
      "level": 1,
      "parent": null,
      "start_ms": 68,
      "end_ms": 69
    },
    "61": {
      "title": "باب فيمن هو أحق بالإمامة على الميت",
      "level": 1,
      "parent": null,
      "start_ms": 69,
      "end_ms": 71
    },
    "62": {
      "title": "-، وفي الثالثة الدعاء للميت وللمسلمين، وفي الرابعة يسلم عن يمينه.",
      "level": 1,
      "parent": null,
      "start_ms": 71,
      "end_ms": 73
    },
    "63": {
      "title": "كتاب الزكاة",
      "level": 1,
