  "sections": {
    "1": {
      "title": "AUTO مقدمة",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 2
    },
    "2": {
      "title": "AUTO ### || AUTO الباب الأول",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 5
    },
    "3": {
      "title": "AUTO كنية الوضوء والصلاة ... والحج والصيام والزكاة",
      "level": 2,
      "parent": 2,
      "start_ms": 3,
      "end_ms": 4
    },
    "4": {
      "title": "AUTO خاتمة والأصل فقد يعبر ... عنه بالاستصحاب فيما يحضر",
      "level": 2,
      "parent": 2,
      "start_ms": 4,
      "end_ms": 4
    },
    "5": {
      "title": "AUTO *القاعدة الرابعة*",
      "level": 2,
      "parent": 2,
      "start_ms": 4,
      "end_ms": 5
    },
    "6": {
      "title": "AUTO لا فرق أن تعم أو تخصا ... عندهم كما عليه نصا",
      "level": 2,
      "parent": 2,
      "start_ms": 5,
      "end_ms": 5
    },
    "7": {
      "title": "AUTO الباب الثاني",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 15
    },
    "8": {
      "title": "AUTO معقبا كلا بما يستثنى ... منا وما يعرض لي في الأثنا",
      "level": 2,
      "parent": 7,
      "start_ms": 6,
      "end_ms": 6
    },
    "9": {
      "title": "AUTO *القاعدة الثانية*",
      "level": 2,
      "parent": 7,
      "start_ms": 6,
      "end_ms": 7
    },
    "10": {
      "title": "AUTO *القاعد الثالثة*",
      "level": 2,
      "parent": 7,
      "start_ms": 7,
      "end_ms": 7
    },
    "11": {
      "title": "AUTO وقد أجيب أن نقصه انجبر ... بنيلبه فضل التعاون الأبر",
      "level": 2,
      "parent": 7,
      "start_ms": 7,
      "end_ms": 8
    },
    "12": {
      "title": "AUTO *القاعدة الخامسة*",
      "level": 2,
      "parent": 7,
      "start_ms": 8,
      "end_ms": 8
    },
    "13": {
      "title": "AUTO وهذه الصورة عدت واحده ... من التي انطوت عليها القاعدة",
      "level": 2,
      "parent": 7,
      "start_ms": 8,
      "end_ms": 8
    },
    "14": {
      "title": "AUTO وشرطها القوة فيما ذكروا ... جزما وإلا فهي لا تؤثر",
      "level": 2,
      "parent": 7,
      "start_ms": 8,
      "end_ms": 8
    },
    "15": {
      "title": "AUTO والحر غير داخل تحت اليد ... في قول كل عالم معتمد",
      "level": 2,
      "parent": 7,
      "start_ms": 8,
      "end_ms": 8
    },
    "16": {
      "title": "AUTO *القاعد التاسعة*",
      "level": 2,
      "parent": 7,
      "start_ms": 8,
      "end_ms": 8
    },
    "17": {
      "title": "AUTO دخل فرد منهما في الآخر ... أي : غالبا على خلاف ظاهر",
      "level": 2,
      "parent": 7,
      "start_ms": 8,
      "end_ms": 9
    },
    "18": {
      "title": "AUTO قالوا : وفيها يدخل التأسيس ... أولى من التأكيد يا رئيس",
      "level": 2,
      "parent": 7,
      "start_ms": 9,
      "end_ms": 9
    },
    "19": {
      "title": "AUTO وقد يرى في العصبات مثله ... يعقل في الخطا ولا إرث له",
      "level": 2,
      "parent": 7,
      "start_ms": 9,
      "end_ms": 9
    },
    "20": {
      "title": "AUTO صحت وكون قوي المدرك ... لا كخلاف الظاهري إذ حكى",
      "level": 2,
      "parent": 7,
      "start_ms": 9,
      "end_ms": 9
    },
    "21": {
      "title": "AUTO والدفع فيما قال كل حبر ... أقوى من الرفع فجل بالفكر",
      "level": 2,
      "parent": 7,
      "start_ms": 9,
      "end_ms": 9
    },
    "22": {
      "title": "AUTO ولا تناط بالمعاصي الرخص ... فلم يبح لعاص الترخص",
      "level": 2,
      "parent": 7,
      "start_ms": 9,
      "end_ms": 9
    },
    "23": {
      "title": "AUTO والشك لا تناط أيضا الرخص ... به كما السبكي على ذلك نص",
      "level": 2,
      "parent": 7,
      "start_ms": 9,
      "end_ms": 9
    },
    "24": {
      "title": "AUTO كضرب زوج ومعلم ومن ... يلي وتعزيزات قاض فاعلمن",
      "level": 2,
      "parent": 7,
      "start_ms": 9,
      "end_ms": 9
    },
    "25": {
      "title": "AUTO *القاعدة الثامنة عشر*",
      "level": 2,
      "parent": 7,
      "start_ms": 9,
      "end_ms": 10
    },
    "26": {
      "title": "AUTO قلت : وفيها بعضهم قد صنفا ... مصنفا فيه أجاد ووفى",
      "level": 2,
      "parent": 7,
      "start_ms": 10,
      "end_ms": 10
    },
    "27": {
      "title": "AUTO وقس على ذلك بالتأمل ... والحمد لله على التفضل",
      "level": 2,
      "parent": 7,
      "start_ms": 10,
      "end_ms": 11
    },
    "28": {
      "title": "AUTO وقال : قد يكون بعض القاصره ... أفضل كالإيمان يا ذا الباصره",
      "level": 2,
      "parent": 7,
      "start_ms": 11,
      "end_ms": 11
    },
    "29": {
      "title": "AUTO *القاعدة الثانية والعشرون*",
      "level": 2,
      "parent": 7,
      "start_ms": 11,
      "end_ms": 11
    },
    "30": {
      "title": "AUTO والجمع في المسجد أولى منه في ... غير وإن كان كثيرا فاعرف",
      "level": 2,
      "parent": 7,
      "start_ms": 11,
      "end_ms": 11
    },
    "31": {
      "title": "AUTO ونظر الخاطب للمخطوبه ... كذلك الكتابة المحبوبه",
      "level": 2,
      "parent": 7,
      "start_ms": 11,
      "end_ms": 12
    },
    "32": {
      "title": "AUTO فإنه مع سهمه يرضخ له ... ذكره جمع كما قد نقله",
      "level": 2,
      "parent": 7,
      "start_ms": 12,
      "end_ms": 12
    },
    "33": {
      "title": "AUTO *القاعدة السادسة والعشرون*",
      "level": 2,
      "parent": 7,
      "start_ms": 12,
      "end_ms": 12
    },
    "34": {
      "title": "AUTO مهما يكن يسمره ولكن ... أجيب عنها بجواب متقن",
      "level": 2,
      "parent": 7,
      "start_ms": 12,
      "end_ms": 12
    },
    "35": {
      "title": "AUTO وجزية الذمي تطلب وإن ... يحرم عليه بلها كما زكن",
      "level": 2,
      "parent": 7,
      "start_ms": 12,
      "end_ms": 12
    },
    "36": {
      "title": "AUTO وهاهنا للأصل تفصيل أشد ... في العقد حيثما على العقد ورد",
      "level": 2,
      "parent": 7,
      "start_ms": 12,
      "end_ms": 12
    },
    "37": {
      "title": "AUTO قلت : الذي جرى عليه ابن حجر ... سنية التثليث وهو المعتبر",
      "level": 2,
      "parent": 7,
      "start_ms": 12,
      "end_ms": 13
    },
    "38": {
      "title": "AUTO قبل أوانه وليس المصلحه ... ثبوته عوقب فافقه ملمحه",
      "level": 2,
      "parent": 7,
      "start_ms": 13,
      "end_ms": 13
    },
    "39": {
      "title": "AUTO كذا سجود السهو ليس يشرع ... للنفل في قول غريب يسمع",
      "level": 2,
      "parent": 7,
      "start_ms": 13,
      "end_ms": 13
    },
    "40": {
      "title": "AUTO وإن ترد تحقيقها فارجع لما ... في الأصل للسبكي قولا محكما",
      "level": 2,
      "parent": 7,
      "start_ms": 13,
      "end_ms": 13
    },
    "41": {
      "title": "AUTO والاشتغال بسوى المقصود قد ... قالوا : عن المقصود إعراضا يعد",
      "level": 2,
      "parent": 7,
      "start_ms": 13,
      "end_ms": 14
    },
    "42": {
      "title": "AUTO وحيث للمنكر فيه كانا ... حق كزوج فافهم البيانا",
      "level": 2,
      "parent": 7,
      "start_ms": 14,
      "end_ms": 14
    },
    "43": {
      "title": "AUTO ويدخل القوي على الضعيف قد ... قالوا ولا عكس فحقق ما ورد",
      "level": 2,
      "parent": 7,
      "start_ms": 14,
      "end_ms": 14
    },
    "44": {
      "title": "AUTO وفي وسائل الأمور مغتفر ... ما ليس في المقصود منها يغتفر",
      "level": 2,
      "parent": 7,
      "start_ms": 14,
      "end_ms": 14
    },
    "45": {
      "title": "AUTO *القاعدة التاسعة والثلاثون*",
      "level": 2,
      "parent": 7,
      "start_ms": 14,
      "end_ms": 14
    },
    "46": {
      "title": "AUTO وما على الكل يزيد البعض قط ... إلا بفرع في إظهار انضبط",
      "level": 2,
      "parent": 7,
      "start_ms": 14,
      "end_ms": 15
    },
    "47": {
      "title": "AUTO الباب الثالث",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "48": {
      "title": "AUTO ### || AUTO *الفصل الأول*",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "49": {
      "title": "AUTO ومسلك الترجيح فيهما اختلف ... للخلف في فروعها وما ائتلف",
      "level": 2,
      "parent": 48,
      "start_ms": 15,
      "end_ms": 15
    },
    "50": {
      "title": "AUTO وجهان والترجيح أيضا مختلف ... فيما لها من الفروع قد عرف",
      "level": 2,
      "parent": 48,
      "start_ms": 15,
      "end_ms": 15
    },
    "51": {
      "title": "AUTO فيه أتى قولان والترجيح ... مختلف فليكفك التلويح",
      "level": 2,
      "parent": 48,
      "start_ms": 15,
      "end_ms": 15
    },
    "52": {
      "title": "AUTO فنية الناذر فيها تحتم ... وليس في فرض ونفل تلزم",
      "level": 2,
      "parent": 48,
      "start_ms": 15,
      "end_ms": 15
    },
    "53": {
      "title": "AUTO ### || AUTO *الفصل الثاني*",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 16
    },
    "54": {
      "title": "AUTO قال السيوطي : وما عبرت به ... اولى كذا في هذي الأبيات انتبه",
      "level": 2,
      "parent": 53,
      "start_ms": 15,
      "end_ms": 16
    },
    "55": {
      "title": "AUTO واختلف الترجيح في الفروع ... كما حكاه صاحب المجموع",
      "level": 2,
      "parent": 53,
      "start_ms": 16,
      "end_ms": 16
    },
    "56": {
      "title": "AUTO قولين والترجيح غير مؤتلف ... فيما لها من الفروع قد وصف",
      "level": 2,
      "parent": 53,
      "start_ms": 16,
      "end_ms": 16
    },
    "57": {
      "title": "AUTO *القاعدة العاشرة*",
      "level": 2,
      "parent": 53,
      "start_ms": 16,
      "end_ms": 16
    },
    "58": {
      "title": "AUTO ### || AUTO *الفصل الثالث*",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 17
    },
    "59": {
      "title": "AUTO وهل هي الرجعة تحسب ابتدا ... نكح أو استدامة خلف بدا",
      "level": 2,
      "parent": 58,
      "start_ms": 16,
      "end_ms": 16
    },
    "60": {
      "title": "AUTO شبه اليمن ؟ فيه خلف قد وصف ... ومنهج الترجيح فيه مختلف",
      "level": 2,
      "parent": 58,
      "start_ms": 16,
      "end_ms": 16
    },
    "61": {
      "title": "AUTO فيه خلاف والفروع مختلف ... في حكمها الترجيح حسبما عرف",
      "level": 2,
      "parent": 58,
      "start_ms": 16,
      "end_ms": 16
    },
    "62": {
      "title": "AUTO لكنه جزم بالأول في ... أشيا كذا الثاني كما عنهم قفي",
      "level": 2,
      "parent": 58,
      "start_ms": 16,
      "end_ms": 17
    },
    "63": {
      "title": "AUTO ### || AUTO *الفصل الرابع*",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "64": {
      "title": "AUTO والجزم بالبقا أتى في صور ... كذاك بالعدم أيضا فاخبر",
      "level": 2,
      "parent": 63,
      "start_ms": 17,
      "end_ms": 17
    },
    "65": {
      "title": "AUTO والجزم قد جاء بكل منهما ... في صور فاحفظ لما قد رسما",
      "level": 2,
      "parent": 63,
      "start_ms": 17,
      "end_ms": 17
    },
    "66": {
      "title": "AUTO والجزم بالأول جاز في صور ... كذاك بالثاني كما قد اشتهر",
      "level": 2,
      "parent": 63,
      "start_ms": 17,
      "end_ms": 17
    },
    "67": {
      "title": "AUTO وجزموا بالمنع في بعض الصور ... كذاك بالجواز حسبما ذكر",
      "level": 2,
      "parent": 63,
      "start_ms": 17,
      "end_ms": 17
    },
    "68": {
      "title": "AUTO *خاتمة*",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": null
    }
