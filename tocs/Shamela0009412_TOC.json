      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "76": {
      "title": ": «حين أسري بي، لقيني إبراهيم، وموسى، وعيسى، ببيت المقدس صلى الله عليهم، فإذا موسى ضرب أدم،",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 10
    },
