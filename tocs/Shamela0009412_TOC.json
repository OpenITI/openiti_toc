      "title": "1441 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "89": {
      "title": ": «إذا خرجت المرأة إلى المسجد فلتغتسل من الطيب كما تغتسل من الجنابة» .",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
