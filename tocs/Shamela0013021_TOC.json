      "title": "6 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 3
    },
    "11": {
      "title": ": «فيك خصلتان يحبهما الله عز وجل» ، قال: وما هما يا نبي الله؟ قال: «الأناة والتؤدة» ، قال: يا نبي",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
