      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "35": {
      "title": ": أحب أن أقبل ما رأيت به رسول الله صلى الله عليه وسلم. فأمكنه من عينيه",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "36": {
      "title": "19 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "37": {
      "title": ": فأعطني يدك. فأعطاه، فقبلها",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "38": {
      "title": "20 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 6
    },
    "39": {
      "title": "وثبنا عن رواحلنا فجعلنا نقبل يديه ورجليه",
