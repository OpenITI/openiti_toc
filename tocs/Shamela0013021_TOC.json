      "end_ms": 4
    },
    "23": {
      "title": ": «بايعت بيدي هذه رسول الله صلى الله عليه وسلم فقبلناها، فلم ينكر ذلك»",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "24": {
      "title": "13 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "25": {
      "title": ": رأيت عليا رضي الله عنه يقبل يدي العباس أو رجله ويقول: «أي عم، ارض عني»",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "26": {
      "title": "14 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 5
    },
    "27": {
      "title": "أتى رسول الله صلى الله عليه وسلم فقبل قدميه، قال: أشهد أن لا إله إلا الله، وأنك رسول",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "28": {
      "title": "15 -",
