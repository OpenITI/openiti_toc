      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "43": {
      "title": ": «استأذن زيد بن حارثة على النبي صلى الله عليه وسلم، فاعتنقه وقبله»",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "44": {
      "title": "23 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "45": {
      "title": ": ناولني يدك التي بايعت بها رسول الله. فناولنيها فقبلتها",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "46": {
      "title": "24 -",
      "level": 1,
      "parent": null,
