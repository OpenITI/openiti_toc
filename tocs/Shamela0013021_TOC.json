    "8": {
      "title": "5 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "9": {
      "title": ": «لا يسجد أحد لأحد، ولو أمرت أحدا أن يسجد لأحد لأمرت المرأة تسجد لزوجها؛ لعظم حقه",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
