      "end_ms": 3
    },
    "15": {
      "title": "كفي هذه، بايعت بها رسول الله صلى الله عليه وسلم. قال: وقلت: ناولني يدك فناولنيها، فأخذتها",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "16": {
      "title": "9 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "17": {
      "title": ": فنزلت إليه فقبلت يده",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
