    "2": {
      "title": "الله هو السلام فإذا صلى أحدكم فليقل: التحيات لله والصلوات والطيبات , السلام عليك أيها",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "3": {
      "title": "2 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "4": {
      "title": "لي وزيرين من أهل السماء , ووزيرين من أهل الأرض , فوزيراي من أهل السماء: جبريل وميكائيل",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "5": {
      "title": "3 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 2
    },
    "6": {
      "title": ": «من يشتري هذه البقعة من خالص ماله فيكون فيها كالمسلمين فإن له خيرا منها» .",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "7": {
      "title": "4 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "8": {
      "title": "لا يحبك إلا مؤمن ولا يبغضك إلا منافق»",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "9": {
      "title": "5 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "10": {
      "title": ": «الحسن والحسين سيدا شباب أهل الجنة»",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "11": {
      "title": "6 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "12": {
      "title": ": «ارم سعد فداك أبي وأمي»",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "13": {
      "title": "7 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 3
    },
    "14": {
      "title": ": ابعث معي رجلا أمينا حق أمين فاستشرف لها أصحاب رسول الله صلى الله عليه , فقال النبي صلى",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "15": {
      "title": "8 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "16": {
      "title": ": «أبو بكر في الجنة , وعمر في الجنة , وعثمان في الجنة , وعلي في الجنة , وطلحة في الجنة",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "17": {
      "title": "9 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "18": {
      "title": ": «اللهم استر العباس وولد العباس من النار»",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "19": {
      "title": "10 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 4
    },
    "20": {
      "title": "يدعونا إلى السحور في شهر رمضان وهو يقول: «هلموا إلى الغذاء المبارك»",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "21": {
      "title": "50 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "22": {
      "title": ": «اللهم علم معاوية الكتاب والحساب وقه العذاب»",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "23": {
      "title": "11 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "24": {
      "title": ": «حسبك من نساء العالمين مريم ابنة عمران وخديجة ابنة خويلد وفاطمة بنت محمد وآسية امرأة",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "25": {
      "title": "12 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "26": {
      "title": ": «فضل عائشة على النساء كفضل الثريد على سائر الطعام»",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "27": {
      "title": "13 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "28": {
      "title": "عن عبد الله بن مسعود , فقال: قرأ القرآن فوقف عند متشابهه فأحل حلاله وحرم حرامه.",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "29": {
      "title": "14 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 5
    },
    "30": {
      "title": ": «هلك في رجلان محب مفرط وعدو مبغض فمن استطاع أن لا يكون واحدا منهما فليفعل»",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "31": {
      "title": "15 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "32": {
      "title": ": «ليس المسكين الذي ترده الأكلة والأكلتان والتمرة والتمرتان , ولكن المسكين الذي لا يسأل",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "33": {
      "title": "16 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "34": {
      "title": ": \" من سبح ثلاثا وثلاثين وكبر ثلاثا وثلاثين وحمد ثلاثا وثلاثين , وقال: لا إله إلا الله وحده",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "35": {
      "title": "17 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 6
    },
    "36": {
      "title": ": «الطاعون رجز أرسل على من قبلكم , أو على بني إسرائيل , فإذا سمعتم به في أرض فلا تقدموا عليه",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "37": {
      "title": "18 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "38": {
      "title": ": «لا تبيعوا الدينار بالدينارين ولا الدرهم بالدرهمين»",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "39": {
      "title": "19 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "40": {
      "title": ": \" لعن رسول الله صلى الله عليه وسلم آكل الربا ومطعمه وشاهده وكاتبه , ومانع الصدقة والواشمة",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "41": {
      "title": "20 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "42": {
      "title": ": «اثبت حراء فإنه ليس عليك إلا نبي وصديق وشهيد» .",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "43": {
      "title": "21 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 7
    },
    "44": {
      "title": ": «ما نفعني في الإسلام مال أحد ما نفعني مال أبي بكر , منه أعتق بلال ومنه هاجر نبيكم , ولو",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "45": {
      "title": "22 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "46": {
      "title": "نفاضل على عهد رسول الله صلى الله عليه وسلم قول أبي بكر ثم عمر ثم عثمان»",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "47": {
      "title": "23 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "48": {
      "title": ": \" من أشقى ثمود؟ قالوا: عاقر الناقة , قال: فمن أشقى هذه الأمة؟ قالوا: الله ورسوله أعلم",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "49": {
      "title": "24 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "50": {
      "title": ": «من أحبهما فقد أحبني ومن أبغضهما فقد أبغضني»",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 8
    },
    "51": {
      "title": "25 ms7 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "52": {
      "title": ": «من لم يحب العباس بن عبد المطلب وأهل بيته فقد برئ الله ورسوله منه»",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "53": {
      "title": "26 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "54": {
      "title": ": \" إذا دخل أهل الجنة الجنة وأهل النار النار , نادى مناد: يا أهل الجنة إن لكم عند الله موعدا",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "55": {
      "title": "27 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "56": {
      "title": ": المؤمن لا يكون مؤمنا حتى يطول صمته ويحسن لفظه ويقل كذبه ويخلص ورعه",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": null
    }
