      "end_ms": 3
    },
    "14": {
      "title": "الله عز وجل لا ينزع العلم من صدور الرجال بعد أن يعلمهم إياه , ولكن ذهابه قبض العلماء",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
