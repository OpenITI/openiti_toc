    "12": {
      "title": ": «أي الخلق أعجب إليكم إيمانا؟» قالوا: الملائكة , قال: «وما لهم لا يؤمنون وهم عند ربهم»",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "13": {
