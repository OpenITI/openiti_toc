      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "16": {
      "title": "ركبت أمركم ولست بخيركم , ولكنه نزل القرآن وسن رسول الله صلى الله عليه وسلم , وعلمنا",
      "level": 1,
