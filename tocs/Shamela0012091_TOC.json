{
  "filename": "1349IbnSahmanKhathcami.MinhajAhlHaqq.Shamela0012091-ara1",
  "sections": {
    "1": {
      "title": "مسائل متفرقة",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "2": {
      "title": "استدلال المتدينين بتكفير البادية الذين في زمنهم بعبارات للشيخ محمد بن عبد الوهاب في البدو الذين في زمانه",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 11
    },
    "3": {
      "title": "إنهم يتحاجون بيانا في فضل المهاجر على الذي لم يهاجر",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 16
    },
    "4": {
      "title": "حكم من رجع إلى المكان الذي هاجر منه",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 17
    },
    "5": {
      "title": "من خرج بغنمه وقت الربيع إلى المكان الذي هاجر منه، ونيته الرجوع",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 18
    },
    "6": {
      "title": "إذا نزل في دار الهجرة. ثم بعد ذلك رجع إلى باديته رغبة عن الدين وربما سبه",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 19
    },
    "7": {
      "title": "حكم قول الزائر للإخوان في المسجد: إخواننا يسلمون عليكم. ثم يرتفع الصوت بالرد عليه",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 22
    },
    "8": {
      "title": "فصل في قصة الخوارج",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 22
    },
    "9": {
      "title": "المدخل",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 36
    },
    "10": {
      "title": "عبارات الشيخ محمد بن عبد الوهاب في البدو هل تنطبق على ماجاء بعدهم",
      "level": 1,
      "parent": null,
      "start_ms": 36,
      "end_ms": 37
    },
    "11": {
      "title": "عبارات الشيخ سليمان بن عبد الوهاب في كفر البوادي هل ينطبق على من في زماننا",
      "level": 1,
      "parent": null,
      "start_ms": 37,
      "end_ms": 41
    },
    "12": {
      "title": "هل التفريق بين البادية الذين في جزيرة العرب وفي ولاية إمام المسلمين ومن ليس في ولايته صحيح؟",
      "level": 1,
      "parent": null,
      "start_ms": 41,
      "end_ms": 42
    },
    "13": {
      "title": "ما الإعراض الذي هو ناقض من نواقض الإسلام؟ وما الذي يصدق عليه الإعراض؟",
      "level": 1,
      "parent": null,
      "start_ms": 42,
      "end_ms": 43
    },
    "14": {
      "title": "ما معنى التعرب بعد الهجرة الذي هو كبيرة, وهل يطلق الذم على كل من بدا ولو كان نيته الرجوع إلى منزله بالحاضرة؟",
      "level": 1,
      "parent": null,
      "start_ms": 43,
      "end_ms": 43
    },
    "15": {
      "title": "قول السائل وهل يستدل بالحديث\"لا يرث كافرا مسلما\" على من مات من النازلين من باديتنا اليوم على من لا ينزل منهم؟",
      "level": 1,
      "parent": null,
      "start_ms": 43,
      "end_ms": 44
    },
    "16": {
      "title": "هل الهجرة من جميعهم واجبة كوجوبها من بالد الشرك على من لا يقدر إضهار دينه أم مستحبة؟",
      "level": 1,
      "parent": null,
      "start_ms": 44,
      "end_ms": 45
    },
    "17": {
      "title": "في إقامة الحجة",
      "level": 1,
      "parent": null,
      "start_ms": 45,
      "end_ms": 46
    },
    "18": {
      "title": "في رجلين تحاورا فب مقصد الإمام والمشايخ بمنع \"الإخوان\" من الدعوة",
      "level": 1,
      "parent": null,
      "start_ms": 46,
      "end_ms": 66
    },
    "19": {
      "title": "قول: صبحك الله بالخير ونحوها، هل هو مسنون ms65 أم الا؟",
      "level": 1,
      "parent": null,
      "start_ms": 66,
      "end_ms": 67
    },
    "20": {
      "title": ": ما الرخص المذمومة",
      "level": 1,
      "parent": null,
      "start_ms": 67,
      "end_ms": null
    }
