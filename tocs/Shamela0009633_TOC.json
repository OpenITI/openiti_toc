      "title": "1627 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "72": {
      "title": "، ما علمت أن اليوم الجمعة، وكنت في السوق ما زدت على الوضوء، فقال: الوضوء أيضا، ثم قال: إن",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
