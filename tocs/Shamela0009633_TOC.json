      "start_ms": 5,
      "end_ms": 6
    },
    "56": {
      "title": ": أخبري رسول الله صلى الله عليه وسلم بما يريد أن يأكل منه، فقالوا: هو ضب، فرفع يده، فقلت:",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "57": {
      "title": "1619 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "58": {
      "title": ": \" لما توفي رسول الله صلى الله عليه وسلم اجتمع المهاجرون إلى أبي بكر، واجتمعت الأنصار في",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
