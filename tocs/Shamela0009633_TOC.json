      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "4": {
      "title": ": \" اقتلوا الوزغ، فإنه كان ينفخ على إبراهيم عليه السلام النار، قال: فكانت عائشة رضي الله عنها",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
