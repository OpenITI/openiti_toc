      "title": "1604 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "32": {
      "title": "يدخل على بعض نسائه وهي حائض، فيتكئ عليها، ويقرأ القرآن في حجرها، وتبسط له الخمرة في",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "33": {
      "title": "1605 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "34": {
      "title": "الله عز وجل وضع عن المسافر الصوم، وشطر الصلاة، وعن الحبلى، أو المرضع \"",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
