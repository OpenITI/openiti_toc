      "title": "1638 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "96": {
      "title": ": \" أيما امرئ قال لأخيه: يا كافر، فقد باء بها أحدهما \"",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "97": {
      "title": "1639 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 11
    },
    "98": {
      "title": "، لعبد الله بن مروان أمير المؤمنين، من عبد الله بن عمر، سلام عليك، فإني أحمد إليك الله الذي",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "99": {
      "title": "1640 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "100": {
      "title": "، متى الساعة؟ قال: «وماذا أعددت لها؟» , قال: لا شيء والله، إني لقليل الصلاة، قليل الصيام، إلا",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "101": {
      "title": "1641 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "102": {
      "title": ": \" استيقظ رسول الله صلى الله عليه وسلم من نومه وهو يضحك، فقلت: ما يضحكك يا رسول الله؟ قال:",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "103": {
      "title": "1642 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 12
    },
    "104": {
      "title": ": «من صلى صلاة لم يقرأ فيها بفاتحة الكتاب، فلم يصل إلا وراء الإمام»",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "105": {
      "title": "1643 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "106": {
      "title": ": «الفطرة قص الشارب، وتقليم الأظفار، ونتف الإبط، وحلق العانة، والختان»",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "107": {
      "title": "1644 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "108": {
      "title": "نحر عن آل محمد في حجة الوداع بقرة واحدة",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "109": {
      "title": "1645 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "110": {
      "title": ": «من تصدق صدقة من كسب طيب، ولا يقبل الله عز وجل إلا طيبا، فكأنما يضعها في كف الرحمن عز وجل،",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "111": {
      "title": "1646 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "112": {
      "title": "1647 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "113": {
      "title": ": «حجم أبو طيبة رسول الله صلى الله عليه وسلم فأعطاه صاعين، أو صاعا من تمر، وأمر أهله أن",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 13
    },
    "114": {
      "title": "1648 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "115": {
      "title": ": «إذا أسلم العبد، فحسن إسلامه كفر الله تعالى عنه بعد ذلك كل سيئة كان زلفها، وكتب له كل حسنة",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "116": {
      "title": "1649 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "117": {
      "title": ": «من نذر أن يطيع الله عز وجل فليطعه، ومن نذر أن يعصيه فلا يعصيه»",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "118": {
      "title": "1650 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "119": {
      "title": ": «حجبت الجنة بالمكاره، وحجبت النار بالشهوات»",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "120": {
      "title": "1651 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "121": {
      "title": ": «ليس فيما دون خمس أواق من الورق صدقة، وليس فيما دون خمس ذود من الإبل صدقة، وليس فيما دون",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "122": {
      "title": "1652 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "123": {
      "title": "عن بيع الولاء، وعن هبته»",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "124": {
      "title": "1653 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 14
    },
    "125": {
      "title": ": لا تدخل على النساء، فما أتى علي يوم كان أشر علي منه \"",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "126": {
      "title": "1654 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "127": {
      "title": ": «صليت مع رسول الله صلى الله عليه وسلم العتمة، فقرأ فيها بالتين والزيتون»",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "128": {
      "title": "1655 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "129": {
      "title": "، ليصلي الصبح، فينصرف النساء متلفعات بمروطهن ما يعرفن من غلس»",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "130": {
      "title": "1656 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "131": {
      "title": ": «لولا أن أشق على أمتي لأحببت أن لا أتخلف عن سرية تخرج في سبيل الله عز وجل، ولكن لا أجد ما",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "132": {
      "title": "1657 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "133": {
      "title": "1658 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 15
    },
    "134": {
      "title": ": \" كنت مع رسول الله صلى الله عليه وسلم في بعض أسفاره، فسألته عن شيء فلم يجبني، ثم سألته فلم",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "135": {
      "title": "1659 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "136": {
      "title": ": يا أهل الجنة، فيقولون: لبيك ربنا وسعديك، والخير بين يديك، فيقول: هل رضيتم، فيقولون: وما",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "137": {
      "title": "1660 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "138": {
      "title": ": \" يطلع الله عز وجل على أهل الجنة، فيقول: يا أهل الجنة، أرضيتم، فيقولون: ما لنا لا نرضى، وقد",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "139": {
      "title": "1661 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "140": {
      "title": ": «إذا أسلم العبد، وحسن إسلامه» .",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "141": {
      "title": "1662 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 16
    },
    "142": {
      "title": ": «من أدرك من الصبح ركعة قبل أن تطلع الشمس فقد أدرك الصبح، ومن أدرك من العصر ركعة قبل أن",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "143": {
      "title": "1663 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "144": {
      "title": ": «إذا كان أحدكم يصلي فلا يدع أحدا يمر بين يديه، وليدرأه ما استطاع، فإن أبى فليقاتله، فإنما",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "145": {
      "title": "1664 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "146": {
      "title": ": «إذا تثاءب أحدكم فليكظم ما استطاع»",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "147": {
      "title": "1665 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "148": {
      "title": "، «نهى أن ينتبذ في الدباء، والمزفت»",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "149": {
      "title": "1666 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "150": {
      "title": ": \" قال رجل لم يعمل حسنة قط: إذا مت احرقوني، ثم اذروا نصفه في البر، ونصفه في البحر، فوالله",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "151": {
      "title": "1667 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 17
    },
    "152": {
      "title": ": \" لو وجدت مع امرأتي رجلا أمهله، حتى آتي بأربعة شهداء؟ قال: نعم \"",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "153": {
      "title": "1668 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "154": {
      "title": "، «إذا كنت يقظانة تحدث معي بعد طلوع الفجر، وإن كنت نائمة اضطجع على شقه الأيمن حتى يأتيه",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "155": {
      "title": "1669 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "156": {
      "title": "، «إذا صلى ما بين الركعتين صلاة الفجر، فإن كنت يقظانة كلمني وجلس حتى تقام الصلاة، فيذهب",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "157": {
      "title": "1670 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "158": {
      "title": "يصلي إحدى عشرة ركعة، ثم يضطجع على شقه الأيمن، فإن كنت يقظانة حدثني حتى يأتيه المؤذن",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "159": {
      "title": "1671 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "160": {
      "title": "الله تعالى لا يقبض العلم انتزاعا ينتزعه من الناس، ولكن يقبض العلم بقبض العلماء، حتى إذا",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "161": {
      "title": "1672 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 18
    },
    "162": {
      "title": ": \" عن الصوم في السفر، فقال: إن شئت فصم، وإن شئت فأفطر \"",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "163": {
      "title": "1673 -",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "164": {
      "title": "«كفن في ثلاثة أثواب بيض ليس فيها قميص ولا عمامة، أدرج فيها إدراجا هكذا» .",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "165": {
      "title": "1674 -",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "166": {
      "title": "، فما بال قوم يشترطون شروطا ليست في كتاب الله عز وجل \".",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "167": {
      "title": "1675 -",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "168": {
      "title": ": \" ما مست يد رسول الله صلى الله عليه وسلم يد امرأة قط، وقالت مرة أخرى: ما صافح رسول الله صلى",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": null
    }
