    },
    "12": {
      "title": "نصبوا شاة يرمونها بالنبل، فقال: «هذه المعذبة لا تأكلوا لحمها، ولا يصر فيها",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "13": {
      "title": "1595 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "14": {
      "title": "أن يمثل بالذوات، وأن تؤكل الممثول بها»",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "15": {
      "title": "1596 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "16": {
      "title": ": \" ائتني بوضوء، فتوضأ، ثم قام بفضل وضوئه، فشربه قائما، فعجبت من ذلك، فقال: أتعجب يا بني، إني",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "17": {
      "title": "1597 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "18": {
      "title": ": «لا تنكح المرأة بغير أمر وليها، فإن نكحت فنكاحها باطل، فنكاحها باطل، فنكاحها باطل، فإن",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
