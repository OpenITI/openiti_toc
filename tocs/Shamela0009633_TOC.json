    "2": {
      "title": ": «من أقسم عليه، فهو أحق بالثمن إن شاء أخذه، وإن شاء تركه»",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "3": {
