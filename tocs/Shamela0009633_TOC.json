      "title": "1606 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 4
    },
    "36": {
      "title": ": «أمرت أن أسجد على سبعة أعظم، ولا أكف شعرا ولا بنانا»",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
