      "title": "1628 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "74": {
      "title": ": \" أيصلي الرجل في الثوب الواحد؟ فقال رسول الله صلى الله عليه وسلم: أوكلكم له",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "75": {
      "title": "1629 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 9
    },
    "76": {
      "title": "، «قضى بالشفعة فيما لم يقسم، فإذا وقعت الحدود فلا شفعة فيه»",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "77": {
      "title": "1630 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "78": {
      "title": ": «رمضان من صامه إيمانا واحتسابا، غفر له ما تقدم من ذنبه»",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "79": {
      "title": "1631 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "80": {
      "title": ": «ليس بكذاب الذي يمشي يصلح بين الناس، فتمنى خيرا، أو يقوله»",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "81": {
      "title": "1632 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "82": {
      "title": ": «إذا سمعتم النداء، فقولوا مثل ما يقول المؤذن»",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "83": {
      "title": "1633 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "84": {
      "title": "أبا بكر رضي الله عنه، استأذن على النبي صلى الله عليه وسلم، ورسول الله صلى الله عليه وسلم",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 10
    },
    "85": {
      "title": "1634 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "86": {
      "title": "\" الرجل ينام وهو جنب، فقال: نعم يتوضأ \".",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "87": {
      "title": "1635 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "88": {
      "title": ": «يقوم الناس يوم القيامة لرب العالمين، حتى أن أحدهم ليغيب في رشحه إلى أنصاف",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "89": {
      "title": "1636 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "90": {
      "title": "، \" حمل على فرس عتيق في سبيل الله، فوجده يباع، فأراد أن يبتاعه، فسأل عن ذلك رسول الله صلى",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "91": {
      "title": "1637 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "92": {
      "title": "عن بيع الولاء، وعن هبته»",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "93": {
      "title": "1638 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "94": {
      "title": ": «متعتان كانتا على عهد رسول الله صلى الله عليه وسلم أنهيا عنهما، وأعاف عليهما، متعة النساء،",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
