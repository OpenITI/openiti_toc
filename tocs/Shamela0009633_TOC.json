      "title": "1620 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "60": {
      "title": ": \" لا يمنع أحدكم جاره أن يغرز خشبة في جداره، قال: ثم يقول أبو هريرة: ما لي أراكم عنها",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 7
