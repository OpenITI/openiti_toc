      "end_ms": 3
    },
    "8": {
      "title": ": «من قرأ القرآن واستظهره , وحفظه , أدخله الله تعالى الجنة , وشفعه في سبعين من أهل بيته",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
