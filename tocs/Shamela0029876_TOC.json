      "start_ms": 5,
      "end_ms": 5
    },
    "22": {
      "title": ": «لا يقبل قول إلا بعمل، ولا عمل إلا بقول، ولا عمل وقول إلا بالنية، ولا يقبل عمل وقول ونية",
      "level": 1,
      "parent": null,
      "start_ms": 5,
