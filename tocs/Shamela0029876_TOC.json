      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "20": {
      "title": ": \" من ألهم خمسة لم يحرم خمسة، من ألهم الدعاء لم يحرم الإجابة؛ لأن الله تعالى، يقول: {وقال",
