    "64": {
      "title": "AUTO باب فضل الصيام، والنهي أن يقال قمت رمضان كله وصمته، وقول الله -عز وجل- {فمن شهد منكم الشهر فليصمه} - وفيمن له الفدية",
      "level": 2,
      "parent": 63,
      "start_ms": 163,
      "end_ms": 164
    },
    "65": {
      "title": "AUTO باب الصوم والفطر للرؤية أو للعدة وفي الهلال يرى كبيرا أو الشهادة على الرؤية وقوله عليه السلام: شهران لا ينقصان",
      "level": 2,
      "parent": 63,
      "start_ms": 164,
      "end_ms": 165
    },
    "66": {
      "title": "AUTO باب متى يحرم الأكل وفي السحور وصفة الفجر، وتبييت الصيام ووقت الفطر وتعجيله والإفطار على التمر أو الماء.",
      "level": 2,
      "parent": 63,
      "start_ms": 165,
      "end_ms": 168
    },
    "67": {
      "title": "AUTO باب في صيام يوم الشك والنهي أن يتقدم رمضان بصوم يوم أو يومين والنهي عن الوصال في الصوم وما جاء في القبلة والمباشرة للصائم، وفي الصائم يصبح جنبا",
      "level": 2,
      "parent": 63,
      "start_ms": 168,
      "end_ms": 169
    },
    "68": {
      "title": "AUTO باب الحجامة للصائم، وفيمن ذرعه القيء ومن نسي فأكل أو شرب وهو صائم، وفيمن جهده الصوم",
      "level": 2,
      "parent": 63,
      "start_ms": 169,
      "end_ms": 169
    },
    "69": {
      "title": "AUTO باب حفظ اللسان وغيره في الصوم وذكر الأيام التي نهي عن صيامها",
      "level": 2,
      "parent": 63,
      "start_ms": 169,
      "end_ms": 170
    },
    "70": {
      "title": "AUTO باب فيمن دعي إلى طعام وهو صائم والصائم المتطوع يفطر، وفيمن ينوي الصيام من النهار.",
      "level": 2,
      "parent": 63,
      "start_ms": 170,
      "end_ms": 171
    },
    "71": {
      "title": "AUTO باب النبي أن تصوم المرأة متطوعة بغير إذن زوجها، وكفارة من وطئ في رمضان، وفي الصيام في السفر",
      "level": 2,
      "parent": 63,
      "start_ms": 171,
      "end_ms": 173
    },
