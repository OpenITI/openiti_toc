      "title": "11 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "22": {
      "title": ": «يمسح المسافر ثلاثة أيام ولياليهن، والمقيم يوما وليلة»",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
