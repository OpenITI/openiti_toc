    },
    "10": {
      "title": ": «غيروا الشيب، ولا تغيروا بالسواد، ولا تشبهوا بأعدائكم من المشركين، وخير ما غيرتم به الحناء",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "11": {
      "title": "6 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "12": {
      "title": "احتجم وهو محرم صائم، وأعطى أجره، ولو كان حراما ما أعطاه»",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "13": {
      "title": "7 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "14": {
      "title": ": «إذا سلم الرجل على النفر فرد أحدهم أجزئ عن البقية، وإذا مر النفر بالقوم، فسلم واحد منهم",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "15": {
      "title": "8 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "16": {
      "title": ": «من تاب قبل أن يغرغر قبل الله تعالى توبته»",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "17": {
      "title": "9 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "18": {
      "title": ": «لقاتل المشركين يوم القرآن نوران، ولقاتل الخوارج يفضل ستة أنوار»",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "19": {
      "title": "10 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 3
    },
    "20": {
      "title": ": \" ما من عبد مؤمن يذكرني، فيصلي علي، إلا كتب له عشر حسنات، ومحي عنه عشر سيئات، ورفع له عشر",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
