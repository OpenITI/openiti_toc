    },
    "10": {
      "title": "مقدمة النشر في الطبعة الأولى- بالمطبعة السلفية، بمكة المكرمة:",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 8
    },
    "11": {
      "title": "مقدمة الشارح",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 15
    },
    "12": {
      "title": "قوله: (نقول في توحيد الله معتقدين بتوفيق الله: إن الله واحد لا شريك له).",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 34
    },
    "13": {
      "title": "قوله: (ولا شيء مثله).",
      "level": 1,
      "parent": null,
      "start_ms": 34,
      "end_ms": 41
    },
    "14": {
      "title": "قوله: (ولا شيء يعجزه).",
      "level": 1,
      "parent": null,
      "start_ms": 41,
      "end_ms": 43
    },
    "15": {
      "title": "قوله: (ولا إله غيره).",
      "level": 1,
      "parent": null,
      "start_ms": 43,
      "end_ms": 46
    },
    "16": {
      "title": "قوله: (لا يفنى ولا يبيد).",
      "level": 1,
      "parent": null,
      "start_ms": 46,
      "end_ms": 46
    },
    "17": {
      "title": "قوله: (ولا يكون إلا ما يريد).",
      "level": 1,
      "parent": null,
      "start_ms": 46,
      "end_ms": 50
    },
    "18": {
      "title": "قوله: (لا تبلغه الأوهام، ولا تدركه الأفهام).",
      "level": 1,
      "parent": null,
      "start_ms": 50,
      "end_ms": 50
    },
    "19": {
      "title": "قوله: (ولا يشبه الأنام).",
      "level": 1,
      "parent": null,
      "start_ms": 50,
      "end_ms": 53
    },
    "20": {
      "title": "قوله: (حي لا يموت قيوم لا ينام).",
      "level": 1,
      "parent": null,
      "start_ms": 53,
      "end_ms": 54
    },
    "21": {
      "title": "قوله: (خالق بلا حاجة، رازق بلا مؤنة).",
      "level": 1,
      "parent": null,
      "start_ms": 54,
      "end_ms": 55
    },
    "22": {
      "title": "قوله: (مميت بلا مخافة، باعث بلا مشقة).",
      "level": 1,
      "parent": null,
      "start_ms": 55,
      "end_ms": 55
    },
    "23": {
      "title": "قوله: (ما زال بصفاته قديما قبل خلقه، لم يزدد بكونهم شيئا لم يكن قبلهم من صفته، كما كان بصفاته أزليا، كذلك لا يزال عليها أبديا).",
      "level": 1,
      "parent": null,
      "start_ms": 55,
      "end_ms": 62
    },
    "24": {
      "title": "قوله: (ليس بعد خلق الخلق استفاد اسم\"الخالق\"، ولا بإحداثه البرية استفاد اسم\"الباري\").",
      "level": 1,
      "parent": null,
      "start_ms": 62,
      "end_ms": 66
    },
    "25": {
      "title": "قوله: (له معنى الربوبية ولا مربوب، ومعنى الخالق ولا مخلوق).",
      "level": 1,
      "parent": null,
      "start_ms": 66,
      "end_ms": 67
    },
    "26": {
      "title": "قوله: (وكما أنه محيي الموتى بعدما أحيا، استحق هذا الاسم قبل إحيائهم، كذلك استحق اسم الخالق قبل إنشائهم).",
      "level": 1,
      "parent": null,
      "start_ms": 67,
      "end_ms": 67
    },
    "27": {
      "title": "قوله: (ذلك بأنه على كل شيء قدير، وكل شىء إليه فقير، وكل أمر إليه يسير، لا يحتاج إلى شيء، ليس كمثله شيء، وهو السميع البصير).",
      "level": 1,
      "parent": null,
      "start_ms": 67,
      "end_ms": 70
    },
    "28": {
      "title": "قوله: (خلق الخلق بعلمه).",
      "level": 1,
      "parent": null,
      "start_ms": 70,
      "end_ms": 72
    },
    "29": {
      "title": "قوله: (وقدر لهم أقدارا).",
      "level": 1,
      "parent": null,
      "start_ms": 72,
      "end_ms": 72
    },
    "30": {
      "title": "قوله: (وضرب لهم آجالا).",
      "level": 1,
      "parent": null,
      "start_ms": 72,
      "end_ms": 74
    },
    "31": {
      "title": "قوله: (ولم يخف عليه شيء قبل أن يخلقهم، وعلم ما هم عاملون قبل أن يخلقهم).",
      "level": 1,
      "parent": null,
      "start_ms": 74,
      "end_ms": 74
    },
    "32": {
      "title": "قوله: (وأمرهم بطاعته، ونهاهم عن معصيته).",
      "level": 1,
      "parent": null,
      "start_ms": 74,
      "end_ms": 75
    },
    "33": {
      "title": "قوله: (وكل شيء يجري بتقديره ومشيئته، ومشيئته تنفذ، لا مشيئة للعباد، إلا ما شاء لهم، فما شاء لهم كان، وما لم يشأ لم يكن).",
      "level": 1,
      "parent": null,
      "start_ms": 75,
      "end_ms": 77
    },
    "34": {
      "title": "قوله: (يهدي من يشاء، ويعصم ويعافي فضلا. ويضل من يشاء، ويخذل ويبتلي عدلا).",
      "level": 1,
      "parent": null,
      "start_ms": 77,
      "end_ms": 77
    },
    "35": {
      "title": "قوله: (وكلهم يتقلبون في مشيئته، بين فضله وعدله).",
      "level": 1,
      "parent": null,
      "start_ms": 77,
      "end_ms": 78
    },
    "36": {
      "title": "قوله : (وهو متعال عن الأضداد والأنداد).",
      "level": 1,
      "parent": null,
      "start_ms": 78,
      "end_ms": 78
    },
    "37": {
      "title": "قوله: (لا راد لقضائه، ولا معقب لحكمه، ولا غالب لأمره).",
      "level": 1,
      "parent": null,
      "start_ms": 78,
      "end_ms": 78
    },
    "38": {
      "title": "قوله: (آمنا بذلك كله، وأيقنا أن كلا من عنده)",
      "level": 1,
      "parent": null,
      "start_ms": 78,
      "end_ms": 78
    },
    "39": {
      "title": "قوله: (وإن محمدا عبده المصطفى، ونبيه المجتبى، ورسوله المرتضى).",
      "level": 1,
      "parent": null,
      "start_ms": 78,
      "end_ms": 86
    },
    "40": {
      "title": "قوله: (وأنه خاتم الأنبياء).",
      "level": 1,
      "parent": null,
      "start_ms": 86,
      "end_ms": 86
    },
    "41": {
      "title": "قوله: (وإمام الأتقياء).",
      "level": 1,
      "parent": null,
      "start_ms": 86,
      "end_ms": 86
    },
    "42": {
      "title": "قوله: (وسيد المرسلين).",
      "level": 1,
      "parent": null,
      "start_ms": 86,
      "end_ms": 90
    },
    "43": {
      "title": "قوله: (وحبيب رب العالمين).",
      "level": 1,
      "parent": null,
      "start_ms": 90,
      "end_ms": 91
    },
    "44": {
      "title": "قوله: (وكل دعوى النبوة بعده (4) فغي وهوى).",
      "level": 1,
      "parent": null,
      "start_ms": 91,
      "end_ms": 91
    },
    "45": {
      "title": "قوله: (وهو المبعوث إلى عامة الجن وكافة الورى، بالحق والهدى، وبالنور والضياء).",
      "level": 1,
      "parent": null,
      "start_ms": 91,
      "end_ms": 93
    },
    "46": {
      "title": "قوله: (وإن القرآن كلام الله، منه بدا بلا كيفية قولا، وأنزله على رسوله وحيا، وصدقه المؤمنون على ذلك حقا، وأيقنوا أنه كلام الله تعالى بالحقيقة،",
      "level": 1,
      "parent": null,
      "start_ms": 93,
      "end_ms": 105
    },
    "47": {
      "title": "قوله\"بلا كيفية\"",
      "level": 1,
      "parent": null,
      "start_ms": 105,
      "end_ms": 107
    },
    "48": {
      "title": "قوله: \"وصدقه المؤمنون على ذلك حقا\"",
      "level": 1,
      "parent": null,
      "start_ms": 107,
      "end_ms": 107
    },
    "49": {
      "title": "قوله: وأيقنوا أنه كلام الله تعالى بالحقيقة ليس بمخلوق ككلام البرية.",
      "level": 1,
      "parent": null,
      "start_ms": 107,
      "end_ms": 111
    },
    "50": {
      "title": "قوله: (ومن سمعه، وقال: إنه كلام البشر، فقد كفر)",
      "level": 1,
      "parent": null,
      "start_ms": 111,
      "end_ms": 111
    },
    "51": {
      "title": "قوله: (ولا يشبه قول البشر)",
      "level": 1,
      "parent": null,
      "start_ms": 111,
      "end_ms": 112
    },
    "52": {
      "title": "قوله: (ومن وصف الله بمعنى من معاني البشر، فقد كفر. من أبصر هذا اعتبر. وعن مثل قول الكفار انزجر. وعلم أن الله بصفاته ليس كالبشر).",
      "level": 1,
      "parent": null,
      "start_ms": 112,
      "end_ms": 112
    },
    "53": {
      "title": "قوله: (والرؤية حق لأهل الجنة،",
      "level": 1,
      "parent": null,
      "start_ms": 112,
      "end_ms": 121
    },
    "54": {
      "title": "قوله: \"بغير إحاطة ولا كيفية\"",
      "level": 1,
      "parent": null,
      "start_ms": 121,
      "end_ms": 123
    },
    "55": {
      "title": "قوله: \"فإنه ما سلم في دينه إلا من سلم لله عز وجل ولرسوله صلى الله عليه وسلم، ورد علم ما اشتبه عليه إلى عالمه\".",
      "level": 1,
      "parent": null,
      "start_ms": 123,
      "end_ms": 125
    },
    "56": {
      "title": "قوله: (ولا تثبت قدم الإسلام إلا على ظهر التسليم والاستسلام).",
      "level": 1,
      "parent": null,
      "start_ms": 125,
      "end_ms": 127
    },
    "57": {
      "title": "قوله: (فمن رام علم ما حظر عنه علمه، ولم يقنع بالتسليم فهمه، حجبه مرامه عن خالص التوحيد، وصافي المعرفة، وصحيح الإيمان).",
      "level": 1,
      "parent": null,
      "start_ms": 127,
      "end_ms": 132
    },
    "58": {
      "title": "قوله: (فيتذبذب بين الكفر والإيمان، والتصديق والتكذيب، والإقرار والإنكار، موسوسا تائها، شاكا، لا مؤمنا مصدقا، ولا جاحدا مكذبا).",
      "level": 1,
      "parent": null,
      "start_ms": 132,
      "end_ms": 134
    },
    "59": {
      "title": "قوله: (ولا يصح الإيمان بالرؤية لأهل دار السلام لمن اعتبرها منهم بوهم،",
      "level": 1,
      "parent": null,
      "start_ms": 134,
      "end_ms": 136
    },
    "60": {
      "title": "قوله: ومن لم يتوق النفي والتشبيه، زل ولم يصب التنزيه",
      "level": 1,
      "parent": null,
      "start_ms": 136,
      "end_ms": 136
    },
    "61": {
      "title": "قوله: \"أو تأولها بفهم\"",
      "level": 1,
      "parent": null,
      "start_ms": 136,
      "end_ms": 140
    },
    "62": {
      "title": "قوله: (ومن لم يتوق النفي والتشبيه، زل ولم يصب التنزيه).",
      "level": 1,
      "parent": null,
      "start_ms": 140,
      "end_ms": 141
    },
    "63": {
      "title": "قوله: (فإن ربنا جل وعلا موصوف بصفات الوحدانية، منعوت بنعوت الفردانية، ليس في معناه أحد من البرية).",
      "level": 1,
      "parent": null,
      "start_ms": 141,
      "end_ms": 141
    },
    "64": {
      "title": "وله: (وتعالى عن الحدود والغايات، والأركان والأعضاء والأدوات، لا تحويه الجهات الست كسائر المبتدعات).",
      "level": 1,
      "parent": null,
      "start_ms": 141,
      "end_ms": 147
    },
    "65": {
      "title": "قوله: (والمعراج حق، وقد أسري بالنبي صلى الله عليه وسلم وعرج بشخصه في اليقظة، إلى السماء. ثم إلى حيث شاء الله من العلا وأكرمه الله بما شاء، وأوحى إليه",
      "level": 1,
      "parent": null,
      "start_ms": 147,
      "end_ms": 150
    },
    "66": {
      "title": "قوله: (والحوض - الذي أكرمه الله تعالى به غياثا لأمته - حق).",
      "level": 1,
      "parent": null,
      "start_ms": 150,
      "end_ms": 152
    },
    "67": {
      "title": "قوله: (والشفاعة التي ادخرها لهم حق، كما روي في الأخبار).",
      "level": 1,
      "parent": null,
      "start_ms": 152,
      "end_ms": 162
    },
    "68": {
      "title": "قوله: (والميثاق الذي أخذه الله تعالى من آدم وذريته حق).",
      "level": 1,
      "parent": null,
      "start_ms": 162,
      "end_ms": 169
    },
    "69": {
      "title": "قوله: (وقد علم الله تعالى فيما لم يزل (1) عدد من يدخل الجنة، وعدد من يدخل النار، جملة واحدة، فلا يزاد في ذلك العدد ولا ينقص منه. وكذلك أفعالهم فيما علم منهم أن يفعلوه).",
      "level": 1,
      "parent": null,
      "start_ms": 169,
      "end_ms": 170
    },
    "70": {
      "title": "قوله: (وكل ميسر لما خلق له، والأعمال بالخواتيم، والسعيد من سعد بقضاء الله، والشقي من شقي بقضاء الله).",
      "level": 1,
      "parent": null,
      "start_ms": 170,
      "end_ms": 171
    },
    "71": {
      "title": "قوله: (وأصل القدر سر الله تعالى في خلقه، لم يطلع على ذلك ملك مقرب، ولا نبي مرسل،",
      "level": 1,
      "parent": null,
      "start_ms": 171,
      "end_ms": 179
    },
    "72": {
      "title": "قوله: \"والتعمق والنظر في ذلك ذريعة الخذلان\"",
      "level": 1,
      "parent": null,
      "start_ms": 179,
      "end_ms": 180
    },
    "73": {
      "title": "قوله: \"فالحذر كل الحذر من ذلك نظرا وفكرا ووسوسة\"-",
      "level": 1,
      "parent": null,
      "start_ms": 180,
      "end_ms": 181
    },
    "74": {
      "title": "قوله: \"فمن سأل: لم فعل؟ فقد رد حكم الكتاب، ومن رد حكم الكتاب كان من الكافرين\".",
      "level": 1,
      "parent": null,
      "start_ms": 181,
      "end_ms": 183
    },
    "75": {
      "title": "قوله: (فهذا جملة ما يحتاج إليه من هو منور قلبه من أولياء الله تعالى،",
      "level": 1,
      "parent": null,
      "start_ms": 183,
      "end_ms": 183
    },
    "76": {
      "title": "قوله \"وهي درجة الراسخين في العلم\"",
      "level": 1,
      "parent": null,
      "start_ms": 183,
      "end_ms": 183
    },
    "77": {
      "title": "قوله: (ونؤمن باللوح والقلم، وبجميع ما فيه قد رقم).",
      "level": 1,
      "parent": null,
      "start_ms": 183,
      "end_ms": 185
    },
    "78": {
      "title": "قوله: (فلو اجتمع الخلق كلهم على شيء كتبه الله تعالى أنه كائن، ليجعلوه غير كائن - لم يقدروا عليه. ولو اجتمعوا كلهم على شيء لم يكتبه الله تعالى فيه، ليجعلوه كائنا - لم يقدروا عليه. جف القلم بما هو كائن إلى يوم القيامة).",
      "level": 1,
      "parent": null,
      "start_ms": 185,
      "end_ms": 188
    },
    "79": {
      "title": "قوله: (وما أخطأ العبد لم يكن ليصيبه، وما أصابه لم يكن ليخطئه).",
      "level": 1,
      "parent": null,
      "start_ms": 188,
      "end_ms": 188
    },
    "80": {
      "title": "قوله: (وعلى العبد أن يعلم أن الله قد سبق علمه في كل كائن من خلقه، فقدر ذلك تقديرا محكما مبرما، ليس فيه ناقض، ولا معقب ولا مزيل ولا مغير، ولا ناقص ولا زائد من خلقه في سماواته وأرضه).",
      "level": 1,
      "parent": null,
      "start_ms": 188,
      "end_ms": 190
    },
    "81": {
      "title": "قوله: (وذلك من عقد الإيمان وأصول المعرفة والاعتراف بتوحيد الله تعالى وربوبيته، كما قال تعالى في كتابه: {وخلق كل شيء فقدره تقديرا} (1). وقال تعالى: {وكان أمر الله قدرا مقدورا}",
      "level": 1,
      "parent": null,
      "start_ms": 190,
      "end_ms": 192
    },
    "82": {
      "title": "قوله: (فويل لمن صار قلبه في القدر قلبا سقيما (1)، لقد التمس بوهمه في فحص الغيب سرا كتيما، وعاد بما قال فيه أفاكا أثيما).",
      "level": 1,
      "parent": null,
      "start_ms": 192,
      "end_ms": 194
    },
    "83": {
      "title": "وقوله: (والعرش والكرسي حق).",
      "level": 1,
      "parent": null,
      "start_ms": 194,
      "end_ms": 208
    },
    "84": {
      "title": "قوله: (ونقول: إن الله اتخذ إبراهيم خليلا، وكلم الله موسى تكليما، إيمانا وتصديقا وتسليما).",
      "level": 1,
      "parent": null,
      "start_ms": 208,
      "end_ms": 212
    },
    "85": {
      "title": "قوله: (ونؤمن بالملائكة والنبيين، والكتب المنزلة على المرسلين، ونشهد أنهم كانوا على الحق المبين).",
      "level": 1,
      "parent": null,
      "start_ms": 212,
      "end_ms": 224
    },
    "86": {
      "title": "قوله: (ونسمي أهل قبلتنا مسلمين مؤمنين، ما داموا بما جاء به النبي صلى الله عليه وسلم معترفين، وله بكل ما قاله وأخبر مصدقين).",
      "level": 1,
      "parent": null,
      "start_ms": 224,
      "end_ms": 224
    },
    "87": {
      "title": "قوله: (ولا نخوض في الله، ولا نماري في دين الله).",
      "level": 1,
      "parent": null,
      "start_ms": 224,
      "end_ms": 225
    },
    "88": {
      "title": "قوله: (ولا نجادل في القرآن، ونشهد أنه كلام رب العالمين،",
      "level": 1,
      "parent": null,
      "start_ms": 225,
      "end_ms": 226
    },
    "89": {
      "title": "قوله: (نزل به الروح الأمين)،",
      "level": 1,
      "parent": null,
      "start_ms": 226,
      "end_ms": 227
    },
    "90": {
      "title": "قوله: (ولا نكفر أحدا من أهل القبلة بذنب، ما لم يستحله، ولا نقول لا يضر مع الإيمان ذنب لمن عمله).",
      "level": 1,
      "parent": null,
      "start_ms": 227,
      "end_ms": 235
    },
    "91": {
      "title": "قوله: (ونرجو للمحسنين من المؤمنين أن يعفو عنهم ويدخلهم الجنة برحمته، ولا نأمن عليهم، ولا نشهد لهم بالجنة، ونستغفر لمسيئهم، ونخاف عليهم، ولا نقنطهم).",
      "level": 1,
      "parent": null,
      "start_ms": 235,
      "end_ms": 240
    },
    "92": {
      "title": "قوله: (والأمن [والإياس ينقلان] (1) عن ملة الإسلام، وسبيل الحق بينهما لأهل القبلة).",
      "level": 1,
      "parent": null,
      "start_ms": 240,
      "end_ms": 241
    },
    "93": {
      "title": "قوله: (ولا يخرج العبد من الإيمان إلا بجحود ما أدخله فيه).",
      "level": 1,
      "parent": null,
      "start_ms": 241,
      "end_ms": 241
    },
    "94": {
      "title": "قوله: (والإيمان: هو الإقرار باللسان، والتصديق بالجنان. وجميع ما صح عن رسول الله صلى الله عليه وسلم من الشرع والبيان كله حق. والإيمان واحد، وأهله في أصله سواء، والتفاضل بينهم بالخشية والتقى، ومخالفة الهوى، وملازمة الأولى).",
      "level": 1,
      "parent": null,
      "start_ms": 241,
      "end_ms": 261
    },
    "95": {
      "title": "قوله: \"وجميع ما صح عن رسول الله صلى الله عليه وسلم من الشرع والبيان كله حق\".",
      "level": 1,
      "parent": null,
      "start_ms": 261,
      "end_ms": 264
    },
    "96": {
      "title": "قوله: (والمؤمنون كلهم أولياء الرحمن).",
      "level": 1,
      "parent": null,
      "start_ms": 264,
      "end_ms": 267
    },
    "97": {
      "title": "قوله: (وأكرمهم عند الله أطوعهم وأتبعهم للقرآن).",
      "level": 1,
      "parent": null,
      "start_ms": 267,
      "end_ms": 268
    },
    "98": {
      "title": "قوله: (والإيمان: هو الإيمان بالله، وملائكته، وكتبه، ورسله، واليوم الآخر، والقدر، خيره وشره، وحلوه ومره، من الله تعالى).",
      "level": 1,
      "parent": null,
      "start_ms": 268,
      "end_ms": 275
    },
    "99": {
      "title": "قوله: (ونحن مؤمنون بذلك كله، لا نفرق بين أحد من رسله، ونصدقهم كلهم على ما جاءوا به).",
      "level": 1,
      "parent": null,
      "start_ms": 275,
      "end_ms": 276
    },
    "100": {
      "title": "قوله: (وأهل الكبائر من أمة محمد صلى الله عليه وسلم في النار لا يخلدون، إذا ماتوا وهم موحدون",
      "level": 1,
      "parent": null,
      "start_ms": 276,
      "end_ms": 278
    },
    "101": {
      "title": "قوله\"وإن لم يكونوا تائبين\"-",
      "level": 1,
      "parent": null,
      "start_ms": 278,
      "end_ms": 278
    },
    "102": {
      "title": "قوله: \"بعد أن لقوا الله تعالى عارفين\"-",
      "level": 1,
      "parent": null,
      "start_ms": 278,
      "end_ms": 278
    },
    "103": {
      "title": "قوله\"وهم في مشيئة الله وحكمه، إن شاء غفر لهم وعفا عنهم بفضله\"،",
      "level": 1,
      "parent": null,
      "start_ms": 278,
      "end_ms": 279
    },
    "104": {
      "title": "\"ذلك أن الله مولى أهل معرفته\"-",
      "level": 1,
      "parent": null,
      "start_ms": 279,
      "end_ms": 279
    },
    "105": {
      "title": "وقوله: \"اللهم يا ولي الإسلام وأهله مسكنا بالإسلام\"وفي نسخة\"ثبتنا على الإسلام حتى نلقاك به\"-",
      "level": 1,
      "parent": null,
      "start_ms": 279,
      "end_ms": 279
    },
    "106": {
      "title": "قوله: (ونرى الصلاة خلف كل بر وفاجر من أهل القبلة، وعلى من مات منهم).",
      "level": 1,
      "parent": null,
      "start_ms": 279,
      "end_ms": 283
    },
    "107": {
      "title": "قوله: (ولا ننزل أحدا منهم جنة ولا نارا).",
      "level": 1,
      "parent": null,
      "start_ms": 283,
      "end_ms": 284
    },
    "108": {
      "title": "قوله: (ولا نشهد عليهم بكفر ولا بشرك ولا بنفاق، ما لم يظهر منهم شيء من ذلك، ونذر سرائرهم إلى الله تعالى).",
      "level": 1,
      "parent": null,
      "start_ms": 284,
      "end_ms": 284
    },
    "109": {
      "title": "قوله: (ولا نرى [القتل] (4) على أحد من أمة محمد صلى الله عليه وسلم إلا من وجب عليه السيف).",
      "level": 1,
      "parent": null,
      "start_ms": 284,
      "end_ms": 285
    },
    "110": {
      "title": "قوله: (ولا نرى الخروج على أئمتنا وولاة أمورنا، وإن جاروا، ولا ندعو عليهم، ولا ننزع يدا من طاعتهم، ونرى طاعتهم من طاعة الله عز وجل فريضة، ما لم يأمروا بمعصية،",
      "level": 1,
      "parent": null,
      "start_ms": 285,
      "end_ms": 287
    },
    "111": {
      "title": "قوله: (ونتبع السنة والجماعة، ونجتنب الشذوذ والخلاف والفرقة).",
      "level": 1,
      "parent": null,
      "start_ms": 287,
      "end_ms": 288
    },
    "112": {
      "title": "قوله: (ونحب أهل العدل والأمانة، ونبغض أهل الجور والخيانة).",
      "level": 1,
      "parent": null,
      "start_ms": 288,
      "end_ms": 289
    },
    "113": {
      "title": "قوله: (ونقول: الله أعلم، فيما اشتبه علينا علمه).",
      "level": 1,
      "parent": null,
      "start_ms": 289,
      "end_ms": 290
    },
    "114": {
      "title": "قوله: (ونرى المسح على الخفين، في السفر والحضر، كما جاء في الأثر).",
      "level": 1,
      "parent": null,
      "start_ms": 290,
      "end_ms": 292
    },
    "115": {
      "title": "قوله: (والحج والجهاد ماضيان مع أولي الأمر من المسلمين، برهم وفاجرهم، إلى قيام الساعة، لا يبطلهما شيء ولا ينقضهما).",
      "level": 1,
      "parent": null,
      "start_ms": 292,
      "end_ms": 293
    },
    "116": {
      "title": "قوله: (ونؤمن بالكرام الكاتبين، فإن الله قد جعلهم علينا حافظين).",
      "level": 1,
      "parent": null,
      "start_ms": 293,
      "end_ms": 294
    },
    "117": {
      "title": "قوله: (ونؤمن بملك الموت، الموكل بقبض أرواح العالمين).",
      "level": 1,
      "parent": null,
      "start_ms": 294,
      "end_ms": 299
    },
    "118": {
      "title": "قوله: (وبعذاب القبر لمن كان له أهلا، وسؤال منكر ونكير في قبره عن ربه ودينه ونبيه، على ما جاءت به الأخبار عن رسول الله صلى الله عليه وسلم، وعن الصحابة رضوان الله عليهم. و",
      "level": 1,
      "parent": null,
      "start_ms": 299,
      "end_ms": 307
    },
    "119": {
      "title": "قوله: (ونؤمن بالبعث",
      "level": 1,
      "parent": null,
      "start_ms": 307,
      "end_ms": 313
    },
    "120": {
      "title": "قوله: \"وجزاء الأعمال\"-",
      "level": 1,
      "parent": null,
      "start_ms": 313,
      "end_ms": 314
    },
    "121": {
      "title": "قوله: \"والعرض والحساب، وقراءة الكتاب، والثواب والعقاب\"-",
      "level": 1,
      "parent": null,
      "start_ms": 314,
      "end_ms": 316
    },
    "122": {
      "title": "قوله\"والصراط\"-",
      "level": 1,
      "parent": null,
      "start_ms": 316,
      "end_ms": 317
    },
    "123": {
      "title": "قوله: \"والميزان\"-",
      "level": 1,
      "parent": null,
      "start_ms": 317,
      "end_ms": 320
    },
    "124": {
      "title": "قوله (والجنة والنار مخلوقتان،",
      "level": 1,
      "parent": null,
      "start_ms": 320,
      "end_ms": 324
    },
    "125": {
      "title": "قوله: \"لا تفنيان أبدا ولا تبيدان\"-",
      "level": 1,
      "parent": null,
      "start_ms": 324,
      "end_ms": 328
    },
    "126": {
      "title": "قوله: \"وخلق لهما أهلا\"-",
      "level": 1,
      "parent": null,
      "start_ms": 328,
      "end_ms": 329
    },
    "127": {
      "title": "قوله: \"فمن شاء منهم إلى الجنة فضلا منه، ومن شاء منهم إلى النار عدلا منه\"",
      "level": 1,
      "parent": null,
      "start_ms": 329,
      "end_ms": 330
    },
    "128": {
      "title": "قوله: (والاستطاعة التي يجب بها الفعل، من نحو التوفيق الذي لا يجوز أن يوصف المخلوق به - تكون مع الفعل. وأما الاستطاعة من جهة الصحة والوسع، والتمكين وسلامة الآلات - فهي قبل الفعل، وبها يتعلق الخطاب، وهو كما قال تعالى: {لا يكلف الله نفسا إل",
      "level": 1,
      "parent": null,
      "start_ms": 330,
      "end_ms": 334
    },
    "129": {
      "title": "قوله: (وأفعال العباد خلق الله وكسب من العباد).",
      "level": 1,
      "parent": null,
      "start_ms": 334,
      "end_ms": 341
    },
    "130": {
      "title": "قوله: (ولم يكلفهم الله تعالى إلا ما يطيقون، ولا يطيقون إلا ما كلفهم.",
      "level": 1,
      "parent": null,
      "start_ms": 341,
      "end_ms": 344
    },
    "131": {
      "title": "قوله: \"وكل شيء يجري بمشيئة الله وعلمه وقضائه وقدره\".",
      "level": 1,
      "parent": null,
      "start_ms": 344,
      "end_ms": 345
    },
    "132": {
      "title": "قوله: \"يفعل ما يشاء، وهو غير ظالم أبدا\"-",
      "level": 1,
      "parent": null,
      "start_ms": 345,
      "end_ms": 348
    },
    "133": {
      "title": "قوله: (وفي دعاء الأحياء وصدقاتهم منفعة للأموات).",
      "level": 1,
      "parent": null,
      "start_ms": 348,
      "end_ms": 354
    },
    "134": {
      "title": "[قوله]: (والله تعالى يستجيب الدعوات، ويقضي الحاجات).",
      "level": 1,
      "parent": null,
      "start_ms": 354,
      "end_ms": 359
    },
    "135": {
      "title": "قوله: (ويملك كل شيء، ولا يملكه شيء. ولا غنى عن الله تعالى طرفة عين، ومن استغنى عن الله طرفة عين، فقد كفر وصار من أهل الحين).",
      "level": 1,
      "parent": null,
      "start_ms": 359,
      "end_ms": 359
    },
    "136": {
      "title": "قوله: (والله يغضب ويرضى، لا كأحد من الورى).",
      "level": 1,
      "parent": null,
      "start_ms": 359,
      "end_ms": null
    }
  },
