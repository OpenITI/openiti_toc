      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "70": {
      "title": ": «من حلف على يمين فرأى خيرا منها فليكفر عن يمينه ويفعل الذي هو خير»",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
