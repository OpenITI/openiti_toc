      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "62": {
      "title": ": «الذهب بالذهب الكفة بالكفة، والفضة بالفضة الكفة بالكفة» .",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
