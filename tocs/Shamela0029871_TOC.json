      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "64": {
      "title": ": «لا بد للعرس من وليمة» .",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "65": {
      "title": "33 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 10
    },
    "66": {
      "title": ": «النجوم أمان لأهل السماء، وأهل بيتي أمان لأهل الأرض»",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "67": {
      "title": "34 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "68": {
      "title": ": «لا يزال الله عز وجل في حاجة العبد ما دام العبد في حاجة أخيه»",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "69": {
