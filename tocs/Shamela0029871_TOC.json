    "2": {
      "title": ": كنت أدخل على رسول الله صلى الله عليه وسلم ليلا ونهارا، وكنت إذا سألته أجابني وإن سكت",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "3": {
      "title": "2 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 2
    },
    "4": {
      "title": ": \" لا سهم في الإسلام لمن لا صلاة له، ولا صلاة لمن لا وضوء له، ولا وضوء لمن لم يذكر الله",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "5": {
      "title": "3 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "6": {
      "title": ": «بشر المشائين في الظلم إلى المساجد أنهم يوم القيامة على منابر من نور، يفزع الناس ولا",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "7": {
      "title": "4 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "8": {
      "title": ": «نحلت إبراهيم خلتي، وكلمت موسى تكليما، وأعطيت يا محمد كفاحا»",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "9": {
      "title": "5 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "10": {
      "title": ": «هلا استمتعتم بإهابها» .",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "11": {
      "title": "6 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 3
    },
    "12": {
      "title": ": «من صلى ms02 الغداة فهو في ذمة الله، فلا يطلبنكم الله بشيء من ذمته»",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "13": {
      "title": "7 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "14": {
      "title": ": \" بينما إبراهيم صلى الله عليه يسير في أرض جبار من الجبابرة ومعه سارة عليهما السلام، إذ سعي",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 4
    },
    "15": {
      "title": "8 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "16": {
      "title": ": «من ملك سمعه وبصره ولسانه غفر الله له»",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "17": {
      "title": "9 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "18": {
      "title": ": أجلس رسول الله صلى الله عليه وسلم الحسن والحسين على فخذيه، وفاطمة رضي الله عنهم في حجره،",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "19": {
      "title": "10 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "20": {
      "title": ": «إن الله بعثني إلى كل أحمر وأسود، ونصرت بالرعب، وأحل لي المغنم، وجعلت لي الأرض مسجدا",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "21": {
      "title": "11 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 5
    },
    "22": {
      "title": ": «يغفر للشهيد في سبيل الله خطاياه إلا الدين، هكذا قال جبريل»",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "23": {
      "title": "12 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "24": {
      "title": "بإهراق الخمر، وقال: «إن الذي حرم شربها حرم بيعها»",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "25": {
      "title": "13 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "26": {
      "title": ": «حبك الشيء يعمي ويصم»",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "27": {
      "title": "14 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "28": {
      "title": ": «إن الله عز وجل يبغض المشائين بالنميمة، المفرقين بين الأحبة»",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "29": {
      "title": "15 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "30": {
      "title": ": «اخبر تقله»",
      "level": 1,
