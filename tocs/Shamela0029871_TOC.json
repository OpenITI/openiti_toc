      "title": "36 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "72": {
      "title": ": «من سأل القضاء وكل إليه، ومن جبر عليه نزل عليه ملك يسدده»",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
