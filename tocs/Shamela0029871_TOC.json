    },
    "56": {
      "title": ": «إذا اشتريت الذهب بالفضة أحدهما بالآخر فلا يفارقك صاحبك وبينك وبينه لبس»",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "57": {
      "title": "29 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "58": {
      "title": ": «الذهب بالذهب، والفضة بالفضة، والتمر بالتمر، والبر بالبر، والشعير بالشعير، والملح بالملح،",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "59": {
      "title": "30 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "60": {
      "title": ": «الذهب بالذهب، والفضة بالفضة، والبر بالبر، والشعير بالشعير، والتمر بالتمر، والملح بالملح،",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
