  "sections": {
    "1": {
      "title": "[مقدمة المؤلف]",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 3
    },
    "2": {
      "title": "الباب الأول في سياقة تواريخ سني ملوك الفرس على طبقاتهم الأربع، وما حدث في أزمنة ملكهم من ظهور الأنبياء عليهم بجانب المغرب وهو خمسة فصول.",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 33
    },
    "3": {
      "title": "الفصل الاول من الباب الأول في ذكر طبقات ملوك الفرس الأربع ذكرا مرسلا مجردا من الأخبار والسير والأوصاف.",
      "level": 2,
      "parent": 2,
      "start_ms": 3,
      "end_ms": 8
    },
    "4": {
      "title": "الطبقة الاولى الفيشدادية وعددهم تسعة، ومدة زمان ملكهم مع سني كل شاه ألفان وأربعماية وسبعون سنة",
      "level": 3,
      "parent": 3,
      "start_ms": 6,
      "end_ms": 6
    },
    "5": {
      "title": "الطبقة الثانية الكيانية وعددهم عشرة، ومدة زمان ملكهم سبعماية وثمان وسبعون سنة",
      "level": 3,
      "parent": 3,
      "start_ms": 6,
      "end_ms": 6
    },
    "6": {
      "title": "الطبقة الثالثة الاشغانية وعددهم أحد عشر، ومدة زمان ملكهم ثلثماية وأربع وأربعون سنة",
      "level": 3,
      "parent": 3,
      "start_ms": 6,
      "end_ms": 7
    },
    "7": {
      "title": "الطبقة الرابعة الساسانية وعددهم ثمانية وعشرون، ومدة زمان ملكهم أربع ماية وتسع وعشرون سنة وثلاثة أشهر وثمانية عشر يوما",
      "level": 3,
      "parent": 3,
      "start_ms": 7,
      "end_ms": 8
    },
    "8": {
      "title": "الفصل الثاني من الباب الأول في إعادة ذكر بعض ما مضى في الفصل الأول من التاريخ مع شرح له، أتى به موسى بن عيسى الكسروي في كتابه.",
      "level": 2,
      "parent": 2,
      "start_ms": 8,
      "end_ms": 12
    },
    "9": {
      "title": "الفصل الثالث من الباب الأول في اعادة ذكر كل ما مضى في الفصل الأول من التاريخ مع شرح له.",
      "level": 2,
      "parent": 2,
      "start_ms": 12,
      "end_ms": 14
    },
