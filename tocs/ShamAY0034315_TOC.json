  "sections": {
    "1": {
      "title": "AUTO أما بعد: فإن البدع ثلاثة أضرب (¬3).",
      "level": 2,
      "parent": null,
      "start_ms": 1,
      "end_ms": 5
    },
    "2": {
      "title": "AUTO فأما ما يختص به العلماء فضربان:",
      "level": 2,
      "parent": 1,
      "start_ms": 2,
      "end_ms": 2
    },
    "3": {
      "title": "AUTO وأما ما يعم العالم والجاهل فمن وجوه:",
      "level": 2,
      "parent": 1,
      "start_ms": 2,
      "end_ms": 3
    },
    "4": {
      "title": "AUTO ومما يدل على ابتداع هذه الصلاة، أن العلماء الذين هم أعلام",
      "level": 2,
      "parent": 1,
      "start_ms": 3,
      "end_ms": 4
    },
    "5": {
      "title": "AUTO وليس لأحد أن يستدل بما روي عن رسول الله صلى الله عليه وسلم",
      "level": 2,
      "parent": 1,
      "start_ms": 4,
      "end_ms": 4
    },
    "6": {
      "title": "CHECK [وقد بلغني أن رجلين ممن تصدى للفتيا مع بعدهما عنها سعيا في",
      "level": 2,
      "parent": 1,
      "start_ms": 4,
      "end_ms": 5
    },
    "7": {
      "title": "AUTO الرد على الترغيب عن صلاة الرغائب الموضوعة وبيان ما فيها من",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 10
    },
    "8": {
      "title": "AUTO هذه الصلاة شاعت بين الناس بعد المائة الرابعة، ولم تكن تعرف،",
      "level": 2,
      "parent": 7,
      "start_ms": 6,
      "end_ms": 6
    },
    "9": {
      "title": "AUTO ثم إنه لا يلزم من ضعف الحديث بطلان صلاة الرغائب والمنع منها،",
      "level": 2,
      "parent": 7,
      "start_ms": 6,
      "end_ms": 7
    },
    "10": {
      "title": "AUTO وكم من صلاة مقبولة مشتملة على وصف خاص لم يرد بوصفها ذلك نص",
      "level": 2,
      "parent": 7,
      "start_ms": 7,
      "end_ms": 7
    },
    "11": {
      "title": "AUTO أحدها: ما فيها من تكرار السورة.",
      "level": 2,
      "parent": 7,
      "start_ms": 7,
      "end_ms": 8
    },
    "12": {
      "title": "AUTO الثاني: السجدتان الفردتان عقيب هذه الصلاة، وقد اختلف ms07 أئمتنا",
      "level": 2,
      "parent": 7,
      "start_ms": 8,
      "end_ms": 8
    },
    "13": {
      "title": "AUTO الثالث: ما فيها من التقييد بعدد خاص من غير قصد، وهذا قريب",
      "level": 2,
      "parent": 7,
      "start_ms": 8,
      "end_ms": 8
    },
    "14": {
      "title": "AUTO الرابع: أن ما فيها من عدد السور والتسبيح وغيرهما مكروه",
      "level": 2,
      "parent": 7,
      "start_ms": 8,
      "end_ms": 8
    },
    "15": {
      "title": "AUTO الخامس: فعلها جماعة، مع أن الجماعة في النوافل مخصوصة",
      "level": 2,
      "parent": 7,
      "start_ms": 8,
      "end_ms": 9
    },
    "16": {
      "title": "AUTO السادس: أن هذه الصلاة صارت شعارا ظاهرا حادثا ويمتنع إظهار",
      "level": 2,
      "parent": 7,
      "start_ms": 9,
      "end_ms": 9
    },
    "17": {
      "title": "AUTO وقد احتج المنازع بأشياء أخر لا تساوي الذكر، ومما يجاب به",
      "level": 2,
      "parent": 7,
      "start_ms": 9,
      "end_ms": 10
    },
    "18": {
      "title": "AUTO تفنيد رد ابن الصلاح",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 17
    },
    "19": {
      "title": "AUTO وإنما أنكرتها لمجموع صفاتها وخصائصها التي بعضها يقتضي",
      "level": 2,
      "parent": 18,
      "start_ms": 10,
      "end_ms": 11
    },
    "20": {
      "title": "AUTO وأما المثل الذي ذكره في قوله تعالى {أرأيت الذي ينهى عبدا إذا",
      "level": 2,
      "parent": 18,
      "start_ms": 11,
      "end_ms": 11
    },
    "21": {
      "title": "AUTO ثم اعترف أنها بدعة موضوعة، فنحتج عليه إذا بقول رسول الله صلى",
      "level": 2,
      "parent": 18,
      "start_ms": 11,
      "end_ms": 11
    },
    "22": {
      "title": "AUTO وأما استدلاله بقوله صلى الله عليه وسلم: ((الصلاة نور))",
      "level": 2,
      "parent": 18,
      "start_ms": 11,
      "end_ms": 12
    },
    "23": {
      "title": "AUTO وأما استدلاله بما أخرجه الترمذي تعليقا من حديث عائشة رضي",
      "level": 2,
      "parent": 18,
      "start_ms": 12,
      "end_ms": 12
    },
    "24": {
      "title": "AUTO وأما ما ذكره من أحداث الصلوات التي توقع على أوصاف خاصة؛",
      "level": 2,
      "parent": 18,
      "start_ms": 12,
      "end_ms": 13
    },
    "25": {
      "title": "AUTO وأما نسبته المنكر لصلاة الرغائب إلى أنه أنكر تكرار السور،",
      "level": 2,
      "parent": 18,
      "start_ms": 13,
      "end_ms": 14
    },
    "26": {
      "title": "AUTO وأما تأويله كراهة بعض أئمة الحديث لذلك، بأنه محمول على ترك",
      "level": 2,
      "parent": 18,
      "start_ms": 14,
      "end_ms": 14
    },
    "27": {
      "title": "AUTO وأما قوله: يجوز الاقتداء في نوافل الصلوات.",
      "level": 2,
      "parent": 18,
      "start_ms": 14,
      "end_ms": 15
    },
    "28": {
      "title": "AUTO وأما نسبته المنكر إلى أنه قال: إن هذه الصلاة صارت شعارا",
      "level": 2,
      "parent": 18,
