      "start_ms": 2,
      "end_ms": 2
    },
    "15": {
      "title": ": «يكون عليكم أمراء يؤخرون الصلاة فصلوا الصلاة لوقتها ثم صلوها معهم»",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "16": {
      "title": "8 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "17": {
      "title": "لا تسأل الإمارة فإنك إن أعطيتها عن مسألة وكلت إليها والتي أعطيتها عن غير مسألة أعنت عليها",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "18": {
      "title": "9 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "19": {
      "title": ": «لو آمن بي عشرة من اليهود ما بقي على ظهرها يهودي إلا أسلم»",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "20": {
      "title": "10 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "21": {
      "title": ": «مثل أمتي مثل المطر لا يدرى أوله خير أو آخره»",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "22": {
      "title": "11 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "23": {
      "title": ": «من غرس غرسا فأكل منه سبع أو طائر كان له أجر»",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "24": {
      "title": "12 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 3
    },
    "25": {
      "title": "أهل الدرجات العلى ليراهم من أسفل منهم كما ترون الكوكب الدري في أفق السماء وإن أبا بكر",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "26": {
      "title": "13 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "27": {
      "title": ": «ليس شيء أكرم على الله من الدعاء»",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "28": {
      "title": "14 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "29": {
      "title": ": «ويل للعراقيب من النار»",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "30": {
      "title": "15 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "31": {
      "title": ": «هذا يوم عاشوراء فصوموه فإن رسول الله صلى الله عليه وسلم أمر بصيامه»",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "32": {
      "title": "16 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "33": {
      "title": ": «لعن رسول الله صلى الله عليه وسلم المتشبهين من الرجال بالنساء والمتشبهات من النساء",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "34": {
      "title": "17 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "35": {
      "title": "[ص: 40]",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "36": {
      "title": "18 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "37": {
      "title": "أي العمل كان أحب إلى رسول الله صلى الله عليه وسلم؟ قالت: «أدومه وإن قل»",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "38": {
      "title": "19 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 4
    },
    "39": {
      "title": "أي الليل كان يوتر رسول الله صلى الله عليه وسلم؟ قالت: «إذا سمع الصارخ» تعني",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "40": {
      "title": "20 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "41": {
      "title": "، {هل في ذلك قسم لذي حجر} [الفجر: 5] قال: «لذي لب»",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "42": {
      "title": "21 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "43": {
      "title": "ماذا عملت فيما علمت \"",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "44": {
      "title": "22 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
