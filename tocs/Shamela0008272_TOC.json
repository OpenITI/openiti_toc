      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "54": {
      "title": ": «أمر رسول الله صلى الله عليه وسلم أن يسجد على سبع ولا يكف شعرا ولا ثوبا»",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "55": {
      "title": "28 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "56": {
      "title": ": «من ترك أربع جمع متواليات من غير عذر فقد نبذ الإسلام وراء ظهره»",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "57": {
      "title": "29 -",
      "level": 1,
