    "2": {
      "title": ": «من غشنا فليس منا والمكر والخداع في النار»",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "3": {
      "title": "2 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "4": {
      "title": ": «من كذب علي متعمدا فليتبوأ مقعده من النار»",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "5": {
      "title": "3 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "6": {
      "title": ": «لو أن العلم معلق بالثريا لتناوله رجال من أبناء فارس»",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "7": {
      "title": "4 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "8": {
      "title": "[ص: 25]",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "9": {
      "title": ": «من قتل عبده قتلناه ومن جدع عبده جدعناه»",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "10": {
      "title": "5 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "11": {
      "title": ": \" أمر بلال أن يشفع الأذان وأن يوتر الإقامة",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "12": {
      "title": "[ص: 28]",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "13": {
