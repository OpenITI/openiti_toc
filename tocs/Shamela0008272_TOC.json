      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "60": {
      "title": "رمى رجلا بحجر فقتله، فأتي به إلى النبي صلى الله عليه وسلم «فأقاد منه»",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "61": {
      "title": "31 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "62": {
      "title": ": «خشيت أن يكون عذابا سلط على أمتي»",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
