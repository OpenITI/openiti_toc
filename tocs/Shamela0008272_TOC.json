      "start_ms": 6,
      "end_ms": 6
    },
    "67": {
      "title": ": «من صلى في يوم اثنتي عشرة ركعة سوى المكتوبة بنى الله له بيتا في الجنة، ومن بنى مسجدا في",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
