      "title": ": «الحجر الأسود من حجارة الجنة»",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "46": {
      "title": ": «من مس فرجه فليتوضأ»",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "47": {
      "title": "24 -",
      "level": 1,
      "parent": null,
