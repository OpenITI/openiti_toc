    },
    "109": {
      "title": ": أصلح الله أمير المؤمنين، ما يظن أهل الشام أنه أتى عليهم يوم هو ms18 أبرد منه، قال: فذكر الدنيا",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "110": {
      "title": "53 -",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "111": {
      "title": ": الحمد لله، عشرين سنة أميرا، وعشرين سنة خليفة، ثم صرت إلى هذا",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "112": {
      "title": "54 -",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "113": {
      "title": ": فأشار لي إنسان إلى قبر عبد الملك بن مروان، فوقفت أنظر فمر عبادي فقال: لم وقفت هاهنا؟",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "114": {
      "title": "55 -",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "115": {
      "title": ": \" أنت عبد الملك الذي كنت تعدني فأرجوك، وتوعدني فأخافك أصبحت وليس معك من ملكك غير ثوبيك،",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 20
    },
    "116": {
      "title": "[ص: 74]",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "117": {
      "title": "56 -",
