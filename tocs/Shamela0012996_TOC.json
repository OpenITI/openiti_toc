      "start_ms": 28,
      "end_ms": 28
    },
    "153": {
      "title": ": \" لما دفن هشام بن عبد الملك وقف مولى له على قبره، فقال: يا أمير المؤمنين، فعل بنا بعدك كذا،",
      "level": 1,
