      "title": "61 -",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "125": {
      "title": ": \" دخلت دار المورياني وهي خراب فقلت: يا دار ما فعل أهلك؟ فإذا أنا بمناد ينادي من أقصى الدار:",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "126": {
      "title": "62 -",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "127": {
      "title": ": \" دخلت دار المورياني فاستخرجت منها ثلاث آيات: {فتلك بيوتهم خاوية بما ظلموا} [النمل: 52] ،",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "128": {
      "title": "63 -",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "129": {
      "title": ": \" رفع المورياني إحدى رجليه على الأخرى، فقال: تاز شاه شاه أزين تيكي، قال: واي واي من الخير،",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "130": {
      "title": "64 -",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "131": {
      "title": ": «اللهم ادفع لخليفتك عن نفس سليمان المكروه، ثم لم يلبث أن فعل به ما فعل»",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "132": {
      "title": "65 -",
      "level": 1,
