{
  "filename": "0318AbuCarubaHarrani.Ahadith.Shamela0013098-ara1",
  "sections": {
    "1": {
      "title": ": «فمره فليراجعها فإذا طهرت ثم حاضت، ثم طهرت، فإن شاء فليمسكها، وإن أراد أن يطلقها فلا",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "2": {
      "title": "2 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "3": {
      "title": ": «مره فليمسكها حتى تحيض غير هذه الحيضة، ثم تطهر، فإن بدا له أن يطلقها فليطلقها كما أمر الله",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "4": {
      "title": "3 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "5": {
      "title": ": «فليراجعها، فإذا طهرت فليطلقها طاهرا أو حاملا»",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "6": {
      "title": "4 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 2
    },
    "7": {
      "title": "[ص: 32]",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "8": {
      "title": ": «لعلك تريدين أن ترجعي إلى رفاعة؟ لا، حتى تذوقي عسيلته ويذوق عسيلتك»",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "9": {
      "title": "5 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "10": {
      "title": ": «لا تحلين للأول، حتى تذوقي عسيلته، ويذوق عسيلتك الآخر»",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "11": {
      "title": "6 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "12": {
      "title": ": «تصلي المستحاضة، وإن قطر الدم على الحصير»",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "13": {
      "title": "7 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "14": {
      "title": "، فأمرها النبي صلى الله عليه وسلم، أن تنكح»",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "15": {
      "title": "8 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "16": {
      "title": "فأمرها النبي صلى الله عليه وسلم أن تتزوج»",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "17": {
      "title": "9 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 3
    },
    "18": {
      "title": ": «طلقها زوجها ثلاثا، فأتت النبي صلى الله عليه وسلم، فأمرها فانتقلت» ، فنزلت على عمرو بن أم",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "19": {
      "title": "10 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "20": {
      "title": "[ص: 36]",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "21": {
      "title": "11 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "22": {
      "title": ": «لا يحل لامرأة تؤمن بالله واليوم الآخر أن تحد على ميت فوق ثلاث إلا على",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "23": {
      "title": "12 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "24": {
      "title": ": «كان حرا»",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "25": {
      "title": "13 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "26": {
      "title": "[ص: 37]",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "27": {
      "title": ": «أنت أحق ما لم تنكحي»",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "28": {
      "title": "14 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 4
    },
    "29": {
      "title": "، هذا أبوك , وهذه أمك، فخذ بيد أيهما شئت» ، فأخذ بيد أمه، فانطلقت",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "30": {
      "title": "15 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "31": {
      "title": "، هذا أبوك، وهذه أمك، فاختر أيهما شئت»",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "32": {
      "title": "16 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "33": {
      "title": ": «لا نكاح إلا بولي، والسلطان ولي من لا ولي له» .",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "34": {
      "title": "17 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "35": {
      "title": "18 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "36": {
      "title": ": «أيما امرأة أنكحت بغير إذن وليها فنكاحها باطل - ثلاث مرات - فإن كان دخل بها فلها الصداق",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "37": {
      "title": "19 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "38": {
      "title": ": \" لا نكاح إلا بولي - أو قال -: بإذن ولي",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "39": {
      "title": "20 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "40": {
      "title": ": «أيما امرأة زوجها وليان لها، فهي للأول منهما، ومن باع بيعا من رجلين فهو للأول",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "41": {
      "title": "21 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 5
    },
    "42": {
      "title": ": «تستأمر اليتيمة في نفسها، فإن سكتت فقد أذنت، وإن كرهت لم تكره»",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "43": {
      "title": "22 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "44": {
      "title": ": «اعتمر النبي صلى الله عليه وسلم ثلاث عمر قبل أن يحج»",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "45": {
      "title": "23 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "46": {
      "title": "، نهى أن تتخذ جلود السباع فرشا \" أو كما قال",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "47": {
      "title": "24 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "48": {
      "title": "، إذا مشى مشى مشيا مجتمعا، ليس فيه كسل»",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "49": {
      "title": "25 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "50": {
      "title": "، فلبى حتى رمى جمرة العقبة يوم النحر»",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "51": {
      "title": "26 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "52": {
      "title": "يصلي مع رسول الله صلى الله عليه وسلم ثم يأتي قومه فيؤمهم في الصلاة التي صلى مع رسول الله",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "53": {
      "title": "27 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "54": {
      "title": "[ص: 44]",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "55": {
      "title": ": \" {يوم يقوم الناس لرب العالمين} [المطففين: 6] يوم القيامة، حتى يبلغ الرشح أنصاف آذانهم \". قال",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "56": {
      "title": "28 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 6
    },
    "57": {
      "title": ": «لا طلاق إلا بعد نكاح»",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "58": {
      "title": "29 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "59": {
      "title": ": «فأحبي عائشة فإني أحبها» ، فقالت فاطمة: ما أقول لعائشة شيئا تكرهه",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "60": {
      "title": "30 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "61": {
      "title": ": «مقبوجا، مشقوجا تؤذي حبيبة رسول الله صلى الله عليه وسلم»",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "62": {
      "title": "31 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "63": {
      "title": "أنها زوجة رسول الله صلى الله عليه وسلم في الدنيا والآخرة» يعني عائشة",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "64": {
      "title": "32 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "65": {
      "title": ": «هذا جبريل يقرأ عليك السلام» ، قالت: وعليه السلام، ترى ما لا نرى",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "66": {
      "title": "33 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "67": {
      "title": ": هذه زوجتك في الدنيا والآخرة \"",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "68": {
      "title": "34 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "69": {
      "title": ": «كمل من الرجال كثير، ولم يكمل من النساء إلا مريم بنت عمران، وآسية امرأة فرعون، وفضل عائشة",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "70": {
      "title": "35 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 7
    },
    "71": {
      "title": ": «فضل عائشة على النساء كفضل الثريد على سائر الطعام»",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "72": {
      "title": "36 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "73": {
      "title": "السكينة تنطق على لسان عمر»",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "74": {
      "title": "37 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "75": {
      "title": ": «ما زلنا أعزة منذ أسلم عمر»",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "76": {
      "title": "38 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "77": {
      "title": ": \" تهادوا: تزدادوا خيرا، وهاجروا: تورثوا أبناءكم مجدا، وأقيلوا الكرام",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "78": {
      "title": "39 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "79": {
      "title": ": «ما نزل علي الوحي في لحاف امرأة منكن إلا في لحاف عائشة»",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "80": {
      "title": "40 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "81": {
      "title": "، إنكم سترون بعدي جفوة، فاستعينوا عليها بأرقاء الناس»",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "82": {
      "title": "41 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "83": {
      "title": ": \" إني سألت الله عز وجل لكم ثلاثا: أن يهدي ضالكم، ويعلم جاهلكم، ويثبت قائلكم، وسألت الله عز",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "84": {
      "title": "42 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 8
    },
    "85": {
      "title": "أمر بقتل الكلاب في الإحرام والحرم»",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "86": {
      "title": "43 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "87": {
      "title": ": «لا يحل لمسلم أن يهجر أخاه فوق ثلاث»",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "88": {
      "title": "44 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "89": {
      "title": ": «من أعتق رقبة، أعتق الله بكل عضو منها عضوا منه، حتى بفرجها فرجه»",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "90": {
      "title": "45 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "91": {
      "title": ": \" اغزوا؛ تغنموا، وصوموا؛ تصحوا، وسافروا: تصحوا \"",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "92": {
      "title": "46 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
