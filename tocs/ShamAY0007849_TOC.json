      "start_ms": 46,
      "end_ms": 49
    },
    "11": {
      "title": "AUTO ان الذين كفروا سواء عليهمءانذرتهم ام لم تنذرهم لايؤمنون 6",
      "level": 1,
      "parent": null,
      "start_ms": 49,
      "end_ms": 54
    },
    "12": {
      "title": "AUTO ختم الله على قلوبهم وعلى سمعهم وعلى ابصارهم غشاوة ولهم عذاب عظيم 7",
      "level": 1,
      "parent": null,
      "start_ms": 54,
      "end_ms": 62
    },
    "13": {
      "title": "AUTO ومن الناس من يقول امنا بالله وباليوم الآخر وما هم بمؤمنين 8",
      "level": 1,
      "parent": null,
      "start_ms": 62,
      "end_ms": 65
    },
    "14": {
      "title": "AUTO يخادعون الله والذين آمنوا وما يخدعون الا انفسهم",
      "level": 1,
      "parent": null,
      "start_ms": 65,
      "end_ms": 71
    },
    "15": {
      "title": "AUTO واذا قيل لهم لا تفسدوا في الارض قالوا انما نحن مصلحون 11",
      "level": 1,
      "parent": null,
      "start_ms": 71,
      "end_ms": 74
    },
    "16": {
      "title": "AUTO واذا قيل لهم آمنوا كما آمن الناس قالوا أنؤمن كما آمن السفهاء",
      "level": 1,
      "parent": null,
      "start_ms": 74,
      "end_ms": 77
    },
    "17": {
      "title": "AUTO واذا لقوا الذين آمنوا قالوا امنا واذا خلوا الى شياطينهم قالوا",
      "level": 1,
      "parent": null,
      "start_ms": 77,
      "end_ms": 81
    },
    "18": {
      "title": "AUTO اولئك الذين اشتروا الضلالة بالهدى فما ربحت تجارتهم وما كانوا",
      "level": 1,
      "parent": null,
      "start_ms": 81,
      "end_ms": 82
    },
    "19": {
      "title": "AUTO مثلهم كمثل الذي استوقد نارا فلما اضاءت ما حوله",
      "level": 1,
      "parent": null,
      "start_ms": 82,
      "end_ms": 99
    },
    "20": {
      "title": "AUTO او كصيب من السماء فيه ظلمات ورعد وبرق يجعلون اصابعهم",
      "level": 1,
      "parent": null,
      "start_ms": 99,
      "end_ms": 111
    },
    "21": {
      "title": "AUTO يا ايها الناس اعبدوا ربكم الذي خلقكم والذين من قبلكم لعلكم",
      "level": 1,
      "parent": null,
      "start_ms": 111,
      "end_ms": 127
    },
    "22": {
      "title": "AUTO وإن كنتم في ريب مما نزلنا على عبدنا فأتوا بسورة من مثله",
      "level": 1,
      "parent": null,
      "start_ms": 127,
      "end_ms": 149
    },
    "23": {
      "title": "AUTO وبشر الذين آمنوا وعملوا الصالحات ان لهم جنات تجري من تحتها",
      "level": 1,
      "parent": null,
      "start_ms": 149,
      "end_ms": 158
    },
    "24": {
      "title": "AUTO ان الله لا يستحيي ان يضرب مثلا ما بعوضة فما فوقها",
      "level": 1,
      "parent": null,
      "start_ms": 158,
      "end_ms": 170
    },
    "25": {
      "title": "AUTO كيف تكفرون بالله وكنتم امواتا فاحياكم ثم يميتكم ثم يحييكم ثم",
      "level": 1,
      "parent": null,
      "start_ms": 170,
      "end_ms": 177
    },
    "26": {
      "title": "AUTO هو الذي خلق لكم ما في الأرض جميعا ثم استوى الى السماء فسويهن",
      "level": 1,
      "parent": null,
      "start_ms": 177,
      "end_ms": 184
    },
    "27": {
      "title": "AUTO واذ قال ربك للملئكة اني جاعل في الأرض خليفة قالوا اتجعل",
      "level": 1,
      "parent": null,
      "start_ms": 184,
      "end_ms": 191
    },
    "28": {
      "title": "AUTO وعلم ادم الاسماء كلها ثم عرضهم على الملئكة فقال انبؤني",
      "level": 1,
      "parent": null,
      "start_ms": 191,
      "end_ms": null
    }
