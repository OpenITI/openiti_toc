    },
    "109": {
      "title": ": «ثلاث لأن يكون لي واحدة منهن، أحب إلي من حمر النعم» نزل على رسول الله صلى الله عليه وسلم",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 12
    },
    "110": {
      "title": "[ص: 70]",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "111": {
      "title": "50 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "112": {
      "title": ": \" مات ابن عباس بالطائف، فجاء طائر لم ير على خلقته، فدخل نعشه، ثم لم ير خارجا منه، قال: فلما",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "113": {
      "title": "51 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "114": {
      "title": ": «من أحب جميع أصحابي وتولاهم، واستغفر لهم، جعله الله عز وجل يوم القيامة معهم في",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "115": {
      "title": "52 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "116": {
      "title": ": «اعملوا، فكل ميسر» أو كما قال",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "117": {
      "title": "53 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "118": {
      "title": "، «يلعن القدرية»",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "119": {
      "title": "54 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "120": {
      "title": ": «يبتدئون فيكونون مرجئة، ثم يكونون قدرية، ثم يصيرون مجوسا»",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "121": {
      "title": "55 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 13
    },
    "122": {
      "title": ": «ولا يدافعن أحد منكم في بطنه غائطا ولا بولا، وإن حك أحدكم فرجه فمرشة، أو مرشتين، وليكن ذلك",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "123": {
      "title": "56 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "124": {
      "title": "اغفر للأنصار، ولأبناء الأنصار، ولأبناء أبناء الأنصار، ولنساء أبناء الأنصار، ولنساء أبناء",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "125": {
      "title": "57 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "126": {
      "title": "إذا مر بشجرة بين مكة والمدينة، أناخ عندها، ثم صب في أصلها إداوة من ماء، وإن لم يكن معه",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "127": {
      "title": "58 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "128": {
      "title": ": «من اتخذ كلبا إلا كلب ماشية أو كلبا ضاريا، نقص من عمله كل يوم قيراط»",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "129": {
      "title": "59 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "130": {
      "title": ": «ارم فداك أبي وأمي»",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "131": {
      "title": "60 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 14
    },
    "132": {
      "title": ": «لا يقرأ الجنب، ولا الحائض شيئا من القرآن»",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "133": {
      "title": "61 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "134": {
      "title": "إذا لم يصل في الجماعة، لم يكبر أيام التشريق»",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "135": {
      "title": "62 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "136": {
      "title": "جئت من الدثينة مجاهدا في سبيلك، وابتغاء مرضاتك، وأنا أشهد أنك تحيي الموتى، وتبعث من في",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "137": {
      "title": "63 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "138": {
      "title": ": «من بلغه عن الله عز وجل شيء فيه فضل فأخذه إيمانا به، ورجاء ثوابه، أعطاه الله عز وجل ذلك،",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "139": {
      "title": "64 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "140": {
      "title": ": «إياكم وكثرة الحلف عند البيع؛ فإنه ينفق، ثم يمحق»",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "141": {
      "title": "65 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "142": {
      "title": ": \" من سره أن ينظر إلى وصية محمد رسول الله صلى الله عليه وسلم التي عليها خاتمه، فليقرأ: {قل",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "143": {
      "title": "66 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 15
    },
    "144": {
      "title": "علمه الكتاب والحساب، وقه العذاب»",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "145": {
      "title": "67 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "146": {
      "title": "صليت مع رسول الله صلى الله عليه وسلم»",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "147": {
      "title": "68 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "148": {
      "title": ": «أما إنكم ترون ربكم عز وجل كما ترون هذا، لا تضامون في رؤيته، فإن قدرتم أن لا تغلبوا على",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "149": {
      "title": "69 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "150": {
      "title": "[ص: 81]",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "151": {
      "title": ": \" أتاني جبريل بدابة فوق الحمار ودون البغل، فحملني عليه، ثم انطلق يهوي بنا، كلما صعد عقبة،",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 16
    },
    "152": {
      "title": "[ص: 82]",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "153": {
      "title": "70 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "154": {
      "title": ": «ما أسكر كثيره فقليله حرام»",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "155": {
      "title": "71 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "156": {
      "title": "[ص: 83]",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "157": {
      "title": ": «كل مسكر حرام، وما أسكر منه الفرق، فالحسوة منه حرام»",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "158": {
      "title": "72 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 17
    },
    "159": {
      "title": ": \" قولوا: اللهم صل على محمد، وعلى آل محمد، كما صليت على إبراهيم، وآل إبراهيم، إنك حميد مجيد،",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "160": {
      "title": "[ص: 84]",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "161": {
      "title": "73 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "162": {
      "title": "، فإذا خرج رسول الله صلى الله عليه وسلم لعب، وذهب، وجاء، فإذا جاء النبي صلى الله عليه وسلم",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "163": {
      "title": "74 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "164": {
      "title": "[ص: 85]",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "165": {
      "title": "75 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "166": {
      "title": ": «ألا أستحي ممن تستحي منه الملائكة»",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "167": {
      "title": "76 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 18
    },
    "168": {
      "title": ": «انطلق، فإن الله سيهدي قلبك، ويثبت لسانك» ، قال: فما شككت في قضاء بين",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "169": {
      "title": "77 -",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "170": {
      "title": "[ص: 87]",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "171": {
      "title": "78 -",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "172": {
      "title": ": «إن كنت لأجده في ثوب رسول الله صلى الله عليه وسلم، فأحته عنه» يعني المني",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "173": {
      "title": "79 -",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "174": {
      "title": ": «أيمنع أحدكم أن يكبر في دبر كل صلاة عشرا، ويسبح عشرا، ويحمد عشرا، فذلك في خمس صلوات خمسون",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "175": {
      "title": "[ص: 88]",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "176": {
      "title": "80 -",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "177": {
      "title": "، فأمرها رسول الله صلى الله عليه وسلم أن تتزوج»",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "178": {
      "title": "81 -",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 19
    },
    "179": {
      "title": ": فأخذ بذواب كان لي أو برأسي، فأقامني عن يمينه \"",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "180": {
      "title": "82 -",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "181": {
      "title": ": «لا، حتى يميز بينه وبينه» ، قال: إنما أردت الحجارة، قال: «لا، حتى يميز بينهما» ، قال: فرد، حتى",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "182": {
      "title": "83 -",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "183": {
      "title": "أدبوا الخيل، ولا يرفعن بين ظهرانيكم الصليب، ولا تجاورنكم الخنازير»",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "184": {
      "title": "84 -",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "185": {
      "title": ": «الجاهر بالقرآن كالجاهر بالصدقة، والمسر بالقرآن كالمسر بالصدقة»",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "186": {
      "title": "85 -",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "187": {
      "title": ": اللهم فاطر السماوات والأرض، عالم الغيب والشهادة، لا إله إلا أنت، رب كل شيء ومليكه، أعوذ",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "188": {
      "title": "86 -",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 20
    },
    "189": {
      "title": "[ص: 92]",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "190": {
      "title": "«لا تقوم الساعة حتى لا تنطح ذات قرن جماء»",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "191": {
      "title": "87 -",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "192": {
      "title": ": {من ذا الذي يقرض الله قرضا حسنا فيضاعفه له} [البقرة: 245] قال أبو الدحداح الأنصاري: يا",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "193": {
      "title": "88 -",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "194": {
      "title": "العبد ليعمل الزمن الطويل من عمره، أو أكثره، أو كله بعمل أهل الجنة، وإنه لمكتوب عند الله",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "195": {
      "title": "89 -",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "196": {
      "title": ": «ينبغي لأهل القدر أن يتقدم إليهم فيما أحدثوا من القدر، فإن كفوا، وإلا استلت ألسنتهم من",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "197": {
      "title": "90 -",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 21
    },
    "198": {
      "title": ": «إياكم والظلم، فإن الظلم ظلمات يوم القيامة، وإياكم والفحش، فإن الله عز وجل لا يحب الفحش",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "199": {
      "title": "[ص: 95]",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "200": {
      "title": "91 -",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "201": {
      "title": ": «وا نبياه، وا خليلاه، وا صفياه»",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "202": {
      "title": "92 -",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "203": {
      "title": "[ص: 96]",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "204": {
      "title": ": «أحبوا قريشا؛ فإنه من أحبهم أحبه الله تعالى»",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "205": {
      "title": "93 -",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "206": {
      "title": ": «خيرت بين الشفاعة وبين أن يدخل شطر أمتي الجنة، فاخترت الشفاعة؛ لأنها أعم وأكفى، أترونها",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "207": {
      "title": "94 -",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "208": {
      "title": "أهل حين استوت به راحلته قائمة»",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": null
    }
