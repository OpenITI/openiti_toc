      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "107": {
      "title": ": «غفر الله لك يا عثمان ما قدمت، وما أخرت، وما أسررت، وما أعلنت، وما أخفيت، وما أبديت، وما",
      "level": 1,
