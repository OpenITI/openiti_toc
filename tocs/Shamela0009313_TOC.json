      "title": "[ص: 59]",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "70": {
      "title": "32 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "71": {
      "title": ": «أول من أسلم أبو بكر رضي الله عنه»",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "72": {
      "title": "33 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 8
    },
    "73": {
      "title": "[ص: 60]",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "74": {
      "title": "«أعطيت فواتح الكلم، وخواتمه، وجوامعه» ، فقلنا: يا رسول الله علمنا مما علمك الله عز وجل،",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "75": {
      "title": "34 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "76": {
      "title": ": «أنا أول شفيع يوم القيامة، وأنا أكثر الأنبياء تبعا يوم القيامة، إن من الأنبياء لمن يأتي",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "77": {
      "title": "35 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "78": {
      "title": "[ص: 61]",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "79": {
      "title": "36 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "80": {
      "title": "علمه الكتاب والحساب، وقه العذاب»",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "81": {
      "title": "37 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 9
    },
    "82": {
      "title": "لو كتبت نفسك لكنت لذلك أهلا»",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "83": {
      "title": "38 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "84": {
      "title": "[ص: 63]",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "85": {
      "title": "39 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "86": {
      "title": ": «يوم كلم الله تعالى موسى عليه السلام، كانت عليه جبة صوف، وسراويل صوف، وكساء صوف، وكمة صوف،",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "87": {
      "title": "40 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "88": {
      "title": "[ص: 64]",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "89": {
      "title": ": «ليس على المختلس، ولا على المنتهب، ولا على الخائن قطع»",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "90": {
      "title": "41 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "91": {
      "title": ": \" سبعة لا ينظر الله عز وجل إليهم يوم القيامة، ولا يزكيهم، ولا يجمعهم مع العالمين، يدخلون",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "92": {
      "title": "42 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "93": {
      "title": "[ص: 65]",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 10
    },
    "94": {
      "title": ": «هو الندم على الذنب حين يفرط منك، فتستغفر الله عز وجل بندامتك عند الحافر، ثم لا تعود إليه",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "95": {
      "title": "43 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "96": {
      "title": ": «هو نور الإسلام»",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "97": {
      "title": "44 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "98": {
      "title": ": «ما بقي لأمتي من الدنيا إلا كمقدار الشمس إذا صليت العصر، إن حوضي ما بين أيلة إلى المدينة،",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
