    "3": {
      "title": ": \" آتي يوم القيامة باب الجنة فأستفتح، فيقول الخازن: من أنت؟ فأقول: محمد، فيقول: بك أمرت أن",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "4": {
      "title": "2 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 2
    },
    "5": {
      "title": "دعا له أن يزيده الله فهما وعلما، قال: ثم رأيت رسول الله صلى الله عليه وسلم نام، حتى سمعته",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
