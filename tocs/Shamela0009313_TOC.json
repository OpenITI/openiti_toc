      "title": "30 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "67": {
      "title": ": \" ذنبان يعجلان، ولا يغفران: البغي، وقطيعة الرحم \"",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "68": {
      "title": "31 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
