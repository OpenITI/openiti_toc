      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 3
    },
    "16": {
      "title": ": «لو كان قتل عثمان هدى، لاحتلبت به الأمة لبنا، ولكنه كان ضلالا، فاحتلبت به الأمة",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "17": {
      "title": "8 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "18": {
      "title": "طوبى لمن أحبك، وصدق فيك، وويل لمن أبغضك، وكذب فيك»",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "19": {
      "title": "9 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "20": {
      "title": ": أنا الله، أنا الرحمن، أنا الملك، أنا القدوس، أنا السلام، أنا المؤمن، أنا المهيمن، أنا",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
