    "82": {
      "title": "الفصل الرابع في فوائد الصلاة على رسول الله صلى الله عليه وسلم",
      "level": 1,
      "parent": null,
      "start_ms": 71,
      "end_ms": 71
    },
    "83": {
      "title": "- منها: صلاة الله تعالى وملائكته ورسوله صلى الله عليه وسلم",
      "level": 1,
      "parent": null,
      "start_ms": 71,
      "end_ms": 76
    },
    "84": {
      "title": "تنبيه:",
      "level": 1,
      "parent": null,
      "start_ms": 76,
      "end_ms": 77
    },
    "85": {
      "title": "- ومنها: أنها سبب لمحبة الملائكة وإعانتهم وترحيبهم",
      "level": 1,
      "parent": null,
      "start_ms": 77,
      "end_ms": 77
    },
    "86": {
      "title": "- ومنها: أنها سبب لشفاعته وشهادته صلى الله عليه وسلم",
      "level": 1,
      "parent": null,
      "start_ms": 77,
      "end_ms": 78
    },
    "87": {
      "title": "- ومنها: أنها سبب للبراءة من النفاق ومن النار",
      "level": 1,
      "parent": null,
      "start_ms": 78,
      "end_ms": 79
    },
    "88": {
      "title": "- ومنها: أنها كفارة لنا وزكاة لأعمالنا",
      "level": 1,
      "parent": null,
      "start_ms": 79,
      "end_ms": 79
    },
    "89": {
      "title": "- ومنها: أنها سبب لمزاحمة كتفه صلى الله عليه وسلم على باب الجنة؛",
      "level": 1,
      "parent": null,
      "start_ms": 79,
      "end_ms": 79
    },
    "90": {
      "title": "- ومنها: أنها تستغفر لقائلها",
      "level": 1,
      "parent": null,
      "start_ms": 79,
      "end_ms": 79
    },
    "91": {
      "title": "- ومنها: أن المرة الواحدة منها بقيراط كجبل أحد.",
      "level": 1,
      "parent": null,
      "start_ms": 79,
      "end_ms": 80
    },
    "92": {
      "title": "- ومنها: أن ملكا قائما على قبره يبلغه إياها",
      "level": 1,
      "parent": null,
      "start_ms": 80,
      "end_ms": 84
    },
    "93": {
      "title": "تنبيه:",
      "level": 1,
      "parent": null,
      "start_ms": 84,
      "end_ms": 85
    },
    "94": {
      "title": "مطلب في الحث على زيارة القبر الشريف",
      "level": 1,
      "parent": null,
      "start_ms": 85,
      "end_ms": 87
    },
    "95": {
      "title": "مطلب في معنى رد الروح إليه ص",
      "level": 1,
      "parent": null,
      "start_ms": 87,
      "end_ms": 88
    },
    "96": {
      "title": "خاتمة:",
      "level": 1,
      "parent": null,
      "start_ms": 88,
      "end_ms": 89
    },
    "97": {
      "title": "- ومنها: أنها سبب للكيل بالمكيال الأوفى من الثواب",
      "level": 1,
      "parent": null,
      "start_ms": 89,
      "end_ms": 89
    },
    "98": {
      "title": "- ومنها: أنها سبب لكفاية المهمات في الدنيا والآخرة",
      "level": 1,
      "parent": null,
      "start_ms": 89,
      "end_ms": 92
    },
    "99": {
      "title": "- ومنها: أنها أمحق للخطايا من الماء للنار",
      "level": 1,
      "parent": null,
      "start_ms": 92,
      "end_ms": 93
    },
    "100": {
      "title": "- ومنها: أن المرة الواحدة منها تمحو ذنوب ثمانين سنة",
      "level": 1,
      "parent": null,
      "start_ms": 93,
      "end_ms": 93
    },
    "101": {
      "title": "- ومنها: أنها سبب للنجاة من أهوال يوم القيامة.",
      "level": 1,
      "parent": null,
      "start_ms": 93,
      "end_ms": 93
    },
    "102": {
      "title": "- ومنها: أنها سبب لرضا الله تعالى.",
      "level": 1,
      "parent": null,
      "start_ms": 93,
      "end_ms": 93
    },
    "103": {
      "title": "- ومنها: أنها سبب لغشيان الرحمة.",
      "level": 1,
      "parent": null,
      "start_ms": 93,
      "end_ms": 94
    },
    "104": {
      "title": "- ومنها: أنها سبب للأمان من سخط الله تعالى.",
      "level": 1,
      "parent": null,
      "start_ms": 94,
      "end_ms": 94
    },
    "105": {
      "title": "- ومنها: أنها سبب للدخول تحت ظل العرش.",
      "level": 1,
      "parent": null,
      "start_ms": 94,
      "end_ms": 94
    },
    "106": {
      "title": "- ومنها: أنها سبب لثقل الميزان والنجاة من النار.",
      "level": 1,
      "parent": null,
      "start_ms": 94,
      "end_ms": 95
    },
    "107": {
      "title": "- ومنها: أنها سبب للأمن من العطش يوم القيامة.",
      "level": 1,
      "parent": null,
      "start_ms": 95,
      "end_ms": 95
    },
    "108": {
      "title": "- ومنها: أنها تأخذ بيد من يعثر على الصراط حتى يمر عليه.",
      "level": 1,
      "parent": null,
      "start_ms": 95,
      "end_ms": 96
    },
    "109": {
      "title": "- ومنها: أن من صلى عليه صلى الله عليه وسلم في يوم ألف مرة",
      "level": 1,
      "parent": null,
      "start_ms": 96,
      "end_ms": 96
    },
    "110": {
      "title": "- ومنها: أنها سبب لكثرة الأزواج في الجنة.",
      "level": 1,
      "parent": null,
      "start_ms": 96,
      "end_ms": 96
    },
    "111": {
      "title": "- ومنها: أنها تعدل عشرين غزوة في سبيل الله تعالى.",
      "level": 1,
      "parent": null,
      "start_ms": 96,
      "end_ms": 96
    },
    "112": {
      "title": "- ومنها: أنها تعدل الصدقة.",
      "level": 1,
      "parent": null,
      "start_ms": 96,
      "end_ms": 97
    },
    "113": {
      "title": "- ومنها: أن صلاة مئة في يوم بألف ألف حسنة",
      "level": 1,
      "parent": null,
      "start_ms": 97,
      "end_ms": 97
    },
    "114": {
      "title": "- ومنها: أن صلاة مئة كل يوم سبب لقضاء مئة حاجة",
      "level": 1,
      "parent": null,
      "start_ms": 97,
      "end_ms": 97
    },
    "115": {
      "title": "- ومنها: أن صلاة واحدة سبب لقضاء مئة حاجة.",
      "level": 1,
      "parent": null,
      "start_ms": 97,
      "end_ms": 97
    },
    "116": {
      "title": "- ومنها: أن من صلى عليه صلى الله عليه وسلم مئة مرة في اليوم..",
      "level": 1,
      "parent": null,
      "start_ms": 97,
      "end_ms": 97
    },
    "117": {
      "title": "- ومنها: أنها أحب الأعمال إلى الله تعالى.",
      "level": 1,
      "parent": null,
      "start_ms": 97,
      "end_ms": 97
    },
    "118": {
      "title": "- ومنها: أنها زينة للمجالس",
      "level": 1,
      "parent": null,
      "start_ms": 97,
      "end_ms": 98
    },
    "119": {
      "title": "- ومنها: أنها تنفي الفقر.",
      "level": 1,
      "parent": null,
      "start_ms": 98,
      "end_ms": 98
    },
    "120": {
      "title": "- ومنها: أن من أكثر منها.. يكون أولى الناس به صلى الله عليه وسلم.",
      "level": 1,
      "parent": null,
      "start_ms": 98,
      "end_ms": 99
    },
    "121": {
      "title": "- ومنها: أن بركتها وفائدتها تدرك الرجل وولده وولد ولده.",
      "level": 1,
      "parent": null,
      "start_ms": 99,
      "end_ms": 99
    },
    "122": {
      "title": "- ومنها: أن أحب ما يكون العبد إلى الله تعالى وأقربه إذا أكثر منها.",
      "level": 1,
      "parent": null,
      "start_ms": 99,
      "end_ms": 99
    },
    "123": {
      "title": "- ومنها: أن الآتي بها قد لا يسأله الله تعالى فيما افترض عليه",
      "level": 1,
      "parent": null,
      "start_ms": 99,
      "end_ms": 99
    },
    "124": {
      "title": "- ومنها: أن من صلى عليه صلى الله عليه وسلم في يوم خمسين مرة.. صافحه يوم القيامة.",
      "level": 1,
      "parent": null,
      "start_ms": 99,
      "end_ms": 100
    },
    "125": {
      "title": "- ومنها: أنها طهارة للقلوب من الصدأ.",
      "level": 1,
      "parent": null,
      "start_ms": 100,
      "end_ms": 101
    },
    "126": {
      "title": "خاتمة في ذكر منامات ونحوها، لا بأس بالإشارة إلى بعضها لأن فيها حثا لمن سمعها على الإكثار من الصلاة على النبي صلى الله عليه وسلم",
      "level": 1,
      "parent": null,
      "start_ms": 101,
      "end_ms": 105
    },
    "127": {
      "title": "الفصل الخامس في ذكر عقوبات وقبائح لمن لم يصل على النبي ص",
      "level": 1,
      "parent": null,
      "start_ms": 105,
      "end_ms": 105
    },
    "128": {
      "title": "- منها: أن من ذكر صلى الله عليه وسلم عنده فلم يصل عليه.. كان شقيا",
      "level": 1,
      "parent": null,
      "start_ms": 105,
      "end_ms": 108
    },
    "129": {
      "title": "- ومنها: أن من ذكر عنده فلم يصل عليه.. خطىء طريق الجنة.",
      "level": 1,
      "parent": null,
      "start_ms": 108,
      "end_ms": 109
    },
    "130": {
      "title": "- ومنها: أن من ذكر عنده فلم يصل عليه صلى الله عليه وسلم.. فقد جفاه.",
      "level": 1,
      "parent": null,
      "start_ms": 109,
      "end_ms": 109
    },
    "131": {
      "title": "- ومنها: أن البخيل كل البخيل الذي لا يراه يوم القيامة",
      "level": 1,
      "parent": null,
      "start_ms": 109,
      "end_ms": 111
    },
    "132": {
      "title": "- ومنها: أن من لم يصل عليه صلى الله عليه وسلم عند ذكره.. ملعون.",
      "level": 1,
      "parent": null,
      "start_ms": 111,
      "end_ms": 111
    },
    "133": {
      "title": "- ومنها: أن من ذكر صلى الله عليه وسلم عنده فلم يصل عليه ألأم الناس.",
      "level": 1,
      "parent": null,
      "start_ms": 111,
      "end_ms": 111
    },
    "134": {
      "title": "- ومنها: أن كل مجلس خلا عن ذكره صلى الله عليه وسلم كان على أهله ترة من الله عز وجل يوم القيامة",
      "level": 1,
      "parent": null,
      "start_ms": 111,
      "end_ms": 113
    },
    "135": {
      "title": "- ومنها: أن من لم يصل عليه صلى الله عليه وسلم.. فلا دين له.",
      "level": 1,
      "parent": null,
      "start_ms": 113,
      "end_ms": 113
    },
    "136": {
      "title": "- ومنها: أن من لم يصل عليه صلى الله عليه وسلم.. لا يرى وجهه.",
      "level": 1,
      "parent": null,
      "start_ms": 113,
      "end_ms": 113
    },
