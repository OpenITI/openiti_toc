    "2": {
      "title": "يصلي وعليه نعلان مقابلتان، ويبصق عن يمينه ويساره»",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "3": {
      "title": "23 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "4": {
      "title": ": «املك عليك لسانك هذا» ، وأشار إلى لسانه.",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "5": {
      "title": "24 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "6": {
      "title": ": «من حج البيت أو اعتمر، فليكن آخر عهده بالطواف» .",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "7": {
      "title": "25 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "8": {
      "title": ": أرأيتك إن صليت الصلاة المكتوبة، وصمت رمضان، وأحللت الحلال، وحرمت الحرام، لم أزد على ذلك",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "9": {
      "title": "26 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "10": {
      "title": "، إن صليت هذه الصلاة، وأحللت الحلال، وحرمت الحرام، أدخل الجنة؟ قال: «نعم»",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "11": {
      "title": "27 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 2
    },
    "12": {
      "title": "، انظر الأخلاق الحسنة التي كنت تصنعها في الجاهلية، فاصنعها في الإسلام، أقر الضيف، وأحسن إلى",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "13": {
      "title": "28 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "14": {
      "title": ": «بعثت في نفس الساعة، سبقتها كما سبقت هذه هذه» ، وأشار بإصبعيه",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "15": {
      "title": "29 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "16": {
      "title": ": «من تخطى رقاب الناس يوم الجمعة والإمام يخطب، فكأنه يجر قصبه في جهنم»",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "17": {
      "title": "30 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "18": {
      "title": ": «أي أهل المدينة أكثر تمرا؟» قالوا: أبو لبابة، فقال رسول الله صلى الله عليه وسلم: «يا أبا",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 3
    },
    "19": {
      "title": "31 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "20": {
      "title": ": «فرق ما بيننا وبين المشركين العمائم، والقلانس»",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "21": {
      "title": "32 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "22": {
      "title": ": «اللهم رب السماوات وما أظللن، ورب الأرضين وما أقللن، ورب الشياطين وما أضللن، ورب الرياح",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "23": {
      "title": "33 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "24": {
      "title": ": «فما رأيت إماما كان أخف من صلاة النبي صلى الله عليه وسلم»",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "25": {
      "title": "34 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 4
    },
    "26": {
      "title": ": \" الأيدي ثلاثة: ms3 فيد الله العليا، ويد المعطي التي تليها، ويد السائل السفلى، فأعط الفضل ولا",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "27": {
      "title": "35 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "28": {
      "title": ": «فإذا آتاك الله مالا، فلير أثره عليك»",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "29": {
      "title": "36 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "30": {
      "title": ": «أرب إبل أنت، أم رب غنم؟» قال: فقلت: من كل قد آتاني الله، فأكثر وأطيب، قال: \" ألست تنتجها",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "31": {
      "title": "37 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "32": {
      "title": ": «ما من مسلم يصلي عليه ثلاثة صفوف من المسلمين، إلا أوجب»",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "33": {
      "title": "38 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 5
    },
    "34": {
      "title": "ربكم حيي ms4 كريم، يستحيي أن يمد أحدكم يديه إليه، فيردهما خائبتين»",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "35": {
      "title": "39 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "36": {
      "title": ": «ويل للأمناء، ويل للعرفاء، ليتمنين أقوام يوم القيامة أن ذوائبهم كانت في الثريا، وأنهم لم",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "37": {
      "title": "40 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "38": {
      "title": ": أي الصلاة أفضل؟ قال: «طول القنوت» .",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "39": {
      "title": "41 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "40": {
      "title": ": \" أي شاب تزوج في حداثة سنه، عج شيطانه: يا ويله، عصم مني دينه \"",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "41": {
      "title": "42 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "42": {
      "title": ": «ما من رجل تعلم كلمة، أو كلمتين، أو ثلاثا، أو أربعا، أو خمسا مما فرض الله عز وجل ورسوله",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "43": {
      "title": "43 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "44": {
      "title": "رجل سادل ثوبه في الصلاة، فعطفه عليه»",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "45": {
      "title": "44 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 6
    },
    "46": {
      "title": ": ادع ربك أن يشفيني، فإن ربك ليطيعك، وابعث إلي بقطاف من قطاف الجنة، فأرسل إليه النبي صلى",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "47": {
      "title": "45 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "48": {
      "title": ": \" صلى بنا أنس بن مالك صلاة، فأوجز فيها، فقال: هكذا كانت صلاة نبيكم صلى الله عليه",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "49": {
      "title": "46 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "50": {
      "title": ": «من قتل دون ماله مظلوما، فله الجنة»",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "51": {
      "title": "47 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "52": {
      "title": ": «أصاد رجل من بني سلمة أرنبا بأحد، فلم يجد سكينا، فذبحها بمروة، فسأل عنها رسول الله صلى",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "53": {
      "title": "48 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "54": {
      "title": ": هذا يوم كنا نصومه قبل أن ينزل رمضان، فلما نزل رمضان صمناه، وتركنا ما",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "55": {
      "title": "49 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 7
    },
    "56": {
      "title": ": «ما نقصت صدقة من مال قط، ولا زاد الله من عفا إلا عزا، وما أحد تواضع إلا رفعه الله عز ms6",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
