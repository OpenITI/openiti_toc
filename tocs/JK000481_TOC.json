      "parent": 181,
      "start_ms": 612,
      "end_ms": 613
    },
    "185": {
      "title": "( وعذرة من قضاعة فمن عذرة )",
      "level": 2,
      "parent": 181,
      "start_ms": 613,
      "end_ms": 614
    },
    "186": {
      "title": "( وبلقين من قضاعة فمنهم",
      "level": 2,
      "parent": 181,
      "start_ms": 614,
      "end_ms": 614
    },
    "187": {
      "title": "ومن قضاعة )",
      "level": 2,
      "parent": 181,
      "start_ms": 614,
      "end_ms": 615
    },
    "188": {
      "title": "( وبلي من قضاعة وقد سمينا من سمينا منهم في الأنصار وحلفائهم وهو بلي بن عمرو بن الحاف بن قضاعة فمن بلي )",
      "level": 2,
      "parent": 181,
      "start_ms": 615,
      "end_ms": 617
    },
    "189": {
      "title": "( وبهزا من قضاعة فمنهم",
      "level": 2,
      "parent": 181,
      "start_ms": 617,
      "end_ms": 617
    },
    "190": {
      "title": "( ومن اليمن حضرموت بن يقطر بن عابر فمن حضرموت )",
      "level": 1,
      "parent": null,
      "start_ms": 617,
      "end_ms": 619
    },
    "191": {
      "title": "( عبد الرحمن بن عايش الحضرمي",
      "level": 2,
      "parent": 190,
      "start_ms": 618,
      "end_ms": 619
    },
    "192": {
      "title": "( غافق من اليمن فمن غافق )",
      "level": 1,
      "parent": null,
      "start_ms": 619,
      "end_ms": 681
    },
    "193": {
      "title": "( عبد الله بن عامر بن ربيعة ومدا وهو يزيد بن يزيد بن حرب بن علة بن خالد بن مالك بن أدر وبهراء بن عمرو بن الحافي بن قضاعة )",
      "level": 2,
      "parent": 192,
      "start_ms": 619,
      "end_ms": 620
    },
    "194": {
      "title": "( ومنهم أبو موسى الغافقي عبد الله بن مالك الغافقي ومن اليمن )",
      "level": 2,
      "parent": 192,
      "start_ms": 620,
      "end_ms": 678
    },
    "195": {
      "title": "( نمر خال السائب بن يزيد",
      "level": 2,
      "parent": 192,
      "start_ms": 678,
      "end_ms": 678
    },
    "196": {
      "title": "عبد الله بن عمرو الهزمي )",
      "level": 2,
      "parent": 192,
      "start_ms": 678,
      "end_ms": 681
    },
    "197": {
      "title": "( ورجال ممن أسلم ورأوا رسول الله ) صلى الله عليه وسلم",
      "level": 1,
      "parent": null,
      "start_ms": 681,
      "end_ms": 681
    },
    "198": {
      "title": "أكلوا الدم في الجاهلية",
      "level": 1,
      "parent": null,
      "start_ms": 681,
      "end_ms": 683
    },
    "199": {
      "title": "( ذكر رجال رووا عن النبي صلى الله عليه وسلم لم تقع إلينا أسماؤهم ونسبوا إلى قبائلهم ورجال لم يسموا نسبوا إلى صحابة نبينا عليه السلام ورجال لم يسموا في روايتنا عنهم وسموا وسنذكرهم إن شاء الله عز وجل ورجال أدركوا النبي صلى الله عليه وسلم وأسلموا في حياته ولم يلقوه ورجال مخضرمين أو ذكر ما حفظ من عدد أصحاب النبي صلى الله عليه وسلم مغازيه غزاة غزاة )",
      "level": 1,
      "parent": null,
      "start_ms": 683,
      "end_ms": 689
    },
    "200": {
      "title": "( وأول ذكر النساء من هذا الكتاب وأوله ذكر )",
      "level": 1,
      "parent": null,
      "start_ms": 689,
      "end_ms": null
    },
