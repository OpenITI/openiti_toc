      "start_ms": 8,
      "end_ms": 8
    },
    "30": {
      "title": "الله عز وجل إذا قضى الأمر من السماء ضربت الملائكة أجنحتها خضعانا لقوله كصوت السلسلة على",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 9
    },
    "31": {
      "title": "16 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "32": {
      "title": ": «خير أمتي القرن الذي بعثت فيهم ثم الذين يلونهم ثم الذين يلونهم» والله أعلم قال الثالثة أم",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "33": {
      "title": "17 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "34": {
      "title": ": «بعثت أنا والساعة كهاتين» .",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 10
    },
    "35": {
      "title": "18 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "36": {
      "title": ": «أشهد أن لا إله إلا الله وأني رسول الله، لا يلقى بهما عبد غير شاك فيهما إلا دخل الجنة» .",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "37": {
      "title": "19 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 11
    },
    "38": {
      "title": ": \" بينما أيوب عليه السلام يغتسل عريانا خر عليه جراد من ذهب، فجعل يحثوا في ثوبه، فناداه ربه",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "39": {
      "title": "20 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "40": {
      "title": ": «من حلف على يمين ليقتطع بها مال امرئ مسلم لقي الله عز وجل وهو عليه",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "41": {
      "title": "21 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "42": {
      "title": ": كان بيني وبين رجل من اليهود أرض فجحدني , فقدمته إلى النبي صلى الله عليه وسلم، فقال لي:",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "43": {
      "title": "22 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 12
    },
    "44": {
      "title": ": «لا يجزي ولد والده إلا أن يجده مملوكا فيشتريه فيعتقه» .",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "45": {
      "title": "23 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "46": {
      "title": ": هل تدرون ما الكوثر؟ قلنا: الله ورسوله أعلم.",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "47": {
      "title": "24 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 13
    },
    "48": {
      "title": ": ما مسست ديباجا ولا حريرا ولا شيئا كان ألين من كف رسول الله صلى الله عليه وسلم، ولا شممت",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "49": {
      "title": "25 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "50": {
      "title": ": «لا يدخل الجنة من لا يأمن جاره بوائقه» .",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "51": {
      "title": "26 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 14
    },
    "52": {
      "title": "«إن في الجمعة لساعة لا يوافقها مسلم قائم يصلي يسأل الله عز وجل خيرا إلا أعطاه إياه» .",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "53": {
      "title": "27 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "54": {
      "title": ": «من كان يؤمن بالله واليوم الآخر فلا يؤذي جاره، ومن كان يؤمن بالله واليوم الآخر فليقل خيرا",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "55": {
      "title": "28 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "56": {
      "title": "فنظر إلى القمر ليلة البدر , فقال: «إنكم سترون ربكم عز وجل عيانا كما ترون هذا، لا تضامون في",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 15
    },
    "57": {
      "title": "29 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "58": {
      "title": "كلكم راع وكلكم مسئول عن رعيته، فالأمير راع وهو مسئول عن رعيته، والرجل راع على أهله وهو",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "59": {
      "title": "30 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 16
    },
    "60": {
      "title": ": «ألا أدلك أو أعلمك ما هو خير لك من ذلك؟ إذا أويت إلى فراشك تسبحي الله ثلاثا وثلاثين، وكبري",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "61": {
      "title": "31 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "62": {
      "title": "أن لا أعطي منها على جزارتها شيئا» .",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "63": {
      "title": "32 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 17
    },
    "64": {
      "title": ": «سباب المسلم فسوق، وقتاله كفر» .",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "65": {
      "title": "33 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 18
    },
    "66": {
      "title": ": \" آية المنافق ثلاث: إذا حدث كذب، وإذا وعد أخلف، وإذا ائتمن خان \".",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "67": {
      "title": "34 -",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "68": {
      "title": ": «لا يتقدمن أحدكم رمضان بيوم ولا يومين، إلا أن يكون صوما يصومه رجل منكم؛ ذلك الصوم» .",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 19
    },
    "69": {
      "title": "35 -",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "70": {
      "title": ": \" ينصب لكل غادر لواء يوم القيامة , يقال: هذه غدرة فلان \".",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "71": {
      "title": "36 -",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "72": {
      "title": ": «لا تنكح البكر حتى تستأذن ولا الثيب حتى تستأمر» .",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 20
    },
    "73": {
      "title": "37 -",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "74": {
      "title": ": \" إن خلق أحدكم يجمع في بطن أمه أربعين يوما وأربعين ليلة، ثم يكون علقة مثل ذلك، ثم يكون مضغة",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 21
    },
    "75": {
      "title": "38 -",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "76": {
      "title": ": «اثبت حراء، فما عليك إلا نبي أو صديق أو شهيد» .",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "77": {
      "title": "39 -",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "78": {
      "title": ": «كل مسكر حرام، وكل مسكر خمر» .",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "79": {
      "title": "40 -",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 22
    },
    "80": {
      "title": ": ابعث معنا رجلا يعلمنا السنة والإسلام.",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 22
    },
