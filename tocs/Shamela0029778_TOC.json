      "end_ms": 7
    },
    "22": {
      "title": ": «أشهد أن لا إله إلا الله، وأني رسول الله , لا يلقى بها عبد غير شاك فيحجب عن الجنة» .",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "23": {
      "title": "12 -",
      "level": 1,
      "parent": null,
