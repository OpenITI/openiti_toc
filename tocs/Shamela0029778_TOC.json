    },
    "28": {
      "title": "كانت تحت رجل من بني مخزوم فطلقها ألبتة، فأرسلت إلى أهله تبتغي النفقة فقالوا: ليست علينا",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "29": {
      "title": "15 -",
      "level": 1,
