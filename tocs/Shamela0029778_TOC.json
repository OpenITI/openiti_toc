      "end_ms": 7
    },
    "24": {
      "title": ": «صليت خلف النبي صلى الله عليه وسلم وأبي بكر وعمر وعثمان رضي الله عنهم، فلم أسمع أحدا منهم",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
