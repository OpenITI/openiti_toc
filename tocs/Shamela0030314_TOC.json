  "sections": {
    "1": {
      "title": "1 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "2": {
      "title": "يحملها على عاتقه وهو قائم يصلي، فإذا أراد أن يسجد وضعها بالأرض» ، بلغت وتزوجها علي بن أبي",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "3": {
      "title": "2 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 2
    },
    "4": {
      "title": "، فدفع إليه النبي صلى الله عليه وسلم ابنته زينب بالنكاح الأول، ويقال: رد عليه بمهر جديد",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "5": {
      "title": "3 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "6": {
      "title": ": تزوج أبو العاص بن الربيع بن ربيعة بن عبد شمس زينب فولدت له أمامة، وتزوج علي أمامة بعد",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "7": {
      "title": "4 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "8": {
      "title": ": لقيط بن الربيع بن عبد العزى بن عبد شمس بن عبد مناف أبو العاص صهر رسول الله صلى الله عليه",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "9": {
      "title": "5 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 3
    },
    "10": {
      "title": ": \" أن أبا العاص بن الربيع بن عبد العزى بن عبد شمس بن عبد مناف، وكان تزوج بنت النبي صلى الله",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "11": {
      "title": "6 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "12": {
      "title": ": «إنه حدثني فصدقني، ووعدني فوفى لي» .",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "13": {
      "title": "7 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 4
    },
    "14": {
      "title": "«ختن رسول الله صلى الله عليه وسلم وزوج ابنته زينب» .",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "15": {
      "title": "8 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "16": {
      "title": "أول محصنة تزوجها رسول الله صلى الله عليه وسلم، فولدت له فاطمة، وأم كلثوم، ورقية، وزينب،",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "17": {
      "title": "9 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 5
    },
    "18": {
      "title": "رد عليه ابنته بالنكاح الأول»",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "19": {
      "title": "10 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "20": {
      "title": "«من عليه رسول الله صلى الله عليه وسلم بعد أن بعثت زينب بنت رسول الله صلى الله عليه وسلم",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "21": {
      "title": "11 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "22": {
      "title": ": وأبو العاص بن الربيع بن عبد العزى بن عبد شمس أسره خراش بن الصمة، حدثنيه إسحاق بن خارجة،",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 6
    },
    "23": {
      "title": "12 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "24": {
      "title": ": فتزوج زينب بنت رسول الله صلى الله عليه وسلم أبو العاص بن الربيع بن عبد العزى بن عبد شمس",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "25": {
      "title": "13 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "26": {
      "title": ": الطبقة الرابعة: من أسلم قبل فتح مكة: أبو العاص بن الربيع بن عبد العزى بن عبد شمس بن عبد",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 7
    },
    "27": {
      "title": "14 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "28": {
      "title": ": وتزوج أبو العاص بن الربيع بن عبد شمس زينب فولدت له أمامة، فتزوج علي عليه السلام أمامة بعد",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "29": {
      "title": "15 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "30": {
      "title": ": فمن بطون عبد شمس أمية بن عبد شمس، وعبد العزى بن عبد شمس، رهط أبي العاص بن الربيع زوج زينب",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "31": {
      "title": "16 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "32": {
      "title": ": أبو العاص بن الربيع اسمه لقيط بن الربيع بن عبد العزى بن عبد شمس، مات في ذي الحجة في سنة",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "33": {
      "title": "17 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 8
    },
    "34": {
      "title": "، هاجرت مع رسول الله صلى الله عليه وسلم إلى المدينة والعاص مشرك على حاله، فأقبل أبو العاص",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "35": {
      "title": "18 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "36": {
      "title": ": «أما بعد , فإني أنكحت أبا العاص بن الربيع فحدثني فصدقني، وإن فاطمة بضعة مني وإنما أكره أن",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": null
    }
