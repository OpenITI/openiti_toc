    "130": {
      "title": "45 -",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "131": {
      "title": "أول أهل أبيات يقرعهم الدجال، قال: من هم؟ قال: «أنتم يا أهل الكوفة»",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "132": {
      "title": "46 -",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "133": {
      "title": ": لو أصبح ببابك , لأوشك بعضكم أن يشكو إليه الحفاء من السرعة إليه",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "134": {
      "title": "47 -",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "135": {
      "title": "[ص: 164]",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "136": {
      "title": ": أكثر من يتبعه اليهود , وأولاد الموامس",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "137": {
      "title": "48 -",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "138": {
      "title": ": إذا رأى الدجال عيسى ابن مريم ماث كما تماث الشحمة",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "139": {
      "title": "49 -",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "140": {
      "title": ": يخرج الدجال من كوثى",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "141": {
      "title": "50 -",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "142": {
      "title": "[ص: 166]",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 20
    },
    "143": {
      "title": "ثم ينزل عيسى عليه السلام فيمكث في الأرض أربعين صباحا , اليوم كالساعة , والشهر كالجمعة",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": null
    }
