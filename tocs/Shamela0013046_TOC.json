    "117": {
      "title": "لا يأتي أربعة مساجد: مكة , والمدينة , وبيت المقدس , والطور أحسبه قال: «يسلط على رجل فيقتله",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "118": {
      "title": "43 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "119": {
      "title": ": \" يأتي الدجال وهو محرم عليه أن يدخل أنقاب المدينة , فيخرج إليه رجل يومئذ - وهو خير الناس",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "120": {
      "title": "44 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "121": {
      "title": "[ص: 156]",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 17
    },
    "122": {
      "title": ": \" تفترقون أيها الناس لخروجه ثلاث فرق , فرقة تتبعه , وفرقة تلحق بأرض بها منابت الشيح , وفرقة",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "123": {
      "title": "[ص: 157]",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
