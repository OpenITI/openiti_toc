    },
    "2": {
      "title": "ما جاء فى ذكر الفلك وعجيبه (a) وحركته وكيفيته وظهور لطيف حكمة الله تعالى وعجيب قدرته فى صنعته وتركيبه",
      "level": 3,
      "parent": null,
      "start_ms": 1,
      "end_ms": null
    },
    "3": {
      "title": "انشد للمأمون",
      "level": 3,
      "parent": 2,
      "start_ms": 2,
      "end_ms": 7
    },
    "4": {
      "title": "وفصل فى ان الارض ايضا بجميع اجزائها من البر والبحر على مثال الكرة",
      "level": 3,
      "parent": 2,
      "start_ms": 7,
      "end_ms": 9
    },
    "5": {
      "title": "فصل فى ان كرة الارض مثبتة فى وسط كرة السماء كالمركز وقدرها عند قدر السماء كقدر النقطة من الدائرة صغرا",
      "level": 3,
      "parent": 2,
      "start_ms": 9,
      "end_ms": 10
    },
    "6": {
      "title": "وهذا فصل فى الحركتين الاولتين من حركات السماء اللتين احديهما حركة الكل التى بها يكون (g) الليل والنهار من المشرق الى المغرب والاخرى حركة الكواكب التى ترى لها فى فلك البروج من المغرب الى المشرق",
      "level": 3,
      "parent": 2,
      "start_ms": 10,
      "end_ms": 11
    },
    "7": {
      "title": "القول فى الاجرام والابعاد",
