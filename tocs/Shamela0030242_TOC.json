      "end_ms": 18
    },
    "101": {
      "title": ": \" من رابط اثني عشر ليلة، أو قال: يوما، في سبيل الله تعالى فليجتهد عباد المساجد أن يدركوا",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "102": {
      "title": "63 -",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "103": {
      "title": ": «رباط يوم وليلة في سبيل الله تعالى خير من صيام شهر وقيامه، فإن مات جرى عليه عمله الذي كان",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "104": {
      "title": "64 -",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "105": {
      "title": ": «من تقلد سيفا ليلة جمعة في سبيل الله مرابطا لا يريد بذلك إلا وجه الله تعالى ثم مات بعد",
      "level": 1,
      "parent": null,
