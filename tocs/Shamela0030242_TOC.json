    "23": {
      "title": ": «إن في الإسكندرية وقزوين بابين من أبواب الجنة فمن رابط إلى إحداهما ليلة وجبت له",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
