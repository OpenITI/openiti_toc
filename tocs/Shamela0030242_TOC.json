      "end_ms": 10
    },
    "48": {
      "title": ": «كل ميت يختم على عمله إلا المرابط في سبيل الله تعالى، فإنه ينمو له عمله إلى يوم القيامة،",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "49": {
      "title": "31 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "50": {
      "title": ": «من مات مرابطا في سبيل الله أجري عليه عمله الصالح الذي كان يعمله، وأجري عليه رزقه، وأمن من",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
