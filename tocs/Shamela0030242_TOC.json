      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "37": {
      "title": ": «سيفتح لكم الشام، ومصر، والإسكندرية، وليرابطن فيها، فليبلغن الشاهد منكم الغائب، إن الله",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "38": {
      "title": "24 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "39": {
      "title": ": «أحب الرباط إلى الله تعالى الإسكندرية، إنها تشرف على الخلائق يوم القيامة في صورة مدينة من",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
