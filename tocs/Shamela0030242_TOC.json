      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 17
    },
    "93": {
      "title": ": \" لا يزال الجهاد حلوا أخضر ما قطرت السماء وأنبتت الأرض، وسينتشئ نشء من قبل المشرق يقولون:",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
