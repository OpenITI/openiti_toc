      "start_ms": 17,
      "end_ms": 17
    },
    "97": {
      "title": ": «كل ميت يختم على عمله، إلا المرابط فإنه يجري عليه عمله حتى يبعثه الله",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
