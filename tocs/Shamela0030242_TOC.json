      "start_ms": 17,
      "end_ms": 17
    },
    "95": {
      "title": ": «الخيل معقود في نواصيها الخير إلى يوم القيامة، وأهلها معانون عليها كالماد يده بالصدقة لا",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
