      "end_ms": 4
    },
    "20": {
      "title": "الناس قد صلوا وناموا أو رقدوا، ولم تزالوا في صلاة ما انتظرتموها» .",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
