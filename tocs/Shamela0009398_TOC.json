      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 16
    },
    "120": {
      "title": ": «لو كان القرآن في إهاب ما أحرقته النار»",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
