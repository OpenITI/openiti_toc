      "end_ms": 17
    },
    "134": {
      "title": ": «إني أردت أن أخبركم بليلة القدر فتلاحى رجلان فاختلجت مني، ولعل ذلك خير لكم اطلبوها في",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
