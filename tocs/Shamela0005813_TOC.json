  "sections": {
    "1": {
      "title": "(ذكر ابتداء نهي النبي صلى الله عليه وسلم أن تكتنى بكنيته)",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 2
    },
    "2": {
      "title": "(ذكر ما يدل على أن النبي صلى الله عليه وسلم إنما نهى عن أن يكتنى بكنيته في حياته، وأباح ذلك بعد وفاته)",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 3
    },
    "3": {
      "title": "(ذكر الأخبار الدالة على أن النبي صلى الله عليه وسلم (ق 3 / أ ) أباح أن يتسمى بعده باسمه، ويكتنى بكنيته)",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 77
    },
    "4": {
      "title": "(ومن كنيته أبو القاسم من التابعين)",
      "level": 3,
      "parent": null,
      "start_ms": 8,
      "end_ms": 17
    },
    "5": {
      "title": "(وممن عرف بكنيته ولم يقف له على اسم)",
      "level": 3,
      "parent": 4,
      "start_ms": 17,
      "end_ms": 17
    },
