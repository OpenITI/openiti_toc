      "start_ms": 9,
      "end_ms": 12
    },
    "4": {
      "title": "AUTO وهكذا القناديل من الذهب والفضة، لأن الشخص إذا اتخذها للمسجد",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 14
    },
    "5": {
      "title": "AUTO وأما الطيب فالظاهر أنه ليس بواجب، بل قربة، والظاهر أنه قربة",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 16
    },
    "6": {
      "title": "AUTO وأما تذهيب الكعبة فإن الوليد بن عبد الملك بعث إلى خالد بن عبد",
      "level": 1,
      "parent": null,
      "start_ms": 16,
