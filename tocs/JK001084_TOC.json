  "sections": {
    "1": {
      "title": "مقدمة المؤلف",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 17
    },
    "2": {
      "title": "1 ذكر ما رويته عن شيوخي رحمهم الله من الدواوين المؤلفة في علوم القرآن من ذلك القراءات وما يتصل بها",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 62
    },
    "3": {
      "title": "2 - ذكرالموطأات وما يتصل بها",
      "level": 1,
      "parent": null,
      "start_ms": 62,
      "end_ms": 78
    },
    "4": {
      "title": "3 - ذكر المصنفات المسندة",
      "level": 1,
      "parent": null,
      "start_ms": 78,
      "end_ms": 107
    },
    "5": {
      "title": "4 ذكر المصنفات المتضمنة للسنن أيضا مع فقه الصحابة والتابعين رضي الله عنهم",
      "level": 1,
      "parent": null,
      "start_ms": 107,
      "end_ms": 117
    },
    "6": {
      "title": "5 - ومن المسانيد المخرجة على أسماء الصحابة رضي الله عنهم",
      "level": 1,
      "parent": null,
      "start_ms": 117,
      "end_ms": 123
    },
    "7": {
      "title": "6 - ومن المسانيد المخرجة على حديث الأئمة رحمهم الله",
      "level": 1,
      "parent": null,
      "start_ms": 123,
      "end_ms": 128
    },
    "8": {
      "title": "7 - ومن سائر كتب الحديث من منثور وغير ذلك",
      "level": 1,
      "parent": null,
      "start_ms": 128,
      "end_ms": 159
    },
    "9": {
      "title": "8 ms158 - ومن كتاب شرح غريب الحديث ومعانيه",
      "level": 1,
      "parent": null,
      "start_ms": 159,
      "end_ms": 173
    },
    "10": {
      "title": "9 - ومن كتب علل الحديث والتواريخ ومعرفة الرجال وغير ذلك مما يتصل به",
      "level": 1,
      "parent": null,
      "start_ms": 173,
      "end_ms": 197
    },
    "11": {
      "title": "10 ومن كتب السير والأنساب ونحو ذلك مما يتصل به",
      "level": 1,
      "parent": null,
      "start_ms": 197,
      "end_ms": 205
    },
    "12": {
      "title": "11 - ومن كتب الفقه على مذهب مالك بن أنس رحمه الله المدونة والمختلطة منها",
      "level": 1,
      "parent": null,
      "start_ms": 205,
      "end_ms": 218
    },
    "13": {
      "title": "12 - ومن كتب أصول الدين وأصول الفقه وفضل العلم وغير ذلك مما يتصل به",
      "level": 1,
      "parent": null,
      "start_ms": 218,
      "end_ms": 223
    },
    "14": {
      "title": "13 - ومن كتب الأشربة",
      "level": 1,
      "parent": null,
      "start_ms": 223,
      "end_ms": 225
    },
    "15": {
      "title": "14 - ومن كتب الفرائض وما يتصل بها",
      "level": 1,
      "parent": null,
      "start_ms": 225,
      "end_ms": 228
    },
    "16": {
      "title": "15 - ومن كتب عبارة الرؤيا",
      "level": 1,
      "parent": null,
      "start_ms": 228,
      "end_ms": 229
    },
    "17": {
      "title": "16 - ومن كتب الزهد والرقائق وما يتصل بها",
      "level": 1,
      "parent": null,
      "start_ms": 229,
      "end_ms": 241
    },
    "18": {
      "title": "17 - ومن تواليف أبي بكر بن أبي الدنيا رحمه الله",
      "level": 1,
      "parent": null,
      "start_ms": 241,
      "end_ms": 243
    },
    "19": {
      "title": "18 - ومن تواليف أبي سعيد بن الأعرابي رحمه الله في معاني الزهد",
      "level": 1,
      "parent": null,
      "start_ms": 243,
      "end_ms": 243
    },
    "20": {
      "title": "19 - من تواليف أبي بكر محمد بن الحسين الأجري رحمه الله",
      "level": 1,
      "parent": null,
      "start_ms": 243,
      "end_ms": 244
    },
    "21": {
      "title": "20 - ومن تواليف أبي ذر عبد بن أحمد الهروي رحمه الله",
      "level": 1,
      "parent": null,
      "start_ms": 244,
      "end_ms": 245
    },
    "22": {
      "title": "21 - في الحكمة والمواعظ وغيرها",
      "level": 1,
      "parent": null,
      "start_ms": 245,
      "end_ms": 260
    },
    "23": {
      "title": "22 - ومن كتب الأنحاء واللغات والآداب والشروحات وأشعار العرب والمحدثين وما يتصل بذلك من نوعه",
      "level": 1,
      "parent": null,
      "start_ms": 260,
      "end_ms": 271
    },
    "24": {
      "title": "23 - ومن تواليف أبي علي الحسن بن أحمد بن عبد الغفار الفارسي الفسوي النحوي رحمه الله سوى ما تقدم ذكرنا له قبل هذا",
      "level": 1,
      "parent": null,
      "start_ms": 271,
      "end_ms": 271
    },
    "25": {
      "title": "24 - باب آخر",
      "level": 1,
      "parent": null,
      "start_ms": 271,
      "end_ms": 272
    },
    "26": {
      "title": "25 - ومن كتب الآداب واللغات والشروحات وما يتصل بذلك من نوعه",
      "level": 1,
      "parent": null,
      "start_ms": 272,
      "end_ms": 320
    },
    "27": {
      "title": "26 - باب آخر",
      "level": 1,
      "parent": null,
      "start_ms": 320,
      "end_ms": 336
    },
    "28": {
      "title": "27 - تسمية كتب الشعر وأسماء الشعراء التي وصل بها أبو علي إسماعيل بن القاسم البغداذي إلى الأندلس سوى ما تزايل عنه وأخذ بالقيروان منه",
      "level": 1,
      "parent": null,
      "start_ms": 336,
      "end_ms": 338
    },
    "29": {
      "title": "28 - ومما ذكره أبو مروان بن سراج مما رواه عن أبي سهل الحراني مما لم يتقدم ذكره قبل",
      "level": 1,
      "parent": null,
      "start_ms": 338,
      "end_ms": 338
    },
    "30": {
      "title": "29 - ومما ذكره أبو علي الغساني مما أخذه عن أبي مروان بن سراج مما لم يتقدم ذكره",
      "level": 1,
      "parent": null,
      "start_ms": 338,
      "end_ms": 338
    },
    "31": {
      "title": "30 - ومما ذكره أبو الحجاج الأعلم مما أخذه عن أبي سهل الحراني مما لم يتقدم ذكره قبل",
      "level": 1,
      "parent": null,
      "start_ms": 338,
      "end_ms": 338
    },
    "32": {
      "title": "31 - وما جلبه أبو علي البغداذي من الأخبار",
      "level": 1,
      "parent": null,
      "start_ms": 338,
      "end_ms": 361
    },
    "33": {
      "title": "32 - ذكر ما ms360 رويته من الفهارس الجامعة لروايات الشيوخ رضي الله عنه وتواليفهم",
      "level": 1,
      "parent": null,
      "start_ms": 361,
      "end_ms": 371
    },
    "34": {
      "title": "33 - وهذا باب جامع يفيدك اتساع الرواية من جهة الإجازة",
      "level": 1,
      "parent": null,
      "start_ms": 371,
      "end_ms": 382
    },
    "35": {
      "title": "34 - تفسير الإجازة العامة",
      "level": 1,
      "parent": null,
      "start_ms": 382,
      "end_ms": 384
    },
    "36": {
      "title": "35 - باب تسمية الشيوخ الذين رويت عنهم وأجازوا لي لفظا وخطا ممن لقيته ومن لم ألقه رحمهم الله وهم",
      "level": 1,
      "parent": null,
      "start_ms": 384,
      "end_ms": null
    },
    "37": {
      "title": "ومن أهل قرطبة ms385 ممن لم ألقه",
      "level": 2,
      "parent": 36,
      "start_ms": 386,
      "end_ms": 386
    },
    "38": {
      "title": "وممن أخذت عنه ولقيته منهم",
      "level": 2,
      "parent": 36,
      "start_ms": 386,
      "end_ms": 387
    },
    "39": {
      "title": "وممن أخذت عنه ولم ألقه أيضا",
      "level": 2,
      "parent": 36,
      "start_ms": 387,
      "end_ms": 387
    },
    "40": {
      "title": "وممن أخذت عنه منهم أيضا ولقيته",
      "level": 2,
      "parent": 36,
      "start_ms": 387,
      "end_ms": 387
    },
    "41": {
      "title": "وممن أخذت عنه من الشيوخ بالمرية حرسها الله ولم القه",
      "level": 2,
      "parent": 36,
      "start_ms": 387,
      "end_ms": 387
    },
    "42": {
      "title": "وممن أخذت عنه من أهلها أيضا ولقيتهم بها",
      "level": 2,
      "parent": 36,
      "start_ms": 387,
      "end_ms": 388
    },
    "43": {
      "title": "وممن أخذت عنه من أهل مالقة حرسها الله ولقيته",
      "level": 2,
      "parent": 36,
      "start_ms": 388,
      "end_ms": 388
    },
    "44": {
      "title": "وممن أخذت عنه بالجزيرة الخضراء حرسها الله",
      "level": 2,
      "parent": 36,
      "start_ms": 388,
      "end_ms": 388
    },
    "45": {
      "title": "وممن رويت عنه أيضا من الشيوخ من سائر البلاد",
      "level": 2,
      "parent": 36,
      "start_ms": 388,
      "end_ms": null
    }
  },
