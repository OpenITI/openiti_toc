      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "196": {
      "title": ": \" جادل المشركون المسلمين , فقالوا: ما بال ما قتل الله لا تأكلون وما قتلتم أنتم أكلتموه",
      "level": 1,
