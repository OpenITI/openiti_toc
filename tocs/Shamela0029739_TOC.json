    },
    "44": {
      "title": ": «ما اسمك» ؟ قال: حزن، قال: «بل أنت سهل» ، قال: إنما السهولة للحمار، فأبى أن",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
