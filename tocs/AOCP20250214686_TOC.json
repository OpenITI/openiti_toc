  "filename": "0950IbnTajDinAstarabadi.AtharAhmadi.AOCP20250214686-per1",
  "sections": {
    "1": {
      "title": "کجاگردد محیط کنه او دل",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 7
    },
    "2": {
      "title": "عین آتش شد از این غیرت و برآدم زد",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 28
    },
    "3": {
      "title": "با که گویم حال تنها ماندن دشوار خود",
      "level": 1,
      "parent": null,
      "start_ms": 28,
      "end_ms": 36
    },
    "4": {
      "title": "چه حاصل از صبا ما را نسیم یار بایستی",
      "level": 1,
      "parent": null,
      "start_ms": 36,
      "end_ms": 41
    },
    "5": {
      "title": "به دیوان آشنائی نیست او را",
      "level": 1,
      "parent": null,
      "start_ms": 41,
      "end_ms": 41
    },
    "6": {
      "title": "نه شیطانی است، رحمانی است این حال PageV01P063",
      "level": 1,
      "parent": null,
      "start_ms": 41,
      "end_ms": 45
    },
    "7": {
      "title": "کز شکست جام مجنون قصد لیلی دیگراست",
      "level": 1,
      "parent": null,
      "start_ms": 45,
      "end_ms": 51
    },
    "8": {
      "title": "خبرم شدهاست کامشب بر یار خواهی آمد",
      "level": 1,
      "parent": null,
      "start_ms": 51,
      "end_ms": 56
    },
    "9": {
      "title": "پای بر چشمم نهادی خانه روشن ساختی",
      "level": 1,
      "parent": null,
      "start_ms": 56,
      "end_ms": 57
    },
    "10": {
      "title": "چه حاجت است که با هر کسی درآمیزم",
      "level": 1,
      "parent": null,
      "start_ms": 57,
      "end_ms": 57
    },
    "11": {
      "title": "تو نه معشوقی نه عاشق مر ترا باری چه شد",
      "level": 1,
      "parent": null,
      "start_ms": 57,
      "end_ms": 64
    },
    "12": {
      "title": "صد ms063 چو من ار فنا شود باد بقای چون توئی",
      "level": 1,
      "parent": null,
      "start_ms": 64,
      "end_ms": 67
    },
    "13": {
      "title": "بر سرکوی تو از پای طلب ننشینم PageV01P086",
      "level": 1,
      "parent": null,
      "start_ms": 67,
      "end_ms": 72
    },
    "14": {
      "title": "خون جگرش ز دیده بیرون میریخت",
      "level": 1,
      "parent": null,
      "start_ms": 72,
      "end_ms": 72
    },
    "15": {
      "title": "که در تیر خدنگت هر طرف او را ستون باشد",
      "level": 1,
      "parent": null,
      "start_ms": 72,
      "end_ms": 80
    },
    "16": {
      "title": "وصل او روزی شود والله خیر الرازقین",
      "level": 1,
      "parent": null,
      "start_ms": 80,
      "end_ms": 83
    },
    "17": {
      "title": "تا نخواهد گشت در خاک لحد عمت دفین",
      "level": 1,
      "parent": null,
      "start_ms": 83,
      "end_ms": 83
    },
    "18": {
      "title": "دعویی کردی و حق در جانب تسست ای امین",
      "level": 1,
      "parent": null,
      "start_ms": 83,
      "end_ms": 96
    },
    "19": {
      "title": "کو ز هر بهر دشمن و کو مهره بهر دوست",
      "level": 1,
      "parent": null,
      "start_ms": 96,
      "end_ms": 106
    },
    "20": {
      "title": "به چشم بختشان عالم سیه گشت",
      "level": 1,
      "parent": null,
      "start_ms": 106,
      "end_ms": 116
    },
    "21": {
      "title": "رود زبان من ازکار و هیچ نتوان گفت",
      "level": 1,
      "parent": null,
      "start_ms": 116,
      "end_ms": 152
    },
    "22": {
      "title": "کو حریفی که قدم بر سر این کوی نهد",
      "level": 1,
      "parent": null,
      "start_ms": 152,
      "end_ms": 159
    },
    "23": {
      "title": "حرباو میدید و میگفت آفرین! صد آفرین!",
      "level": 1,
      "parent": null,
      "start_ms": 159,
      "end_ms": 164
    },
    "24": {
      "title": "خوش دمی باشد که ما را کشته زین میدان برند",
      "level": 1,
      "parent": null,
      "start_ms": 164,
      "end_ms": 175
    },
    "25": {
      "title": "به چنین منصب شایسته شدم دولتمند",
      "level": 1,
      "parent": null,
      "start_ms": 175,
      "end_ms": 197
    },
    "26": {
      "title": "سلامت فرصتی می جست و بگریخت PageV01P203",
      "level": 1,
      "parent": null,
      "start_ms": 197,
      "end_ms": 197
    },
    "27": {
      "title": "زبانها بود از دیوان به لا حول",
      "level": 1,
      "parent": null,
      "start_ms": 197,
      "end_ms": 207
    },
    "28": {
      "title": "همچنان هیچ نگفتیم که صد چندان است",
      "level": 1,
      "parent": null,
      "start_ms": 207,
      "end_ms": 233
    },
    "29": {
      "title": "به غمزه مسئله آموز صد مدرس شد",
      "level": 1,
      "parent": null,
      "start_ms": 233,
      "end_ms": 235
    },
    "30": {
      "title": "و ز همه غمهای دل خط امان می خوانمش",
      "level": 1,
      "parent": null,
      "start_ms": 235,
      "end_ms": 252
    },
    "31": {
      "title": "چه تمکین مشت خس را پیش سیلاب",
      "level": 1,
      "parent": null,
      "start_ms": 252,
      "end_ms": 268
    },
    "32": {
      "title": "چشم جان را نور بخشیدی و مردم را صفا",
      "level": 1,
      "parent": null,
      "start_ms": 268,
      "end_ms": 270
    },
    "33": {
      "title": "جگر حسود خون شد تو مگر جگرنداری",
      "level": 1,
      "parent": null,
      "start_ms": 270,
      "end_ms": 318
    },
    "34": {
      "title": "جان پردرد و زبان عذر ms317 خواه آوردهایم",
      "level": 1,
      "parent": null,
      "start_ms": 318,
      "end_ms": 345
    },
    "35": {
      "title": "به چنین منصب شایسته شدم دولتمند",
      "level": 1,
      "parent": null,
      "start_ms": 345,
      "end_ms": 381
    },
    "36": {
      "title": "که حضرت را جفا در خستگی چیست",
      "level": 1,
      "parent": null,
      "start_ms": 381,
      "end_ms": 385
    },
    "37": {
      "title": "سیلاب خون زدیدهآ گریان همی رود",
      "level": 1,
      "parent": null,
      "start_ms": 385,
      "end_ms": 388
    },
    "38": {
      "title": "تا قیامت آن سخن ورد زبان من شود",
      "level": 1,
      "parent": null,
      "start_ms": 388,
      "end_ms": 388
    },
    "39": {
      "title": "آن کیست که او به مرگ شادان نشود",
      "level": 1,
      "parent": null,
      "start_ms": 388,
      "end_ms": 392
    },
    "40": {
      "title": "خوش خرامان گذری کن به تماشاگه راز",
      "level": 1,
      "parent": null,
      "start_ms": 392,
      "end_ms": 392
    },
    "41": {
      "title": "برقع از رخ بفکن جمله ملک را بنواز",
      "level": 1,
      "parent": null,
      "start_ms": 392,
      "end_ms": 395
    },
    "42": {
      "title": "هزار فتنه زهرگوشه رو به مردم کرد",
      "level": 1,
      "parent": null,
      "start_ms": 395,
      "end_ms": 399
    },
    "43": {
      "title": "سینه و دل خون شده روح [و] روان بگریسته",
      "level": 1,
      "parent": null,
      "start_ms": 399,
      "end_ms": 399
    },
    "44": {
      "title": "بر دل من جمله مرغان چمن بگریستی",
      "level": 1,
      "parent": null,
      "start_ms": 399,
      "end_ms": 399
    },
    "45": {
      "title": "می توان دیدن به خوابش ای دریغا خواب کو",
      "level": 1,
      "parent": null,
      "start_ms": 399,
      "end_ms": 424
    },
    "46": {
      "title": "خواهی ببخش و خواه بکش رأی رأی توست",
      "level": 1,
      "parent": null,
      "start_ms": 424,
      "end_ms": 465
    },
    "47": {
      "title": "خلق را خشنود سازند و ms464 خدا را خشمناک",
      "level": 1,
      "parent": null,
      "start_ms": 465,
      "end_ms": 468
    },
    "48": {
      "title": "خوش دمی باشد که ما راکشته زین میدان برند",
      "level": 1,
      "parent": null,
      "start_ms": 468,
      "end_ms": 475
    },
    "49": {
      "title": "فرق پیدا در میان ترک و مغفر میکند",
      "level": 1,
      "parent": null,
      "start_ms": 475,
      "end_ms": 479
    },
    "50": {
      "title": "دراین اندیشه یکروباش و عالم را قفایی زن",
      "level": 1,
      "parent": null,
      "start_ms": 479,
      "end_ms": 479
    },
    "51": {
      "title": "بساط قرب میخواهی بلا را مرحبایی زن",
      "level": 1,
      "parent": null,
      "start_ms": 479,
      "end_ms": 483
    },
    "52": {
      "title": "روزی که قضا باشد و روزی که قضا نیست",
      "level": 1,
      "parent": null,
      "start_ms": 483,
      "end_ms": 484
    },
    "53": {
      "title": "آغشته به خون، لاله صفت نزد خدا رفت",
      "level": 1,
      "parent": null,
      "start_ms": 484,
      "end_ms": 523
    },
    "54": {
      "title": "ولک التسع من الثمن و بالکل تملکت",
      "level": 1,
      "parent": null,
      "start_ms": 523,
      "end_ms": 524
    },
    "55": {
      "title": "کمر چون توأمان بسته است خورشید جهان آرا",
      "level": 1,
      "parent": null,
      "start_ms": 524,
      "end_ms": null
    }
