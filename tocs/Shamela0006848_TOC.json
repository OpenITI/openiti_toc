      "level": 1,
      "parent": null,
      "start_ms": 70,
      "end_ms": 71
    },
    "58": {
      "title": "وكان بعض السلف يقول لا تظلم الضعفاء فتكون من أشرار الأقوياء وقال",
      "level": 1,
      "parent": null,
      "start_ms": 71,
      "end_ms": 72
    },
    "59": {
      "title": "وروي عن النبي صلى الله عليه وسلم أنه قال خمسة غضب الله عليهم إن شاء أمضى غضبه عليهم في الدنيا وإلا أمر بهم في الآخرة إلى النار أمير قوم يأخذ حقه من رعيته ولا ينصفهم من نفسه ولا يدفع الظلم عنهم وزعيم قوم يطيعونه ولا يساوي بين القوي والضعيف ويتكلم",
      "level": 1,
      "parent": null,
      "start_ms": 72,
      "end_ms": 73
    },
    "60": {
      "title": "وعن أبي أمامة قال يجيء الظالم يوم القيامة حتى إذا كان على جسر جهنم لقيه المظلوم وعرفه ما ظلمه به فما يبرح الذين ظلموا بالذين ظلموا حتى ينزعوا ما بأيدهم من الحسنات فإن لم يجدوا لهم حسنات حملوا عليهم من سيئاتهم مثل ما ظلموهم حتى يردوا إلى الدرك الأسفل",
      "level": 1,
      "parent": null,
      "start_ms": 73,
      "end_ms": 74
    },
    "61": {
      "title": "فصل",
      "level": 1,
      "parent": null,
      "start_ms": 74,
      "end_ms": 74
    },
    "62": {
      "title": "ومن أعظم الظلم المماطلة بحق عليه مع قدرته على الوفاء لما ثبت في الصحيحين أن رسول الله صلى الله عليه وسلم قال مطل الغني ظلم وفي رواية لي الواجد ظلم يحل عرضه وعقوبته أي يحل شكايته وحبسه",
      "level": 1,
      "parent": null,
      "start_ms": 74,
      "end_ms": 74
    },
    "63": {
      "title": "ومن الظلم أن يظلم المرأة حقها من صداقها ونفقتها وكسوتها وهو داخل في قوله صلى الله عليه وسلم لي الواجد ظلم يحل عرضه وعقوبته وعن ابن مسعود رضي الله عنه قال يؤخذ بيد العبد أو الأمة يوم القيامة فينادى به على رؤوس الخلائق هذا فلان ابن فلان من كان له عليه",
      "level": 1,
      "parent": null,
      "start_ms": 74,
      "end_ms": 75
    },
    "64": {
      "title": "فصل",
      "level": 1,
      "parent": null,
      "start_ms": 75,
      "end_ms": 76
    },
    "65": {
      "title": "وقد روي أنه لا أكره للعبد يوم القيامة من أن يرى من يعرفه خشية أن يطالبه بمظلمة ظلمه بها في الدنيا كما قال النبي صلى الله عليه وسلم لتؤدن الحقوق إلى أهلها يوم القيامة حتى يقاد للشاة الجلحاء من الشاة القرناء وقال صلى الله عليه وسلم من كانت عنده",
      "level": 1,
      "parent": null,
      "start_ms": 76,
      "end_ms": 76
