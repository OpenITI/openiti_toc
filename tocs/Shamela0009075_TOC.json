{
  "filename": "0748Dhahabi.Radd.Shamela0009075-ara1",
  "sections": {
    "1": {
      "title": "[الرد على ابن القطان في كتابه بيان الوهم والإيهام]",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "2": {
      "title": "المقدمة",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "3": {
      "title": ": \" لا يقضي القاضي إلا وهو شبعان ريان \".",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "4": {
      "title": ": \" أن مملوكا",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 2
    },
    "5": {
      "title": "في قيامه - عليه السلام - في رمضان ليلة بالناس،",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "6": {
      "title": ": \" إذا دخل أحدكم المسجد فلا يجلس حتى يركع",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "7": {
      "title": ": \" طعام البخيل داء \"،",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "8": {
      "title": "\" لا يسمع بي أحد من هذه الأمة، لا يهودي، ولا نصراني \".",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 3
    },
    "9": {
      "title": "حديث في قضاء صوم التطوع،",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "10": {
      "title": ": \" إذا كان دم الحيض",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "11": {
      "title": "لتغتسل للظهر والعصر غسلا واحدا",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 4
    },
    "12": {
      "title": "، لما حضرت أبا طالب الوفاة.",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "13": {
      "title": ": \" ليس على النساء حلق \"،",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "14": {
      "title": ": \" وقت العقيق \"",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "15": {
      "title": ": \" فمنا من رمى بست",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "16": {
      "title": ": [لم] يأمرني رسول الله - صلى الله عليه وسلم - أن أنزل الأبطح،",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 5
    },
    "17": {
      "title": "\": عن عبد الله الصنابحي في فضلية الوضوء.",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 6
    },
    "18": {
      "title": ": حديث معاذ في زكاة البقر",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "19": {
      "title": "حديث: \" ستر وجه المرأة \"",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "20": {
      "title": ": \" رش على قبر",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "21": {
      "title": ": \" كان لا يأذن لمن لم يبدأ بالسلام \"",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "22": {
      "title": ": \" من (3 / ب) صلى وحده ثم أدرك",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 7
    },
    "23": {
      "title": ": \" لا يحصن",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "24": {
      "title": ": \" من لم يقرأ بأم القرآن \"،",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "25": {
      "title": "حديث في قضاء صوم التطوع،",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "26": {
      "title": ": \" لا تحج إلا بإذن زوجها \"،",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "27": {
      "title": ": في غسل",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "28": {
      "title": ": \" لا وضوء لمن لم يسم \".",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 8
    },
    "29": {
      "title": "بشر بن المفضل، عن عبد الرحمن بن حرملة، ms07 عن أبي ثفال،",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "30": {
      "title": ": \" نهي أن يستفاد في المسجد \".",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "31": {
      "title": "حديث ابن جريح، عن محمد بن عمر بن علي، عن عباس بن عبيد الله",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "32": {
      "title": ": \" إذا توضأ عرك عارضيه \"،",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "33": {
      "title": "- كان يقرأ في الركعتين التي يوتر بعدهما بسبح، وقل يا أيها الكافرون، ويقرأ في الوتر: قل هو الله أحد، والمعوذتين.",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 9
    },
    "34": {
      "title": ": إذا توفي أحدكم فوجد",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "35": {
      "title": ": \" صوما يوما مكانه \".",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "36": {
      "title": ": \" ماء زمزم لما شرب له \".",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 10
    },
    "37": {
      "title": ": \" أسلمت وتحتي أختان \"",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "38": {
      "title": "أسلم وله عشر نسوة،",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "39": {
      "title": "غيلان",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "40": {
      "title": ": \" لا تطلق النساء إلا من ريبة، إن الله لا يحب الذواقين",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 11
    },
    "41": {
      "title": "النهي عن الكلب إلا كلب الصيد؛",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "42": {
      "title": ": \" إذا اختلف البيعان، وليس بينة، فهو ما يقول رب السلعة، أو",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 12
    },
    "43": {
      "title": "-: \" لا يتم بعد احتلام، ولا صمات يوم إلى الليل \".",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "44": {
      "title": ": \" الخال وارث من لا وارث له \".",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "45": {
      "title": "مولى النبي - صلى الله عليه وسلم - وقع من نخلة فمات، فقال: انظروا هل له من وارث؟",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 13
    },
    "46": {
      "title": ": \" علي كل بيت في العام أضحية وعتيرة \".",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "47": {
      "title": ": \" نهى عن لبس الذهب إلا مقطعا \".",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "48": {
      "title": ": \" أهل الجنة عشرون ومائة صف \".",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "49": {
      "title": ": \" أول ما خلق الله القلم، فقال له: \" أجر \"، فجرى بما هو",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 14
    },
    "50": {
      "title": "حديث أبي رزين: يا رسول الله، أين كان ربنا؟ قال: \" كان في عماء",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "51": {
      "title": ": \" أخبرنا عن ثياب الجنة، أتنسج؟ \".",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "52": {
      "title": ": \" وأدخل أصابعه في صماخ أذنيه \".",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "53": {
      "title": ": إن أدركتها: أصلي معهم؟ قال: \" إن شئت \".",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 15
    },
    "54": {
      "title": ": \" رخص في دم الحبون \".",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "55": {
      "title": ": \" من قال: يثرب، فليقل: المدينة عشرا \".",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "56": {
      "title": ": \" الرجل أحق بصدر دابته \".",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "57": {
      "title": "حديث عائشة في رضاع سالم من سهلة خمس رضعات.",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 16
    },
    "58": {
      "title": ": \" الربا وإن كثر فإنه يصير ms15 إلى قل \".",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "59": {
      "title": "بيع المحفلات خلابة",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "60": {
      "title": ": كان عندي",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 17
    },
    "61": {
      "title": "-: \" تدنو الشمس يوم القيامة قدر",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "62": {
      "title": ": \" إذا قرأتم",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "63": {
      "title": ": \" كان إذا توضأ أخذ كفا فأدخله تحت حنكه \".",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 18
    },
    "64": {
      "title": ": \" اغسلوا قتلاكم \"",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "65": {
      "title": "حديث أم سلمة في زكاة الحلي",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "66": {
      "title": ": \" من كان عليه صوم رمضان فليسرده ولا يقطعه \".",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "67": {
      "title": ": \" غزونا خيبر فأصبنا غنما فقسم بعضها \".",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "68": {
      "title": ": \" أن النهبة ليست بأحل من الميتة \".",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "69": {
      "title": "امرأة أعطاها ابنها حديقة،",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 19
    },
    "70": {
      "title": ": \" اشتركنا (9 / ب) في البقرة سبعة، وفي البعير",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "71": {
      "title": ": \" كان النبي - صلى الله عليه وسلم - يلبس النعال السبتية، ويصفر لحيته بالورس، والزعفران \".",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "72": {
      "title": ": \" يقبل توبة عبده ما لم يغرغر \".",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 20
    },
    "73": {
      "title": ": \" إذا أمسك الرجل الرجل وقتله آخر، يقتل القاتل، ويحبس الممسك \".",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "74": {
      "title": ": \" إذا سجد فلا يبرك كالبعير \".",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "75": {
      "title": ": \" الأرض كلها مسجد إلا المقبرة والحمام \".",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "76": {
      "title": ": تقبيل النبي - صلى الله عليه وسلم - عثمان بن مظعون،",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "77": {
      "title": ": \" لعن زوارات القبور \"",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "78": {
      "title": "وقال في الجهاد: خالد بن الفزر، ليس بالقوي،",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 21
    },
    "79": {
      "title": "التشديد في زيارة النساء القبور.",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 22
    },
    "80": {
      "title": "ذكر المصنفين الذين أخرج عنهم في كتابه من متن أو علة:",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": null
    }
  },
