      "end_ms": 38
    },
    "172": {
      "title": ": «والله إنها لبدعة ما قنت رسول الله غير شهر واحد»",
      "level": 1,
      "parent": null,
      "start_ms": 38,
      "end_ms": 38
    },
    "173": {
      "title": "101 -",
      "level": 1,
      "parent": null,
      "start_ms": 38,
      "end_ms": 38
    },
    "174": {
      "title": ": \" خرج عثمان مهاجرا إلى الحبشة ومعه ابنة النبي، واحتبس على النبي صلى الله عليه وسلم خبرهم",
      "level": 1,
