      "title": "91 -",
      "level": 1,
      "parent": null,
      "start_ms": 36,
      "end_ms": 36
    },
    "156": {
      "title": ": \" بينا جبريل عليه السلام قاعد عند النبي عليه السلام سمع نقيضا من فوقه فرفع رأسه، فقال: هذا",
      "level": 1,
      "parent": null,
      "start_ms": 36,
      "end_ms": 36
    },
    "157": {
      "title": "92 -",
      "level": 1,
      "parent": null,
      "start_ms": 36,
      "end_ms": 36
    },
    "158": {
      "title": ": «ما صلى علي عبد من أمتي صلاة صادقا من قبل نفسه إلا صلى الله عليه بها عشر صلوات، وكتب الله",
      "level": 1,
      "parent": null,
      "start_ms": 36,
      "end_ms": 36
    },
    "159": {
      "title": "93 -",
      "level": 1,
      "parent": null,
      "start_ms": 36,
      "end_ms": 36
    },
    "160": {
      "title": ": «أنا أول الناس خروجا إذا بعثوا، وقائدهم إذا وفدوا، وشفيعهم إذا حبسوا، ومبشرهم إذا أيسوا،",
      "level": 1,
      "parent": null,
      "start_ms": 36,
      "end_ms": 36
    },
    "161": {
      "title": "94 -",
      "level": 1,
      "parent": null,
      "start_ms": 36,
      "end_ms": 37
    },
    "162": {
      "title": ": \" قالت: يا بني لو رأيته رأيت الشمس طالعة \"",
      "level": 1,
      "parent": null,
      "start_ms": 37,
      "end_ms": 37
    },
    "163": {
      "title": "95 -",
      "level": 1,
      "parent": null,
      "start_ms": 37,
      "end_ms": 37
    },
    "164": {
      "title": ": «من لم يأت بيت المقدس يصلي فيه، فليبعث بزيت يسرج فيه»",
      "level": 1,
      "parent": null,
      "start_ms": 37,
      "end_ms": 37
    },
    "165": {
      "title": "96 -",
      "level": 1,
      "parent": null,
      "start_ms": 37,
      "end_ms": 37
    },
    "166": {
      "title": ": «أنا قائد المرسلين ولا فخر، وأنا خاتم النبيين ولا فخر، وأنا أول شافع مشفع ولا",
      "level": 1,
      "parent": null,
      "start_ms": 37,
      "end_ms": 37
    },
    "167": {
      "title": "97 -",
      "level": 1,
      "parent": null,
      "start_ms": 37,
      "end_ms": 37
    },
    "168": {
      "title": ": «بعثت من خير قرون بني آدم قرنا فقرنا حتى كنت من القرن الذي كنت فيه»",
      "level": 1,
      "parent": null,
      "start_ms": 37,
      "end_ms": 37
    },
    "169": {
      "title": "98 -",
      "level": 1,
      "parent": null,
