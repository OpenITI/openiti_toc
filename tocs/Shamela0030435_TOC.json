    "107": {
      "title": ": «إني فرطكم على الحوض، وإنما بعد ما بين طرفيه كما بين صنعاء وأيلة كأن الأباريق فيه",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "108": {
      "title": "64 -",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 22
    },
    "109": {
      "title": ": «يا سلمان وبعده»",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 22
    },
    "110": {
      "title": "65 -",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 22
    },
    "111": {
      "title": ": \" لا تشد الرحال إلا إلى ثلاثة مساجد: مسجد الحرام ومسجدي ومسجد بيت المقدس \"",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 22
    },
    "112": {
      "title": "66 -",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 22
    },
    "113": {
      "title": "67 -",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 22
    },
    "114": {
      "title": ": «إن أمامكم حوضا كما بين جرباء وأذرح»",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 22
    },
    "115": {
      "title": "68 -",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 23
    },
    "116": {
      "title": ": \" إن حوضي من عدن إلى عمان البلقاء ماؤه أشد بياضا من اللبن وأحلى من العسل أكاويبه عدد نجوم",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 23
    },
    "117": {
      "title": "....",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 23
    },
    "118": {
      "title": "69 -",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 24
    },
    "119": {
      "title": ": \" إن حوضي لأبعد من أيلة وعدن، والذي نفسي بيده لآنيته أكثر من عدد النجوم، وهو أشد بياضا من",
      "level": 1,
      "parent": null,
      "start_ms": 24,
      "end_ms": 24
    },
    "120": {
      "title": "70 -",
      "level": 1,
      "parent": null,
      "start_ms": 24,
      "end_ms": 24
    },
    "121": {
      "title": ".....",
      "level": 1,
      "parent": null,
      "start_ms": 24,
      "end_ms": 24
    },
    "122": {
      "title": ": \" ثم إن الله تبارك وتعالى أوحى إلى موسى أن سر إلى أريحا، وهي أرض ببيت المقدس، فتقاتل",
      "level": 1,
      "parent": null,
      "start_ms": 24,
      "end_ms": 26
    },
    "123": {
      "title": "71 -",
      "level": 1,
      "parent": null,
      "start_ms": 26,
      "end_ms": 26
    },
    "124": {
      "title": ": \" لما حضر أجل هارون أوحى الله إلى موسى أن انطلق أنت وهارون وابن هارون إلى غار في الجبل فإنا",
      "level": 1,
      "parent": null,
      "start_ms": 26,
      "end_ms": 26
    },
    "125": {
      "title": "72 -",
      "level": 1,
      "parent": null,
      "start_ms": 26,
      "end_ms": 27
    },
    "126": {
      "title": ".....",
      "level": 1,
      "parent": null,
      "start_ms": 27,
      "end_ms": 28
    },
    "127": {
      "title": "73 -",
      "level": 1,
      "parent": null,
      "start_ms": 28,
      "end_ms": 28
    },
    "128": {
      "title": ": \" أتى ملك الموت موسى ليقبض نفسه، فلطمه لطمة ففقأ عينه فرجع ملك الموت إلى ربه عز وجل، وهو",
      "level": 1,
      "parent": null,
      "start_ms": 28,
      "end_ms": 29
    },
    "129": {
      "title": "74 -",
      "level": 1,
      "parent": null,
      "start_ms": 29,
      "end_ms": 29
    },
    "130": {
      "title": "75 -",
      "level": 1,
      "parent": null,
      "start_ms": 29,
      "end_ms": 29
    },
    "131": {
      "title": "76 -",
      "level": 1,
      "parent": null,
      "start_ms": 29,
      "end_ms": 30
    },
    "132": {
      "title": ": \" عمران بيت المقدس خراب يثرب، وخراب يثرب خروج الملحمة، وخروج الملحمة فتح القسطنطينية، وفتح",
      "level": 1,
      "parent": null,
      "start_ms": 30,
      "end_ms": 30
    },
    "133": {
      "title": "77 -",
      "level": 1,
      "parent": null,
      "start_ms": 30,
      "end_ms": 31
    },
    "134": {
      "title": "78 -",
      "level": 1,
      "parent": null,
      "start_ms": 31,
      "end_ms": 31
    },
    "135": {
      "title": ": «من رآني في المنام فقد رآني فإن الشيطان لا يتمثل بي»",
      "level": 1,
      "parent": null,
      "start_ms": 31,
      "end_ms": 31
    },
    "136": {
      "title": "79 -",
      "level": 1,
      "parent": null,
      "start_ms": 31,
      "end_ms": 31
    },
    "137": {
      "title": ": «كل حسب ونسب منقطع يوم القيامة إلا حسبي ونسبي»",
      "level": 1,
      "parent": null,
      "start_ms": 31,
      "end_ms": 31
    },
    "138": {
      "title": "80 -",
      "level": 1,
      "parent": null,
      "start_ms": 31,
      "end_ms": 32
    },
    "139": {
      "title": "81 -",
      "level": 1,
      "parent": null,
      "start_ms": 32,
      "end_ms": 32
    },
    "140": {
      "title": ": \" لم يكن بالطويل الممغط ولا القصير المتردد كان ربعة، ولم يكن بالجعد القطط ولا السبط كان",
      "level": 1,
      "parent": null,
      "start_ms": 32,
      "end_ms": 32
    },
    "141": {
      "title": "82 -",
      "level": 1,
      "parent": null,
      "start_ms": 32,
      "end_ms": 32
    },
    "142": {
      "title": "\" ليلة أسري بي أتاني جبريل بالبراق مسرجا ملجما، فذهبت لأركبه، فاستصعب علي، فقال جبريل:",
      "level": 1,
      "parent": null,
      "start_ms": 32,
      "end_ms": 32
    },
    "143": {
      "title": "83 -",
      "level": 1,
      "parent": null,
      "start_ms": 32,
      "end_ms": 33
    },
    "144": {
      "title": "84 -",
      "level": 1,
      "parent": null,
      "start_ms": 33,
      "end_ms": 33
    },
    "145": {
      "title": ": \" لما كان ليلة أسري بي ثم أصبحت بمكة، فظعت بأمري وعلمت أن الناس مكذبي، قال: فقعد معتزلا",
      "level": 1,
      "parent": null,
      "start_ms": 33,
      "end_ms": 34
    },
    "146": {
      "title": "85 -",
      "level": 1,
      "parent": null,
      "start_ms": 34,
      "end_ms": 34
    },
    "147": {
      "title": ": \" لقد رأيتني في الحجر وأنا أخبر قريشا عن مسراي",
      "level": 1,
      "parent": null,
      "start_ms": 34,
      "end_ms": 34
    },
    "148": {
      "title": "86 -",
      "level": 1,
      "parent": null,
      "start_ms": 34,
      "end_ms": 34
