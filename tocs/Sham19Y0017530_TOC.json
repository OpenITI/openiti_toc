{
  "filename": "0909IbnMabrid.SabbKhumul.Sham19Y0017530-ara1",
  "sections": {
    "1": {
      "title": "CHECK مقدمة المؤلف",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "2": {
      "title": "CHECK مدح الأولياء والصالحين في كتاب الله، وكونهم من خواص الله وأحبابه",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 2
    },
    "3": {
      "title": "CHECK الأولياء والصالحون ليس عليهم خوف، لا في الدنيا ولا في الآخرة",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "4": {
      "title": "CHECK الفرق بين حزب الله وحزب الشيطان في القرآن، وأن العاقبة لحزب الله",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 5
    },
    "5": {
      "title": "CHECK عاقبة من ينال أولياء الله بسوء",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 7
    },
    "6": {
      "title": "CHECK خدمة الصالحين ومجالستهم",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 9
    },
    "7": {
      "title": "CHECK الأولياء والصالحون يذكرون بذكره تعالى، ويذكر بذكرهم",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "8": {
      "title": "CHECK من أحب الأولياء والصالحين فهو منهم",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "9": {
      "title": "CHECK ذكر الأولياء والصالحين لله، وذكر كل شيء معهم",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 11
    },
    "10": {
      "title": "CHECK حفظ الأولياء والصالحين بحفظ الله، وكلائته",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "11": {
      "title": "CHECK صحبة الأولياء والصالحين ومعاداتهم، وذكر شيء من أحوالهم",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 13
    },
    "12": {
      "title": "CHECK أثر دعائهم، وأنه السهم المصيب",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "13": {
      "title": "CHECK التحصن بآيات الله من القرآن وشرطه",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 14
    },
    "14": {
      "title": "CHECK خوف الكفرة مع كفرهم من دعاء الأولياء والصالحين",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "15": {
      "title": "CHECK فرار الكفرة من الأولياء والصالحين ليس بمخصوص بالصحابة والتابعين",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 16
    },
    "16": {
      "title": "CHECK تشبيه النبي - صلى الله عليه وسلم - نفسه بالأولياء والصالحين",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "17": {
      "title": "CHECK رفضهم لباطن العاجلة وفسادها، ونظروا إلى ظاهر الدنيا فوضعوها",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 19
    },
    "18": {
      "title": "CHECK صون أولياء الله أنفسهم لنفسه، عن حقارة الدنيا الدنية",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "19": {
      "title": "CHECK من بارز بالعداوة فقد بارز الله، ولن يعجزه",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 21
    },
    "20": {
      "title": "CHECK زينة الأولياء وحلية المتقين أعظم بهجة من زينة الدنيا",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 23
    },
    "21": {
      "title": "AUTO أهل الله به كلفون",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 25
    },
    "22": {
      "title": "CHECK أولياء الله إن حضروا لم يعرفوا، وإن غابوا لم يفقدوا",
      "level": 1,
      "parent": null,
      "start_ms": 25,
      "end_ms": 25
    },
    "23": {
      "title": "CHECK قبول أولياء الله للحق، وبذلهم ما عندهم",
      "level": 1,
      "parent": null,
      "start_ms": 25,
      "end_ms": 26
    },
    "24": {
      "title": "CHECK حال قلوب أولياء الله، وخوفهم وانبساطهم",
      "level": 1,
      "parent": null,
      "start_ms": 26,
      "end_ms": 26
    },
    "25": {
      "title": "CHECK تساوى عند أولياء الله الذهب والحجر، والصفو والكدر، والمادح والذام",
      "level": 1,
      "parent": null,
      "start_ms": 26,
      "end_ms": 27
    },
    "26": {
      "title": "CHECK مبادرة أولياء الله إلى حق الله من غير تسويف",
      "level": 1,
      "parent": null,
      "start_ms": 27,
      "end_ms": 27
    },
    "27": {
      "title": "CHECK تمام عقولهم، وحسن أقوالهم وأفعالهم",
      "level": 1,
      "parent": null,
      "start_ms": 27,
      "end_ms": 28
    },
    "28": {
      "title": "CHECK ذكر شيء من صفات أولياء الله في كتابه",
      "level": 1,
      "parent": null,
      "start_ms": 28,
      "end_ms": 29
    },
    "29": {
      "title": "CHECK ضيق الدنيا وقلتها لذة لأولياء الله، واتساعها عذاب لأهلها",
      "level": 1,
      "parent": null,
      "start_ms": 29,
      "end_ms": 31
    },
    "30": {
      "title": "CHECK عدم احتقار القليل من الشر أن تتقيه، ولا شيئا من الخير أن تفعله",
      "level": 1,
      "parent": null,
      "start_ms": 31,
      "end_ms": 36
    },
    "31": {
      "title": "CHECK مقام الولاية أعظم وأجل من مقام الخلافة",
      "level": 1,
      "parent": null,
      "start_ms": 36,
      "end_ms": 43
    },
    "32": {
      "title": "AUTO وصف الأبرار الأخيار",
      "level": 1,
      "parent": null,
      "start_ms": 43,
      "end_ms": 45
    },
    "33": {
      "title": "CHECK ذهاب النسناس في زماننا وبقاء الأنجاس",
      "level": 1,
      "parent": null,
      "start_ms": 45,
      "end_ms": 47
    },
    "34": {
      "title": "CHECK حاجة البلاد إلى الأوتاد، ليرفع الله بهم البلاء عن العباد",
      "level": 1,
      "parent": null,
      "start_ms": 47,
      "end_ms": 49
    },
    "35": {
      "title": "CHECK التحذير من إيذاء من يتوسم فيه الخير",
      "level": 1,
      "parent": null,
      "start_ms": 49,
      "end_ms": 51
    },
    "36": {
      "title": "AUTO الأولياء أوتاد الدنيا",
      "level": 1,
      "parent": null,
      "start_ms": 51,
      "end_ms": 52
    },
    "37": {
      "title": "CHECK قوة أولياء الله بالله",
      "level": 1,
      "parent": null,
      "start_ms": 52,
      "end_ms": 53
    },
    "38": {
      "title": "CHECK نصح أولياء الله لله، وإصلاحهم أنفسهم له",
      "level": 1,
      "parent": null,
      "start_ms": 53,
      "end_ms": 54
    },
    "39": {
      "title": "CHECK ذكر أولاد أولياء الله للقلوب كالسماد للزرع",
      "level": 1,
      "parent": null,
      "start_ms": 54,
      "end_ms": 54
    },
    "40": {
      "title": "CHECK حفظ أولاد أولياء الله وأزواجهم وكل من سمتهم كذلك",
      "level": 1,
      "parent": null,
      "start_ms": 54,
      "end_ms": 55
    },
    "41": {
      "title": "CHECK ذكر شيء من صفات أولياء الله",
      "level": 1,
      "parent": null,
      "start_ms": 55,
      "end_ms": 56
    },
    "42": {
      "title": "CHECK فضل من اعتصم بالله، وعاقبة من أعجب بنفسه",
      "level": 1,
      "parent": null,
      "start_ms": 56,
      "end_ms": 56
    },
    "43": {
      "title": "CHECK من أولياء الله من يعطيه قبل سؤاله",
      "level": 1,
      "parent": null,
      "start_ms": 56,
      "end_ms": 58
    },
    "44": {
      "title": "CHECK أولياء الله مع الله والله معهم",
      "level": 1,
      "parent": null,
      "start_ms": 58,
      "end_ms": 58
    },
    "45": {
      "title": "CHECK أولياء الله عرف فضلهم، ولم يروا لهم فضلا على أحد",
      "level": 1,
      "parent": null,
      "start_ms": 58,
      "end_ms": 75
    },
    "46": {
      "title": "CHECK أولياء الله قوم لم تخف نفوسهم إلا من الله",
      "level": 1,
      "parent": null,
      "start_ms": 75,
      "end_ms": 79
    },
    "47": {
      "title": "CHECK كتاب ابن عبد الهادي إلى جماعة الرواد",
      "level": 1,
      "parent": null,
      "start_ms": 79,
      "end_ms": 82
    },
    "48": {
      "title": "CHECK خوف بعض السلف من أن يعيروا أحدا، أو يوبخوه في المعاصي",
      "level": 1,
      "parent": null,
      "start_ms": 82,
      "end_ms": 84
    },
    "49": {
      "title": "CHECK في غوغاء عباد الله، من أسود وأحمر، لو دعا الله في أمر أجابه",
      "level": 1,
      "parent": null,
      "start_ms": 84,
      "end_ms": 85
    },
    "50": {
      "title": "CHECK قضاء الله حاجة الإنسان قبل سؤاله",
      "level": 1,
      "parent": null,
      "start_ms": 85,
      "end_ms": 87
    },
    "51": {
      "title": "CHECK من أولياء الله قوم لم يتعرضوا على الرب في تصريفه الزمان",
      "level": 1,
      "parent": null,
      "start_ms": 87,
      "end_ms": 88
    },
    "52": {
      "title": "CHECK أولياء الله قوم جادوا بأنفسهم لله",
      "level": 1,
      "parent": null,
      "start_ms": 88,
      "end_ms": null
    }
