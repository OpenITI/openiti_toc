    "10": {
      "title": "الفصل الثاني في السبب الداعي إلى جمع هذه الأحاديث واستخراجها من أماكنها المتباعدة ومظانها المتعددة",
      "level": 2,
      "parent": 1,
      "start_ms": 8,
      "end_ms": 11
    },
    "11": {
      "title": "الفصل الثالث فيما رويته بطريق الإسناد المتصل المذكور إسناده بطريق العنعنة مما لا تدخل فيه الإجازة والمناولة",
      "level": 2,
      "parent": 1,
      "start_ms": 11,
      "end_ms": 15
    },
    "12": {
      "title": "الفصل الرابع في ذكر أحاديث رويتها بطرقي المذكورة محذوفة الإسناد اعتمادا على الإسناد المذكور أولا وهي كلها تنتهي إلى الرسول (ص)",
      "level": 2,
      "parent": 1,
      "start_ms": 15,
      "end_ms": 27
    },
    "13": {
      "title": "الفصل الخامس في ذكر أحاديث رويتها بهذا المنوال تتعلق بمعالم الدين وجملة من الآداب رويت بالطرق المذكورة",
      "level": 2,
      "parent": 1,
      "start_ms": 27,
      "end_ms": 33
    },
    "14": {
      "title": "الفصل السادس في أحاديث أخرى من هذا الباب رويتها بطريق واحد",
      "level": 2,
      "parent": 1,
      "start_ms": 33,
      "end_ms": 37
    },
    "15": {
      "title": "الفصل السابع في أحاديث تتضمن مثل هذا السياق رويتها بطريقها من مظانها على هذا المنوال",
      "level": 2,
      "parent": 1,
      "start_ms": 37,
      "end_ms": 45
    },
    "16": {
      "title": "الفصل الثامن في ذكر أحاديث تشتمل على كثير من الآداب ومعالم الدين روايتها تنتهي إلى النبي(ص)بطريق واحد من طرقي المذكورة آنفا",
      "level": 2,
      "parent": 1,
      "start_ms": 45,
      "end_ms": 65
    },
    "17": {
      "title": "الفصل التاسع في ذكر أحاديث تتضمن شيئا من أبواب الفقه ذكرها بعض الأصحاب في بعض كتبه مروية بطريقي إليه",
      "level": 2,
      "parent": 1,
      "start_ms": 65,
      "end_ms": 75
    },
    "18": {
      "title": "الفصل العاشر في أحاديث تتضمن شيئا من الآداب الدينية",
      "level": 2,
      "parent": 1,
      "start_ms": 75,
      "end_ms": 84
    },
    "19": {
      "title": "الباب الأول في الأحاديث المتعلقة بأبواب الفقه الغير المرتبة بترتيب أبوابه",
      "level": 1,
      "parent": null,
      "start_ms": 84,
      "end_ms": 123
    },
    "20": {
      "title": "المسلك الأول في أحاديث ذكرها بعض متقدمي الأصحاب رويتها عنه بطرقي إليه لا يختص إسنادها بالرسول ص",
      "level": 3,
      "parent": null,
      "start_ms": 84,
      "end_ms": 123
    },
    "21": {
      "title": "المسلك الثاني في أحاديث تتعلق بمصالح الدين رواها جمال المحققين في بعض كتبه بالطريق التي له إلى روايتها",
      "level": 3,
      "parent": 20,
      "start_ms": 97,
      "end_ms": 111
    },
    "22": {
      "title": "المسلك الثالث في أحاديث رواها الشيخ العالم شمس الملة والدين محمد بن مكي في بعض مصنفاته تتعلق بأحوال الفقه رويتها عنه بطرقي إليه",
      "level": 3,
      "parent": 20,
      "start_ms": 111,
      "end_ms": 123
    },
    "23": {
      "title": "تتمة باب الأول في الأحاديث المتعلقة بأبواب الفقه الغير المرتبة أبوابه",
      "level": 1,
      "parent": null,
      "start_ms": 123,
      "end_ms": 163
    },
    "24": {
