      "end_ms": 6
    },
    "40": {
      "title": "الخاصرة عرق الكلوة، فإذا تحرك آذت صاحبها , فداووها بالماء المحرق",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "41": {
      "title": "21 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "42": {
      "title": ": «الإيمان بضع وسبعون بابا، أفضلها شهادة أن لا إله إلا الله، وأهونها إماطة الأذى عن الطريق،",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
