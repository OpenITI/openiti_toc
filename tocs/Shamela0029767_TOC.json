      "end_ms": 12
    },
    "82": {
      "title": ": «الماهر في القرآن مع السفرة الكرام البررة، والذي ms11 يقرأ القرآن يتتعتع فيه وهو عليه شديد فله",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
