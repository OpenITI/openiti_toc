    "76": {
      "title": "، \" أي الكلام أحب إلى الله؟ قال: ما اصطفاه الله لملائكته: سبحان ربي وبحمده، سبحان ربي",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
