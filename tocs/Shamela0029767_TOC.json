      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 9
    },
    "62": {
      "title": ": «هذا كتاب كتبه رب العالمين فيه تسمية أهل الجنة وتسمية آبائهم، ثم أجمل على آخرهم فلا يزاد",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "63": {
      "title": "32 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "64": {
      "title": "الرجل ليعمل بعمل أهل الجنة، وإنه لمكتوب في الكتاب أنه من أهل النار، فإذا كان قبل موته",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "65": {
      "title": "33 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "66": {
      "title": "إذا دعي إلى جنازة سأل عنها، فإن أثني عليها خيرا قام فصلى عليها، وإن أثني عليها غير ذلك،",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "67": {
      "title": "34 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 10
    },
