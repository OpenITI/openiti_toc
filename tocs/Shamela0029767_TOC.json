      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "88": {
      "title": ": \" من رأى عبدا به بلاء، فقال: الحمد لله الذي عافاني مما ابتلاك به، وفضلني على كثير ممن خلق",
      "level": 1,
      "parent": null,
      "start_ms": 12,
