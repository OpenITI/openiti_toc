      "end_ms": 1
    },
    "4": {
      "title": ": العمل الصالح الذي لا تريد أن يحمدك عليه أحد إلا لله",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "5": {
      "title": "6 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "6": {
      "title": ": لا يقل عمل مع تقوى، وكيف يقل ما يتقبل؟",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "7": {
      "title": "7 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "8": {
      "title": ": طوبى لمن أخلص عبادته ودعاءه لله ولم يشغل قلبه ما تراه عيناه، ولم ينسه ذكره ما تسمع أذناه،",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "9": {
      "title": "8 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "10": {
      "title": ": الإجابة مقرونة بالإخلاص لا فرقة بينهما",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "11": {
      "title": "9 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 2
    },
    "12": {
      "title": ": بئس الخاطب أنت ألا ألقيت الحصى، وأخلصت لله الدعاء",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "13": {
      "title": "10 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "14": {
      "title": ": كونوا لقبول العمل أشد هما منكم بالعمل، ألم تسمعوا الله يقول {إنما يتقبل الله من المتقين}",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "15": {
      "title": "11 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "16": {
      "title": "الرجل ليعمل العمل الحسن في أعين الناس، أو العمل لا يريد به وجه الله فيقع له المقت والعيب",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "17": {
      "title": "12 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "18": {
      "title": ": إذا أقبل العبد إلى الله أقبل الله بقلوب العباد إليه",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "19": {
      "title": "13 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "20": {
      "title": ": أي الأعمال وجدت أفضل؟ قال: ما أريد به وجه الله",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "21": {
      "title": "14 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "22": {
      "title": ": عند تصحيح الضمائر تغفر الكبائر، وإذا عزم العبد على ترك الآثام أتته",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "23": {
      "title": "15 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "24": {
      "title": ": اخرج إنما نشتري بأموالنا لا بأدياننا",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "25": {
      "title": "16 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "26": {
      "title": ": نعم الشيء هذا يا أبا إبراهيم إن لم يكن تكرمة دين",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "27": {
      "title": "17 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 3
    },
    "28": {
      "title": ": اجعلوه في سجين فإني لم أرد بهذا",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "29": {
      "title": "18 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "30": {
      "title": "عبدي هذا لم يخلص لي عمله فاجعلوه في سجين قال: ويصعدون بعمل العبد من عباد الله يستقلونه",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "31": {
      "title": "[ص: 47]",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "32": {
      "title": "19 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "33": {
      "title": ": صدقتم ملائكتي ولكنه يحب أن يعرف مكانه",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "34": {
      "title": "20 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "35": {
      "title": ": لأن أكون أعلم أن الله قد تقبل مني مثقال حبة من خردل أحب إلي من الدنيا وما فيها؛ لأن الله",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "36": {
      "title": "21 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "37": {
      "title": ": الاتقاء على العمل ألا يكون لله",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "38": {
      "title": "22 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "39": {
      "title": "{ليبلوكم أيكم أحسن عملا} [هود: 7] قال: أخلصه وأصوبه، قال: إن العمل إذا كان خالصا ولم يكن",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "40": {
      "title": "[ص: 51]",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "41": {
      "title": "23 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 4
    },
    "42": {
      "title": ": من كان ظاهره أرجح من باطنه خف ميزانه يوم القيامة، ومن كان باطنه أرجح من ظاهره ثقل ميزانه",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "43": {
      "title": "24 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "44": {
      "title": ": من كانت سريرته أفضل من علانيته فذلك الفضل، ومن كانت سريرته مثل علانيته فذلك النصف، ومن",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "45": {
      "title": "25 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "46": {
      "title": ": من أصلح سريرته أصلح الله علانيته، ومن أصلح ما بينه وبين الله كفاه الله ما بينه وبين",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "47": {
      "title": "26 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "48": {
      "title": ": لا تكن وليا لله في العلانية وعدوه في السريرة",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "49": {
      "title": "27 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "50": {
      "title": "اعلموا أن عند الله مسألة فاضحة قال تعالى {فوربك لنسألنهم أجمعين عما كانوا يعملون} [الحجر:",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "51": {
      "title": "28 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "52": {
      "title": ": لا تكن ذا وجهين وذا لسانين، تظهر للناس ليحمدوك، وقلبك فاجر",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "53": {
      "title": "29 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "54": {
      "title": ": ليسألنك الله يوم القيامة ما أردت بهذا",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "55": {
      "title": "30 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "56": {
      "title": ": خير العمل أخفاه، أمنعه من الشيطان وأبعده من الرياء",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "57": {
      "title": "31 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "58": {
      "title": "[ص: 57]",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "59": {
      "title": "«طوبى لمن طاب كسبه، وصلحت سريرته، وكرمت علانيته، وعزل عن الناس شره»",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "60": {
      "title": "32 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 5
    },
    "61": {
      "title": ": رب ارحمني، رب اعف عني، رب إن تعف عني تعف طولا من قبلك، وإن تعذبني تعذبني غير ظالم ولا",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "62": {
      "title": "33 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "63": {
      "title": ": إذا كان يوم صوم أحدكم فليدهن لحيته بدهن ويمسح فليخفه من شماله، وإذا صلى في بيته فليلق",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "64": {
      "title": "34 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "65": {
      "title": ": السر أملك بالعلانية من العلانية بالسر، والفعل أملك بالقول من القول",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "66": {
      "title": "35 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "67": {
      "title": ": قد كان أحدهم يبكي إلى جنب صاحبه فما يعلم به",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "68": {
      "title": "36 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "69": {
      "title": "أدركت رجالا كان الرجل يكون رأسه ورأس امرأته على وساد واحد قد بل ما تحت خده من دموعه لا",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "70": {
      "title": "37 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "71": {
      "title": "الرجل يتعبد عشرين سنة وما يعلم به جاره",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "72": {
      "title": "38 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "73": {
      "title": "لا يعرف البر في عمر ولا ابن عمر حتى يقولا أو يعملا،",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "74": {
      "title": "39 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "75": {
      "title": "40 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 6
    },
    "76": {
      "title": "الرجل ليجتمع إليه القوم أو يجتمعون يتذاكرون فتجيء الرجل عبرته فيردها ثم تجيء فيردها ثم",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "77": {
      "title": "41 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "78": {
      "title": "\" هذه الزكمة ربما عرضت",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "79": {
      "title": "الشيخ إذا كبر مج",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "80": {
      "title": "42 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "81": {
      "title": "يحدث أو يقرأ فيأتيه البكاء فيصرفه إلى الضحك",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "82": {
      "title": "43 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "83": {
      "title": "تنفس عند عمر كأنه يتحازن فلكزه عمر أو قال: لكمه",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "84": {
      "title": "44 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "85": {
      "title": ": إن كان لله فقد شهرت نفسك، وإن كان لغير الله هلكت",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "86": {
      "title": "45 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "87": {
      "title": "الرجل ليكون عنده الزوار فيصلي الصلاة الطويلة أو الكثيرة من الليل ما يعلم بها",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "88": {
      "title": "46 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "89": {
      "title": ": إن جاء أحد يطلبني فقولوا: هو في حاجة له",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "90": {
      "title": "47 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "91": {
      "title": ": إذا رأيت رجلا قد أقبل ترى أنه يريدني فأخبرني. ثم يقوم فيصلي فإذا جاء رجل أخبره الغلام",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "92": {
      "title": "48 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 7
    },
    "93": {
      "title": "49 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "94": {
      "title": ": ربما اشترى حسان بن أبي سنان أهل بيت الرجل وعياله ثم يعتقهم جميعا، ثم لا يتعرف إليهم ولا",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "95": {
      "title": "50 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "96": {
      "title": "يصلي في المحمل جالسا يومئ برأسه إيماء، وكان يأمر الحادي أن يكون خلفه ويرفع صوته حتى لا",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "97": {
      "title": "51 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "98": {
      "title": "الرجل ليبكي عشرين سنة ومعه امرأته ما تعلم به",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "99": {
      "title": "52 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "100": {
      "title": ": إليك عني فإن في القول فتنة، والفعال أولى بالمؤمن من القول",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "101": {
      "title": "53 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "102": {
      "title": "يكرهون إذا اجتمعوا أن يظهر الرجل أحسن ما عنده",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "103": {
      "title": "54 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "104": {
      "title": "أصلحوا آخرتكم يصلح الله لكم دنياكم، وأصلحوا سرائركم يصلح الله لكم علانيتكم والله إن عبدا",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "105": {
      "title": "55 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 8
    },
    "106": {
      "title": "لا تعمل عملا تريد به غير الله فتجعل الله ثوابك على من أردت، ويا أبا العالية لا تتكل على",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "107": {
      "title": "56 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
