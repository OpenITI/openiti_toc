      "parent": null,
      "start_ms": 72,
      "end_ms": 82
    },
    "17": {
      "title": "المسئلة الثالثة فى بيان تلبيسهم بقولهم ان الله فاعل العالم وصانعه وان العالم صنعه وفعله وبيان ان ذلك مجاز عندهم وليس بحقيقة",
      "level": 1,
      "parent": null,
      "start_ms": 82,
      "end_ms": 83
    },
    "18": {
      "title": "اما الاول",
      "level": 1,
      "parent": null,
      "start_ms": 83,
      "end_ms": 90
    },
    "19": {
      "title": "الوجه الثانى",
      "level": 1,
      "parent": null,
      "start_ms": 90,
      "end_ms": 97
    },
    "20": {
      "title": "الوجه الثالث",
      "level": 1,
      "parent": null,
      "start_ms": 97,
      "end_ms": 149
    },
    "21": {
      "title": "مسئلة فى بيان عجزهم عن الاستدلال على وجود صانع العالم",
      "level": 1,
      "parent": null,
      "start_ms": 149,
      "end_ms": 163
    },
    "22": {
      "title": "مسئلة فى بيان عجزهم عن اقامة الدليل على ان الله تعالى واحد وانه لا يجوز فرض اثنين واجبى الوجود كل واحد منهما لا علة له",
      "level": 1,
      "parent": null,
      "start_ms": 163,
      "end_ms": 167
    },
    "23": {
      "title": "مسلكهم الثانى",
      "level": 1,
      "parent": null,
      "start_ms": 167,
      "end_ms": 180
    },
    "24": {
      "title": "مسئلة",
      "level": 1,
      "parent": null,
      "start_ms": 180,
      "end_ms": 189
    },
    "25": {
      "title": "المسلك الثانى",
      "level": 1,
      "parent": null,
      "start_ms": 189,
      "end_ms": 215
    },
    "26": {
      "title": "مسئلة فى ابطال قولهم ان الاول لا يجوز ان يشارك غيره فى جنس ويفارقه بفصل وانه لا يتطرق اليه انقسام فى حق العقل بالجنس والفصل",
      "level": 1,
      "parent": null,
      "start_ms": 215,
      "end_ms": 227
    },
    "27": {
      "title": "المسلك الثانى الالزام",
      "level": 1,
      "parent": null,
      "start_ms": 227,
      "end_ms": 229
    },
    "28": {
      "title": "مسئلة فى ابطال قولهم ان وجود الاول بسيط اى هو وجود محض ولا ماهية ولا حقيقة يضاف الوجود اليها بل الوجود الواجب له كالماهية لغيره",
      "level": 1,
      "parent": null,
      "start_ms": 229,
      "end_ms": 233
    },
    "29": {
      "title": "مسلكهم الثانى",
      "level": 1,
      "parent": null,
      "start_ms": 233,
      "end_ms": 235
    },
    "30": {
      "title": "مسئلة فى تعجيزهم عن اقامة الدليل على ان الاول ليس بجسم",
      "level": 1,
      "parent": null,
      "start_ms": 235,
      "end_ms": 243
    },
    "31": {
      "title": "المسئلة العاشرة فى بيان عجزهم عن اقامة الدليل على ان للعالم صانعا وعلة وان القول بالدهر لازم لهم",
      "level": 1,
      "parent": null,
      "start_ms": 243,
      "end_ms": 248
    },
    "32": {
      "title": "السئلة الحادية عشر فى تعجيز من يرى منهم ان الاول يعلم غيره ويعلم الاجناس والانواع بنوع كلى",
      "level": 1,
      "parent": null,
      "start_ms": 248,
      "end_ms": 252
    },
    "33": {
      "title": "الاول",
      "level": 1,
      "parent": null,
      "start_ms": 252,
      "end_ms": 256
    },
    "34": {
      "title": "الفن الثانى",
      "level": 1,
      "parent": null,
      "start_ms": 256,
      "end_ms": 262
    },
    "35": {
      "title": "المسئلة الثانية عشر فى تعجيز هم عن اقامة الدليل على انه يعرف ذاته",
      "level": 1,
      "parent": null,
      "start_ms": 262,
      "end_ms": 267
    },
    "36": {
      "title": "المسئلة الثالثة عشر فى ابطال قولهم ان الله تعالى عن قولهم لا يعرف الجزئيات المنقسمة بانقسام الزمان الى الكائن وما كان وما يكون",
      "level": 1,
      "parent": null,
      "start_ms": 267,
      "end_ms": 274
    },
    "37": {
      "title": "الاعتراض الثانى",
      "level": 1,
      "parent": null,
      "start_ms": 274,
      "end_ms": 277
    },
    "38": {
      "title": "المسئلة الرابعة عشر فى تعجيز هم عن اقامة الدليل على ان السماء حيوان مطيع الله تبارك وتعالى بالحركة الدورية",
      "level": 1,
      "parent": null,
      "start_ms": 277,
      "end_ms": 277
    },
    "39": {
      "title": "وقد قالوا",
      "level": 1,
      "parent": null,
      "start_ms": 277,
      "end_ms": 281
    },
    "40": {
      "title": "الاعتراض",
      "level": 1,
      "parent": null,
      "start_ms": 281,
      "end_ms": 286
    },
    "41": {
      "title": "المسئلة الخامسة عشر فى ابطال ما ذكروه من الغرض المحرك للسماء",
      "level": 1,
      "parent": null,
      "start_ms": 286,
      "end_ms": 286
    },
    "42": {
      "title": "وقد قالوا",
      "level": 1,
      "parent": null,
      "start_ms": 286,
      "end_ms": 288
    },
    "43": {
      "title": "الاعتراض",
      "level": 1,
      "parent": null,
      "start_ms": 288,
      "end_ms": 289
    },
    "44": {
      "title": "والثانى",
      "level": 1,
      "parent": null,
      "start_ms": 289,
      "end_ms": 293
    },
    "45": {
      "title": "المسئلة السادسة عشر فى ابطال قولهم ان نفوس السماوات مطلعة على جميع الجزئيات الحادثة فى هذا العالم",
      "level": 1,
      "parent": null,
      "start_ms": 293,
      "end_ms": 294
    },
    "46": {
      "title": "واستدلوا",
      "level": 1,
      "parent": null,
      "start_ms": 294,
      "end_ms": 298
    },
    "47": {
      "title": "والجواب",
      "level": 1,
      "parent": null,
      "start_ms": 298,
      "end_ms": 300
    },
    "48": {
      "title": "المقدمة الثالثة",
      "level": 1,
      "parent": null,
      "start_ms": 300,
      "end_ms": 303
    },
    "49": {
      "title": "اما الملقب بالطبيعيات فهى علوم كثيرة",
      "level": 1,
      "parent": null,
      "start_ms": 303,
      "end_ms": 307
    },
    "50": {
      "title": "المسئلة الاولى",
      "level": 1,
