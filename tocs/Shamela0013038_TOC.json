      "end_ms": 14
    },
    "115": {
      "title": "56 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 15
    },
    "116": {
      "title": ": «ما تصدق امرؤ بصدقة من كسب طيب - ولا يقبل الله إلا الطيب - إلا وضعها حين يضعها في كف",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "117": {
      "title": "57 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "118": {
      "title": "[ص: 40]",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "119": {
      "title": "، وهي عندنا حق لا نشك فيها، ولكن إذا قيل كيف وضع قدمه وكيف ضحك؟ قلنا لا يفسر هذا ولا سمعنا",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "120": {
      "title": "58 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "121": {
      "title": "هذه الأحاديث يعني مثل الكرسي موضع القدمين ونحو هذا، فقال وكيع: «أدركنا إسماعيل بن أبي",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "122": {
      "title": "59 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "123": {
      "title": "[ص: 41]",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "124": {
      "title": ": «حق على ما سمعنا ممن نثق به ونرضاه»",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "125": {
      "title": "60 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "126": {
      "title": ": «من رأيتموه ينكر هذه الأحاديث فاحسبوه من الجهمية»",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "127": {
      "title": "61 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 16
    },
    "128": {
      "title": ": «كل شيء وصف الله به نفسه في القرآن فقراءته تفسيره لا كيف ولا مثل»",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "129": {
      "title": "62 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "130": {
      "title": ": «نسلم هذه الأحاديث كما جاءت، ولا نقول كيف هذا ولم جاء هذا»",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "131": {
      "title": "63 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "132": {
      "title": "[ص: 42]",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "133": {
      "title": "نقر بها ونحدث بها بلا كيف \"",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "134": {
      "title": "64 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "135": {
      "title": "[ص: 43]",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "136": {
      "title": "، أشهد أنك فوق العرش، فوق سبع سموات، ليس كما يقول أعداؤك الزنادقة»",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "137": {
      "title": "65 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "138": {
      "title": ": «أما نحن فأخذنا ديننا عن أبناء التابعين عن أصحاب رسول الله صلى الله عليه وسلم فهم عمن",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "139": {
      "title": "66 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 17
    },
    "140": {
      "title": "، يحدثون أن الله عز وجل يرى في الآخرة، حتى جاءنا ابن يهودي صباغ فزعم أن الله لا يرى» يعني",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "141": {
      "title": "67 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
