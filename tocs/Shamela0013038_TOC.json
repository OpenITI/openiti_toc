    },
    "113": {
      "title": "الله عز وجل يقبل الصدقات، ويأخذها بيمينه، ويربيها لأحدكم كما يربي أحدكم فلوه أو مهره، وإن",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "114": {
      "title": "[ص: 39]",
      "level": 1,
