    "99": {
      "title": "مسألة: عند الشافعي وجماعة من العلماء الصلح الموقوف على الإجارة لا يصح،",
      "level": 1,
      "parent": null,
      "start_ms": 394,
      "end_ms": 395
    },
    "100": {
      "title": "مسألة: في مذهب الشافعي إذا قال المدعى عليه للمدعي بعني هذا المدعى؟ فهل يكون إقرارا؟",
      "level": 1,
      "parent": null,
      "start_ms": 395,
      "end_ms": 396
    },
    "101": {
      "title": "مسألة: عند الشافعي وأكثر ms395 العلماء إن كان سطح أحدهما أعلى من الآخر لم يجبر واحد منهما علي بناء شفرة بينهما.",
      "level": 1,
      "parent": null,
      "start_ms": 396,
      "end_ms": 396
    },
    "102": {
      "title": "مسألة: عند الشافعي وأحمد وأبي حنيفة وأكثر العلماء إذا تنازعا حائطا بين ملكيهما",
      "level": 1,
      "parent": null,
      "start_ms": 396,
      "end_ms": 396
    },
    "103": {
      "title": "مسألة: عند الشافعي وأحمد إذا تنازعا حائطا بين ملكيهما ولأحدهما عليه جذوع لم ترجح بذلك دعواه،",
      "level": 1,
      "parent": null,
      "start_ms": 396,
      "end_ms": 397
    },
    "104": {
      "title": "كتاب الحوالة",
      "level": 1,
      "parent": null,
      "start_ms": 397,
      "end_ms": 397
    },
    "105": {
      "title": "مسألة: عند الشافعي وكافة العلماء رضى المحتال شرط في صحة الحوالة.",
      "level": 1,
      "parent": null,
      "start_ms": 397,
      "end_ms": 397
    },
    "106": {
      "title": "مسألة: عند أكثر أصحاب الشافعي لا تصح الحوالة على من لا حق عليه ولو رضى.",
      "level": 1,
      "parent": null,
      "start_ms": 397,
      "end_ms": 397
    },
    "107": {
      "title": "مسألة: عند الشافعي ومالك والليث وأحمد وإسحاق وعلي بن أبي طالب يبرأ المحيل من الحق بالحوالة،",
      "level": 1,
      "parent": null,
      "start_ms": 397,
      "end_ms": 398
    },
    "108": {
      "title": "مسألة: عند الشافعي وأبي حنيفة إذا أحاله على ms397 رجل ولم يشترط أنه مليء أو معسر، وبان أنه معسر لم يرجع المحتال على المحيل،",
      "level": 1,
      "parent": null,
      "start_ms": 398,
      "end_ms": 398
    },
    "109": {
      "title": "مسألة: عند أكثر أصحاب الشافعي وأبي حنيفة واختاره المزني أنه إذا اتفق المحيل والمحتال على لفظ الحوالة، ثم اختلفا",
      "level": 1,
      "parent": null,
      "start_ms": 398,
      "end_ms": 398
    },
    "110": {
      "title": "كتاب الضمان",
      "level": 1,
      "parent": null,
      "start_ms": 398,
      "end_ms": 398
    },
    "111": {
