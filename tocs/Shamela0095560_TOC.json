    },
    "112": {
      "title": "مسألة: عند الشافعي ومالك وأبي يوسف ومحمد وأكثر العلماء يصح ضمان الدين عن الميت،",
      "level": 1,
      "parent": null,
      "start_ms": 398,
      "end_ms": 398
    },
    "113": {
      "title": "مسألة: عند الشافعي لا يعتبر رضا المضمون له في صحة الضمان في أصح الوجهين،",
      "level": 1,
      "parent": null,
      "start_ms": 398,
      "end_ms": 399
