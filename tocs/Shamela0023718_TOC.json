  "filename": "0346Mascudi.TanbihWaIshraf.Shamela0023718-ara1.mARkdown",
  "sections": {
    "1": {
      "title": "ذكر الغرض من هذا الكتاب",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 5
    },
    "2": {
      "title": "ذكر الأفلاك وهيئاتها والنجوم وتأثيراتها والعناصر وتراكيبها وكيفية أفعالها",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 9
    },
    "3": {
      "title": "ذكر البيان عن قسمة الازمنة، وفصول السنة وما لكل فصل من المنازل، والتنازع في المبتدإ به منها والاصطقصات، وما اتصل بذلك",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 12
    },
    "4": {
      "title": "ذكر الرياح الأربع ومهابها وأفعالها وتأثيراتها وما اتصل بذلك من تقريظ مصر والتنبيه على فضلها وما شرفت به على غيرها",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 16
    },
    "5": {
      "title": "ذكر الأرض وشكلها وما قيل في مقدار مساحتها وعامرها وغامرها، والنواحي والآفاق وما يغلب عليها وتأثيرها في سكانها وما اتصل بذلك",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 22
    },
    "6": {
      "title": "ذكر الأقاليم السبعة وقسمتها وحدودها وما قيل في طولها وعرضها وما اتصل بذلك",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 36
    },
    "7": {
      "title": "ذكر قسمة الأقاليم على الكواكب السبعة- الخمسة والنيرين-",
      "level": 2,
      "parent": 6,
      "start_ms": 24,
      "end_ms": 25
    },
    "8": {
      "title": "ذكر الإقليم الرابع ووصفه وفضله على سائر الأقاليم، وما خص به ساكنوه من الفضائل التي باينوا بها سكان غيره منها وما اتصل بذلك من الكلام في عروض البلدان واطوالها والاهوية والترب والمياه وتأثيراتها وغير ذلك",
      "level": 2,
      "parent": 6,
      "start_ms": 25,
      "end_ms": 36
    },
    "9": {
      "title": "ذكر البحار واعدادها وما قيل في اطوالها وعروضها واتصالها وانفصالها، ومصبات عظام الأنهار اليها وما يحيط بها من الممالك وغير ذلك من أحوالها",
      "level": 1,
      "parent": null,
      "start_ms": 36,
      "end_ms": 55
    },
    "10": {
      "title": "ذكر الأول منها وهو الحبشي",
      "level": 2,
      "parent": 9,
      "start_ms": 37,
      "end_ms": 40
    },
    "11": {
      "title": "ذكر البحر الثاني وهو الرومي",
      "level": 2,
      "parent": 9,
      "start_ms": 40,
      "end_ms": 43
    },
    "12": {
      "title": "ذكر البحر الثالث وهو الخزري",
      "level": 2,
      "parent": 9,
      "start_ms": 43,
      "end_ms": 47
    },
    "13": {
      "title": "ذكر البحر الرابع وهو بنطس",
      "level": 2,
      "parent": 9,
      "start_ms": 47,
      "end_ms": 48
    },
    "14": {
      "title": "ذكر أوقيانس وهو المحيط",
      "level": 2,
      "parent": 9,
      "start_ms": 48,
      "end_ms": 55
    },
    "15": {
      "title": "ذكر الأمم السبع في سالف الزمان ولغاتهم وآرائهم ومواضع مساكنهم وما بانت به كل أمة من غيرها وما اتصل بذلك",
      "level": 1,
      "parent": null,
      "start_ms": 55,
      "end_ms": 60
    },
    "16": {
      "title": "ذكر ملوك الفرس على طبقاتهم من جيومرت، وهو الأول من ملوكهم إلى يزدجرد بن شهريار آخرهم، وعدة ما ملكوا من السنين",
      "level": 1,
      "parent": null,
      "start_ms": 60,
      "end_ms": 77
    },
    "17": {
      "title": "ذكر الطبقة الاولى من ملوك الفرس الأولى",
      "level": 2,
      "parent": 16,
      "start_ms": 61,
      "end_ms": 62
    },
    "18": {
      "title": "ذكر الطبقة الثانية من ملوك الفرس الاولى وهم بلان، معنى ذلك العلويون",
      "level": 2,
      "parent": 16,
      "start_ms": 62,
      "end_ms": 63
    },
    "19": {
      "title": "ذكر الطبقة الثالثة من ملوك الفرس الاولى وهم الكيانيون، تفسير ذلك والأعزاء",
      "level": 2,
      "parent": 16,
      "start_ms": 63,
      "end_ms": 66
    },
    "20": {
      "title": "ذكر ما أدركه الإحصاء من ملوك الطوائف وهي الطبقة الرابعة من ملوك الفرس وجملة ما ملكوا من السنين",
      "level": 2,
      "parent": 16,
      "start_ms": 66,
      "end_ms": 69
    },
    "21": {
      "title": "ذكر ملوك الفرس الثانية وهم الساسانية، وهي الطبقة الخامسة من ملوكهم",
      "level": 2,
      "parent": 16,
      "start_ms": 69,
      "end_ms": 77
    },
    "22": {
      "title": "ذكر ملوك اليونانيين ومدة ما ملكوا من السنين",
      "level": 1,
      "parent": null,
      "start_ms": 77,
      "end_ms": 84
    },
    "23": {
      "title": "ذكر ملوك الروم على طبقاتهم من الحنفاء وهم الصابئون والمنتصرة وعدتهم، وجملة ما ملكوا من السنين",
      "level": 1,
      "parent": null,
      "start_ms": 84,
      "end_ms": 133
    },
    "24": {
      "title": "ذكر الطبقة الاولى من ملوك الروم، وهم الصابئون",
      "level": 2,
      "parent": 23,
      "start_ms": 85,
      "end_ms": 94
    },
    "25": {
      "title": "ذكر الطبقة الثانية من ملوك الروم وهم المنتصرة وتأريخهم وأعدادهم، وما كان من الكوائن والاحداث العظام الديانية والملوكية في أيامهم",
      "level": 2,
      "parent": 23,
      "start_ms": 94,
      "end_ms": 106
    },
    "26": {
      "title": "ذكر ملوك الروم من الهجرة الى سنة 345",
      "level": 2,
      "parent": 23,
      "start_ms": 106,
      "end_ms": 119
    },
    "27": {
      "title": "ذكر بنود الروم وحدودها ومقاديرها، وما يتصل منها بالخليج، وبحر الروم والخزر وما اتصل بذلك من اللمع المنبهة على ما تقدم من تأليفنا فيما سلف من كتبنا",
      "level": 2,
      "parent": 23,
      "start_ms": 119,
      "end_ms": 128
    },
    "28": {
      "title": "ذكر الأفدية بين المسلمين والروم",
      "level": 2,
      "parent": 23,
      "start_ms": 128,
      "end_ms": 133
    },
    "29": {
      "title": "ذكر تأريخ الأمم والأنبياء والملوك، وجامع تأريخ العالم من آدم الى نبينا صلى الله عليه وعلى آله، وما اتصل بذلك",
      "level": 1,
      "parent": null,
      "start_ms": 133,
      "end_ms": 146
    },
    "30": {
      "title": "ذكر جمل من الكلام في سنى الأمم وشهورها وكبسها ونسيئها وما اتصل بذلك",
      "level": 1,
      "parent": null,
      "start_ms": 146,
      "end_ms": 156
    },
    "31": {
      "title": "ذكر التأريخ من مولد رسول الله صلى الله عليه وسلم. ومبعثه. وهجرته. ومغازيه. وسراياه. وسوار به. وكتابه. ووفاته. وتأريخ الخلفاء والملوك بعده. وأيامهم. وكتابهم. ووزرائهم. وحجابهم. وقضاتهم. ونقوش خواتيمهم. وما كان من الحوادث العظيمة الديانية والملوكية في أيامهم. وحصر تواريخهم الى سنة 345 في خلافة المطيع",
      "level": 1,
      "parent": null,
      "start_ms": 156,
      "end_ms": null
    },
    "32": {
      "title": "ذكر السنة الثانية من الهجرة وتعرف «بسنة الأمر» لأنه أمر فيها بالقتال",
