      "start_ms": 1,
      "end_ms": 1
    },
    "2": {
      "title": "إذا كبر للصلاة رفع يديه حذو منكبيه وإذا ركع فعل ذلك ولا يفعل ذلك بين",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "3": {
      "title": "2 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 2
    },
    "4": {
      "title": ": «على كل باب كل مسجد يوم الجمعة ملائكة يكتبون مجيء الرجل , فإذا جلس الإمام طويت الصحف،",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "5": {
      "title": "3 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "6": {
      "title": "ينقل معهم الحجارة للكعبة وعليه إزاره، فقال له العباس: محمد يا ابن أخي لو حللت إزارك",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "7": {
      "title": "4 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "8": {
      "title": ": \" ما منكم من أحد إلا كتب مقعده من الجنة ومقعده من النار.",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "9": {
      "title": "5 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "10": {
      "title": ": «أرحم أمتي أبو بكر , وأشدها في دين الله عمر , وأصدقها حياء عثمان , وأفرضهم زيد , وأقرؤهم",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "11": {
      "title": "6 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "12": {
      "title": ": «من نوقش الحساب هلك» .",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "13": {
      "title": "7 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 3
    },
    "14": {
      "title": ": «عذبت أمة من الأمم من بني إسرائيل اتخذوا مثل هذه»",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "15": {
      "title": "8 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "16": {
      "title": "«في المسح على الخفين ثلاثة أيام للمسافر ولياليهن، وللمقيم يوم وليلة»",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "17": {
      "title": "9 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "18": {
      "title": ": «ضرس الكافر مثل أحد , وفخذه مثل البيضاء، ومقعده من النار بين قديد ومكة، وكثافة جلده اثنان",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "19": {
      "title": "10 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "20": {
      "title": ": «بايعت رسول الله صلى الله عليه وسلم على إقام الصلاة، وإيتاء الزكاة، والنصح لكل",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "21": {
      "title": "11 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "22": {
      "title": ": «الحياء خير كله»",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "23": {
      "title": "12 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "24": {
      "title": ": «العز إزاري، والكبرياء ردائي، من نازعني شيئا منهما عذبته»",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "25": {
      "title": "13 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "26": {
      "title": ": \" إذا بقي ثلث الليل نزل الله إلى سماء الدنيا , يقول: «من ذا الذي يدعوني فأستجيب له، من ذا",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 4
    },
    "27": {
      "title": "14 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "28": {
      "title": ": \" لا يدخل الجنة أحد إلا برحمة الله.",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "29": {
      "title": "15 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "30": {
      "title": ": صفي لي رسول الله صلى الله عليه وسلم.",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "31": {
      "title": "16 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "32": {
      "title": ": \" أمرت أن أقاتل الناس حتى يقولوا: لا إله إلا الله، فإذا قالوها عصموا مني دماءهم وأموالهم",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "33": {
      "title": "17 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "34": {
      "title": ": «من أخذ شبرا من الأرض بغير حق طوقه يوم القيامة من سبع أرضين»",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "35": {
      "title": "18 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "36": {
      "title": "«سمع بكاء صبي وهو في الصلاة فخفف صلاته»",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "37": {
      "title": "19 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "38": {
      "title": ": لما خلق الخلق كتب على نفسه بيده: «إن رحمتي تغلب غضبي»",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "39": {
      "title": "20 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "40": {
      "title": "بقتل الوزغ»",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "41": {
      "title": "21 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "42": {
      "title": ": كنا مع طلحة ونحن محرمون فأهدي لنا لحم صيد وهو راقد , فمنا من أكل ومنا من تورع، فلم يأكل",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 5
    },
    "43": {
      "title": "22 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "44": {
      "title": ": \" أفلا أوصيك بكلمات تقولهن في دبر كل صلاة، قل: رب أعني على ذكرك وشكرك وحسن",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "45": {
      "title": "23 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "46": {
      "title": "طاف على راحلته يسلم الأركان بمحجنه، ثم خرج فطاف بين الصفا والمروة على",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "47": {
      "title": "24 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "48": {
      "title": ": «يبعث الناس يوم القيامة والسماء تطش عليهم»",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "49": {
      "title": "25 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "50": {
      "title": ": «لا ترجعوا بعدي كفارا يضرب بعضكم رقاب بعض»",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "51": {
      "title": "26 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "52": {
      "title": "قد علمت أن والدي استشهد يوم أحد وترك عليه دينا كثيرا وأنا أحب أن يراك الغرماء، قال: «اذهب",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 6
    },
    "53": {
      "title": "27 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "54": {
      "title": ": «لا طيرة والطيرة على من تطير، فإن يكن في شيء ففي الدار والمرأة والفرس»",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "55": {
      "title": "28 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "56": {
      "title": ": «ما خرج رسول الله صلى الله عليه وسلم يوم فطر حتى يأكل تمرات ثلاثا أو خمسا أو سبعا أو أقل",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "57": {
      "title": "29 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "58": {
      "title": ": «إذا خطب أحدكم امرأة فإن استطاع أن ينظر منها إلى بعض ما يدعوه إلى نكاحها",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "59": {
      "title": "30 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "60": {
      "title": ": \" ألا أنشدك، قال رسول الله صلى الله عليه وسلم: لا \".",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "61": {
      "title": "31 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 7
    },
    "62": {
      "title": "لما نزل الحديبية أتاه سهيل بن عمرو، ms6 فقال رسول الله صلى الله عليه وسلم: «هذا سهيل بن عمرو",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "63": {
      "title": "32 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "64": {
      "title": ": \" مثل الجليس الصالح مثل العطار إن لم تصب من عطره , أو قال: لم يعطك من عطره أصبت من ريحه",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "65": {
      "title": "33 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "66": {
      "title": ": «ما من نفس إلا قد كتب مدخلها ومخرجها وما هي لاقية» .",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "67": {
