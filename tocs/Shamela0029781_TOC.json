      "start_ms": 7,
      "end_ms": 7
    },
    "68": {
      "title": "أي العمل أفضل؟ قال: الصلاة على ميقاتها، قال: قلت: ثم أي؟ قال: ثم بر الوالدين، قال: قلت:",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 8
    },
