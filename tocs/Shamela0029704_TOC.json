      "end_ms": 15
    },
    "102": {
      "title": ": \" أحدثكم بخير دور الأنصار؟ قالوا: نعم يا رسول الله.",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 16
    },
    "103": {
      "title": "52 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "104": {
      "title": ": \" اشتكت النار إلى ربها تعالى فقالت: يا رب أكل بعضي بعضا، فأذن لها بنفسين: نفس في الشتاء",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "105": {
      "title": "53 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "106": {
      "title": ": «والله إني لأستغفر وأتوب في اليوم أكثر من سبعين مرة»",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "107": {
      "title": "54 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "108": {
      "title": ": اللهم ارحمني ومحمدا ولا ترحم معنا أحدا.",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "109": {
      "title": "55 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "110": {
      "title": ": \" بينا راع في غنمه عدا عليه الذئب، فقال: من لها يوم السبع، يوم ليس لها راع غيري.",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 17
    },
    "111": {
      "title": "56 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "112": {
      "title": ": «أنا الرحمن، وأنا خلقت الرحم وشققت لها من اسمي، فمن وصلها وصلته ومن قطعها قطعته",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "113": {
      "title": "57 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "114": {
      "title": ": «عليكم بهذه الحبة السوداء , فإن فيها شفاء من كل شيء إلا من السام» .",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "115": {
      "title": "58 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "116": {
      "title": ": «إني ذاكر لك أمرا فلا عليك ألا تستعجلي حتى تستأمري أبويك» .",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "117": {
      "title": "59 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "118": {
      "title": "اعدل.",
      "level": 1,
