      "start_ms": 6,
      "end_ms": 7
    },
    "32": {
      "title": ": «إنما أنا بشر، وإنه يأتيني الخصم، فلعل بعضهم أن يكون أبلغ من بعض فأقضي له بذلك وأحسب أنه",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "33": {
