      "start_ms": 5,
      "end_ms": 5
    },
    "22": {
      "title": "من تبنى رجلا في الجاهلية دعاه الناس إليه وورث من ميراثه، حتى أنزل الله تعالى في ذلك:",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 6
