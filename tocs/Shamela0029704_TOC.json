      "start_ms": 8,
      "end_ms": 8
    },
    "46": {
      "title": "لولا أن رجالا من المؤمنين لا تطيب أنفسهم أن يتخلفوا عني ولا أجد ما أحملهم عليه ما تخلفت",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
