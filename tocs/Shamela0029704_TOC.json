      "end_ms": 6
    },
    "26": {
      "title": "إني كنت تحت رفاعة فطلقني فبت طلاقي، فتزوجت بعده عبد الرحمن بن الزبير وإنه ما معه يا رسول",
      "level": 1,
      "parent": null,
