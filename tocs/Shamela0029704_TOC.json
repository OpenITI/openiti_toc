      "start_ms": 4,
      "end_ms": 4
    },
    "18": {
      "title": "أفلح أخا أبي القعيس استأذن علي فأبيت أن آذن له حتى أستأذنك في ذلك.",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 5
