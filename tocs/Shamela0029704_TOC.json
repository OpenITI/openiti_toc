      "start_ms": 9,
      "end_ms": 9
    },
    "50": {
      "title": ": «ما من بني آدم من مولود إلا يمسه الشيطان حين يولد فيستهل صارخا من مس الشيطان، غير مريم",
      "level": 1,
      "parent": null,
      "start_ms": 9,
