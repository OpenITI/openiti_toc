      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "34": {
      "title": "لم يقبض نبي قط حتى يرى مقعده من الجنة ثم يحيى، فلما اشتكى وحضره القبض ورأسه على فخذ عائشة",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
