      "title": "19 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "43": {
      "title": ": \" إذا أشار العبد بأصبعه في الصلاة، يقول الله عز وجل: أخلص لي عبدي، وإذا رفع يديه في الصلاة",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "44": {
      "title": "20 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "45": {
      "title": ": «ما خطب رسول الله صلى الله عليه وسلم، إلا أمر بالصدقة، ونهى عن المثلة»",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
