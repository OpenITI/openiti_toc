      "start_ms": 9,
      "end_ms": 9
    },
    "72": {
      "title": ": «أنزلت الصحف الأولى أول يوم من رمضان، وأنزلت التوراة في ستة من رمضان، وأنزل الإنجيل في",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 10
