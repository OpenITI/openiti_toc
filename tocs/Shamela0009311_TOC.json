    },
    "105": {
      "title": "قد دنا مني حقوق من بين أظهركم، فمن كنت جلدت له ظهرا، فهذا ظهري فليستقد منه، ومن كنت أخذت",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 14
    },
    "106": {
      "title": "[ص: 49]",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "107": {
      "title": "[ص: 50]",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "108": {
      "title": "50 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 15
    },
    "109": {
      "title": "[ص: 51]",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "110": {
      "title": "\" رأيت رب العزة عز وجل في النوم فقلت: يا رب ما أفضل ما تقرب المتقربون به إليك؟ فقال: «كلامي",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "111": {
      "title": "51 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "112": {
      "title": "، «أن النبي صلى الله عليه وسلم كان يقرأ في الصبح، ب ق، والقرآن المجيد، وكانت صلاته بعد ذلك",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "113": {
      "title": "52 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "114": {
      "title": ": «تعجيل الإفطار، وتأخير السحور من شعائر الإسلام»",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "115": {
      "title": "53 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "116": {
      "title": ": «لا يزال الدين ظاهرا ما عجلوا الناس الإفطار، فإن اليهود والنصارى يؤخرون»",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "117": {
      "title": "54 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 16
    },
    "118": {
      "title": ": \" إذا كان يوم الفطر قامت الملائكة على أفواه الطرق، فنادوا: يا معشر المسلمين اغدوا إلى ربكم،",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "119": {
      "title": "55 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "120": {
      "title": ": «من أفطر يوما من شهر رمضان من غير عذر، ولا رخصة فلا يقضيه صيام الدهر كله وإن",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "121": {
      "title": "56 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "122": {
      "title": "[ص: 57]",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "123": {
      "title": "57 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 17
    },
    "124": {
      "title": ": «وعزة ربي والذي بعثني بالحق، لو عاش مائة سنة فصامها ما أدرك فضل ذلك",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "125": {
      "title": "58 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "126": {
      "title": "[ص: 58]",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "127": {
      "title": "من كان عليه صيام من رمضان فليسرده، ولا يقطعه»",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "128": {
      "title": "59 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "129": {
      "title": ": «ليست بمنسوخة هو الشيخ الكبير، والمرأة الكبيرة لا يستطيعان أن يصوما فيطعمان مكان كل يوم",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "130": {
      "title": "60 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "131": {
      "title": "«فليطعم عنه لكل يوم نصف صاع من بر»",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "132": {
      "title": "61 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "133": {
      "title": ": «ذلك إليك، أرأيت لو كان على أحدكم دين، وقضى الدرهم والدرهمين، ألم يكن قضاؤها لله عز وجل",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "134": {
      "title": "62 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 18
    },
    "135": {
      "title": "[ص: 60]",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "136": {
      "title": "63 -",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "137": {
      "title": ": «إذا رأيتم الذين يسبون أصحابي فالعنوهم»",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "138": {
      "title": "64 -",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "139": {
      "title": "[ص: 63]",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "140": {
      "title": "«لأعطين الراية غدا لرجل يحبه الله ورسوله، وهو من أهل الجنة» وكان علي عليه السلام أرمد فدعاه",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "141": {
      "title": "65 -",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "142": {
      "title": ": \" رأيت ليلة أسري بي مكتوبا حول العرش في فرندة خضراء، مكتوبا فيها بقلم من نور أبيض: لا إله",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 19
    },
    "143": {
      "title": "66 -",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "144": {
      "title": ": «شهر بركة وخير يغشاكم الله تعالى فيه بتنزيل الرحمة، ويحط الخطايا، ويستجيب فيه الدعاء، ينظر",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "145": {
      "title": "67 -",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "146": {
      "title": ": «من صام ستة أيام بعد الفطر فكأنما صام الدهر كله»",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "147": {
      "title": "68 -",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "148": {
      "title": "[ص: 65]",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "149": {
      "title": "هذا الشهر كتب الله صيامه، ولم يكتب عليكم قيامه، فمن قامه فإنها من نوافل الخير، ومن لا",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 20
    },
    "150": {
      "title": "69 -",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "151": {
      "title": ": \" ألا أنبئكم بأفضل الملائكة: جبريل عليه السلام، وأفضل النبيين: آدم عليه السلام، وأفضل",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "152": {
      "title": "70 -",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "153": {
      "title": ": \" تنكح المرأة لأربع: لجمالها، ولحسبها، ولمالها، ولدينها، فاظفر بذات الدين تربت",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "154": {
      "title": "71 -",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "155": {
      "title": ": \" هي إحدى عشرة كبيرة: منها أربع في الرأس، وهي: الشرك بالله عز وجل، وقذف المحصنة، واليمين",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "156": {
      "title": "72 -",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 21
    },
    "157": {
      "title": ": «لكل داء دواء» فإذا أصيب دواء الداء برأ بإذن الله عز وجل \" قال الشيخ: هذا حديث صحيح، أخرجه",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "158": {
      "title": "73 -",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "159": {
      "title": "الناس يكثرون، وأصحابي يقلون، فلا تسبوهم، ومن سبهم فعليه لعنة الله»",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "160": {
      "title": "74 -",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "161": {
      "title": ": \" ليلة أسري بي قلت لجبريل عليه السلام: إن قومي لا يصدقوني، قال لي جبريل عليه السلام: يصدقك",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "162": {
      "title": "75 -",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "163": {
      "title": ": «من أشقى الأولين؟» فقال علي عليه السلام: «عاقر الناقة» قال: «فمن أشقى الآخرين؟» قال: «لا أدري»",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "164": {
      "title": "[ص: 70]",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "165": {
      "title": "76 -",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 22
    },
    "166": {
      "title": "[ص: 71]",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 22
    },
    "167": {
      "title": "ألا أعلمك كلمات تقولها، لو كانت عليك من الذنوب كذر النمل لغفرها الله لك، مع أنه مغفور لك",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 22
    },
    "168": {
      "title": "77 -",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 22
    },
    "169": {
      "title": ": \" من تهاون بصلاته، فإن الله عز وجل يعاقبه بخمس عشرة خصلة ست منها في الدنيا، وثلاث عند",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 22
    },
    "170": {
      "title": "[ص: 72]",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 22
    },
    "171": {
      "title": "78 -",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 23
    },
    "172": {
      "title": ": «لا أعلم شيئا يراد الله به أفضل من طلب العلم»",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 23
    },
    "173": {
      "title": "79 -",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 23
    },
    "174": {
      "title": ": «أكلت مع رسول الله صلى الله عليه وسلم، وأبي بكر وعمر وعثمان خبزا ولحما وصلوا ولم",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 23
    },
    "175": {
      "title": "80 -",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 23
    },
    "176": {
      "title": "حرم أبو بكر الخمر على نفسه في الجاهلية لأنه مر بسكران يتناول العذرة بيده، فإذا أدناها من",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 23
    },
    "177": {
      "title": "[ص: 75]",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 23
    },
    "178": {
      "title": "81 -",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 23
    },
    "179": {
      "title": "الشهادة من ورائك، فكيف صبرك إذا خضبت هذه من هذا بدم» وأهوى بيده إلى لحيته ورأسه، فقال علي",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 23
    },
    "180": {
      "title": "82 -",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 24
    },
    "181": {
      "title": ": «مثل الصلوات الخمس، كمثل رجل، على بابه نهر غمر» يغتسل منه كل يوم خمس مرات «فما عسى أن يبقى",
      "level": 1,
      "parent": null,
      "start_ms": 24,
      "end_ms": 24
    },
    "182": {
      "title": "83 -",
      "level": 1,
      "parent": null,
      "start_ms": 24,
      "end_ms": 24
    },
    "183": {
      "title": ": «نعم البيت الحمام، يدخله الرجل المسلم فيتعوذ فيه بالله، ومن النار، ويسأل الله عز وجل فيه",
      "level": 1,
      "parent": null,
      "start_ms": 24,
      "end_ms": 24
    },
    "184": {
      "title": "84 -",
      "level": 1,
      "parent": null,
      "start_ms": 24,
      "end_ms": 24
    },
    "185": {
      "title": ": \" إن أول ما يكفأ من الدين كما يكفأ من الإناء هي: الخمر، يشربونها ويدعونها بغير",
      "level": 1,
      "parent": null,
      "start_ms": 24,
      "end_ms": 24
    },
    "186": {
      "title": "85 -",
      "level": 1,
      "parent": null,
      "start_ms": 24,
      "end_ms": 24
    },
    "187": {
      "title": "[ص: 78]",
      "level": 1,
      "parent": null,
      "start_ms": 24,
      "end_ms": 24
    },
    "188": {
      "title": "«كلوها، ولا بأس بها»",
      "level": 1,
      "parent": null,
      "start_ms": 24,
      "end_ms": 24
    },
    "189": {
      "title": "86 -",
      "level": 1,
      "parent": null,
      "start_ms": 24,
      "end_ms": 25
    },
    "190": {
      "title": "الله عز وجل أفرح بتوبة عبده المؤمن من الضال الواجد، ومن الضامن الوارد، ومن العقيم الوالد،",
      "level": 1,
      "parent": null,
      "start_ms": 25,
      "end_ms": 25
    },
    "191": {
      "title": "87 -",
      "level": 1,
      "parent": null,
      "start_ms": 25,
      "end_ms": 25
    },
    "192": {
      "title": "[ص: 79]",
      "level": 1,
      "parent": null,
      "start_ms": 25,
      "end_ms": 25
    },
    "193": {
      "title": "فأمره ألا يستقبل الريح، وأن ينتكب القبلة ولا يستقبلها، ولا يستدبرها، وأن يستنجي بثلاثة",
      "level": 1,
      "parent": null,
      "start_ms": 25,
      "end_ms": 25
    },
    "194": {
      "title": "88 -",
      "level": 1,
      "parent": null,
      "start_ms": 25,
      "end_ms": 25
    },
    "195": {
      "title": ": «من ألقى جلباب الحياء فلا غيبة له»",
      "level": 1,
      "parent": null,
      "start_ms": 25,
      "end_ms": 25
    },
    "196": {
      "title": "89 -",
      "level": 1,
      "parent": null,
      "start_ms": 25,
      "end_ms": 25
    },
    "197": {
      "title": ": «يأتي زمان على الناس من لم يكن معه أصفر، أو أبيض، لم يتهنأ على العيش»",
      "level": 1,
      "parent": null,
      "start_ms": 25,
      "end_ms": 25
    },
    "198": {
      "title": "90 -",
      "level": 1,
      "parent": null,
      "start_ms": 25,
      "end_ms": 25
    },
    "199": {
      "title": "أصبحت تحدد الدنيا بطول الأمل، وتمنى على الله الأماني بشر العمل، هيهات تضرب في حديد",
      "level": 1,
      "parent": null,
      "start_ms": 25,
      "end_ms": 26
    },
    "200": {
      "title": "91 -",
      "level": 1,
      "parent": null,
      "start_ms": 26,
      "end_ms": 26
    },
    "201": {
      "title": ": «أيما صبي حج، ثم أدرك فعليه أن يحج حجة أخرى، وأيما عبد حج، ثم أعتق، فعليه أن يحج حجة",
      "level": 1,
      "parent": null,
      "start_ms": 26,
      "end_ms": 26
    },
    "202": {
      "title": "92 -",
      "level": 1,
      "parent": null,
      "start_ms": 26,
      "end_ms": 26
    },
    "203": {
      "title": ": «اثبت فإنما عليك نبي وصديق وشهيدان»",
      "level": 1,
      "parent": null,
      "start_ms": 26,
      "end_ms": 26
    },
    "204": {
      "title": "93 -",
      "level": 1,
      "parent": null,
      "start_ms": 26,
      "end_ms": 26
    },
    "205": {
      "title": "[ص: 83]",
      "level": 1,
      "parent": null,
      "start_ms": 26,
      "end_ms": 26
    },
    "206": {
      "title": "لقد فقدتم رجلا لم يسبقه الأولون، ولم يدركه الآخرون، إن كان رسول الله صلى الله عليه وسلم",
      "level": 1,
      "parent": null,
      "start_ms": 26,
      "end_ms": 26
    },
    "207": {
      "title": "94 -",
      "level": 1,
      "parent": null,
      "start_ms": 26,
      "end_ms": 27
    },
    "208": {
      "title": ": «كل شراب أسكر فهو حرام»",
      "level": 1,
      "parent": null,
      "start_ms": 27,
      "end_ms": 27
    },
    "209": {
      "title": "95 -",
      "level": 1,
      "parent": null,
      "start_ms": 27,
      "end_ms": 27
