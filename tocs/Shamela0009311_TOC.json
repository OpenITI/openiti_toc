      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "92": {
      "title": "الجماعة بركة، والثريد بركة، والسحور بركة، تسحروا فإنه يزيد في القوة، وهو من السنة تسحروا",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
