      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "70": {
      "title": ": «أفش السلام، وأطب الكلام، وأطعم الطعام، وأدم الصيام، وصل بالليل والناس نيام تدخل الجنة",
      "level": 1,
