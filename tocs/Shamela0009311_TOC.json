      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "50": {
      "title": ": «هذا شهر رمضان يستقبلكم وتستقبلونه، ألا وإن الله عز وجل ليس بتارك صبيحة الصوم أحدا من أهل",
      "level": 1,
