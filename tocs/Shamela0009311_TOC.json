    "59": {
      "title": "[ص: 36]",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "60": {
      "title": "«رب قائم حظه من قيامه السهر، ورب صائم حظه من صيامه الجوع والعطش»",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "61": {
      "title": "27 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "62": {
      "title": "من قرأ في أول ليلة من شهر رمضان إنا فتحنا لك فتحا مبينا في التطوع حفظ في ذلك",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
