      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "96": {
      "title": ": «كان رسول الله صلى الله عليه وسلم يقبل وهو صائم» هذا حديث صحيح أخرجه مسلم بن الحجاج، عن أبي",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "97": {
      "title": "46 -",
      "level": 1,
