    },
    "14": {
      "title": ": \" إن الله عز وجل ليشفع يوم القيامة ثلاثة: الأنبياء، ثم العلماء، ثم",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "15": {
      "title": "7 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "16": {
      "title": ": «أحبوا الأيامى، وتوددوا إليهم، واعلموا أنه لا يتم شرف إلا بولاية علي بن أبي طالب عليه",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
