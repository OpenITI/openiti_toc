      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 9
    },
    "64": {
      "title": ": \" يوحي الله عز وجل إلى الملكين : لا تكتبا على عبدي الصائم بعد العصر سيئة \"",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "65": {
      "title": "29 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "66": {
      "title": ": \" رأيت رسول الله صلى الله عليه وسلم في المنام فقال لي: أنت الهيثم القارئ الذي تزين القرآن",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "67": {
      "title": "30 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "68": {
      "title": ": «من عمل بغير مشورة فذاك باطل يتعنى، ومن لم ينصر من ظالمه بيد ولا بلسان ولا حقد فذاك",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
