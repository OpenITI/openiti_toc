      "end_ms": 4
    },
    "29": {
      "title": ": «إنما الأعمال بالنية، وإنما لكل امرئ ما نوى، فمن كانت هجرته إلى الله ورسوله؛ فهجرته إلى",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
