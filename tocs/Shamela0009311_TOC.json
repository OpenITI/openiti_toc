      "title": "23 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "53": {
      "title": ": «أفطر عندكم الصائمون، وأكل طعامكم الأبرار، وتنزلت عليكم الملائكة»",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "54": {
      "title": "24 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 8
    },
    "55": {
      "title": ": \" إذا لقم أحدكم أول لقمة - يعني عند إفطاره - فليقل: يا واسع المغفرة، اغفر",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "56": {
      "title": "25 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "57": {
      "title": "الله عز وجل فرض عليكم صيام رمضان، وسننت لكم قيامه فمن صامه وقامه إيمانا واحتسابا، أخرج من",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "58": {
      "title": "26 -",
      "level": 1,
