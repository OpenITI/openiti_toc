      "start_ms": 11,
      "end_ms": 12
    },
    "94": {
      "title": "أقم الصلاة للصيام من هذه الساعة إلى الليل، من أخلاق الأنبياء عليهم السلام: تعجيل الإفطار،",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "95": {
