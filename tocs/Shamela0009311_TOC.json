      "title": "[ص: 29]",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "41": {
      "title": ": «المدينة قبة الإسلام، ودار الإيمان، وأرض الهجرة، ومبين الحلال والحرام»",
      "level": 1,
      "parent": null,
