    "2": {
      "title": "منها قولهم: هلم جرا",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 2
    },
    "3": {
      "title": "ومنها قولهم: ومن ثم",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 3
    },
    "4": {
      "title": "ومنها قولهم: أيضا",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "5": {
      "title": "ومنها قولهم: اللهم إلا أن يكون كذا،",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 5
    },
    "6": {
      "title": "ومنها قولهم: لا بد من كذا",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 7
    },
    "7": {
      "title": "ومنها قولهم: كذا لغة واصطلاحا",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 8
    },
    "8": {
      "title": "ومنها قولهم: هو أكثر من أن يحصى",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 9
    },
    "9": {
      "title": "ومنها قولهم: سواء كان كذا أم كذا",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 10
    },
    "10": {
      "title": "ومنها قولهم في معرض الجواب ونحوه: على أنا نقول",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 11
    },
    "11": {
      "title": "ومنها قولهم: كل فرد فرد.",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 13
    },
    "12": {
      "title": "ومنها قولهم: فقط",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "13": {
      "title": "ومنها قولهم: كائنا ما كان",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 14
    },
    "14": {
      "title": "ومنها قولهم: بعد اللتيا والتي",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 15
    },
    "15": {
      "title": "ومنها قولهم: أولا وبالذات",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "16": {
      "title": "ومنها قولهم: وهذا الشيء لا محالة كذا",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "17": {
      "title": "ومنها قولهم: لا أفعله البتة.",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 16
    },
    "18": {
      "title": "ومنها قولهم: فضلا",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 20
    },
    "19": {
      "title": "ومنها قولهم: وهذا بخلاف كذا",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "20": {
      "title": "ومنها قولهم: هو ك (لا شيء)",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 21
    },
    "21": {
      "title": "ومنها قولهم: وليس هذا كما زعمه فلان صوابا",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "22": {
      "title": "ومنها قولهم: قالوا عن آخرهم",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "23": {
      "title": "ومنها قولهم: وناهيك بكذا",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 22
    },
    "24": {
      "title": "ومنها قولهم: يجوز كذا خلافا لفلان",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 22
    },
