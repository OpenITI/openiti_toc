    },
    "2": {
      "title": ": «نهى رسول الله صلى الله عليه وسلم أن تستقبل القبلة بالغائط أو بول، ولكن يشرق أو يغرب",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "3": {
      "title": "2 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "4": {
      "title": ": \" إن رجلا من أهل الجنة يشرف يوم القيامة على أهل النار، فيناديه رجل من أهل النار، فيقول: يا",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 2
    },
    "5": {
      "title": "3 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "6": {
      "title": ": \" ثلاث ساعات كان رسول الله صلى الله عليه وسلم ينهانا أن نصلي فيهن أو نقبر فيهن موتانا: حين",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "7": {
      "title": "4 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "8": {
      "title": ": «ومن الناس ناس مفاتيح للخير مغاليق للشر , ومن الناس مفاتيح للشر مغاليق للخير , فطوبى لعبد",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "9": {
      "title": "5 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "10": {
      "title": ": «إن الله تعالى قد قسم بينكم أخلاقكم كما قسم بينكم أرزاقكم , والله يؤتي الدنيا من يحب ومن",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 3
    },
    "11": {
      "title": "6 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "12": {
      "title": ": «يا أبا هريرة ارض بقسم الله تكن أغنى الناس، وكن ورعا تكن أعبد الناس، وأحب للناس ما تحب",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "13": {
      "title": "7 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "14": {
      "title": ": \" قل: ربي الله , ثم استقم.",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "15": {
      "title": "8 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "16": {
      "title": ": «نعم، حق الولد على الوالد أن يعلمه كتاب الله عز وجل والسباحة والرمي، وأن تؤدبه",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 4
    },
    "17": {
      "title": "9 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "18": {
      "title": ": «ويل للعرب من شر قد اقترب، فتن كقطع الليل المظلم، يصبح الرجل فيها مؤمنا ويمسي كافرا، يبيع",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "19": {
      "title": "10 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "20": {
      "title": ": \" من أحيا سنتي فقد أحبني، ومن أحبني كان معي في الجنة",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "21": {
      "title": "11 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "22": {
      "title": ": إن كل نبي أعطي سبعة نجباء، وإن نبيكم صلى الله عليه وسلم أعطي أربعة عشر: أنا، وابني الحسن",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 5
    },
    "23": {
      "title": "12 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "24": {
      "title": ": «كان ليس بالذاهب طويلا فوق الربعة، إذا جامع القوم غمرهم، أبيض شديد الوضح، ضخم الهامة، أغر",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "25": {
      "title": "13 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "26": {
      "title": ": «ومن أنت؟» قال: أنا الباهلي الذي جئتك عام أول، قال: «فما غيرك وقد كنت حسن الهيئة؟» قال: ما",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "27": {
      "title": "14 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 6
    },
    "28": {
      "title": ": «اللهم إني أعوذ بك من علم لا ينفع، ودعاء لا يسمع، وقلب لا يخشع، ونفس لا تشبع، اللهم إني",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "29": {
      "title": "15 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "30": {
      "title": ": «أصبحنا على فطرة الإسلام، وكلمة الإخلاص، وسنة نبينا محمد صلى الله عليه وسلم، وملة أبينا",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "31": {
      "title": "16 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "32": {
      "title": ": «وجهت وجهي إلى الذي فطر السموات والأرض حنيفا مسلما وما أنا من المشركين، سبحانك اللهم",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "33": {
      "title": "17 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "34": {
      "title": ": «سمع الله لمن حمده» .",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 7
    },
    "35": {
      "title": "18 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "36": {
      "title": ": «إذا سبقت للعبد من الله منزلة لم ينلها بعمله، ابتلاه في جسده أو في ماله أو ولده، ثم يصبر",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "37": {
      "title": "19 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "38": {
      "title": ": «إن الرجل من أهل عليين ليشرف على أهل الجنة فيضئ وجهه كأنه كوكب دري، وإن أبا بكر وعمر منهم",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "39": {
      "title": "20 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 8
    },
    "40": {
      "title": ": «فيك مثل من عيسى عليه السلام، أبغضته يهود حتى بهتوا أمه، وأحبته النصارى حتى أنزلوه",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "41": {
      "title": "21 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "42": {
      "title": ": «لا ترم منزلك أنت وبنوك غدا، حتى آتيكم فإن لي فيكم حاجة» .",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "43": {
      "title": "22 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "44": {
      "title": ": «عن الصديق تسأل؟» قال: رحمك الله وتسميه الصديق.",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 9
    },
    "45": {
      "title": "23 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "46": {
      "title": ": «يخرج في آخر الزمان قوم لهم نبز ينتحلون شيعتنا، وليس من شيعتنا، آية ذلك أنهم يشتمون أبا",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": null
    }
