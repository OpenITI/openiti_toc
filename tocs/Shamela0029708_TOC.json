      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "83": {
      "title": "42 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "84": {
      "title": "، لما وقع في عين ابن عباس الماء، أراد أن يتعالج منه، فقيل له: إنك تمكث كذا وكذا لا تصلي إلا",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "85": {
      "title": "43 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
