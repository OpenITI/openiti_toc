      "end_ms": 7
    },
    "89": {
      "title": "45 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "90": {
      "title": "، يقرأ: 0 وما أرسلنا من قبلك من رسول ولا نبي 0.",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 8
    },
