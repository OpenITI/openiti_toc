    },
    "104": {
      "title": ": \" ليس للعبد خلاق إلا نادى سيده , وقرأ: {ضرب الله مثلا عبدا مملوكا لا يقدر على شيء} [النحل:",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
