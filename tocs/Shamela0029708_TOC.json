      "start_ms": 2,
      "end_ms": 2
    },
    "20": {
      "title": ": «لا تدخلوا على هؤلاء القوم إلا أن تكونوا باكين، فإن لم تكونوا باكين فلا تدخلوا عليهم، فإني",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
