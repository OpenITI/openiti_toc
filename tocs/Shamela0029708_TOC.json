      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "22": {
      "title": "حين أراد أن يوسع المسجد أراد أن يأخذ من العباس داره، فقال: لا أبيعها.",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "23": {
      "title": "12 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "24": {
      "title": ": \" اعتد عليهم بالغذاء وإن جاء بها الراعي يحملها على يده وأخبرهم أنك تدع لهم الشاة الماخض",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 3
    },
