      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "40": {
      "title": ": إذا كنت بالبواد فارفع صوتك بالآذان، فإني سمعت رسول الله يقول: «لا يسمعه شيء إلا شهد لربه»",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "41": {
      "title": "21 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "42": {
      "title": "، نهى أن يبيع حاضر لباد",
      "level": 1,
