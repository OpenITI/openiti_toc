    "2": {
      "title": "AUTO والناس في ذلك أربعة أقسام:",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 3
    },
    "3": {
      "title": "AUTO وفي هذا الحديث دلالة على أنه لا يكتفى من الإنسان بقول لا إله",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 6
    },
    "4": {
      "title": "AUTO فكل من لم يؤمن بالنبي صلى الله عليه وسلم وبما بعث به فليس",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 7
    },
    "5": {
      "title": "AUTO فهذا فرعون قد أتى بالتوحيد بلسانه ولم ينفعه لأنه في وقت التلف",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 16
    },
    "6": {
      "title": "AUTO فإن من شروط كلمة الإخلاص باللسان: التصديق بذلك وتحقيق بالقلب، PageV01P077",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 17
    },
    "7": {
      "title": "AUTO ومن شرط ذلك أيضا اقترانها بشهادة وأن محمدا رسول الله والتصديق",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "8": {
      "title": "AUTO ومن شرط ذلك الإيمان بالقدر، وأن الساعة حق، والبعث حق، والجنة",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 18
    },
    "9": {
      "title": "AUTO ونرجع إلى التوحيد فإن التوحيد هو: التجريد، والتفريد وأكثر",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 20
    },
    "10": {
      "title": "AUTO فالرياء: أن يفعل العبادة إما: كلها ليقال فعل لا لطاعة الله،",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": null
    }
  },
