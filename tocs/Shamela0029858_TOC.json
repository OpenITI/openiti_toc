    },
    "2": {
      "title": ": «من أعطي عطاء فوجد فليجز به، فإن لم يجد فليثن به، فإنه إذا أثنى به فقد شكره، ومن كتمه فقد",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "3": {
      "title": "2 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "4": {
      "title": ": \" من قال: سبحان الله وبحمده أثبتت له عشر حسنات، ومن قالها عشر مرار أثبتت له مائة حسنة، ومن",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "5": {
      "title": "3 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "6": {
      "title": ": «مطل الغني ظلم، وإذا أحلت على ملي فاتبعه، ولا تبع بيعتين في بيعة»",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "7": {
      "title": "4 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "8": {
      "title": ": «النفقة كلها في سبيل الله عز وجل إلا هذا البناء فلا خير فيه»",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "9": {
      "title": "5 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 3
    },
    "10": {
      "title": "لا يكاد يدع في بيته يوم عيد من أهله أحدا إلا أخرجه»",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "11": {
      "title": "6 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "12": {
      "title": ": «لا تختلف صفوفكم فتختلف قلوبكم»",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "13": {
      "title": "7 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "14": {
      "title": "الله وملائكته يصلون على الصفوف الأول»",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "15": {
      "title": "8 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "16": {
      "title": ": «زينوا القرآن بأصواتكم»",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "17": {
      "title": "9 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "18": {
      "title": ": \" من منح ورقا أو سقى لبنا أو هدى رقاقا كان كعدل رقبة، ومن قال: لا إله إلا الله وحده لا شريك",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "19": {
      "title": "10 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "20": {
      "title": ": «امرؤ القيس صاحب لواء الشعراء إلى النار»",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "21": {
      "title": "11 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "22": {
      "title": ": «امرؤ القيس بن حجر قائد لواء الشعراء يوم القيامة إلى النار»",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "23": {
      "title": "12 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "24": {
      "title": ": «من مس فرجه فليتوضأ»",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "25": {
      "title": "13 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "26": {
      "title": "أكل طعاما مما مست النار ثم صلى ولم يتوضأ , ثم رأيت أبا بكر رضي الله عنه من بعد النبي صلى",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "27": {
      "title": "14 -",
      "level": 1,
