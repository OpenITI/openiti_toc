    "21": {
      "title": "الفصل الثامن في أنه (عليه السلام) أقرب الناس من رسول الله (صلى الله عليه وآله) والخليفة بعده",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 43
    },
    "22": {
      "title": "أ. توسط بيته (عليه السلام) بيوت النبي (صلى الله عليه وآله)",
      "level": 3,
      "parent": null,
      "start_ms": 22,
      "end_ms": 43
    },
    "23": {
      "title": "ب. قوله (صلى الله عليه وآله): علي أخي، رفيقي، خير إخوتي، أخي في الدنيا والآخرة",
      "level": 3,
      "parent": 22,
      "start_ms": 22,
      "end_ms": 23
    },
    "24": {
      "title": "ج. قوله (صلى الله عليه وآله): علي صاحبي، وزيري، وصيي، خليلي، صفيي وأميني، خليفتي، موضع سري، خير من أخلف بعدي، يقضي ديني، ينجز عداتي",
      "level": 3,
      "parent": 22,
      "start_ms": 23,
      "end_ms": 26
    },
    "25": {
      "title": "د. قوله (صلى الله عليه وآله): علي مني بمنزلة رأسي من بدني.",
      "level": 3,
      "parent": 22,
      "start_ms": 26,
      "end_ms": 26
    },
    "26": {
      "title": "ه. قوله (صلى الله عليه وآله): علي كنفسي",
      "level": 3,
      "parent": 22,
      "start_ms": 26,
      "end_ms": 27
    },
    "27": {
      "title": "و. قوله (صلى الله عليه وآله): علي خير البشر، خير البرية، خير الأمة بعد نبيها",
      "level": 3,
      "parent": 22,
      "start_ms": 27,
      "end_ms": 28
    },
    "28": {
      "title": "ز. قوله (صلى الله عليه وآله) لعلي (عليه السلام): أنت مني بمنزلة هارون من موسى (1)",
      "level": 3,
      "parent": 22,
      "start_ms": 28,
      "end_ms": 29
    },
    "29": {
      "title": "ح. قوله (صلى الله عليه وآله): علي مع الحق والحق مع علي، علي مع القرآن والقرآن مع علي",
      "level": 3,
      "parent": 22,
      "start_ms": 29,
      "end_ms": 31
    },
    "30": {
      "title": "ط. قوله (صلى الله عليه وآله): علي أولى الناس بكم بعدي، وليكم بعدي",
      "level": 3,
      "parent": 22,
      "start_ms": 31,
      "end_ms": 32
    },
    "31": {
      "title": "ي. حديث الغدير (3)",
      "level": 3,
      "parent": 22,
      "start_ms": 32,
      "end_ms": 34
    },
