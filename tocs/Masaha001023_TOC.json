      "parent": 10,
      "start_ms": 21,
      "end_ms": 21
    },
    "12": {
      "title": "(3) والدليل على حدوث الحركة والسكون:",
      "level": 3,
      "parent": 10,
      "start_ms": 21,
      "end_ms": 21
    },
    "13": {
      "title": "(4) والدليل على ان الله تعالى واجب الوجود:",
      "level": 3,
      "parent": 10,
      "start_ms": 21,
      "end_ms": 22
    },
    "14": {
      "title": "(5) والدليل على ان الله تعالى قديم أزلي:",
      "level": 3,
      "parent": 10,
      "start_ms": 22,
      "end_ms": 22
    },
    "15": {
      "title": "(6) والدليل على ان الله تعالى باق أبدى:",
      "level": 3,
      "parent": 10,
      "start_ms": 22,
      "end_ms": 22
    },
    "16": {
      "title": "(7) والدليل على انه تعالى قادر مختار لا موجب،",
      "level": 3,
      "parent": 10,
      "start_ms": 22,
      "end_ms": 22
    },
    "17": {
      "title": "(8)- والدليل على انه تعالى عالم:",
      "level": 3,
      "parent": 10,
      "start_ms": 22,
      "end_ms": 22
    },
    "18": {
      "title": "(9) والدليل على انه تعالى سميع بصير:",
      "level": 3,
      "parent": 10,
      "start_ms": 22,
      "end_ms": 22
    },
    "19": {
      "title": "(10) والدليل على انه تعالى واحد:",
      "level": 3,
      "parent": 10,
      "start_ms": 22,
      "end_ms": 22
    },
    "20": {
      "title": "(11) والدليل على ان الله تعالى ليس بجسم:",
      "level": 3,
      "parent": 10,
      "start_ms": 22,
      "end_ms": 22
    },
    "21": {
      "title": "(12) والدليل على انه ليس بعرض:",
      "level": 3,
      "parent": 10,
      "start_ms": 22,
      "end_ms": 22
    },
    "22": {
      "title": "(13) والدليل على انه تعالى ليس بجوهر",
      "level": 3,
      "parent": 10,
      "start_ms": 22,
      "end_ms": 23
    },
    "23": {
      "title": "(14) والدليل على انه تعالى ليس بمرئي بحاسة البصر",
      "level": 3,
      "parent": 10,
      "start_ms": 23,
      "end_ms": 23
    },
    "24": {
      "title": "(15) والدليل على انه تعالى ليس بمحتاج الى غيره وغيره محتاج إليه:",
      "level": 3,
      "parent": 10,
      "start_ms": 23,
      "end_ms": 23
    },
    "25": {
      "title": "(16) والدليل على انه تعالى عدل حكيم:",
      "level": 3,
      "parent": 10,
      "start_ms": 23,
      "end_ms": 23
    },
    "26": {
      "title": "(17) والدليل على نبوة نبينا",
      "level": 3,
      "parent": 10,
      "start_ms": 23,
      "end_ms": 23
    },
    "27": {
      "title": "(18) والدليل على انه (صلى الله عليه وآله) معصوم",
      "level": 3,
      "parent": 10,
      "start_ms": 23,
      "end_ms": 23
    },
    "28": {
      "title": "(19) والدليل على انه- (صلى الله عليه وآله)- خاتم الرسل:",
      "level": 3,
      "parent": 10,
      "start_ms": 23,
      "end_ms": 23
    },
    "29": {
      "title": "(20) والدليل على انه- (صلى الله عليه وآله)- صادق بجميع ما أخبر به",
      "level": 3,
      "parent": 10,
      "start_ms": 23,
      "end_ms": 24
    },
    "30": {
      "title": "(21) واعتقد أن شفاعة محمد، (صلى الله عليه وآله) [3] نبيا حقا حقا،",
      "level": 3,
      "parent": 10,
      "start_ms": 24,
      "end_ms": 24
    },
    "31": {
      "title": "(22) والدليل على ان الإمام الحق بعد رسول الله",
      "level": 3,
      "parent": 10,
      "start_ms": 24,
      "end_ms": 24
    },
    "32": {
      "title": "(23) والدليل على ان الإمام من بعد على (عليه السلام) ولده الحسن",
      "level": 3,
      "parent": 10,
      "start_ms": 24,
      "end_ms": 24
    },
    "33": {
      "title": "(24) والدليل على ان الخليفة الإمام القائم (عليه السلام) حي",
      "level": 3,
      "parent": 10,
      "start_ms": 24,
      "end_ms": 24
    },
    "34": {
      "title": "(25) ويدل على بقائه إلى فناء هذه الأمة:",
      "level": 3,
      "parent": 10,
      "start_ms": 24,
      "end_ms": 24
    },
