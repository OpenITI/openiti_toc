      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 10
    },
    "4": {
      "title": "القسم الأول (في تعظيم العلي الأعلى لقدر النبي المصطفى صلى الله عليه وسلم قولا وفعلا)",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 11
    },
    "5": {
      "title": "الباب الأول في ثناء الله تعالى عليه وإظهاره عظيم قدره لديه",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "6": {
      "title": "(الفصل الأول) فيما جاء من ذلك مجئ المدح والثناء وتعداد المحاسن",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 16
    },
    "7": {
      "title": "الفصل الثاني (في وصفه تعالى له بالشهادة وما يتعلق بها من الثناء والكرامة)",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 18
    },
    "8": {
      "title": "الفصل الثالث فيما ورد من خطابه إياه مورد الملاطفة والمبرة",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 20
    },
    "9": {
      "title": "الفصل الرابع في قسمه تعالى بعظيم قدره",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 22
    },
    "10": {
      "title": "الفصل الخامس في قسمه تعالى جده له لتحقق مكانته عنده",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 25
    },
    "11": {
      "title": "الفصل السادس فيما ورد من قوله تعالى في جهته صلى الله عليه وسلم مورد الشفقة والإكرام",
      "level": 1,
      "parent": null,
      "start_ms": 25,
      "end_ms": 27
    },
    "12": {
      "title": "الفصل السابع فيما أخبر الله تعالى به في كتابه العزيز من عظيم قدره وشريف منزلته على الأنبياء وحظوة رتبته عليهم",
      "level": 1,
      "parent": null,
      "start_ms": 27,
      "end_ms": 28
    },
    "13": {
      "title": "الفصل الثامن في إعلال الله تعالى خلقه بصلاته عليه وولايته له ورفعه العذاب بسببه",
      "level": 1,
      "parent": null,
      "start_ms": 28,
      "end_ms": 30
    },
    "14": {
      "title": "الفصل التاسع فيما تضمنته سورة الفتح من كراماته صلى الله عليه وسلم",
      "level": 1,
      "parent": null,
      "start_ms": 30,
      "end_ms": 31
    },
    "15": {
      "title": "الفصل العاشر فيما أظهره الله تعالى في كتابه العزيز من كرامته عليه ومكانته عنده وما خصه به من ذلك سوى ما انتظم فيما ذكرناه قبل:",
      "level": 1,
      "parent": null,
      "start_ms": 31,
      "end_ms": 33
    },
    "16": {
      "title": "الباب الثاني في تكميل الله تعالى له المحاسن خلقا وخلقا وقرانه جميع الفضائل الدينية والدنيوية فيه نسقا",
      "level": 1,
      "parent": null,
      "start_ms": 33,
      "end_ms": 34
    },
    "17": {
      "title": "(فصل)",
      "level": 1,
      "parent": null,
      "start_ms": 34,
      "end_ms": 36
    },
    "18": {
      "title": "(فصل) وأما نظافة جسمه وطيب ريحه وعرقه ونزاهته عن الأقذار وعورات الجسد",
      "level": 1,
      "parent": null,
      "start_ms": 36,
      "end_ms": 38
    },
    "19": {
      "title": "(فصل) وأما وفور عقله وذكاء لبه وقوة حواسه وفصاحة لسانه واعتدال حركاته وحسن شمائله",
      "level": 1,
      "parent": null,
      "start_ms": 38,
      "end_ms": 40
    },
    "20": {
      "title": "(فصل) وأما فصاحة اللسان وبلاغة القول",
      "level": 1,
      "parent": null,
      "start_ms": 40,
      "end_ms": 42
    },
    "21": {
      "title": "(فصل) وأما شرف نسبه وكرم بلده ومنشئه فما لا يحتاج إلى إقامة دليل عليه ولا بيان مشكل ولا خفي منه",
      "level": 1,
      "parent": null,
      "start_ms": 42,
      "end_ms": 44
    },
    "22": {
      "title": "(فصل) وأما ما تدعو ضرورة الحياة إليه مما فصلناه فعلى ثلاثة أضرب:",
      "level": 1,
      "parent": null,
      "start_ms": 44,
      "end_ms": 46
    },
    "23": {
      "title": "(فصل) والضرب الثاني ms045 ما يتفق التمدح بكثرته والفخر بوفوره كالنكاح والجاه.",
      "level": 1,
      "parent": null,
      "start_ms": 46,
      "end_ms": 48
    },
    "24": {
      "title": "(فصل) وأما الضرب الثالث فهو ما تختلف الحالات في التمدح",
      "level": 1,
      "parent": null,
      "start_ms": 48,
      "end_ms": 50
    },
    "25": {
      "title": "(فصل) وأما الخصال المكتسبة من الأخلاق الحميدة والآداب الشريفة التي اتفق جميع العقلاء على تفضيل صاحبها",
      "level": 1,
      "parent": null,
      "start_ms": 50,
      "end_ms": 52
    },
    "26": {
      "title": "(فصل) أما أصل فروعها وعنصر ينابيعها ونقطة دائرتها فالعقل",
      "level": 1,
      "parent": null,
      "start_ms": 52,
      "end_ms": 53
    },
    "27": {
      "title": "(فصل) وأما الحلم والاحتمال والعفو مع المقدرة والصبر على ما يكره",
      "level": 1,
      "parent": null,
      "start_ms": 53,
      "end_ms": 56
    },
    "28": {
      "title": "(فصل) وأما الجود والكرم والسخاء والسماحة",
      "level": 1,
      "parent": null,
      "start_ms": 56,
      "end_ms": 58
    },
    "29": {
      "title": "(فصل) وأما الشجاعة والنجدة:",
      "level": 1,
      "parent": null,
      "start_ms": 58,
      "end_ms": 60
    },
    "30": {
      "title": "(فصل) وأما الحياء والإغضاء:",
      "level": 1,
      "parent": null,
      "start_ms": 60,
      "end_ms": 61
    },
    "31": {
      "title": "(فصل) وأما حسن عشرته وأدبه وبسط خلقه صلى الله عليه وسلم مع أصناف الخلق",
      "level": 1,
      "parent": null,
      "start_ms": 61,
      "end_ms": 63
    },
    "32": {
      "title": "(فصل) وأما الشفقة والرأفة والرحمة لجميع الخلق",
      "level": 1,
      "parent": null,
      "start_ms": 63,
      "end_ms": 65
    },
    "33": {
      "title": "(فصل) وأما خلقه ms064 صلى الله عليه وسلم في الوفاء وحسن العهد وصلة الرحم",
      "level": 1,
      "parent": null,
      "start_ms": 65,
      "end_ms": 66
    },
    "34": {
      "title": "(فصل) وأما تواضعه صلى الله عليه وسلم على علو منصبه ورفعة",
      "level": 1,
      "parent": null,
      "start_ms": 66,
      "end_ms": 68
    },
    "35": {
      "title": "(فصل) وأما عدله صلى الله عليه وسلم وأمانته وعفته وصدق لهجته،",
      "level": 1,
      "parent": null,
      "start_ms": 68,
      "end_ms": 70
    },
    "36": {
      "title": "(فصل) وأما وقاره صلى الله عليه وسلم وصمته وتؤدته ومروؤته وحسن هديه",
      "level": 1,
      "parent": null,
      "start_ms": 70,
      "end_ms": 71
    },
    "37": {
      "title": "(فصل) وأما زهده في الدنيا",
      "level": 1,
      "parent": null,
      "start_ms": 71,
      "end_ms": 73
    },
    "38": {
      "title": "(فصل)",
      "level": 1,
      "parent": null,
      "start_ms": 73,
      "end_ms": 74
    },
    "39": {
      "title": "(فصل)",
      "level": 1,
      "parent": null,
      "start_ms": 74,
      "end_ms": 78
    },
    "40": {
      "title": "(فصل)",
      "level": 1,
      "parent": null,
      "start_ms": 78,
      "end_ms": 82
    },
    "41": {
      "title": "(فصل في تفسير غريب هذا الحديث ومشكله)",
      "level": 1,
      "parent": null,
      "start_ms": 82,
      "end_ms": 84
    },
    "42": {
      "title": "(الباب الثالث) فيما ورد من صحيح الأخبار ومشهورها بعظيم قدره عند ربه ومنزلته وما خصه به في الدارين من كرامته صلى الله عليه وسلم",
      "level": 1,
      "parent": null,
      "start_ms": 84,
      "end_ms": 84
    },
    "43": {
      "title": "(الفصل الأول) فيما ورد من ذكر مكانته عند ربه عز وجل والاصطفاء ورفعة الذكر والتفضيل، وسيادة ولد آدم وما خصه به في الدنيا من مزايا الرتب وبركة اسمه الطيب:",
      "level": 1,
      "parent": null,
      "start_ms": 84,
      "end_ms": 90
    },
    "44": {
      "title": "(فصل) في تفضيله بما تضمنته كرامة الإسراء",
      "level": 1,
      "parent": null,
      "start_ms": 90,
      "end_ms": 97
    },
    "45": {
      "title": "(فصل) ثم اختلف السلف والعلماء هل كان إسراؤه بروحه أو جسده",
      "level": 1,
      "parent": null,
      "start_ms": 97,
      "end_ms": 99
    },
    "46": {
      "title": "(فصل) في إبطال حجج من قال إنها نوم",
      "level": 1,
      "parent": null,
      "start_ms": 99,
      "end_ms": 102
    },
    "47": {
      "title": "(فصل) وأما رؤيته صلى الله عليه وسلم لربه جل وعز",
      "level": 1,
      "parent": null,
      "start_ms": 102,
      "end_ms": 106
    },
    "48": {
      "title": "(فصل) وأما ما ورد في هذه القصة من مناجاته لله تعالى وكلامه معه",
      "level": 1,
      "parent": null,
      "start_ms": 106,
      "end_ms": 107
    },
    "49": {
      "title": "(فصل) وأما ما ورد في حديث الإسراء",
      "level": 1,
      "parent": null,
      "start_ms": 107,
      "end_ms": 109
    },
    "50": {
      "title": "(فصل) في ذكر تفضيله صلى الله عليه وسلم في القيامة بخصوص الكرامة",
      "level": 1,
      "parent": null,
      "start_ms": 109,
      "end_ms": 111
    },
    "51": {
      "title": "(فصل) في تفضيله بالمحبة والخلة:",
      "level": 1,
      "parent": null,
      "start_ms": 111,
      "end_ms": 114
    },
    "52": {
      "title": "فصل في تفضيله صلى الله عليه وسلم بالشفاعة والمقام المحمود",
      "level": 1,
      "parent": null,
      "start_ms": 114,
      "end_ms": 119
    },
    "53": {
      "title": "فصل",
      "level": 1,
      "parent": null,
      "start_ms": 119,
      "end_ms": 120
    },
    "54": {
      "title": "(فصل)",
      "level": 1,
      "parent": null,
      "start_ms": 120,
      "end_ms": 122
    },
    "55": {
      "title": "فصل في أسمائه صلى الله عليه وسلم وما تضمنته من فضيلته",
      "level": 1,
      "parent": null,
      "start_ms": 122,
      "end_ms": 126
    },
    "56": {
      "title": "فصل",
      "level": 1,
      "parent": null,
      "start_ms": 126,
      "end_ms": 132
    },
    "57": {
      "title": "(فصل)",
      "level": 1,
      "parent": null,
      "start_ms": 132,
      "end_ms": 133
    },
    "58": {
      "title": "الباب الرابع ففيما أظهره الله تعالى على يديه من المعجزات وشرفه به من الخصائص والكرامات",
      "level": 1,
      "parent": null,
      "start_ms": 133,
      "end_ms": 135
    },
    "59": {
      "title": "(فصل) اعلم أن الله جل اسمه قادر على خلق المعرفة في قلوب عباده",
      "level": 1,
      "parent": null,
      "start_ms": 135,
      "end_ms": 137
    },
    "60": {
      "title": "(فصل) اعلم أن معني تسميتنا ما جاءت به الأنبياء معجزة",
      "level": 1,
      "parent": null,
      "start_ms": 137,
      "end_ms": 140
    },
    "61": {
      "title": "فصل في إعجاز القرآن",
      "level": 1,
      "parent": null,
      "start_ms": 140,
      "end_ms": 143
    },
    "62": {
      "title": "(فصل) الوجه الثاني من إعجازه صورة نظمه العجيب والأسلوب الغريب",
      "level": 1,
      "parent": null,
      "start_ms": 143,
      "end_ms": 145
    },
    "63": {
      "title": "(فصل) الوجه الثالث من الإعجاز ما انطوى عليه من الأخبار بالمغيبات",
      "level": 1,
      "parent": null,
      "start_ms": 145,
      "end_ms": 146
    },
    "64": {
      "title": "(فصل) الوجه الرابع ما أنبأ به من أخبار القرون السالفة",
      "level": 1,
      "parent": null,
      "start_ms": 146,
      "end_ms": 147
    },
    "65": {
      "title": "(فصل) هذه الوجوه الأربعة من إعجازه",
      "level": 1,
      "parent": null,
      "start_ms": 147,
      "end_ms": 148
    },
    "66": {
      "title": "(فصل) ومنها الروعة التي تلحق قلوب سامعيه",
      "level": 1,
      "parent": null,
      "start_ms": 148,
      "end_ms": 150
    },
    "67": {
      "title": "(فصل) ومن وجوه إعجازه المعدودة كونه آية باقية",
      "level": 1,
      "parent": null,
      "start_ms": 150,
      "end_ms": 150
    },
    "68": {
      "title": "(فصل) وقد عد جماعة من الأئمة ومقلدي الأمة في إعجازه وجوها كثيرة",
      "level": 1,
      "parent": null,
      "start_ms": 150,
      "end_ms": 153
    },
    "69": {
      "title": "فصل انشقاق القمر وحبس الشمس",
      "level": 1,
      "parent": null,
      "start_ms": 153,
      "end_ms": 155
    },
    "70": {
      "title": "فصل في نبع الماء من بين أصابعه وتكثير ببركته",
      "level": 1,
      "parent": null,
      "start_ms": 155,
      "end_ms": 157
    },
    "71": {
      "title": "(فصل) ومما يشبه هذا من معجزاته تفجير الماء ببركته وابتعاثه بمسه ودعوته *",
      "level": 1,
      "parent": null,
      "start_ms": 157,
      "end_ms": 158
    },
    "72": {
      "title": "فصل ومن معجزاته تكثير الطعام ببركته ودعائه",
      "level": 1,
      "parent": null,
      "start_ms": 158,
      "end_ms": 163
    },
    "73": {
      "title": "فصل (في كلام الشجر وشهادتها له بالنبوة وإجابتها دعوته)",
      "level": 1,
      "parent": null,
      "start_ms": 163,
      "end_ms": 166
    },
    "74": {
      "title": "فصل في قصة حنين الجذع",
      "level": 1,
      "parent": null,
      "start_ms": 166,
      "end_ms": 167
    },
    "75": {
      "title": "فصل ومثل هذا في سائر الجمادات",
      "level": 1,
      "parent": null,
      "start_ms": 167,
      "end_ms": 169
    },
    "76": {
      "title": "فصل في الآيات في ضروب الحيوانات",
      "level": 1,
      "parent": null,
      "start_ms": 169,
      "end_ms": 173
    },
    "77": {
      "title": "فصل في إحياء الموتى وكلامهم (وكلام الصبيان والمراضع وشهادتهم له بالنبوة صلى الله عليه وسلم)",
      "level": 1,
      "parent": null,
      "start_ms": 173,
      "end_ms": 176
    },
    "78": {
      "title": "فصل في إبراء المرضى وذوي العاهات",
      "level": 1,
      "parent": null,
      "start_ms": 176,
      "end_ms": 178
    },
    "79": {
      "title": "فصل في إجابة دعائه صلى الله عليه وسلم",
      "level": 1,
      "parent": null,
      "start_ms": 178,
      "end_ms": 181
    },
    "80": {
      "title": "فصل في كرامته وبركاته وانقلاب الأعيان له فيما لمسه أو باشره صلى الله عليه وسلم",
      "level": 1,
      "parent": null,
      "start_ms": 181,
      "end_ms": 184
    },
    "81": {
      "title": "فصل (ومن ذلك ما اطلع عليه من الغيوب وما يكون)",
      "level": 1,
      "parent": null,
      "start_ms": 184,
      "end_ms": 189
    },
    "82": {
      "title": "فصل في عصمة الله تعالى له من الناس وكفايته من آذاه",
      "level": 1,
      "parent": null,
      "start_ms": 189,
      "end_ms": 194
    },
    "83": {
      "title": "فصل ومن معجزاته الباهرة ما جمعه الله له من المعارف والعلوم",
      "level": 1,
      "parent": null,
      "start_ms": 194,
      "end_ms": 199
    },
    "84": {
      "title": "فصل ومن دلائل نبوته وعلامات رسالته ما ترادفت به الأخبار عن الرهبان والأحبار",
      "level": 1,
      "parent": null,
      "start_ms": 199,
      "end_ms": 200
    },
    "85": {
      "title": "فصل ومن ذلك ما ظهر من الآيات عند مولده وما حكته أمه ومن حضره من العجائب",
      "level": 1,
      "parent": null,
      "start_ms": 200,
      "end_ms": 202
    },
    "86": {
      "title": "فصل قال القاضي أبو الفضل رحمه الله قد أتينا في هذا الباب على نكت من معجزاته واضحة",
      "level": 1,
      "parent": null,
      "start_ms": 202,
      "end_ms": 206
    },
    "87": {
      "title": "القسم الثاني (فيما يجب على الأنام من حقوقه صلى الله عليه وسلم)",
      "level": 1,
      "parent": null,
      "start_ms": 206,
      "end_ms": 207
    },
    "88": {
      "title": "(الباب الأول) (في فرض الإيمان به ووجوب طاعته وأتباع سنته)",
      "level": 1,
      "parent": null,
      "start_ms": 207,
      "end_ms": 209
    },
    "89": {
      "title": "فصل وأما وجوب طاعته:",
      "level": 1,
      "parent": null,
      "start_ms": 209,
      "end_ms": 210
