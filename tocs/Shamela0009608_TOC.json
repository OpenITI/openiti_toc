{
  "filename": "0485NizamMulkWazir.Amali.Shamela0009608-ara1",
  "sections": {
    "1": {
      "title": "1 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "2": {
      "title": ": «إذا جاء أحدكم المسجد، فليركع ركعتين قبل أن يجلس» ، رواه البخاري، ومسلم في صحيحهما، من حديث",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "3": {
      "title": "2 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "4": {
      "title": "الحلال بين، والحرام بين، وبين ذلك أمور متشابهات، وربما قال: مشتبهة، وسأضرب لكم في ذلك",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 2
    },
    "5": {
      "title": "3 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "6": {
      "title": ": \" إذا دخل أهل الجنة الجنة، وأهل النار النار، نادى مناد: يا أهل الجنة، إن لكم عند الله",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "7": {
      "title": "4 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "8": {
      "title": ": «لو صليتم حتى تكونوا كالحنايا، وصمتم حتى تكونوا كالأوتار، ثم كان الاثنان أحب إليكم من",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "9": {
      "title": "5 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "10": {
      "title": "، \" ما الإسلام؟ قال: شهادة أن لا إله إلا الله، وأني رسول الله، وتؤمن بالأقدار خيرها وشرها،",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "11": {
      "title": "6 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 3
    },
    "12": {
      "title": ": \" أتاني جبريل عليه السلام، فقرأ: {بسم الله الرحمن الرحيم} [الفاتحة: 1] ، فجهر",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "13": {
      "title": "7 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "14": {
      "title": ": إذا كان الماء قلتين، لم ينجسه شيء \"",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "15": {
      "title": "8 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "16": {
      "title": "قنت شهرا يدعو عليهم، ثم تركه، وأما في الصبح، فلم يزل يقنت حتى فارق",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "17": {
      "title": "9 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "18": {
      "title": ": التحيات، المباركات، الصلوات، الطيبات لله، سلام عليك أيها النبي ورحمة الله وبركاته، سلام",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "19": {
      "title": "10 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 4
    },
    "20": {
      "title": "للحكمة أهلا، إن منعتها أهلها كنت جاهلا، فكن كالطبيب العالم يضع دواءه حيث",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "21": {
      "title": "11 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "22": {
      "title": ": «إذا رأيت رجلا من أصحاب الحديث، فكأني رأيت رسول الله صلى الله عليه وسلم»",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "23": {
      "title": "12 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "24": {
      "title": "13 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 5
    },
    "25": {
      "title": ": \" من أنفق زوجين في سبيل الله نودي في الجنة: يا عبد الله، هذا خير، فمن كان من أهل الصلاة دعي",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "26": {
      "title": "14 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "27": {
      "title": ": \" بينا أنا نائم رأيت الناس، عرضوا علي، وعليهم قمص، فمنها ما يبلغ الثدي، ومنها ما يبلغ دون",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "28": {
      "title": "15 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "29": {
      "title": "\" وحض على جيش العسرة، فقام عثمان، رضي الله عنه، فقال: مائة بعير بأحلاسها وأقتابها في سبيل",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "30": {
      "title": "16 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 6
    },
    "31": {
      "title": "، من يحمل رايتك يوم القيامة؟ قال: من عسى أن يحملها يوم القيامة إلا من كان يحملها في الدنيا",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "32": {
      "title": "17 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "33": {
      "title": ": «رحم الله أبا بكر زوجني ابنته، وحملني إلى دار الهجرة، وأعتق بلالا من ماله، رحم الله عمر،",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "34": {
      "title": "18 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "35": {
      "title": "أخذ بيد الحسن والحسين، رضي الله عنهما، فقال: من أحب هذين وأباهما وأمهما كان معي في درجتي",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "36": {
      "title": "19 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 7
    },
    "37": {
      "title": ": \" أعطيت عشر خصال لم تعطهن ذات خمار قبلي: صورت لرسول الله قبل أن أصور في رحم أمي، وتزوجني",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "38": {
      "title": "20 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "39": {
      "title": "الله تعالى اختارني واختار لي أصحابا، فجعل منهم وزراء، وأنصارا، وأصهارا، فمن سبهم فعليه",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "40": {
      "title": "21 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "41": {
      "title": "أصحابك عندي بمنزلة النجوم في السماء بعضها أضوأ من بعض، فمن أخذ بشيء مما هم عليه من",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "42": {
      "title": "22 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 8
    },
    "43": {
      "title": ": \" يرحم الله خلفائي، قيل: ومن خلفاؤك يا رسول الله؟ قال: الذين يأتون من بعدي يروون أحاديثي،",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "44": {
      "title": "23 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "45": {
      "title": ": إن أنا نمت نهاري ضاعت الرعية، وإن نمت ليلا ضيعت نفسي، فكيف بالنوم",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "46": {
      "title": "24 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "47": {
      "title": "يشهد أن لا إله إلا الله وحده لا شريك له وأن محمدا عبده ورسوله، وأن الجنة حق، وأن النار",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": null
    }
  },
