      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "19": {
      "title": ": «لن أترك الرمي أبدا، وإن كانت يدي مقطوعة بعد شيء سمعته من رسول الله صلى الله عليه",
      "level": 1,
      "parent": null,
      "start_ms": 2,
