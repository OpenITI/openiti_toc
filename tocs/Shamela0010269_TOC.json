      "end_ms": 2
    },
    "17": {
      "title": ": «نعم لهو المؤمن الرمي، ومن ترك الرمي بعدما علمه، فهو نعمة تركها»",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
