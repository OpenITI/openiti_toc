      "start_ms": 25,
      "end_ms": 25
    },
    "92": {
      "title": ": «ما من صاحب إبل، ولا بقر، ولا غنم، لا يؤدي زكاتها، إلا جاءت يوم القيامة أعظم ما كانت",
      "level": 1,
