      "title": "4 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 2
    },
    "10": {
      "title": ": \" مثلي كمثل رجل استوقد نارا فلما أضاءت ما حولها جعل الفراش وهذه الدواب التي يقعن في النار",
      "level": 1,
