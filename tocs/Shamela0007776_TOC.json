      "start_ms": 2,
      "end_ms": 2
    },
    "19": {
      "title": "9 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "20": {
      "title": ": «الملائكة تصلي على أحدكم ما دام في مصلاه الذي صلى فيه، وتقول: اللهم اغفر له، اللهم ارحمه",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "21": {
      "title": "10 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "22": {
      "title": ": «إذا قال أحدكم: آمين والملائكة في السماء: آمين، فوافق إحداها الأخرى؛ غفر له ما تقدم من",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "23": {
      "title": "11 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "24": {
      "title": ": «ويلك اركبها: ويلك اركبها»",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "25": {
      "title": "12 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
