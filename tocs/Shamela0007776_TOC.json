      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "70": {
      "title": ": «إذا نظر أحدكم إلى من هو فضل عليه في المال والخلق، فلينظر إلى من هو أسفل منه ممن فضل",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
