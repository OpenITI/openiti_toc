      "start_ms": 1,
      "end_ms": 1
    },
    "8": {
      "title": ": «مثل البخيل والمتصدق كمثل رجلين عليهما جبتان أو جنتان من حديد إلى ثدييهما أو إلى تراقيهما،",
      "level": 1,
