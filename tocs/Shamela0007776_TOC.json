      "start_ms": 2,
      "end_ms": 2
    },
    "14": {
      "title": "الظن أكذب الحديث، ولا تناجشوا، ولا تحاسدوا، ولا تنافسوا، ولا تباغضوا، ولا تدابروا، وكونوا",
      "level": 1,
