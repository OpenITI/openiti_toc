    },
    "80": {
      "title": ": بم سدت قومك؟ فقال: «أطعم جائعهم، وأكسو عاريهم، وأحمل نفسي كلهم، فمن فعل مثل فعلي فهو مثلي،",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
