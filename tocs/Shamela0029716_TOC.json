      "title": "31 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "62": {
      "title": ": «النظر إلى وجه الله تبارك وتعالى واجب للنبيين والصديقين والشهداء»",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
