    "32": {
      "title": "حامل الحسن على عاتقه، فقال رجل: نعم المركب ركبت يا غلام، فقال رسول الله صلى الله عليه",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "33": {
      "title": "17 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "34": {
      "title": ": \" ستة لا يسلم عليهم: اليهودي، والنصراني، والمجوسي، والذين بين أيديهم الخمر والريحان،",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "35": {
      "title": "18 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 4
    },
    "36": {
      "title": "، ولقد رأيتني في هذا الوادي وأنا أرعى إبلا للخطاب، وكان ما علمت فظا غليظا، فكانت أمي تكسوني",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "37": {
      "title": "19 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "38": {
      "title": ": \" لعن رسول الله صلى الله عليه وسلم ثلاثة: رجلا أم قوما وهم له كارهون، وامرأة باتت وزوجها",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "39": {
      "title": "20 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "40": {
      "title": ": هذا ابن خطل متعلق بأستار الكعبة، فقال: «اقتلوه»",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "41": {
      "title": "21 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "42": {
      "title": ": «من غشنا فليس منا»",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "43": {
      "title": "22 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 5
    },
    "44": {
      "title": ": «لا تصوموا حتى تروا الهلال، ولا تفطروا حتى تروه، فإن غم عليكم فاقدروا",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "45": {
      "title": "23 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
