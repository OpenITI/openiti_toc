  "filename": "0620IbnQudamaMaqdisi.Wasiyya.ShamAY0034298-ara1",
  "sections": {
    "1": {
      "title": "AUTO بسم الله الرحمن الرحيم",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "2": {
      "title": "AUTO وإن هذه الدار هي أمنية أهل الجنة وأهل النار!:",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 2
    },
    "3": {
      "title": "AUTO فاغتنم رحمك الله حياتك النفيسة واحتفظ بأوقاتك العزيزة واعلم",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 3
    },
    "4": {
      "title": "AUTO وإنني قد خطر لي أن أمثل هذه الدنيا وأهلها كمثل أهل سفينة",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 5
    },
    "5": {
      "title": "AUTO فاجتهد رحمك الله تعالى في الكون من الفرقة الأولى:",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "6": {
      "title": "AUTO واحترس من مفسدات الأعمال لئلا يفسد عملك ويخيب سعيك فلا تحصل",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 7
    },
    "7": {
      "title": "AUTO 2- واعلم أنك لا تقدر على معصيته إلا بنعمته التي تفضل بها عليك:",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 8
    },
    "8": {
      "title": "AUTO وإن ابتليت بمعصية: فبادر إلى التوبة، والاستغفار، والندم، وابك",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 12
    },
    "9": {
      "title": "AUTO ومناجاة العباد رحمهم الله تعالى لربهم كثيرة، ومن أحسنها ما",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 15
    },
    "10": {
      "title": "AUTO ولتكن همتك في هذه الدنيا: التقرب إلى ربك الكريم، وطلب فضله",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 19
    },
    "11": {
      "title": "AUTO آخر الوصية",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": null
    }
  },
