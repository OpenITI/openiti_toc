{
  "filename": "0463IbnCabdBarr.Insaf.Shamela0013000-ara1",
  "sections": {
    "1": {
      "title": "مقدمة",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 2
    },
    "2": {
      "title": "باب ذكر اختلافهم في قراءة بسم الله الرحمن الرحيم في الصلاة أول فاتحة الكتاب , وهل هي آية منها؟ اختلف علماء السلف والخلف في قراءة بسم الله الرحمن الرحيم في أول فاتحة الكتاب , وهل هي آية منها؟ فذهب مالك رضي الله تعالى عنه وأصحابه إلى أنها لا تقرأ في أول",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 3
    },
    "3": {
      "title": "[ص: 164]",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 4
    },
    "4": {
      "title": "ذكر الآثار التي احتج بها من أسقط بسم الله الرحمن الرحيم من أول فاتحة الكتاب في الصلاة وكره قراءتها فيها , ولم يعدها آية منها فمن ذلك حديث عبد الله بن مغفل المزني: وهو حديث يدور على أبي مسعود سعيد بن إياس الجريري , عن أبي نعامة قيس بن عباية الحنفي , عن",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
