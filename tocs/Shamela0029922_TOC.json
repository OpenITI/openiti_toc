      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "30": {
      "title": "أرأيت إن ابتلينا بالبقاء بعدك، فأين ننزل؟ قال: «بيت المقدس؛ فإن الصلاة فيه ألف صلاة، لعل",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "31": {
      "title": "16 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "32": {
      "title": ": «يحمل هذا العلم من كل خلف عدوله، ينفون عنه انتحال المبطلين، وتأويل",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
