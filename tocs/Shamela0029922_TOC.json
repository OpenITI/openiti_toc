      "end_ms": 12
    },
    "64": {
      "title": "إذا سمع الذكر ارتعد، فقال له إبراهيم: إن كنت تملك هذا فما أبالي أن لا أعتد بك، وإن كنت لا",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
