      "start_ms": 11,
      "end_ms": 11
    },
    "58": {
      "title": "فالزم الحق ينزلك الحق منازل أهل الحق يوم لا يقضى إلا بالحق»",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
