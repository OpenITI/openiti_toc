      "title": ": «ناولني نعلي» .",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "27": {
      "title": "14 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 7
    },
    "28": {
      "title": ": «الصدقات بالغدوات تذهب بالعاهات» .",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
