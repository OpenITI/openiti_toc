    "2": {
      "title": ": «كان عمر آدم ألف سنة فجعل لداود أربعين سنة والأقلام رطبة تجري»",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "3": {
      "title": "2 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "4": {
      "title": ": \" خلق الله الإنسان من ثلاثة: من طين لازب , وصلصال , وحمأ مسنون , فالطين اللازب اللازق الجيد",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "5": {
      "title": "3 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "6": {
      "title": "الله تعالى خمر طينة آدم عليه السلام أربعين ليلة أو أربعين يوما , ثم ضرب بيديه ففرقهما» .",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "7": {
      "title": "4 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 2
    },
    "8": {
      "title": ": \" {من طين لازب} [الصافات: 11] .",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "9": {
      "title": "5 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "10": {
      "title": ": «إنما سمي آدم لأنه خلق من أديم الأرض كلها , من أحمرها وأسودها وأبيضها وسهلها وجبلها وسبخها",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "11": {
      "title": "6 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "12": {
      "title": ": «إنما سمي الإنسان لأنه عهد إليه فنسي , وإنما سمي آدم لأنه خلق من أديم",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "13": {
      "title": "7 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "14": {
      "title": ": «بعث رب العزة إبليس، فأمره أن يكبش من أديم الأرض من عذبها ومالحها، ففعل فخلق منه آدم، فمن",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 3
    },
    "15": {
      "title": "8 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "16": {
      "title": ": «إنما سمي آدم لأنه خلق من أديم الأرض»",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "17": {
      "title": "9 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "18": {
      "title": ": «خير يوم طلعت عليه الشمس يوم الجمعة , خلق الله آدم فيه , وفيه أدخل الجنة وفيه يعاد",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "19": {
      "title": "10 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "20": {
      "title": ": «خير يوم طلعت فيه الشمس يوم الجمعة , فيه خلق آدم وفيه أسكن الجنة وفيه",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "21": {
      "title": "11 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "22": {
      "title": ": «خير يوم طلعت فيه الشمس يوم الجمعة , فيها خلق آدم وفيها أدخل الجنة وفيها أخرج منها وفيها",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "23": {
      "title": "12 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "24": {
      "title": "تدري ما يوم الجمعة؟ قال: قلت: الله ورسوله أعلم.",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "25": {
      "title": "13 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 4
    },
    "26": {
      "title": "من أفضل أيامكم يوم الجمعة فيه خلق الله آدم , وفيه النفخة , وفيه الصعقة»",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "27": {
      "title": "14 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "28": {
      "title": ": «ما أسكن آدم الجنة إلا ما بين صلاة العصر إلى غروب الشمس»",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "29": {
      "title": "15 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "30": {
      "title": ": «ما مكث آدم في الجنة إلا ما بين الظهر إلى العصر»",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "31": {
      "title": "16 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "32": {
      "title": ": «خلق الله آدم عليه السلام لسبع ساعات من يوم الجمعة» ، بمحلوف عبد الله بن سلام فما جاءت إحدى",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "33": {
      "title": "17 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "34": {
      "title": ": \" إن أباكم آدم عليه السلام كان رجلا طوالا مثل النخلة السحوق , كثير الشعر يواري العورة",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 5
    },
    "35": {
      "title": "18 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "36": {
      "title": ": \" كان آدم صلوات الله عليه رجلا طويلا كثير شعر الصدر كأنه نخلة جوفاء , فلما أصاب الخطيئة سقط",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "37": {
      "title": "19 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "38": {
      "title": ": \" لما ثقل آدم أمر بنيه أن يجيئوه من ثمار الجنة فجاءوا , فلقيتهم الملائكة , فقالت: ارجعوا",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "39": {
      "title": "20 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "40": {
      "title": ": \" الملائكة صلت على آدم عليه السلام وكبرت عليه أربعا , وقالوا: هذه سنتكم يا بني آدم \"",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "41": {
      "title": "21 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 6
    },
    "42": {
      "title": ": كان لآدم عليه السلام بنون؛ ود , وسواع , ويغوث , ويعوق , ونسر , فكان أكبرهم يغوث , فقال",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "43": {
      "title": "22 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "44": {
      "title": "الله لما أخرج آدم من الجنة زوده من ثمار الجنة وعلمه صنعة كل شيء , فثماركم من ثمار الجنة",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "45": {
      "title": "23 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "46": {
      "title": ": \" كان لباس آدم عليه السلام وحواء كالظفر , فلما أكلا الشجرة لم يبق منه شيء إلا مثل الظفر",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "47": {
      "title": "24 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "48": {
      "title": ": أهبط الله آدم من الجنة وهو يأكل منها رغدا حيث شاء إلى غير طعام، فعلمه العمل كيف يعمله",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 7
    },
    "49": {
      "title": "25 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "50": {
      "title": ": «لم يحزن حزن آدم أحد , بكى أربعين عاما وسجد أربعين عاما حتى قبل الله",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "51": {
      "title": "26 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 8
    },
    "52": {
      "title": "\" {فتلقى آدم من ربه كلمات} [البقرة: 37] .",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "53": {
      "title": "27 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "54": {
      "title": ": \" لما خلق الله آدم نفخ الروح في رأسه قبل جسده فعطس , فقال: الحمد لله لرب خلقني.",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 9
    },
    "55": {
      "title": "28 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "56": {
      "title": "أي الأنبياء كان أولا؟ قال: آدم.",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "57": {
      "title": "29 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "58": {
      "title": "كم كانوا الأنبياء؟ قال: كانوا مائة ألف وعشرين ألفا.",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 10
    },
    "59": {
      "title": "30 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "60": {
      "title": "\" {فلا يخرجنكما من الجنة} [طه: 117] .",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "61": {
      "title": "31 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "62": {
      "title": ": \" لما صور الله عز وجل آدم تركه ما شاء أن يتركه , فجعل إبليس يطيف به فلما رآه أجوف عرف أنه",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "63": {
      "title": "32 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "64": {
      "title": "الكعبة خلقت قبل الأرض بألفي سنة وهي من الأرض.",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 12
    },
    "65": {
      "title": "33 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 13
    },
    "66": {
      "title": "، متى كتبت نبيا؟ قال: وآدم بين الروح والجسد \"",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "67": {
      "title": "34 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "68": {
      "title": ": كتبت نبيا وآدم بين الروح والجسد \"",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "69": {
      "title": "35 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "70": {
      "title": "\" متى وجبت لك النبوة؟ قال: من خلق آدم ونفخ الروح فيه \"",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "71": {
      "title": "36 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "72": {
      "title": ": «إني لعبد الله وخاتم النبيين وإن آدم لمنجدل في طينته»",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "73": {
      "title": "37 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "74": {
      "title": "\" {وتقلبك في الساجدين} [الشعراء: 219] .",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "75": {
      "title": "38 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "76": {
      "title": ": «لم يزل الله عز وجل يتقدم في النبي صلى الله عليه وسلم إلى آدم فمن بعده , ولم تزل الأمم",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 14
    },
    "77": {
      "title": "39 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "78": {
      "title": "لنجد بعث النبي صلى الله عليه وسلم في سطرين من كتاب الله عز وجل , نجده في سطر محمد رسول",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "79": {
      "title": "40 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 15
    },
    "80": {
      "title": "أن بني إسرائيل لما أصابهم ما أصابهم من ظهور بختنصر عليهم وفرقتهم وذلتهم , تفرقوا فكانوا",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 16
    },
    "81": {
      "title": "41 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "82": {
      "title": "أخبرنا عن نفسك.",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "83": {
      "title": "42 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 17
    },
    "84": {
      "title": ": \" {وإذ أخذنا من النبيين ميثاقهم ومنك ومن نوح} [الأحزاب: 7] .",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "85": {
      "title": "43 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "86": {
      "title": "هل تجدون محمدا في كتبكم؟» قالوا: نعم",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "87": {
      "title": "44 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "88": {
      "title": ": وجد في البيت كتاب في صخر منقور في الهرمة الأولى , فدعا رجلا فقرأه فإذا فيه: عبدي المتحبب",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "89": {
      "title": "45 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "90": {
      "title": ": كنا مع النبي صلى الله عليه وسلم جلوسا على جبل من جبال تهامة إذ أقبل شيخ بيده عصا فسلم",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 18
    },
