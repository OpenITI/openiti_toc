      "title": "46 -",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "92": {
      "title": ": «ولد النبي صلى الله عليه وسلم يوم الفيل»",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "93": {
      "title": "47 -",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "94": {
      "title": ": «ولدت أنا ورسول الله صلى الله عليه وسلم عام الفيل»",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
