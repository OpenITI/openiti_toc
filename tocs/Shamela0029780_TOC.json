      "end_ms": 18
    },
    "96": {
      "title": ": أنت أكبر أو رسول الله صلى الله عليه وسلم؟ فقال: رسول الله صلى الله عليه وسلم أكبر مني",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
