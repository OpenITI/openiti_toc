      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 19
    },
    "98": {
      "title": "خرج عبد الله بن عبد المطلب حتى أتى عيضا فوقف في أصل صومعته , ثم نادى: يا عيضا.",
      "level": 1,
