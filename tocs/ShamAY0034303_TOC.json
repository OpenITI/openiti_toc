  "sections": {
    "1": {
      "title": "AUTO الحمد لله الذي طهر قلوب الموحدين من دنس الشرك، والصلاة",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "2": {
      "title": "AUTO ثم عن لي أن أبين مجمل هذا الجواب في هذه الأوراق، مستعينا",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 3
    },
    "3": {
      "title": "AUTO ومن فروع القول بنجاسة المستعمل قولهم بفساد الماء في الإناء",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "4": {
      "title": "AUTO [المخالطات الطاهرة]",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 4
    },
    "5": {
      "title": "AUTO فظهر من هذا أن المعتبر في اختلاط المستعمل بالطهور غلبة",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 6
    },
    "6": {
      "title": "AUTO قلت: الظاهر عدم اعتبار هذا المعنى في النجس، فكيف بالطاهر؟ قال",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 7
    },
    "7": {
      "title": "AUTO فأخرج ابن أبي شيبة عن جابر بن عبد الله قال: كنا نستحب أن نأخذ",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 8
    },
    "8": {
      "title": "AUTO عشرة في عشرة، ثم رجع إلى قول أبي حنيفة وقال: لا أؤقت شيئا. انتهى.",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 11
    },
    "9": {
      "title": "AUTO وإن كان يجري عليها النصف أو دون النصف، فالقياس أن يجوز التوضؤ",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 16
    },
    "10": {
      "title": "AUTO الإباحة -وهو الذي خالطه من الأشياء الطاهرة- ولا فرق في ذلك",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 18
    },
    "11": {
      "title": "AUTO [مسائل وأجوبتها]",
