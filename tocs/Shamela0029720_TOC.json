      "end_ms": 12
    },
    "106": {
      "title": ": \" أمرت أن أقاتل الناس حتى يقولوا لا إله إلا الله، ومن قال: لا إله إلا الله، فقد عصم مني",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
