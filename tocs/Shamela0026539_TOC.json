      "start_ms": 50,
      "end_ms": 50
    },
    "23": {
      "title": "وقال الأستاذ أبو الحسن الحرالي في تفسيره في غريب ألفاظ البسملة:",
      "level": 1,
      "parent": null,
      "start_ms": 50,
      "end_ms": 50
    },
    "24": {
      "title": "{مالك يوم الدين}",
      "level": 1,
      "parent": null,
      "start_ms": 50,
      "end_ms": 51
    },
    "25": {
      "title": "{إياك نعبد}:",
      "level": 1,
      "parent": null,
      "start_ms": 51,
      "end_ms": 53
    },
    "26": {
      "title": "{غير المغضوب عليهم ولا الضالين}",
      "level": 1,
      "parent": null,
      "start_ms": 53,
      "end_ms": 54
    },
    "27": {
      "title": "سورة (البقرة)",
      "level": 1,
      "parent": null,
      "start_ms": 54,
      "end_ms": 54
    },
    "28": {
      "title": "\"الم\"",
      "level": 1,
      "parent": null,
      "start_ms": 54,
      "end_ms": 55
    },
    "29": {
      "title": "{ذلك الكتاب لا ريب}:",
      "level": 1,
      "parent": null,
      "start_ms": 55,
      "end_ms": 56
    },
    "30": {
      "title": "{الذين يؤمنون بالغيب ويقيمون الصلاة ومما رزقناهم ينفقون}.",
      "level": 1,
      "parent": null,
      "start_ms": 56,
      "end_ms": 57
    },
    "31": {
      "title": "{وأولئك هم المفلحون}",
      "level": 1,
      "parent": null,
      "start_ms": 57,
      "end_ms": 57
    },
    "32": {
      "title": "{ختم الله على قلوبهم وعلى سمعهم}",
      "level": 1,
      "parent": null,
      "start_ms": 57,
      "end_ms": 58
    },
    "33": {
      "title": "{يخادعون الله}",
      "level": 1,
      "parent": null,
      "start_ms": 58,
      "end_ms": 59
    },
    "34": {
      "title": "{لا تفسدوا في الأرض}",
      "level": 1,
      "parent": null,
      "start_ms": 59,
      "end_ms": 59
    },
    "35": {
      "title": "{وإذا لقوا الذين آمنوا}",
      "level": 1,
      "parent": null,
      "start_ms": 59,
      "end_ms": 59
    },
    "36": {
      "title": "{وإذا خلوا إلى شياطينهم}",
      "level": 1,
      "parent": null,
      "start_ms": 59,
      "end_ms": 60
    },
    "37": {
      "title": "{أو كصيب}",
      "level": 1,
      "parent": null,
      "start_ms": 60,
      "end_ms": 60
    },
    "38": {
      "title": "{يا أيها الناس}",
      "level": 1,
      "parent": null,
      "start_ms": 60,
      "end_ms": 62
    },
    "39": {
      "title": "{الذي جعل}",
      "level": 1,
      "parent": null,
      "start_ms": 62,
      "end_ms": 64
    },
    "40": {
      "title": "{أندادا}",
      "level": 1,
      "parent": null,
      "start_ms": 64,
      "end_ms": 67
    },
    "41": {
      "title": "{وبشر الذين آمنوا وعملوا الصالحات}",
      "level": 1,
      "parent": null,
      "start_ms": 67,
      "end_ms": 68
    },
    "42": {
      "title": "{إن الله لا يستحيي أن يضرب مثلا ما بعوضة فما فوقها}",
      "level": 1,
      "parent": null,
      "start_ms": 68,
      "end_ms": 70
    },
    "43": {
      "title": "{الذين ينقضون}",
      "level": 1,
      "parent": null,
      "start_ms": 70,
      "end_ms": 71
    },
    "44": {
      "title": "{كيف تكفرون بالله}",
      "level": 1,
      "parent": null,
      "start_ms": 71,
      "end_ms": 73
    },
    "45": {
      "title": "ا ني",
      "level": 1,
      "parent": null,
      "start_ms": 73,
      "end_ms": 73
    },
    "46": {
      "title": "{ما في الأرض جميعا}",
      "level": 1,
      "parent": null,
      "start_ms": 73,
      "end_ms": 77
    },
    "47": {
      "title": "{إني}",
      "level": 1,
      "parent": null,
      "start_ms": 77,
      "end_ms": 77
    },
    "48": {
      "title": "{وعلم آدم الأسماء كلها}",
      "level": 1,
      "parent": null,
      "start_ms": 77,
      "end_ms": 79
    },
    "49": {
      "title": "{سبحانك}",
      "level": 1,
      "parent": null,
      "start_ms": 79,
      "end_ms": 79
    },
    "50": {
      "title": "{يا آدم أنبئهم بأسمائهم}",
      "level": 1,
      "parent": null,
      "start_ms": 79,
      "end_ms": 81
    },
    "51": {
      "title": "{وإذ قلنا للملائكة اسجدوا لآدم فسجدوا}",
      "level": 1,
      "parent": null,
      "start_ms": 81,
      "end_ms": 82
    },
    "52": {
      "title": "{وزوجك الجنة}",
      "level": 1,
      "parent": null,
      "start_ms": 82,
      "end_ms": 82
    },
    "53": {
      "title": "{فأزلهما الشيطان}",
      "level": 1,
      "parent": null,
      "start_ms": 82,
      "end_ms": 83
    },
    "54": {
      "title": "{وقلنا اهبطوا}",
      "level": 1,
      "parent": null,
      "start_ms": 83,
      "end_ms": 84
    },
    "55": {
      "title": "{فتلقى آدم}",
      "level": 1,
      "parent": null,
      "start_ms": 84,
      "end_ms": 85
    },
    "56": {
      "title": "{قلنا اهبطوا منها جميعا}",
      "level": 1,
      "parent": null,
      "start_ms": 85,
      "end_ms": 85
    },
    "57": {
      "title": "{والذين كفروا}",
      "level": 1,
      "parent": null,
      "start_ms": 85,
      "end_ms": 86
    },
    "58": {
      "title": "{يا بني إسرائيل}",
      "level": 1,
      "parent": null,
      "start_ms": 86,
      "end_ms": 87
    },
    "59": {
      "title": "{مصدقا لما معكم}",
      "level": 1,
      "parent": null,
      "start_ms": 87,
      "end_ms": 88
    },
    "60": {
      "title": "{وآتوا الزكاة}",
      "level": 1,
      "parent": null,
      "start_ms": 88,
      "end_ms": 88
    },
    "61": {
      "title": "{أتأمرون}",
      "level": 1,
      "parent": null,
      "start_ms": 88,
      "end_ms": 89
    },
    "62": {
      "title": "{واستعينوا بالصبر والصلاة}",
      "level": 1,
      "parent": null,
      "start_ms": 89,
      "end_ms": 89
    },
    "63": {
      "title": "{يظنون}",
      "level": 1,
      "parent": null,
      "start_ms": 89,
      "end_ms": 90
    },
    "64": {
      "title": "{وأني فضلتكم}",
      "level": 1,
      "parent": null,
      "start_ms": 90,
      "end_ms": 90
    },
    "65": {
      "title": "{شفاعة}",
      "level": 1,
      "parent": null,
      "start_ms": 90,
      "end_ms": 91
    },
    "66": {
      "title": "، وإذ\"",
      "level": 1,
      "parent": null,
      "start_ms": 91,
      "end_ms": 92
    },
    "67": {
      "title": "{وإذ فرقنا}",
      "level": 1,
      "parent": null,
      "start_ms": 92,
      "end_ms": 93
    },
    "68": {
      "title": ": {وإذ واعدنا}",
      "level": 1,
      "parent": null,
      "start_ms": 93,
      "end_ms": 94
    },
    "69": {
      "title": "{ثم عفونا}",
      "level": 1,
      "parent": null,
      "start_ms": 94,
      "end_ms": 95
    },
    "70": {
      "title": "{وإذ آتينا موسى الكتاب والفرقان}",
      "level": 1,
      "parent": null,
      "start_ms": 95,
      "end_ms": 95
    },
    "71": {
      "title": "{وإذ قال موسى}",
      "level": 1,
      "parent": null,
      "start_ms": 95,
      "end_ms": 96
    },
    "72": {
      "title": "{لن نؤمن لك}",
      "level": 1,
      "parent": null,
      "start_ms": 96,
      "end_ms": 98
    },
    "73": {
      "title": "{وأنزلنا عليكم المن}",
      "level": 1,
      "parent": null,
      "start_ms": 98,
      "end_ms": 99
    },
    "74": {
      "title": "{وإذ قلنا ادخلوا هذه القرية}",
      "level": 1,
      "parent": null,
      "start_ms": 99,
      "end_ms": 100
    },
    "75": {
      "title": ": {فبدل}",
      "level": 1,
      "parent": null,
      "start_ms": 100,
      "end_ms": 101
    },
    "76": {
      "title": "{وإذ استسقى}",
      "level": 1,
      "parent": null,
      "start_ms": 101,
      "end_ms": 103
    },
    "77": {
      "title": "{لن نصبر على طعام واحد}",
      "level": 1,
      "parent": null,
      "start_ms": 103,
      "end_ms": 105
    },
    "78": {
      "title": "{والذين هادوا}",
      "level": 1,
      "parent": null,
      "start_ms": 105,
      "end_ms": 105
    },
    "79": {
      "title": "{وإذ أخذنا ميثاقكم}",
      "level": 1,
      "parent": null,
      "start_ms": 105,
      "end_ms": 106
    },
    "80": {
      "title": "{تثير الأرض}",
      "level": 1,
      "parent": null,
      "start_ms": 106,
      "end_ms": 106
    },
    "81": {
      "title": "{كالحجارة أو أشد قسوة} \"",
      "level": 1,
      "parent": null,
      "start_ms": 106,
      "end_ms": 106
    },
    "82": {
      "title": "{فريق منهم}",
      "level": 1,
      "parent": null,
      "start_ms": 106,
      "end_ms": 107
    },
    "83": {
      "title": "{إلا أياما معدودة}",
      "level": 1,
      "parent": null,
      "start_ms": 107,
      "end_ms": 107
    },
    "84": {
      "title": "{وبالوالدين إحسانا}",
      "level": 1,
      "parent": null,
      "start_ms": 107,
      "end_ms": 108
    },
    "85": {
      "title": "{وقفينا}",
      "level": 1,
      "parent": null,
      "start_ms": 108,
      "end_ms": 109
    },
    "86": {
      "title": "{فتمنوا الموت}",
      "level": 1,
      "parent": null,
      "start_ms": 109,
      "end_ms": 110
    },
    "87": {
      "title": "{وما هو بمزحزحه من العذاب}",
      "level": 1,
      "parent": null,
      "start_ms": 110,
      "end_ms": 111
    },
    "88": {
      "title": "{يعلمون الناس السحر}،",
      "level": 1,
      "parent": null,
      "start_ms": 111,
      "end_ms": 113
    },
    "89": {
      "title": "{وقولوا انظرنا}",
      "level": 1,
      "parent": null,
      "start_ms": 113,
      "end_ms": 113
    },
    "90": {
      "title": "{أو ننسها}",
      "level": 1,
      "parent": null,
      "start_ms": 113,
      "end_ms": 115
    },
    "91": {
      "title": "{أم تريدون}",
      "level": 1,
      "parent": null,
      "start_ms": 115,
      "end_ms": 116
    },
    "92": {
      "title": "{قل هاتوا برهانكم}",
      "level": 1,
      "parent": null,
      "start_ms": 116,
      "end_ms": 116
    },
    "93": {
      "title": "{ممن منع مساجد الله}",
      "level": 1,
      "parent": null,
      "start_ms": 116,
      "end_ms": 117
    },
    "94": {
      "title": "{ولله المشرق والمغرب}",
      "level": 1,
      "parent": null,
      "start_ms": 117,
      "end_ms": 118
    },
    "95": {
      "title": "{إذا قضى أمرا}",
      "level": 1,
      "parent": null,
      "start_ms": 118,
      "end_ms": 119
    },
    "96": {
      "title": "{إنا أرسلناك بالحق}",
      "level": 1,
      "parent": null,
      "start_ms": 119,
      "end_ms": 119
    },
    "97": {
      "title": "{ولن ترضى}",
      "level": 1,
      "parent": null,
      "start_ms": 119,
      "end_ms": 121
    },
    "98": {
      "title": "{بكلمات فأتمهن}",
      "level": 1,
      "parent": null,
      "start_ms": 121,
      "end_ms": 122
    },
    "99": {
      "title": "{مثابة للناس}",
      "level": 1,
      "parent": null,
      "start_ms": 122,
      "end_ms": 123
    },
    "100": {
      "title": "{إلا من سفه نفسه}",
      "level": 1,
      "parent": null,
      "start_ms": 123,
      "end_ms": 124
    },
    "101": {
      "title": "{وما أنزل إلى إبراهيم وإسماعيل وإسحاق}",
      "level": 1,
      "parent": null,
      "start_ms": 124,
      "end_ms": 125
    },
    "102": {
      "title": "{فسيكفيكهم الله}",
      "level": 1,
      "parent": null,
      "start_ms": 125,
      "end_ms": 126
    },
    "103": {
      "title": "{جعلناكم أمة}",
      "level": 1,
      "parent": null,
      "start_ms": 126,
      "end_ms": 126
    },
    "104": {
      "title": "{قد نرى تقلب وجهك}",
      "level": 1,
      "parent": null,
      "start_ms": 126,
      "end_ms": 127
    },
    "105": {
      "title": "وفي قوله: {ترضاها}",
      "level": 1,
      "parent": null,
      "start_ms": 127,
      "end_ms": 127
    },
    "106": {
      "title": "{من بعد ما جاءك من العلم}",
      "level": 1,
      "parent": null,
      "start_ms": 127,
      "end_ms": 129
    },
    "107": {
      "title": "{الذين آتيناهم الكتاب يعرفونه كما يعرفون أبناءهم}",
      "level": 1,
      "parent": null,
      "start_ms": 129,
      "end_ms": 130
    },
    "108": {
      "title": "{ولكل وجهة هو موليها}",
      "level": 1,
      "parent": null,
      "start_ms": 130,
      "end_ms": 131
    },
    "109": {
      "title": "{فولوا وجوهكم}",
      "level": 1,
      "parent": null,
      "start_ms": 131,
      "end_ms": 132
    },
    "110": {
      "title": "{ويزكيكم}",
      "level": 1,
      "parent": null,
      "start_ms": 132,
      "end_ms": 132
    },
    "111": {
      "title": "{ويعلمكم الكتاب}",
      "level": 1,
      "parent": null,
      "start_ms": 132,
      "end_ms": 133
    },
    "112": {
      "title": "{إن الله مع الصابرين}",
      "level": 1,
      "parent": null,
      "start_ms": 133,
      "end_ms": 134
    },
    "113": {
      "title": "{أموات بل أحياء}",
      "level": 1,
      "parent": null,
      "start_ms": 134,
      "end_ms": 134
    },
    "114": {
      "title": "{ولنبلونكم}",
      "level": 1,
      "parent": null,
      "start_ms": 134,
      "end_ms": 136
    },
    "115": {
      "title": "{إن الصفا والمروة من شعائر الله}",
      "level": 1,
      "parent": null,
      "start_ms": 136,
      "end_ms": 139
    },
    "116": {
      "title": "{إن الذين يكتمون ما أنزلنا}",
      "level": 1,
      "parent": null,
      "start_ms": 139,
      "end_ms": 140
    },
    "117": {
      "title": "{وماتوا وهم كفار}",
      "level": 1,
      "parent": null,
      "start_ms": 140,
      "end_ms": 141
    },
    "118": {
      "title": "{وإلهكم إله واحد لا إله إلا هو الرحمن الرحيم}",
      "level": 1,
      "parent": null,
      "start_ms": 141,
      "end_ms": 144
    },
    "119": {
      "title": "{والفلك}",
      "level": 1,
      "parent": null,
      "start_ms": 144,
      "end_ms": 147
    },
    "120": {
      "title": "{والذين آمنوا أشد حبا لله}",
      "level": 1,
      "parent": null,
      "start_ms": 147,
      "end_ms": 149
    },
    "121": {
      "title": "{إذ تبرأ الذين اتبعوا من الذين اتبعوا}",
      "level": 1,
      "parent": null,
      "start_ms": 149,
      "end_ms": 150
    },
    "122": {
      "title": "{لو أن لنا كرة }",
      "level": 1,
      "parent": null,
      "start_ms": 150,
      "end_ms": 151
    },
    "123": {
      "title": "{يا أيها الناس}",
      "level": 1,
      "parent": null,
      "start_ms": 151,
      "end_ms": 152
