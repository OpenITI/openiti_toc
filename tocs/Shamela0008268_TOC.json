    "12": {
      "title": "الله أمرني أن أقرأ عليك: {لم يكن الذين كفروا} [البينة: 1] \"، قال: وسماني؟ قال: «نعم» قال:",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
