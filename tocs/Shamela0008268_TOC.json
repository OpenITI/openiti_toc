    },
    "14": {
      "title": ": «لولا أن تدافنوا؛ لدعوت الله أن يسمعكم عذاب القبر»",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "15": {
      "title": "7 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "16": {
      "title": ": «إذا كان أحدكم في صلاة؛ فإنه يناجي ربه عز وجل، فلا يبزقن بين يديه، ولا عن يمينه، ولكن عن",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "17": {
      "title": "8 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "18": {
      "title": "، فلم أسمع أحدا منهم يقرأ: {بسم الله الرحمن الرحيم} [الفاتحة: 1] \"",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "19": {
      "title": "9 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "20": {
      "title": ": «سووا صفوفكم؛ فإن تسوية الصفوف من تمام الصلاة، واعتدلوا بالسجود، ولا يبسط أحدكم ذراعيه",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "21": {
      "title": "10 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "22": {
      "title": ": «ما رأيت أحدا أجمل في حلة حمراء من رسول الله صلى الله عليه وسلم» ، وقال: «كان له شعر إلى شحمة",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "23": {
      "title": "11 -",
      "level": 1,
