      "start_ms": 19,
      "end_ms": 21
    },
    "11": {
      "title": "فصل إذا مسح في الحضر ثم سافر أتم مسح مقيم",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "12": {
      "title": "فصل ويجوز المسح على كل خف صحيح يمكن متابعة المشي عليه فأما الخف المخرق فلا يصح المسح عليه في أصح القولين",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 22
    },
    "13": {
      "title": "فصل لا يجوز المسح على الجرموق وهو خف يلبس فوق خف",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 22
    },
    "14": {
      "title": "فصل ولا يجوز المسح على الخف حتى يلبسه على طهارة كاملة",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 23
    },
    "15": {
      "title": "فصل السنة أن يمسح أعلى الخف وأسفله",
