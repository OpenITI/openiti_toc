  "sections": {
    "1": {
      "title": "مقدمة",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 4
    },
    "2": {
      "title": "فصل: فى أن الله هو الغنى المطلق والخلق فقراء محتاجون إليه",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 14
    },
    "3": {
      "title": "فصل: في تفسير الفقر ودرجاته",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 15
    },
    "4": {
      "title": "فصل: في أن حقيقة الفقر توجه العبد بجميع أحواله إلى الله",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 31
    },
    "5": {
      "title": "فصل: فى تقسيم الغنى إلى عال وسافل",
      "level": 1,
      "parent": null,
      "start_ms": 31,
      "end_ms": 32
    },
    "6": {
      "title": "فصل: فى الغني العالي",
      "level": 1,
      "parent": null,
      "start_ms": 32,
      "end_ms": 40
    },
    "7": {
      "title": "فصل: فى تفسير غنى النفس",
      "level": 1,
      "parent": null,
      "start_ms": 40,
      "end_ms": 41
    },
    "8": {
      "title": "فصل: فيما يغنى القلب ويسد الفاقة",
      "level": 1,
      "parent": null,
      "start_ms": 41,
      "end_ms": 43
    },
    "9": {
      "title": "فصل: فى بيان الدرجة الثانية من درجات الغنى بالله عز وجل",
      "level": 1,
      "parent": null,
      "start_ms": 43,
      "end_ms": 47
    },
    "10": {
      "title": "فصل: فى بيان الدرجة الثالثة من درجات الغنى بالرب",
      "level": 1,
      "parent": null,
      "start_ms": 47,
      "end_ms": 48
    },
    "11": {
      "title": "فصل: فى ذكر كلمات عن أرباب الطريق فى الفقر والغني",
      "level": 1,
      "parent": null,
      "start_ms": 48,
      "end_ms": 52
    },
    "12": {
      "title": "فصل: فى تحقيق نعت الفقير",
      "level": 1,
      "parent": null,
      "start_ms": 52,
      "end_ms": 60
    },
    "13": {
      "title": "فصل: فى بيان أصلين عظيمين مبنى عليهما ما تقدم",
      "level": 1,
      "parent": null,
      "start_ms": 60,
      "end_ms": 65
    },
    "14": {
      "title": "فصل: فى بيان منفعة الحق، ومنفعة الخلق، وما بينهما من التباين",
      "level": 1,
      "parent": null,
      "start_ms": 65,
      "end_ms": 66
    },
    "15": {
      "title": "فصل: فى بيان أن المنفعة والمضرة لا تكون إلا من الله وحده",
      "level": 1,
      "parent": null,
      "start_ms": 66,
      "end_ms": 99
    },
    "16": {
      "title": "فصل: فى تفصيل ما أجمل فيما مر وتوضيحه",
      "level": 1,
      "parent": null,
      "start_ms": 99,
      "end_ms": 111
    },
    "17": {
      "title": "[ص:28]",
      "level": 1,
      "parent": null,
      "start_ms": 111,
      "end_ms": 121
    },
    "18": {
      "title": "فصل: فى إثبات الحمد كله لله عز وجل",
      "level": 1,
      "parent": null,
      "start_ms": 121,
      "end_ms": 127
    },
    "19": {
      "title": "فصل: فى بيان أن حمده تعالى شامل لكل ما يحدثه",
      "level": 1,
      "parent": null,
      "start_ms": 127,
      "end_ms": 152
    },
    "20": {
      "title": "فصل: فى أن الله خلق دارين وخص كل دار بأهل",
      "level": 1,
      "parent": null,
      "start_ms": 152,
      "end_ms": 159
    },
    "21": {
      "title": "فصل: فى بيان ما للناس فى دخول الشر فى القضاء الإلهي من الطرق والأصول التى تفرعت عنها هذه الطرق.",
      "level": 1,
      "parent": null,
      "start_ms": 159,
      "end_ms": 170
    },
    "22": {
      "title": "الفصل السادس: فى كيفية دخول الشر فى القضاء الإلهى،",
      "level": 1,
      "parent": null,
      "start_ms": 170,
      "end_ms": 200
    },
    "23": {
      "title": "فصل: فى تقسيم الناس من حيث القوة العلمية والعملية",
      "level": 1,
      "parent": null,
      "start_ms": 200,
      "end_ms": 383
    },
    "24": {
      "title": "فصل: فى مراتب المكلفين فى الدار الآخرةوطبقاتهم فيها،",
      "level": 1,
      "parent": null,
      "start_ms": 383,
      "end_ms": 458
    },
    "25": {
      "title": "[ص:85]",
      "level": 1,
      "parent": null,
      "start_ms": 458,
      "end_ms": null
    }
  },
