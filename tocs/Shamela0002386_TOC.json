  "sections": {
    "1": {
      "title": "باب: كتاب التوحيد",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 23
    },
    "2": {
      "title": "باب: فضل التوحيد وما يكفر من الذنوب",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 44
    },
    "3": {
      "title": "باب\" من حقق التوحيد دخل الجنة بغير حساب\"",
      "level": 1,
      "parent": null,
      "start_ms": 44,
      "end_ms": 53
    },
    "4": {
      "title": "باب الخوف من الشرك.",
      "level": 1,
      "parent": null,
      "start_ms": 53,
      "end_ms": 67
    },
    "5": {
      "title": "باب\" تفسير ms066 التوحيد وشهادة أن لا إله إلا الله\"",
      "level": 1,
      "parent": null,
      "start_ms": 67,
      "end_ms": 82
    },
    "6": {
      "title": "باب: \"من الشرك لبس الحلقة والخيط ونحوهما لرفع البلاء أو دفعه\"",
      "level": 1,
      "parent": null,
      "start_ms": 82,
      "end_ms": 86
    },
    "7": {
      "title": "باب: ما جاء في الرقى والتمائم",
      "level": 1,
      "parent": null,
      "start_ms": 86,
      "end_ms": 93
    },
    "8": {
      "title": "باب: \" من تبرك بشجرة أو حجر ونحوهما\"",
      "level": 1,
      "parent": null,
      "start_ms": 93,
      "end_ms": 100
    },
    "9": {
      "title": "باب: \" ما جاء في الذبح لغير الله\"",
      "level": 1,
      "parent": null,
      "start_ms": 100,
      "end_ms": 113
    },
    "10": {
      "title": "باب: \" من الشرك الاستعاذة بغير الله\"",
      "level": 1,
      "parent": null,
      "start_ms": 113,
      "end_ms": 116
    },
    "11": {
      "title": "باب: \" من الشرك أن يستغيث بغير الله أو يدعو غيره\"",
      "level": 1,
      "parent": null,
      "start_ms": 116,
      "end_ms": 129
    },
    "12": {
      "title": "باب: قول الله تعالى: {أيشركون ما لا يخلق شيئا وهم يخلقون ولا يستطيعون لهم نصرا ولا أنفسهم ينصرون}",
      "level": 1,
      "parent": null,
      "start_ms": 129,
      "end_ms": 139
    },
    "13": {
      "title": "باب: قول الله تعالى: {حتى إذا فزع عن قلوبهم قالوا ماذا قال ربكم قالوا الحق ms138 وهو العلي الكبير }",
      "level": 1,
      "parent": null,
      "start_ms": 139,
      "end_ms": 146
    },
    "14": {
      "title": "باب الشفاعة",
      "level": 1,
      "parent": null,
      "start_ms": 146,
      "end_ms": 152
    },
    "15": {
      "title": "باب: قول الله تعالى: {إنك لا تهدي من أحببت ولكن الله يهدي من يشاء}",
      "level": 1,
      "parent": null,
      "start_ms": 152,
      "end_ms": 155
    },
    "16": {
      "title": "باب: \"ما جاء أن سبب كفر بني آدم وتركهم دينهم هو الغلو في الصالحين\"",
      "level": 1,
      "parent": null,
      "start_ms": 155,
      "end_ms": 163
    },
    "17": {
      "title": "باب: \" ما جاء من التغليظ فيمن عبد الله عند قبر رجل صالح فكيف إذا عبده؟ \"",
      "level": 1,
      "parent": null,
      "start_ms": 163,
      "end_ms": 175
    },
    "18": {
      "title": "باب: \"ما جاء أن الغلو في قبور الصالحين يصيرها ms174 أوثانا تعبد من دون الله\"",
      "level": 1,
      "parent": null,
      "start_ms": 175,
      "end_ms": 183
    },
    "19": {
      "title": "باب: ما جاء في حماية المصطفى صلي الله عليه وسلم جناب التوحيد \"وسده كل طريق يوصل إلى الشرك",
      "level": 1,
      "parent": null,
      "start_ms": 183,
      "end_ms": 191
    },
    "20": {
      "title": "باب: \" ما جاء أن بعض هذه الأمة يعبد الأوثان\"",
      "level": 1,
      "parent": null,
      "start_ms": 191,
      "end_ms": 204
    },
    "21": {
      "title": "باب \" ما جاء في السحر\"",
      "level": 1,
      "parent": null,
      "start_ms": 204,
      "end_ms": 210
    },
    "22": {
      "title": "باب: \" بيان شيء من أنواع السحر\"",
      "level": 1,
      "parent": null,
      "start_ms": 210,
      "end_ms": 215
    },
    "23": {
      "title": "باب: \" ما جاء في الكهان ونحوهم\"",
      "level": 1,
      "parent": null,
      "start_ms": 215,
      "end_ms": 221
    },
    "24": {
      "title": "باب: \" ما جاء في النشرة\"",
      "level": 1,
      "parent": null,
      "start_ms": 221,
      "end_ms": 223
    },
    "25": {
      "title": "باب: \" ما جاء في التطير\"",
      "level": 1,
      "parent": null,
      "start_ms": 223,
      "end_ms": 233
    },
    "26": {
      "title": "باب: \" ما جاء في التنجيم\"",
      "level": 1,
      "parent": null,
      "start_ms": 233,
      "end_ms": 237
    },
    "27": {
      "title": "باب: \" ما جاء في الاستسقاء بالأنواء\"",
      "level": 1,
      "parent": null,
      "start_ms": 237,
      "end_ms": 246
    },
    "28": {
      "title": "باب: قول الله تعلى: {ومن الناس من يتخذ من دون الله أندادا يحبونهم كحب الله}",
      "level": 1,
      "parent": null,
      "start_ms": 246,
      "end_ms": 257
    },
    "29": {
      "title": "باب: قول الله تعالى: {إنما ذلكم الشيطان يخوف أولياءه فلا تخافوهم وخافوني إن كنتم مؤمنين}",
      "level": 1,
      "parent": null,
      "start_ms": 257,
      "end_ms": 264
    },
    "30": {
      "title": "باب: قول الله تعالى: {وعلى الله فتوكلوا إن كنتم مؤمنين}",
      "level": 1,
      "parent": null,
      "start_ms": 264,
      "end_ms": 270
    },
    "31": {
      "title": "باب: قول الله تعالى: {أفأمنوا مكر الله فلا يأمن مكر الله إلا القوم الخاسرون}",
      "level": 1,
      "parent": null,
      "start_ms": 270,
      "end_ms": 272
    },
    "32": {
      "title": "باب: \" من الإيمان بالله: الصبر على أقدار الله\"",
      "level": 1,
      "parent": null,
      "start_ms": 272,
      "end_ms": 278
    },
    "33": {
      "title": "باب: \" ما جاء في الرياء\"",
      "level": 1,
      "parent": null,
      "start_ms": 278,
      "end_ms": 282
    },
    "34": {
      "title": "باب: \" من الشرك إرادة الإنسان بعمله الدنيا\"",
      "level": 1,
      "parent": null,
      "start_ms": 282,
      "end_ms": 292
    },
    "35": {
      "title": "باب: \" من أطاع العلماء والأمراء في تحريم ما أحل الله أو تحليل ما حرم الله، فقد اتخذهم أربابا من دون الله\"",
      "level": 1,
      "parent": null,
      "start_ms": 292,
      "end_ms": 300
    },
    "36": {
      "title": "باب: قول الله تعالى: {ألم تر إلى الذين يزعمون أنهم آمنوا بما أنزل إليك وما أنزل من قبلك يريدون أن يتحاكموا إلى الطاغوت وقد أمروا أن يكفروا به}",
      "level": 1,
      "parent": null,
      "start_ms": 300,
      "end_ms": 309
    },
    "37": {
      "title": "باب: من جحد شيئا من الأسماء والصفات، وقول الله تعالى: {وهم يكفرون بالرحمن قل هو ربي لا إله إلا هو عليه توكلت وإليه متاب}",
      "level": 1,
      "parent": null,
      "start_ms": 309,
      "end_ms": 316
    },
    "38": {
      "title": "باب: قول الله تعالى: {يعرفون نعمة الله ثم ينكرونها وأكثرهم الكافرون}",
      "level": 1,
      "parent": null,
      "start_ms": 316,
      "end_ms": 318
    },
    "39": {
      "title": "باب: قول الله تعالى: {فلا تجعلوا لله أندادا وأنتم تعلمون}",
      "level": 1,
      "parent": null,
      "start_ms": 318,
      "end_ms": 324
    },
    "40": {
      "title": "باب: \" ما جاء فيمن لم يقنع بالحلف بالله\"",
      "level": 1,
      "parent": null,
      "start_ms": 324,
      "end_ms": 325
    },
    "41": {
      "title": "باب: \"قول \"ما شاء الله وشئت\"",
      "level": 1,
      "parent": null,
      "start_ms": 325,
      "end_ms": 328
    },
    "42": {
      "title": "باب: \" من سب الدهر فقد آذى الله\"",
      "level": 1,
      "parent": null,
      "start_ms": 328,
      "end_ms": 331
    },
    "43": {
      "title": "بااب: التسمي بقاضي القضاة ونحوه",
      "level": 1,
      "parent": null,
      "start_ms": 331,
      "end_ms": 333
    },
    "44": {
      "title": "باب: \" احترام أسماء الله تعالى وتغيير الاسم لأجل ذلك\"",
      "level": 1,
      "parent": null,
      "start_ms": 333,
      "end_ms": 335
    },
    "45": {
      "title": "باب: \" من هزل بشيء فيه ذكر الله أو القرآن أو الرسول\"",
      "level": 1,
      "parent": null,
      "start_ms": 335,
      "end_ms": 339
    },
    "46": {
      "title": "باب: قول الله تعالى: {ولئن أذقناه رحمة منا من بعد ضراء مسته ليقولن هذا لي وما أظن الساعة قائمة ولئن رجعت إلى ربي إن لي عنده للحسنى فلننبئن الذين كفروا بم",
      "level": 1,
      "parent": null,
      "start_ms": 339,
      "end_ms": 342
    },
    "47": {
      "title": "باب: \"قول الله تعالى: {فلما آتاهما صالحا جعلا له شركاء فيما آتاهما فتعالى الله عما يشركون}",
      "level": 1,
      "parent": null,
      "start_ms": 342,
      "end_ms": 345
    },
    "48": {
      "title": "باب قول الله تعالى: {ولله الأسماء الحسنى فادعوه بها وذروا الذين يلحدون في أسمائه} 1 الآية.",
      "level": 1,
      "parent": null,
      "start_ms": 345,
      "end_ms": 348
    },
    "49": {
      "title": "باب \"لا يقال \" السلام على الله\"",
      "level": 1,
      "parent": null,
      "start_ms": 348,
      "end_ms": 349
    },
    "50": {
      "title": "باب\" قول: \" اللهم اغفر لي إن شئت\"",
      "level": 1,
      "parent": null,
      "start_ms": 349,
      "end_ms": 351
    },
    "51": {
      "title": "باب \" لا يقول عبدي وأمتي",
      "level": 1,
      "parent": null,
      "start_ms": 351,
      "end_ms": 351
    },
    "52": {
      "title": "باب \" لا يرد من سأل بالله",
      "level": 1,
      "parent": null,
      "start_ms": 351,
      "end_ms": 353
    },
    "53": {
      "title": "باب: \" لا يسأل بوجه الله إلا الجنة",
      "level": 1,
      "parent": null,
      "start_ms": 353,
      "end_ms": 354
    },
    "54": {
      "title": "باب: ما جاء في \"لو\"",
      "level": 1,
      "parent": null,
      "start_ms": 354,
      "end_ms": 360
    },
    "55": {
      "title": "\"باب النهي عن سب الريح\"",
      "level": 1,
      "parent": null,
      "start_ms": 360,
      "end_ms": 360
    },
    "56": {
      "title": "باب: قول الله تعالى: {ثم أنزل عليكم من بعد الغم أمنة نعاسا يغشى طائفة منكم وطائفة قد أهمتهم أنفسهم يظنون بالله غير الحق ظن الجاهلية يقولون هل لنا من الأم",
      "level": 1,
      "parent": null,
      "start_ms": 360,
      "end_ms": 366
    },
    "57": {
      "title": "باب: \" ما جاء في منكري القدر\"",
      "level": 1,
      "parent": null,
      "start_ms": 366,
      "end_ms": 370
    },
    "58": {
      "title": "باب: \" ما جاء في المصورين\"",
      "level": 1,
      "parent": null,
      "start_ms": 370,
      "end_ms": 376
    },
    "59": {
      "title": "باب: \" ما جاء في كثرة الحلف\"",
      "level": 1,
      "parent": null,
      "start_ms": 376,
      "end_ms": 380
    },
    "60": {
      "title": "باب: \"ما جاء في ذمة الله وذمة نبيه",
      "level": 1,
      "parent": null,
      "start_ms": 380,
      "end_ms": 384
    },
    "61": {
      "title": "باب: \" ما جاء في الإقسام على الله\"",
      "level": 1,
      "parent": null,
      "start_ms": 384,
      "end_ms": 386
    },
    "62": {
      "title": "باب: لا يستشفع بالله على خلقه",
      "level": 1,
      "parent": null,
      "start_ms": 386,
      "end_ms": 388
    },
    "63": {
      "title": "باب: \" ما جاء في حماية النبي صلى الله عليه وسلم حمى التوحيد، وسده طرق الشرك\"",
      "level": 1,
      "parent": null,
      "start_ms": 388,
      "end_ms": 391
    },
    "64": {
      "title": "باب: ما جاء في قول الله تعالى: {وما قدروا الله حق قدره والأرض جميعا قبضته يوم القيامة والسماوات مطويات بيمينه سبحانه وتعالى عما يشركون}",
      "level": 1,
      "parent": null,
      "start_ms": 391,
      "end_ms": null
    }
  },
