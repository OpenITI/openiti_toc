      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "34": {
      "title": ": «إذا أراد الله عز وجل خلق عبد، جامع الرجل المرأة، طار ماؤه في كل عرق وعضو منها، فإذا كان",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
