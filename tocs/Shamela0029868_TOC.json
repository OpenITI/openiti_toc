      "start_ms": 4,
      "end_ms": 4
    },
    "29": {
      "title": "15 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "30": {
      "title": ": \" علي أقضانا، وأبي أقرؤنا، وإنا لندع بعض ما يقول أبي، وأبي يقول: سمعت من رسول الله صلى الله",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "31": {
      "title": "16 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "32": {
      "title": ": «إذا زادت الإبل على عشرين ومائة ففي كل خمسين حقة , وفي كل أربعين ابنة",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "33": {
