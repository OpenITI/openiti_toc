      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "82": {
      "title": ": لما خلق الله عز وجل الخلق، كتب على نفسه بيده عز وجل: «إن رحمتي تغلب",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "83": {
      "title": "42 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 9
    },
    "84": {
      "title": ": «ما من أمير عشرة إلا يؤتى به ms08 يوم القيامة مغلولا حتى يفكه عنه العدل أو يوبقه",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
