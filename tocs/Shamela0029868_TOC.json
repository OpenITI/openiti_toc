      "start_ms": 6,
      "end_ms": 6
    },
    "57": {
      "title": "29 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "58": {
      "title": ": \" لإن بقيت لأنهين الناس أن يسموا: بركة، وأفلح، وأسلم \"",
      "level": 1,
