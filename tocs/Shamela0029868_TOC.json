      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "64": {
      "title": ": \" نزلت هذه الآية: حافظوا على الصلوات والصلاة العصر، فقرأناها على عهد رسول الله ما شاء الله",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "65": {
      "title": "33 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "66": {
      "title": ": «إن مما أتخوف عليكم رجل قرأ القرآن حتى إذا رئيت عليه بهجته وكان ردءا للإسلام غيره إلى ما",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
