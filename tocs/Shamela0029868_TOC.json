      "start_ms": 9,
      "end_ms": 9
    },
    "93": {
      "title": "47 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "94": {
      "title": "يأمر بتأخير الصلاة» ، فسألت عنه , فقالوا: هذا أنس بن رافع بن خديج",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "95": {
      "title": "48 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
