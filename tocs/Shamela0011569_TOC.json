{
  "filename": "0744IbnCabdHadi.TacliqaCalaCilal.Shamela0011569-ara1",
  "sections": {
    "1": {
      "title": "إذا خرج من الخلاء قال: «غفرانك» .",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 3
    },
    "2": {
      "title": "يخرج فيبول فيتمسح بالتراب، فقال: يا رسول الله، الماء منك قريب! فقال: «ما أدري لعلي لا",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 4
    },
    "3": {
      "title": "الماء لا ينجس \".",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 6
    },
    "4": {
      "title": ": «إذا كان الماء قلتين لم يحمل الخبث» .",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 12
    },
    "5": {
      "title": ": «الماء لا ينجسه شيء إلا ما غلب على ريحه وطعمه ولونه» .",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 15
    },
    "6": {
      "title": "السنور سبع \".",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 16
    },
    "7": {
      "title": "، فجئته بإداوة، فإذا فيها نبيذ، فتوضأ رسول الله صلى الله عليه وسلم.",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 21
    },
    "8": {
      "title": "واحدة واحدة، فقال: «هذا وضوء من لا يقبل الله منه صلاة إلا به» .",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 25
    },
    "9": {
      "title": "يتوضأ، فغسل كفيه ثلاثا، وتمضمض ثلاثا، واستنشق ثلاثا، وغسل وجهه ثلاثا، وذراعيه ثلاثا ومسح",
      "level": 1,
      "parent": null,
      "start_ms": 25,
      "end_ms": 29
    },
    "10": {
      "title": "، فأمرني أن أمسح على الجبائر.",
      "level": 1,
      "parent": null,
      "start_ms": 29,
      "end_ms": 30
    },
    "11": {
      "title": "توضأ، ثم أخذ حفنة من ماء، فقال بها هكذا - يعني: انتضح بها.",
      "level": 1,
      "parent": null,
      "start_ms": 30,
      "end_ms": 34
    },
    "12": {
      "title": "إذا بال توضأ، وينتضح.",
      "level": 1,
      "parent": null,
      "start_ms": 34,
      "end_ms": 35
    },
    "13": {
      "title": "، فتوضأ النبي صلى الله عليه وسلم فلما فرغ أخذ النبي صلى الله عليه وسلم بيده ماء، فنضح به",
      "level": 1,
      "parent": null,
      "start_ms": 35,
      "end_ms": 39
    },
    "14": {
      "title": "نزلت آية التيمم، ضرب رسول الله صلى الله عليه وسلم بيده على الأرض، فمسح بها وجهه، وضرب",
      "level": 1,
      "parent": null,
      "start_ms": 39,
      "end_ms": 40
    },
    "15": {
      "title": "العين وكاء السه، فمن نام فليتوضأ \".",
      "level": 1,
      "parent": null,
      "start_ms": 40,
      "end_ms": 41
    },
    "16": {
      "title": ": «لا وضوء إلا من صوت أو ريح» .",
      "level": 1,
      "parent": null,
      "start_ms": 41,
      "end_ms": 42
    },
    "17": {
      "title": "يقبلني، ثم يخرج إلى الصلاة ولا يحدث وضوء.",
      "level": 1,
      "parent": null,
      "start_ms": 42,
      "end_ms": 43
    },
    "18": {
      "title": "يتوضأ، ثم يقبل، ثم يصلي ولا يتوضأ.",
      "level": 1,
      "parent": null,
      "start_ms": 43,
      "end_ms": 44
    },
    "19": {
      "title": "قبل بعض نسائه، ثم خرج إلى الصلاة ولم يتوضأ.",
      "level": 1,
      "parent": null,
      "start_ms": 44,
      "end_ms": 46
    },
    "20": {
      "title": "رجل مس ذكره في الصلاة؟ قال: «وهل هو إلا مضغة منه - أو بضعة منه -» .",
      "level": 1,
      "parent": null,
      "start_ms": 46,
      "end_ms": 55
    },
    "21": {
      "title": "أهراق الدم.",
      "level": 1,
      "parent": null,
      "start_ms": 55,
      "end_ms": 56
    },
    "22": {
      "title": ": «عدي أيام أقرائك» .",
      "level": 1,
      "parent": null,
      "start_ms": 56,
      "end_ms": 58
    },
    "23": {
      "title": "الذي يأتي امرأته وهي ms057 حائض: «يتصدق بدينار، أو بنصف دينار» .",
      "level": 1,
      "parent": null,
      "start_ms": 58,
      "end_ms": 66
    },
    "24": {
      "title": "هو ركضة من ركضات الشيطان، فتحيضي ستة أو سبعة أيام في علم الله عز وجل، ثم اغتسلي حتى إذا",
      "level": 1,
      "parent": null,
      "start_ms": 66,
      "end_ms": 69
    },
    "25": {
      "title": "يذكر الله على كل أحيانه.",
      "level": 1,
      "parent": null,
      "start_ms": 69,
      "end_ms": 71
    },
    "26": {
      "title": ": «إنها ليست بنجس، إنها من الطوافين عليكم والطوافات» .",
      "level": 1,
      "parent": null,
      "start_ms": 71,
      "end_ms": 74
    },
    "27": {
      "title": "لا تستمتعوا من الميتة بإهاب ولا عصب \".",
      "level": 1,
      "parent": null,
      "start_ms": 74,
      "end_ms": 78
    },
    "28": {
      "title": ": «لا صلاة لمن لا وضوء له، ولا وضوء لمن ms077 لم يذكر اسم الله عليه» .",
      "level": 1,
      "parent": null,
      "start_ms": 78,
      "end_ms": 80
    },
    "29": {
      "title": "للوضوء شيطانا يقال له: ولهان، فاتقوا وسواس الماء \".",
      "level": 1,
      "parent": null,
      "start_ms": 80,
      "end_ms": 83
    },
    "30": {
      "title": "يتوضأ، والماء يسيل من وجهه ولحيته على صدره، فرأيته يفصل بين المضمضة والاستنشاق.",
      "level": 1,
      "parent": null,
      "start_ms": 83,
      "end_ms": 84
    },
    "31": {
      "title": "توضأ بأعلى نهر، فلما فرغ من ms083 وضوئه أفرغ فضله في النهر، وقال: «يبلغه الله قوما ينفعهم به» .",
      "level": 1,
      "parent": null,
      "start_ms": 84,
      "end_ms": 84
    },
    "32": {
      "title": ": «الأذنان من الرأس» .",
      "level": 1,
      "parent": null,
      "start_ms": 84,
      "end_ms": 85
    },
    "33": {
      "title": ": توضأ عمر وبقي على بعض رجله قطعة لم يصبها الماء، فأمره رسول الله صلى الله عليه وسلم أن",
      "level": 1,
      "parent": null,
      "start_ms": 85,
      "end_ms": 89
    },
    "34": {
      "title": "مسح أعلى الخف وأسفله.",
      "level": 1,
      "parent": null,
      "start_ms": 89,
      "end_ms": 89
    },
    "35": {
      "title": "فلقيه رجل فسلم عليه، فلم يرد عليه حتى أقبل على الجدار، فمسح بوجهه ويديه، ثم رد عليه",
      "level": 1,
      "parent": null,
      "start_ms": 89,
      "end_ms": 96
    },
    "36": {
      "title": ": \" التيمم ضربتان: ضربة للوجه، وضربة لليدين إلى المرفقين \".",
      "level": 1,
      "parent": null,
      "start_ms": 96,
      "end_ms": 100
    },
    "37": {
      "title": "الاستطابة: «بثلاثة أحجار، ليس فيها رجيع» .",
      "level": 1,
      "parent": null,
      "start_ms": 100,
      "end_ms": 102
    },
    "38": {
      "title": ": «عليكم بالسواك» .",
      "level": 1,
      "parent": null,
      "start_ms": 102,
      "end_ms": 103
    },
    "39": {
      "title": "السواك من أذن النبي صلى الله عليه وسلم موضع القلم من أذن الكاتب.",
      "level": 1,
      "parent": null,
      "start_ms": 103,
      "end_ms": 104
    },
    "40": {
      "title": "توضأ ثلاثا ثلاثا.",
      "level": 1,
      "parent": null,
      "start_ms": 104,
      "end_ms": 106
    },
    "41": {
      "title": "، فغسل يديه قبل أن يدخلهما الإناء، ثم قال: هكذا رأيت رسول الله صلى الله عليه وسلم صنع.",
      "level": 1,
      "parent": null,
      "start_ms": 106,
      "end_ms": 107
    },
    "42": {
      "title": "، فأخذ بيمينه الإناء فكفأ على يده اليسرى، فغسل كفيه ثلاث مرات.",
      "level": 1,
      "parent": null,
      "start_ms": 107,
      "end_ms": 111
    },
    "43": {
      "title": "الوضوء مرة مرة، فقال: «هذا الذي افترض الله عليكم» .",
      "level": 1,
      "parent": null,
      "start_ms": 111,
      "end_ms": 111
    },
    "44": {
      "title": "خرج من الخلاء، فاتبعته بالإداوة أو القدح، فجلست له بالطريق، فكان إذا أتى حاجة أبعد.",
      "level": 1,
      "parent": null,
      "start_ms": 111,
      "end_ms": 112
    },
    "45": {
      "title": ": «ويل للأعقاب من النار» .",
      "level": 1,
      "parent": null,
      "start_ms": 112,
      "end_ms": 113
    },
    "46": {
      "title": ": «أتموا الوضوء، ويل للأعقاب من النار» .",
      "level": 1,
      "parent": null,
      "start_ms": 113,
      "end_ms": 114
    },
    "47": {
      "title": ": «ويل للأعقاب من النار» .",
      "level": 1,
      "parent": null,
      "start_ms": 114,
      "end_ms": 115
    },
    "48": {
      "title": ": «ويل للأعقاب من النار» .",
      "level": 1,
      "parent": null,
      "start_ms": 115,
      "end_ms": 115
    },
    "49": {
      "title": ": صلى رسول الله صلى الله عليه وسلم يوم الفتح خمس صلوات بوضوء، ومسح على خفيه، فقال له عمر:",
      "level": 1,
      "parent": null,
      "start_ms": 115,
      "end_ms": 117
    },
    "50": {
      "title": "مخضب من صفر، قالت: فكنت أرجل رأس رسول الله صلى الله عليه وسلم.",
      "level": 1,
      "parent": null,
      "start_ms": 117,
      "end_ms": 118
    },
    "51": {
      "title": "مخضبا من صفر، فقالت: كان رسول الله صلى الله عليه وسلم يغتسل فيه.",
      "level": 1,
      "parent": null,
      "start_ms": 118,
      "end_ms": 118
    },
    "52": {
      "title": "بال ثم توضأ، ومسح على خفيه.",
      "level": 1,
      "parent": null,
      "start_ms": 118,
      "end_ms": 119
    },
    "53": {
      "title": "بال فتوضأ، ومسح على خفيه.",
      "level": 1,
      "parent": null,
      "start_ms": 119,
      "end_ms": 120
    },
    "54": {
      "title": "يمسح على خفيه وخماره.",
      "level": 1,
      "parent": null,
      "start_ms": 120,
      "end_ms": 122
    },
    "55": {
      "title": ": \" للوضوء شيطان يقال له: الولهان \".",
      "level": 1,
      "parent": null,
      "start_ms": 122,
      "end_ms": 122
    },
    "56": {
      "title": "نغتسل من إناء واحد، وذلك القدح يومئذ يدعى الفرق.",
      "level": 1,
      "parent": null,
      "start_ms": 122,
      "end_ms": 123
    },
    "57": {
      "title": ": «معك ماء؟» قلت: نعم.",
      "level": 1,
      "parent": null,
      "start_ms": 123,
      "end_ms": 125
    },
    "58": {
      "title": ": اختلفت يدي ويد رسول الله صلى الله عليه وسلم في الوضوء من إناء واحد.",
      "level": 1,
      "parent": null,
      "start_ms": 125,
      "end_ms": 127
    },
    "59": {
      "title": ": «إذا استيقظ أحدكم من نومه فلا يغمس يده في الإناء حتى يغسلها ثلاثا، فإنه لا يدري أين باتت",
      "level": 1,
      "parent": null,
      "start_ms": 127,
      "end_ms": 128
    },
    "60": {
      "title": "، المرأة ترى ما يرى الرجل في المنام، فترى من نفسها ما يرى الرجل من نفسه؟ فقالت عائشة: يا أم",
      "level": 1,
      "parent": null,
      "start_ms": 128,
      "end_ms": 128
    },
    "61": {
      "title": "توضأ فمسح رأسه مرة.",
      "level": 1,
      "parent": null,
      "start_ms": 128,
      "end_ms": 129
    },
    "62": {
      "title": "فأصب على رأسي ثلاث مرات» .",
      "level": 1,
      "parent": null,
      "start_ms": 129,
      "end_ms": 130
    },
    "63": {
      "title": "قبلها ثم مضى لوجهه ولم يحدث وضوء.",
      "level": 1,
      "parent": null,
      "start_ms": 130,
      "end_ms": 130
    },
    "64": {
      "title": ": «بسم الله» .",
      "level": 1,
      "parent": null,
      "start_ms": 130,
      "end_ms": 131
    },
    "65": {
      "title": "ترك الوضوء مما مست النار.",
      "level": 1,
      "parent": null,
      "start_ms": 131,
      "end_ms": 132
    },
    "66": {
      "title": "مسح على خفيه، ولكن أقبل «المائدة» أم بعدها؟ لا يخبرك أحد أن رسول الله صلى الله عليه وسلم",
      "level": 1,
      "parent": null,
      "start_ms": 132,
      "end_ms": 133
    },
    "67": {
      "title": ": «إذا استيقظ أحدكم من منامه فليغسل كفيه ثلاث مرات قبل أن يدخلها في الإناء، فإنه لا يدري أين",
      "level": 1,
      "parent": null,
      "start_ms": 133,
      "end_ms": 133
    },
    "68": {
      "title": "توضأ ثلاثا ثلاثا.",
      "level": 1,
      "parent": null,
      "start_ms": 133,
      "end_ms": 134
    },
    "69": {
      "title": "توضأ مرة مرة، ثم قال: «هذا وضوءنا معشر الأنبياء فمن زاد على ذلك فقد أساء وأربى» .",
      "level": 1,
      "parent": null,
      "start_ms": 134,
      "end_ms": 134
    },
    "70": {
      "title": "تبرز وتوضأ ومسح على خفيه. . . وذكر الحديث.",
      "level": 1,
      "parent": null,
      "start_ms": 134,
      "end_ms": 136
    },
    "71": {
      "title": "ترك الوضوء مما مست النار.",
      "level": 1,
      "parent": null,
      "start_ms": 136,
      "end_ms": 136
    },
    "72": {
      "title": "أكل مع النبي صلى الله عليه وسلم لحما، ثم صلى ولم يتوضأ.",
      "level": 1,
      "parent": null,
      "start_ms": 136,
      "end_ms": 137
    },
    "73": {
      "title": "توضأ وبقي على ظهر قدمه مثل ظفر إبهامه لم يمسه الماء، فقال له النبي صلى الله عليه وسلم:",
      "level": 1,
      "parent": null,
      "start_ms": 137,
      "end_ms": 139
    },
    "74": {
      "title": ": \" إذا أخذت مضجعك فتوضأ وضوءك للصلاة، ثم اضطجع على شقك الأيمن، ثم قل: اللهم إني أسلمت وجهي",
      "level": 1,
      "parent": null,
      "start_ms": 139,
      "end_ms": 140
    },
    "75": {
      "title": ": «ويل للأعقاب من النار» .",
      "level": 1,
      "parent": null,
      "start_ms": 140,
      "end_ms": 140
    },
    "76": {
      "title": "مسح على عمامته وخفيه.",
      "level": 1,
      "parent": null,
      "start_ms": 140,
      "end_ms": 141
    },
    "77": {
      "title": "توضأ وخلل لحيته.",
      "level": 1,
      "parent": null,
      "start_ms": 141,
      "end_ms": 142
    },
    "78": {
      "title": ": أنتم الغر المحجلون من آثار الطهور، فمن استطاع منكم أن يطيل غرته فليفعل \".",
      "level": 1,
      "parent": null,
      "start_ms": 142,
      "end_ms": 142
    },
    "79": {
      "title": "ذهب لحاجته في غزوة تبوك، قال المغيرة: فذهبت معه بماء، فجاء رسول الله صلى الله عليه وسلم،",
      "level": 1,
      "parent": null,
      "start_ms": 142,
      "end_ms": 143
    },
    "80": {
      "title": "إذا ذهب إلى الغائط أبعد.",
      "level": 1,
      "parent": null,
      "start_ms": 143,
      "end_ms": 145
    },
    "81": {
      "title": ": «لينهكن أحدكم أصابعه قبل أن تنهكه النار» .",
      "level": 1,
      "parent": null,
      "start_ms": 145,
      "end_ms": 146
    },
    "82": {
      "title": "توضأ، فأفرغ على يديه ثلاثا فغسلهما، ثم مضمض واستنثر وغسل وجهه ثلاثا، وغسل يده اليمنى إلى",
      "level": 1,
      "parent": null,
      "start_ms": 146,
      "end_ms": 147
    },
    "83": {
      "title": "أشد ضفر رأسي، فأنقضه لغسل الجنابة؟ فقال: «لا، إنما يكفيك أن تحثي على رأسك ثلاث حثيات، ثم",
      "level": 1,
      "parent": null,
      "start_ms": 147,
      "end_ms": 149
    },
    "84": {
      "title": ": «الوضوء مما مست النار» .",
      "level": 1,
      "parent": null,
      "start_ms": 149,
      "end_ms": 151
    },
    "85": {
      "title": ": «من كان يؤمن بالله واليوم الآخر فليكرم جاره، ومن كان يؤمن بالله واليوم الآخر فليكرم ضيفه،",
      "level": 1,
      "parent": null,
      "start_ms": 151,
      "end_ms": 152
    },
    "86": {
      "title": ": شرب رسول الله صلى الله عليه وسلم لبنا، ثم قال: «هاتوا ماء» .",
      "level": 1,
      "parent": null,
      "start_ms": 152,
      "end_ms": 153
    },
    "87": {
      "title": ": «ويل للأعقاب من النار» .",
      "level": 1,
      "parent": null,
      "start_ms": 153,
      "end_ms": 153
    },
    "88": {
      "title": "يمسح على الموقين والخمار.",
      "level": 1,
      "parent": null,
      "start_ms": 153,
      "end_ms": null
    }
  },
