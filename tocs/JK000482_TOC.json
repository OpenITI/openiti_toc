  "sections": {
    "1": {
      "title": "( سئل عن فضائل أبي بكر الصديق رحمة الله عليه ورضوانه )",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 9
    },
    "2": {
      "title": "سئل عن قول علي بن أبي طالب وغيره خير هذه الأمة بعد نبيها أبو بكر وعمر",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 14
    },
    "3": {
      "title": "قوله صلى الله عليه وسلم لو كنت متخذا من الناس خليلا لاتخذت أبا بكر خليلا",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 16
    },
    "4": {
      "title": "قوله صلى الله عليه وسلم مروا أبا بكر فليصل بالناس",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 19
    },
    "5": {
      "title": "( بقية قوله مروا أبا بكر يصلي بالناس )",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 56
    },
    "6": {
      "title": "( أن أول من اسلم أبو بكر )",
      "level": 1,
      "parent": null,
      "start_ms": 56,
      "end_ms": 60
    },
    "7": {
      "title": "( ما روي ان أبا بكر جاء ليستأذن فقال النبي صلى الله عليه وسلم ائذن",
      "level": 1,
      "parent": null,
      "start_ms": 60,
      "end_ms": 65
    },
    "8": {
