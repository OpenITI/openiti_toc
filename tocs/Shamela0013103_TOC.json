    },
    "5": {
      "title": ": «ذروني ما تركتم، فإنما هلك الذين قبلكم بسؤالهم واختلافهم على أنبيائهم، فإذا نهيتكم عن شيء",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 2
    },
    "6": {
      "title": "3 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "7": {
      "title": ": «اللهم إني أتخذ عندك عهدا لن تخلفه، إنما أنا بشر فأي المؤمنين آذيته، لعنته، شتمته، جلدته،",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "8": {
      "title": "4 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "9": {
      "title": ": «إذا نظر أحدكم إلى من فضل عليه في المال والخلق، فلينظر إلى من هو أسفل منه ممن فضل",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "10": {
      "title": "5 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "11": {
      "title": ": «لا يجمع الرجل بين المرأة وعمتها، وبينها وبين خالتها»",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "12": {
      "title": "6 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "13": {
      "title": ": «إذا انتعل أحدكم، فليبدأ باليمين، وإذا نزع، فليبدأ بالشمال، فلتكن اليمين أول ما يلبس وآخر",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "14": {
      "title": "7 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "15": {
      "title": ": «لا يدخل أحد الجنة إلا أري مقعده من النار، ليزداد شكرا ولا يدخل النار أحد إلا أري مقعده من",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "16": {
      "title": "8 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "17": {
      "title": ": «إذا صلى أحدكم للناس، فليخفف فإن فيهم الضعيف، وإن فيهم السقيم، وإن فيهم الكبير، وإذا صلى",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "18": {
      "title": "9 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "19": {
      "title": ": «لا يصل أحدكم في الثوب الواحد ليس على عاتقه منه شيء»",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "20": {
      "title": "10 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "21": {
      "title": ": «لكل نبي دعوة يستجاب له، وأريد إن شاء الله أن أختبئ دعوتي شفاعة لأمتي في",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "22": {
      "title": "11 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 3
    },
    "23": {
      "title": ": «تجدون من شرار الناس ذا الوجهين، الذي يأتي هؤلاء بوجه، ms2 وهؤلاء بوجه»",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "24": {
      "title": "12 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "25": {
      "title": "أحدكم في الصلاة ما دام في مصلاه، لا يحبسه، ولا يمنعه تقلبه إلى أهله إلا انتظار",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "26": {
      "title": "13 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "27": {
      "title": "، لو تعلمون ما أعلم لضحكتم قليلا ولبكيتم كثيرا»",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "28": {
      "title": "14 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "29": {
      "title": ": «اصنع المعروف إلى من هو أهله، وإلى من ليس أهله، فإن كان أهله فهو أهله، وإن لم يكن أهله،",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "30": {
      "title": "15 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "31": {
      "title": ": «أكمل المؤمنين إيمانا أحسنهم خلقا، وخيركم خيركم لنسائه»",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "32": {
      "title": "16 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "33": {
      "title": ": «بعثت برفع قوم ووضع آخرين»",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "34": {
      "title": "17 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "35": {
      "title": ": «المدينة مهاجري، وفيها قبري،",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "36": {
      "title": "18 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 4
    },
    "37": {
      "title": ": «المدينة ms3 مهاجري، وفيها قبري»",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "38": {
      "title": ": «صلاة الليل مثنى مثنى، فإذا خشيت الصبح فواحدة»",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "39": {
      "title": "19 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "40": {
      "title": "صاد أرنبا، فذبحها بمروة، فتعلقها بيده، فسأل عنها رسول الله صلى الله عليه وسلم «فأمر",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "41": {
      "title": "20 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "42": {
      "title": ": «إن الإسلام بدأ غريبا، وسيعود غريبا كما بدأ»",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "43": {
      "title": "21 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "44": {
      "title": ": «لا تكن لعانا»",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "45": {
      "title": "22 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "46": {
      "title": "يصلي قبل المغرب ركعتين وركعتين بعدها»",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "47": {
      "title": "23 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "48": {
      "title": "الله عز وجل لا يقبض العلم انتزاعا ينتزعه من الناس، ولكن يقبضه بقبض العلماء، حتى إذا لم",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "49": {
      "title": "24 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 5
    },
    "50": {
      "title": ": «من أتى الجمعة، فليغتسل»",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "51": {
      "title": "25 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "52": {
      "title": "بعثهم في سرية، فبلغت سهمانهم اثني عشر بعيرا، ونفلنا بعيرا بعيرا»",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "53": {
      "title": "26 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "54": {
      "title": ": \" يحشر المتكبرون في صور كالذر، تعلوهم الصغار، ويساقون إلى نهر يقال له: بولس، يعلوه نار",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "55": {
      "title": "27 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "56": {
      "title": ": «صليت خلف رسول الله صلى الله عليه وسلم أنا ويتيم، وصلت وراءنا أم سليم رضي الله",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
