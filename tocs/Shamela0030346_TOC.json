    "12": {
      "title": ": «لقد رأيت النبي صلى الله عليه وسلم يلتوي ما يجد ما يملأ بطنه من الدقل، وما ترضون إلا ألوان",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
