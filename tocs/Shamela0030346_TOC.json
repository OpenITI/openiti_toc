    },
    "44": {
      "title": ": «إنه ليس من عبد يلقى الله عز وجل لا يشرك به شيئا لم يتند بدم حرام إلا دخل من أي أبواب",
      "level": 1,
      "parent": null,
      "start_ms": 8,
