      "end_ms": 3
    },
    "18": {
      "title": ": «إن الله عز وجل حيي كريم يستحيي أن يرفع العبد يديه أن يردهما صفرا حتى يضع فيهما",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
