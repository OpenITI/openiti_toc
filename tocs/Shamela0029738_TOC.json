    },
    "2": {
      "title": ": رحمك الله أبا بكر، كنت إلف رسول الله صلى الله عليه وسلم وأنيسه، ومستراحه وثقته، وموضع سره",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 3
    },
    "3": {
      "title": "2 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "4": {
      "title": "كتاب الله القصاص \".",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "5": {
      "title": "3 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 4
    },
    "6": {
      "title": "رجلا سرق بردة، فرفعه إلى النبي صلى الله عليه وسلم فأمر بقطعه، فقال: \" يا رسول الله , قد",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "7": {
      "title": "4 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "8": {
      "title": ": «لا يصوم عبد يوما في سبيل الله إلا باعد الله بذلك اليوم النار عن وجهه سبعين",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "9": {
      "title": "5 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 5
    },
    "10": {
      "title": ": «الغسل يوم الجمعة» .",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "11": {
      "title": "6 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "12": {
      "title": ": «ليس على المسلم في فرسه ولا مملوكه صدقة» .",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "13": {
      "title": "7 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "14": {
      "title": ": أسلم أناس من عرينة، فاجتووا المدينة، فقال لهم رسول الله صلى الله عليه وسلم: «لو خرجتم إلى",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 6
    },
    "15": {
      "title": "8 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "16": {
      "title": "حيا من العرب اجتووا المدينة، فقال لهم النبي صلى الله عليه وسلم: «لو خرجتم إلى إبلنا فأصبتم",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "17": {
      "title": "9 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "18": {
      "title": ": «غزا مع رسول الله صلى الله عليه وسلم ست عشرة غزوة» .",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 7
    },
    "19": {
      "title": "10 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "20": {
      "title": "«كان يعرض راحلته ويصلي إليها» .",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "21": {
      "title": "11 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "22": {
      "title": "اليدين يسجدان كما يسجد الوجه، فإذا وضع أحدكم وجهه فليضع يديه، وإذا رفعه",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "23": {
      "title": "12 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "24": {
      "title": ": إذا أكل أحدكم فليأكل بيمينه، وإذا شرب فليشرب بيمينه , فإن الشيطان يأكل بشماله ويشرب",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "25": {
      "title": "13 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "26": {
      "title": ": \" خمس لا جناح في قتلهن على من قتلهن في الحل والحرم: العقرب، والفأرة، والغراب، والحدأة،",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "27": {
      "title": "14 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "28": {
      "title": ": «لا تتركوا النار في بيوتكم حين تنامون»",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "29": {
      "title": "15 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "30": {
      "title": ": «لا تسافر المرأة ثلاثا إلا ومعها ذو محرم»",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "31": {
      "title": "16 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "32": {
      "title": "، فمر برجل وهو ينحر بدنته، وهي باركة، فقال: «ابعثها قياما مقيدة سنة محمد صلى الله عليه",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 8
    },
    "33": {
      "title": "17 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "34": {
      "title": ": «إذا أقيمت الصلاة فلا صلاة إلا المكتوبة» .",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "35": {
      "title": "18 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "36": {
      "title": ": «إني أحبه فأحبه وأحب من يحبه» .",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "37": {
      "title": "19 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "38": {
      "title": "إن أنسا غلام كيس فليخدمك.",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "39": {
      "title": "20 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "40": {
      "title": "يلبي بالحج والعمرة جميعا» .",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 9
    },
    "41": {
      "title": "21 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "42": {
      "title": "، فتوضأ وصبه علي فأفقت، فقلت: \" يا رسول الله كيف أصنع في مالي ولي أخوات؟ فنزلت آية الميراث:",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "43": {
      "title": "22 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "44": {
      "title": "سليكا جاء ورسول الله صلى الله عليه وسلم يخطب فجلس، فأمره النبي صلى الله عليه وسلم أن يصلي",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "45": {
      "title": "23 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 10
    },
    "46": {
      "title": "الحلال بين، وإن الحرام بين، وإن بين ذلك أمورا مشتبهات» .",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "47": {
      "title": "24 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 11
    },
    "48": {
      "title": ": \" لا تسافر امرأة مسيرة يومين ولا ليلتين إلا ومعها ذو محرم أو زوجها، ولا صوم يومين: يوم",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "49": {
      "title": "25 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "50": {
      "title": ": «من أعتق رقبة أعتق الله بكل عضو منها عضوا منه من النار، حتى فرجه بفرجه»",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "51": {
      "title": "26 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "52": {
      "title": ": «من أعتق رقبة أعتق الله بكل إرب إربا منه من النار، حتى باليد اليد، وبالرجل الرجل، وبالفرج",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 12
    },
    "53": {
      "title": "27 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "54": {
      "title": ": «لا تكتبوا عني، ومن كتب عني غير القرآن فليمحه»",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "55": {
      "title": "28 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "56": {
      "title": "، ومن كذب علي متعمدا فليتبوأ مقعده من النار»",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "57": {
      "title": "29 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "58": {
      "title": ": يخرج رجلان من النار فيعرضان على الله عز وجل، يؤمر بهما إلى النار، قال: فيلتفت أحدهما،",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "59": {
      "title": "30 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "60": {
      "title": ": «زجر عن الشرب قائما» .",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "61": {
      "title": "31 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 13
    },
    "62": {
      "title": ": «لا عدوى، ولا طيرة، ويعجبني الفأل الكلمة الطيبة الحسنة» .",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "63": {
      "title": "32 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "64": {
      "title": "، عطس عندك رجلان فشمت أحدهما ولم تشمت الآخر، أو فسمته ولم تشمت الآخر، فقال: «إن هذا حمد الله",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "65": {
      "title": "33 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 15
    },
    "66": {
      "title": ": «اللهم إنك حي لا تموت، وخالق لا تعاب، وبصير لا ترتاب، وصادق لا تكذب، وقاهر لا تغلب، وبدي",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "67": {
      "title": "34 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 16
    },
    "68": {
      "title": "الجساسة بطوله، هكذا في كتابه",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "69": {
      "title": "35 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "70": {
      "title": "حدثني تميم الداري، أن ناسا من قومه كانوا في البحر في سفينة لهم، فانكسرت، فركب بعضهم على",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 17
    },
    "71": {
      "title": "36 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "72": {
      "title": ": \" إني لم أدعكم لرغبة ولا لرهبة نزلت، ولكن تميما الداري أخبرني أن قوما من أهل فلسطين ركبوا",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "73": {
      "title": "37 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 18
    },
    "74": {
      "title": ": \" إن تميما الداري دخل علي اليوم في الهاجرة، أو في الظهيرة، فأخبرني أن بني عم له ألقتهم",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 19
    },
    "75": {
      "title": "38 -",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 20
    },
    "76": {
      "title": ": كانت ليلتي انقلب، فوضع نعليه عند رجليه، ووضع رداءه، وبسط طرف إزاره على فراشه، ولم يلبث",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "77": {
      "title": "39 -",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 21
    },
    "78": {
      "title": ": «من فطر صائما كتب له مثل أجره، إلا أنه لا ينقص من أجر الصائم شيئا، ومن جهز غازيا في سبيل",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 22
    },
    "79": {
      "title": "40 -",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 22
    },
    "80": {
      "title": "عن كسب الإماء» .",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 22
    },
    "81": {
      "title": "41 -",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 23
    },
    "82": {
      "title": "الله ورسوله ينهيانكم عن لحوم الحمر فإنها رجس.",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 23
    },
    "83": {
      "title": "42 -",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 23
    },
    "84": {
      "title": "نذر اعتكاف ليلة في الجاهلية، فأمره النبي صلى الله عليه وسلم أن يعتكف، فلم يعتكف حتى كان",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 24
    },
    "85": {
      "title": "43 -",
      "level": 1,
      "parent": null,
      "start_ms": 24,
      "end_ms": 24
    },
    "86": {
      "title": "عمه غاب عن قتال بدر، فقال: أغيب عن أول قتال قاتل رسول الله صلى الله عليه وسلم المشركين،",
      "level": 1,
      "parent": null,
      "start_ms": 24,
      "end_ms": 25
    },
    "87": {
      "title": "44 -",
      "level": 1,
      "parent": null,
      "start_ms": 25,
      "end_ms": 25
    },
    "88": {
      "title": "عمه غاب عن قتال بدر، فقال: غيبت عن أول قتال قاتله رسول الله صلى الله عليه وسلم المشركين،",
      "level": 1,
      "parent": null,
      "start_ms": 25,
      "end_ms": 25
    },
    "89": {
      "title": "45 -",
      "level": 1,
      "parent": null,
      "start_ms": 25,
      "end_ms": 25
    },
    "90": {
      "title": ": \" غاب أنس بن النضر عن قتال بدر، فقال: غيبت عن أول قتال قاتله رسول الله صلى الله عليه وسلم،",
      "level": 1,
      "parent": null,
      "start_ms": 25,
      "end_ms": null
    }
