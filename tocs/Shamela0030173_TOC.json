    "27": {
      "title": "، ومن يعدل إذا لم أعدل، قد خبت وخسرت إن لم أعدل، قال عمر: يا رسول الله، ائذن لي فيه أضرب",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
