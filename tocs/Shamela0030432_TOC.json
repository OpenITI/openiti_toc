      "title": ": «ما من أحد يسلم علي إلا رد الله إلي روحي حتى أرد عليه السلام»",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "108": {
      "title": "56 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "109": {
      "title": ": «من صام يوما ابتغاء وجه الله باعده الله من جهنم كبعد غراب طار وهو فرخ حتى مات",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "110": {
      "title": "57 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "111": {
      "title": ": «إن من دعوة الأخ للأخ في الله تستجاب»",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "112": {
      "title": "58 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "113": {
      "title": ": «لا ترغبوا عن آبائكم، فمن رغب عن أبيه فإنه كفر»",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "114": {
      "title": "59 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 15
    },
    "115": {
      "title": ": \" إن هؤلاء كانوا عبادا لي يعبدوني ولا يشركوا بي شيئا، ويسد بهم الثغور، ويتقى بهم المكاره،",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "116": {
      "title": "60 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "117": {
      "title": ": «فراش للرجل، وفراش لامرأته، والثالث للضيف، والرابع للشيطان»",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "118": {
      "title": "61 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "119": {
      "title": ": «لا تخيفوا أنفسكم» .",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "120": {
      "title": "62 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "121": {
      "title": ": «إن كان في شيء شفاء ففي شرطة من حجم، أو شربة من عسل، أو كية بنار تصيب الماء، ولا أحب أن",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "122": {
      "title": "63 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "123": {
      "title": ": «ما من غازية تغزو في سبيل الله فيصيبوا غنيمة إلا تعجلوا ثلثي أجرهم من الأجر، ويبقى لهم",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "124": {
      "title": "64 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "125": {
      "title": ": «من عرض عليه طيب فلا يرده، فإنه خفيف المحمل طيب الرائحة»",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "126": {
      "title": "65 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 16
    },
    "127": {
      "title": ": \" من سمع رجلا ينشد في المسجد ضالة فليقل: لا أداها الله إليك، إن المساجد لم تبن",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "128": {
      "title": "66 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "129": {
      "title": "67 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "130": {
      "title": "68 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "131": {
      "title": "69 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "132": {
      "title": ": «كان رسول الله صلى الله عليه وسلم يمص اللسان»",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "133": {
      "title": "70 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "134": {
      "title": "71 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "135": {
      "title": "72 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "136": {
      "title": "73 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "137": {
      "title": ": «ما من قلب إلا وهو بين إصبعين من أصابع الرحمن، إذا شاء أن يقيمه أقامه، وإذا شاء أن يزيغه",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "138": {
      "title": "74 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 17
    },
    "139": {
      "title": "75 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "140": {
      "title": ": \" يا خرقاء، تموتين بفلاة من الأرض، يدفنك خير مؤمن من أهل الأرض يومئذ، فقال له عمر: ومن أنت",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "141": {
      "title": "76 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "142": {
      "title": ": «ألا أخبركم بخمس دنانير أفضلها وأخسها، أفضلها دينار أنفقته على والدتك، ودينار أنفقته على",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "143": {
      "title": "77 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 18
    },
    "144": {
      "title": ": «امكث حتى يأتي القوم» .",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "145": {
      "title": "78 -",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "146": {
      "title": ": «الإيمان بضع وستون، أو بضع وسبعون، أفضلها شهادة أن لا إله إلا الله، وأدناها إماطة الأذى عن",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "147": {
      "title": "79 -",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "148": {
      "title": ": «لا يجزئ ولد والده إلا أن يجده مملوكا فيشتريه ويعتقه»",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "149": {
      "title": "80 -",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 19
    },
    "150": {
      "title": ": «لا تذهب الأيام والليالي حتى تعود أرض العرب مروجا وأنهارا، ويحبس الفرات عن جبل من الذهب،",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "151": {
      "title": "81 -",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "152": {
      "title": ": «إذا لقيتم المشركين في الطريق فلا تبدءوهم بالسلام، واضطروهم إلى أضيقها»",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "153": {
      "title": "82 -",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "154": {
      "title": ": «إنما الدين النصيحة» .",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "155": {
      "title": "83 -",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "156": {
      "title": ": \" من قال حين يمسي: أعوذ بكلمات الله التامة من شر ما خلق، لم يضره لدغة عقرب حتى",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "157": {
      "title": "84 -",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "158": {
      "title": "«إذا قام الرجل من مجلسه ثم جاء فهو أحق به»",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "159": {
      "title": "85 -",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "160": {
      "title": ": «من قام من مجلسه يوم الجمعة ثم عاد فهو أحق به»",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "161": {
      "title": "86 -",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "162": {
      "title": ": «إن الله تعالى لا ينام ولا ينبغي له أن ينام يحفظ القسط ويرفعه، يرفع إليه عمل الليل قبل",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 20
    },
    "163": {
      "title": "87 -",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "164": {
      "title": ": «حين غربت الشمس تدري أين تذهب؟» قال: الله ورسوله أعلم، قال: \" إنها تذهب فتسجد تحت العرش،",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "165": {
      "title": "88 -",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "166": {
      "title": ": «ما عاب رسول الله صلى الله عليه وسلم طعاما قط، إن اشتهى شيئا أكله، وإن لم يشته شيئا",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "167": {
      "title": "89 -",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "168": {
      "title": ": «اتقوا النار ولو بشق تمرة، فإن لم يكن شق تمرة فكلمة طيبة»",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "169": {
      "title": "90 -",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "170": {
      "title": ": \" اقرءوا القرآن من أربعة: من ابن أم عبد، فبدأ به، وأبي بن كعب، ومعاذ بن جبل، وسالم مولى أبي",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "171": {
      "title": "91 -",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "172": {
      "title": ": «ما هلك أهل نبوة حتى يفشو فيهم الربا والزنا»",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "173": {
      "title": "92 -",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "174": {
      "title": ": «يا أبا ذر، تدري فيم ينتطحان؟» قلت: الله ورسوله أعلم، قال: «لكن الله أعلم سيقضي",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 21
    },
    "175": {
      "title": "93 -",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "176": {
      "title": ": «كنا نرى الآية في زمن رسول الله صلى الله عليه وسلم بركة، وأنت ترون الآية",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "177": {
      "title": "94 -",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "178": {
      "title": ": «أنا أحق أن أتجاوز عنه»",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "179": {
      "title": "95 -",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "180": {
      "title": ": «كفر بالله ادعاء إلى نسب لا يعرف، وكفر بالله تبرؤ من نسب وإن دق»",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "181": {
      "title": "96 -",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "182": {
      "title": ": «ما منكم أحد ينجيه عمله» .",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "183": {
      "title": "97 -",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "184": {
      "title": ": «يا مقلب القلوب ثبت قلوبنا على دينك» .",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "185": {
      "title": "98 -",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 22
    },
    "186": {
      "title": ": «لا يموتن أحد إلا وهو حسن الظن بالله عز وجل»",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 22
    },
    "187": {
      "title": "99 -",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 22
    },
    "188": {
      "title": ": «اهتز عرش الرحمن لموت سعد بن معاذ»",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 22
    },
    "189": {
      "title": "100 -",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 22
    },
    "190": {
      "title": ": «والله ما رقدت، ولكن أشياء حدثت بها نفسي حتى والله غمتني، فنظرت في الأشياء كلها، فإذا هي",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 22
    },
    "191": {
      "title": "101 -",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 22
    },
    "192": {
      "title": ": «اللهم من آمن بي وصدقني وعلم أن ما جئت به الحق من عندك فأقل ماله وولده، وحبب إليه لقاءك،",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 22
    },
    "193": {
      "title": "102 -",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 22
    },
    "194": {
      "title": ": «يا أرض ربي وربك الله، أعوذ بالله من شرك وشر ما فيك، وشر ما خلق فيك وشر ما دب عليك، أعوذ",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 22
    },
    "195": {
      "title": "103 -",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 23
    },
    "196": {
      "title": ": «البر حسن الخلق، والإثم ما حاك في نفسك وكرهت أن يعلم الناس»",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 23
    },
    "197": {
      "title": "104 -",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 23
    },
    "198": {
      "title": ": «نزلت في المسافر تصيبه الجنابة فيتيمم ويصلي»",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 23
    },
    "199": {
      "title": "105 -",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 23
    },
    "200": {
      "title": ": «إن هذا الإحصاء شديد»",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 23
    },
    "201": {
      "title": "106 -",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 23
    },
    "202": {
      "title": ": \" صليت بغير وضوء {ولم يصروا على ما فعلوا وهم يعلمون} [آل عمران: 135] فأتى المطهرة فتوضأ ثم",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 23
    },
    "203": {
      "title": "107 -",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 23
    },
    "204": {
      "title": ": «يا عمر، قم فأطعمهم» ، فقال عمر: يا رسول الله، ما عندي إلا تمر هو قوت عيالي، قال: «قم فأطعمهم»",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 23
    },
    "205": {
      "title": "108 -",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 23
    },
    "206": {
      "title": ": \" إذا استقر أهل الجنة في الجنة اشتاق الإخوان إلى الإخوان، فيسير سرير ذا إلى ذا، فيلتقيان",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 24
    },
    "207": {
      "title": "109 -",
      "level": 1,
      "parent": null,
      "start_ms": 24,
      "end_ms": 24
    },
    "208": {
      "title": ": «صلى بنا رسول الله صلى الله عليه وسلم في ثوب واحد متوشحا به»",
      "level": 1,
      "parent": null,
      "start_ms": 24,
      "end_ms": 24
    },
    "209": {
      "title": "110 -",
      "level": 1,
      "parent": null,
      "start_ms": 24,
      "end_ms": 24
    },
    "210": {
      "title": ": «كنا نصلي مع رسول الله صلى الله عليه وسلم الجمعة، ثم ننصرف وليس للحيطان فيء نستظل",
      "level": 1,
      "parent": null,
      "start_ms": 24,
      "end_ms": 24
    },
    "211": {
      "title": "111 -",
      "level": 1,
      "parent": null,
      "start_ms": 24,
      "end_ms": 24
    },
    "212": {
      "title": "112 -",
      "level": 1,
      "parent": null,
      "start_ms": 24,
      "end_ms": 24
    },
    "213": {
