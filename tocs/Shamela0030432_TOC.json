      "end_ms": 3
    },
    "20": {
      "title": ": \" إذا استقر أهل الجنة في الجنة اشتاق الأخوان، فيسير سرير ذا إلى ذا حتى يلتقيان، فيتحدثان ما",
      "level": 1,
