      "end_ms": 2
    },
    "8": {
      "title": ": «تداووا عباد الله، فإن الله تعالى لم ينزل داء إلا وقد أنزل له شفاء إلا هذا",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "9": {
      "title": "5 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "10": {
      "title": "، ما خير ما أعطي العبد المسلم؟ قال: «خلق حسن»",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "11": {
      "title": "6 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "12": {
      "title": "يصلي حافيا وناعلا وقائما وقاعدا، وينفتل عن يمينه وعن شماله»",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "13": {
      "title": "7 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "14": {
      "title": ": «ليس فيما دون خمس أواق صدقة , وليس فيما دون خمس ذود صدقة»",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "15": {
      "title": "8 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "16": {
      "title": ": «من مات وفي يده ريح غمر فأصابه شيء , فلا يلومن إلا نفسه»",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "17": {
      "title": "9 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "18": {
      "title": "ما أنزل الله من داء إلا أنزل له شفاء»",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
