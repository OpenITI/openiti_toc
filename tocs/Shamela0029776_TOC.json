      "end_ms": 6
    },
    "46": {
      "title": ": «إذا كان يوم الجمعة كان على كل باب من أبواب المسجد ملائكة , يكتبون الناس؛ الأول فالأول",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
