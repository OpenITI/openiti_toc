      "start_ms": 6,
      "end_ms": 6
    },
    "48": {
      "title": ": «لا يكلم أحد في سبيل الله، والله أعلم بمن يكلم في سبيله، إلا جاء يوم القيامة وجرحه يثغب",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
