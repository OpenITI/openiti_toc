    },
    "52": {
      "title": ": «إذا هم عبدي بحسنة فاكتبوها له , فإن عملها فاكتبوها عشرة أمثالها , وإن هم بسيئة فلا",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
