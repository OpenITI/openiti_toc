      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "39": {
      "title": "20 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "40": {
      "title": ": «كن نساء من المؤمنات يصلين مع النبي صلى الله عليه وسلم الصبح متلفعات بمروطهن ثم يرجعن إلى",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "41": {
      "title": "21 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "42": {
      "title": "إذا افتتح الصلاة رفع يديه حتى يحاذي منكبيه، وإذا أراد أن يركع، وبعدما يرفع من الركوع",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
