    },
    "22": {
      "title": ": «الراحمون يرحمهم الرحيم , ارحموا أهل الأرض , يرحمكم أهل السماء»",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "23": {
      "title": "12 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "24": {
      "title": "يأمرنا إذا كنا سفرا أو مسافرين أن لا ننزع خفافنا ثلاثة أيام وليالهن إلا من جنابة , لكن من",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
