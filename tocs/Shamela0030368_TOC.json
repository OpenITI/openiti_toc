{
  "filename": "0258IbnYahyaNaysaburi.Juz.Shamela0030368-ara1",
  "sections": {
    "1": {
      "title": "1 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 2
    },
    "2": {
      "title": ": «لا تحاسدوا، ولا تقاطعوا، ولا تدابروا، وكونوا عباد الله إخوانا، ولا يحل لمسلم أن يهجر أخاه",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "3": {
      "title": "2 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "4": {
      "title": "«دخل مكة في عمرة القضاء وعبد الله بن رواحة بين يديه» .",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "5": {
      "title": "3 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "6": {
      "title": ": \" فرضت على رسول الله صلى الله عليه وسلم، ليلة أسري به الصلوات خمسين، ثم نقصت حتى جعلت خمسا،",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "7": {
      "title": "4 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "8": {
      "title": ": «لو أعلم أن هذا ينتظرني حتى آتيه، لطعنت بالمدرى في عينيه، وهل جعل الاستئذان إلا من أجل",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "9": {
      "title": "5 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "10": {
      "title": ": «لا صلاة لمن لم يقرأ بأم القرآن فصاعدا»",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "11": {
      "title": "6 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 3
    },
    "12": {
      "title": ": «على رسلكما إنها صفية بنت حيي» .",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "13": {
      "title": "7 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "14": {
      "title": ": «ألا أرى هذا يعلم ما هاهنا، لا يدخلن عليكن هذا» .",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "15": {
      "title": "8 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "16": {
      "title": ": «كان رسول الله صلى الله عليه وسلم إذا اعتكف لم يدخل البيت إلا لحاجة",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "17": {
      "title": "9 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "18": {
      "title": ": «من أنفق زوجين من ماله في سبيل الله عز وجل دعي من أبواب الجنة، وللجنة أبواب فمن كان من أهل",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "19": {
      "title": "10 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 4
    },
    "20": {
      "title": ": «لولا أن أشق على أمتي لأمرتهم بالسواك مع كل وضوء»",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "21": {
      "title": "11 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "22": {
      "title": ": «كل عمل ابن آدم له إلا الصيام، الصيام لي وأنا أجزي به، وخلوف الصائم عند الله أطيب من ريح",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "23": {
      "title": "12 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "24": {
      "title": ": «إذا استيقظ أحدكم من الليل، فلا يدخل يده في الإناء حتى يفرغ عليها الماء مرتين أو ثلاثا،",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "25": {
      "title": "13 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "26": {
      "title": ": \" إذا قال الإمام {غير المغضوب عليهم ولا الضالين} [الفاتحة: 7] فقولوا: آمين، فإن الملائكة",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "27": {
      "title": "14 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "28": {
      "title": ": «إذا أقيمت الصلاة فلا تأتوها تسعون، ولكن ائتوها تمشون وعليكم السكينة، فما أدركتم فصلوا،",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "29": {
      "title": "15 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "30": {
      "title": ": «لا يبيع حاضر لباد، ولا تناجشوا، ولا يبيع الرجل على بيع أخيه، ولا يخطب على خطبته، ولا تسأل",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "31": {
      "title": "16 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "32": {
      "title": ": «من أكل هذه الشجرة» يعني الثوم «فلا يؤذينا في مسجدنا»",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "33": {
      "title": "17 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 5
    },
    "34": {
      "title": ": «إن كان جامدا فألقوها وما حولها، وإن كان مائعا فلا تقربوه»",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "35": {
      "title": "18 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "36": {
      "title": ": «من كان يؤمن بالله واليوم الآخر فليكرم ضيفه، ومن كان يؤمن بالله واليوم الآخر فلا يؤذين",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "37": {
      "title": "19 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "38": {
      "title": ": «أولكلكم ثوبان» .",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "39": {
      "title": "21 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "40": {
      "title": ": «إني لأستغفر الله عز وجل في اليوم وأتوب إليه سبعين مرة»",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "41": {
      "title": "22 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "42": {
      "title": ": «كل شراب أسكر حرام»",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "43": {
      "title": "23 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "44": {
      "title": ": «الرؤيا من الله عز وجل، والحلم من الشيطان، فإذا حلم أحدكم حلما يكرهه فليبصق ثلاث بصقات،",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "45": {
      "title": "24 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 6
    },
    "46": {
      "title": ": «أنا الرحمن، خلقت الرحم، وشققت لها اسما من اسمي، فمن وصلها وصلته، ومن قطعها",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "47": {
      "title": "25 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "48": {
      "title": ": «سأل سعد بن عبادة رسول الله صلى الله عليه وسلم عن نذر كان على أمه فأمره",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "49": {
      "title": "26 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "50": {
      "title": ": \" جئت إلى النبي صلى الله عليه وسلم في حجة الوداع، أو قال: يوم الفتح، وهو يصلي وأنا والفضل",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "51": {
      "title": "27 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "52": {
      "title": ": «لا تدخل الملائكة بيتا فيه كلب ولا صورة تماثيل»",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "53": {
      "title": "28 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "54": {
      "title": ": \" خمس من الفطرة: الاستحداد، والختان، وقص الشارب، ونتف الإبط، وتقليم",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "55": {
      "title": "29 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "56": {
      "title": ": «الإيمان بالله» قال: ثم ماذا؟ قال: «ثم الجهاد في سبيل الله» قال: ثم ماذا؟ قال: «ثم حج",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "57": {
      "title": "30 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "58": {
      "title": ": \" لا حسد إلا على اثنتين: رجل آتاه الله القرآن فهو يقوم به آناء الليل وآناء النهار، ورجل",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "59": {
      "title": "31 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "60": {
      "title": ": «دعه فإن الحياء من الإيمان»",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "61": {
      "title": "32 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 7
    },
    "62": {
      "title": ": «من أعتق شركا له في عبد أقيم عليه ما بقي في ماله»",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "63": {
      "title": "33 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "64": {
      "title": "«كان إذا عجل به السير جمع بين المغرب والعشاء»",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "65": {
      "title": "34 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "66": {
      "title": ": «نعم، وتوضأ وضوءك للصلاة»",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "67": {
      "title": "35 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "68": {
      "title": "\" كان إذا افتتح الصلاة رفع يديه حذو منكبيه، وإذا أراد أن يركع فعل مثل ذلك، وإذا رفع رأسه من",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "69": {
      "title": "36 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "70": {
      "title": ": «صلاة الليل مثنى، فإذا خفت الصبح فواحدة توتر بها»",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "71": {
      "title": "37 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "72": {
      "title": ": «لا تتركوا النار في بيوتكم حين تنامون»",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "73": {
      "title": "38 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "74": {
      "title": ": \" خمس تجب للمسلم على أخيه: رد السلام، وتشميت العاطس، وعيادة المرضى، واتباع الجنائز، وإجابة",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "75": {
      "title": "39 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "76": {
      "title": ": «لا ألفينكم ترجعون بعدي كفارا، يضرب بعضكم رقاب بعض، ومن صلى الصبح فهو في ذمة الله، ومن",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 8
    },
    "77": {
      "title": "40 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "78": {
      "title": ": «هذا كهذ الشعر، لكن رسول الله صلى الله عليه وسلم كان يقرأ النظائر عشرين سورة من المفصل",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "79": {
      "title": "41 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "80": {
      "title": ": «أعطني نمرتك، وخذ نمرتي» .",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "81": {
      "title": "42 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "82": {
      "title": ": «رأيت رسول الله صلى الله عليه وسلم إذا سجد وضع ركبتيه قبل يديه، وإذا نهض رفع يديه قبل",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "83": {
      "title": "43 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "84": {
      "title": ": «جاءت فاطمة إلى رسول الله صلى الله عليه وسلم تشتكي مجلا بيديها، فأمرها رسول الله صلى الله",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "85": {
      "title": "44 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 9
    },
    "86": {
      "title": ": «أي سعد ألم تسمع ما قال أبو حباب» يريد عبد الله بن أبي «قال كذا وكذا» قال: اعف عنه يا رسول",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "87": {
      "title": "45 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "88": {
      "title": ": «أسلمت على ما سلف لك من خير»",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "89": {
      "title": "46 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "90": {
      "title": ": «هل ترون ما أرى؟» قالوا: لا.",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "91": {
      "title": "47 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "92": {
      "title": ": «خذوا من العمل ما تطيقون، فالله لا يسأم حتى تسأموا»",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "93": {
      "title": "48 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 10
    },
    "94": {
      "title": ": \" كان المنافقون يجلسون عند رسول الله صلى الله عليه وسلم، ثم يخرجون، فيقولون: ماذا قال آنفا ،",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "95": {
      "title": "49 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "96": {
      "title": "«تزوج ميمونة وهو محرم»",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "97": {
      "title": "50 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "98": {
      "title": ": «هل في نفسك من أمر الجاهلية؟» قال: لا.",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "99": {
      "title": "51 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "100": {
      "title": ": «فضل الصلاة بالسواك على الصلاة بغير السواك سبعون ضعفا»",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "101": {
      "title": "52 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "102": {
      "title": ": «لم أر رسول الله صلى الله عليه وسلم يصلي قاعدا، حتى كان قبل موته بعام أو اثنين، فكان يصلي",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "103": {
      "title": "53 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "104": {
      "title": "«صلى في بيته سبحة الضحى فقاموا وراءه فصلوا»",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "105": {
      "title": "54 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "106": {
      "title": ": \" رأيت رسول الله صلى الله عليه وسلم يقسم لحما بالجعرانة، وأنا غلام شاب، فأقبلت امرأة، فلما",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "107": {
      "title": "55 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "108": {
      "title": "«نهى عن الزبيب والتمر»",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "109": {
      "title": "56 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 11
    },
    "110": {
      "title": ": «مثل المجاهد في سبيل الله، والله أعلم بمن يجاهد في سبيله، أن يتوفاه فيدخله الجنة، أو يرجعه",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "111": {
      "title": "57 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "112": {
      "title": "«كان يعتكف العشر الأواخر من رمضان حتى قبضه الله عز وجل»",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "113": {
      "title": "58 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "114": {
      "title": ": «إن الرجل من أهل الجنة ليشرف على أهل الجنة كأنه كوكب دري، وإن أبا بكر وعمر منهم،",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "115": {
      "title": "59 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "116": {
      "title": ": \" بينما أنا نائم رأيت الناس يعرضون علي وعليهم قمص منها ما يبلغ الثدي، ومنها ما يبلغ دون",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "117": {
      "title": "60 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "118": {
      "title": ": «وهل ترك لنا عقيل بن أبي طالب شيئا» ثم قال: «لا يرث المسلم الكافر، ولا الكافر المسلم» ثم قال:",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "119": {
      "title": "61 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 12
    },
    "120": {
      "title": ": «ألا تصلون؟» فقلت: يا رسول الله، إنما أنفسنا بيد الله عز وجل، فإذا شاء أن يبعثنا بعثنا،",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "121": {
      "title": "62 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "122": {
      "title": ": «هذه آخر سورة سمعت رسول الله صلى الله عليه وسلم يقرأ بها في المغرب»",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "123": {
      "title": "63 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "124": {
      "title": ": «إذا قلت لأخيك أنصت، والإمام يخطب فقد لغوت»",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "125": {
      "title": "64 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "126": {
      "title": ": «صلاة في مسجدي هذا خير من ألف صلاة في غيره من المساجد إلا المسجد الحرام»",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "127": {
      "title": "65 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "128": {
      "title": "«كان أجود الناس، وأجود ما يكون في رمضان، حين يلقاه جبريل، وكان يلقاه في كل ليلة في رمضان،",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "129": {
      "title": "66 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "130": {
      "title": ": «إن له دسما»",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "131": {
      "title": "67 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "132": {
      "title": ": «أقرأني جبريل فراجعته، فلم أستزيده، ويزيدني، فانتهى إلى سبعة» قال الزهري: وإنما حده في",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 13
    },
    "133": {
      "title": "68 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "134": {
      "title": ": «خير نسائها مريم بنت عمران، وخير نسائها خديجة»",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "135": {
      "title": "69 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "136": {
      "title": ": «وعندك؟» قال: قلت: نعم، بنت حمزة.",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "137": {
      "title": "70 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "138": {
      "title": ": «والذي فلق الحبة، وبرأ النسمة إنه لعهد النبي صلى الله عليه وسلم إلي أن لا يحبك إلا مؤمن،",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "139": {
      "title": "71 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "140": {
      "title": ": «أرسله، اقرأ يا هشام» فقرأ عليه القراءة التي سمعتها، فقال النبي صلى الله عليه وسلم: «هكذا",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "141": {
      "title": "72 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 14
    },
    "142": {
      "title": ": «ما رأيت رسول الله صلى الله عليه وسلم يصلي في بيت أم سلمة في ثوب واحد واضعا طرفيه على",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "143": {
      "title": "73 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "144": {
      "title": ": «في الجنة شجرة يسير الراكب في ظلها مائة سنة لا يقطعها»",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "145": {
      "title": "74 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "146": {
      "title": ": «لو تعلمون ما أعلم لضحكتم قليلا، ولبكيتم كثيرا»",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "147": {
      "title": "75 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "148": {
      "title": ": «لما قضى الله الخلق، كتب كتابا فهو تحت العرش إن رحمتي سبقت غضبي»",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "149": {
      "title": "76 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "150": {
      "title": ": «إن لله عز وجل تسعة وتسعين اسما، مائة غير واحد من أحصاها كلها دخل الجنة، إنه وتر يحب",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "151": {
      "title": "77 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "152": {
      "title": ": «إذا نظر أحدكم إلى من فضل عليه في المال والخلق، فلينظر إلى من هو دونه ممن فضل هو",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "153": {
      "title": "78 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "154": {
      "title": ": «إن الذي يجر ثوبه من الخيلاء لا ينظر الله إليه يوم القيامة»",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "155": {
      "title": "79 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "156": {
      "title": "«كان يدخل مكة من الثنية العليا، ويخرج من الثنية السفلى»",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "157": {
      "title": "80 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 15
    },
    "158": {
      "title": "، «فرض زكاة الفطر صاعا من تمر أو صاعا من شعير على كل عبد أو حر، صغير أو",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "159": {
      "title": "81 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "160": {
      "title": "\" رأى النبي صلى الله عليه وسلم يصلي على ناقته، أو قال: على بعيره النوافل في كل",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "161": {
      "title": "82 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "162": {
      "title": ": «أكل بنيك نحلت مثل هذا؟» قال: لا.",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "163": {
      "title": "83 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "164": {
      "title": ": «صدق رؤياك» ، فسجد على جبهته",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "165": {
      "title": "84 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "166": {
      "title": "«صلى بهم، فسها في صلاته، فسجد سجدتي السهو ثم تشهد ثم سلم»",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "167": {
      "title": "85 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "168": {
      "title": ": «إذا سمعتم النداء فقولوا مثل ما يقول المنادي»",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "169": {
      "title": "86 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "170": {
      "title": ": «لا بل دعه» قال: قلت: وإن قطع يدي؟ قال: «وإن فعل» فراجعته مرتين أو ثلاثا، فقال النبي صلى الله",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 16
    },
    "171": {
      "title": "87 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "172": {
      "title": ": «من صلى البردين دخل الجنة»",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "173": {
      "title": "88 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "174": {
      "title": ": «من وفى فأجره على الله، ومن أصاب من ذلك شيئا، فعوقب به في الدنيا، فهو طهرة له» أو قال:",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "175": {
      "title": "89 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "176": {
      "title": ": «ألا أخبركم بخير لكم من الصيام والصدقة، صلاح ذات البين، وإياكم والبغضة فإنها هي",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "177": {
      "title": "90 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "178": {
      "title": ": \" جاءت الجدة إلى أبي بكر رضي الله عنه، تسأله ميراثها فقال: ما لك في كتاب الله عز وجل شيء،",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "179": {
      "title": "91 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 17
    },
    "180": {
      "title": "، \" أن النبي صلى الله عليه وسلم جاءه رجل فقال: يا رسول الله إن أخي مات، فقم فصل عليه، فقام",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "181": {
      "title": "92 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "182": {
      "title": ": «توفي النبي صلى الله عليه وسلم وأنا ابن خمس عشرة، مختونا»",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "183": {
      "title": "93 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "184": {
      "title": ": «إن كنت لآتي البيت، وفيه المريض فما أسأل عنه إلا وأنا مارة وهي معتكفة، وإن كان رسول الله",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "185": {
      "title": "94 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "186": {
      "title": ": «من صام رمضان ثم أتبعه بست من شوال كان كمن صام السنة»",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "187": {
      "title": "95 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "188": {
      "title": "«نهى أن يدخل الرجل الماء إلا بإزار»",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "189": {
      "title": "96 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "190": {
      "title": ": \" كان رسول الله صلى الله عليه وسلم يقرأ في الركعتين اللتين يوتر بعدهما ب {سبح اسم ربك",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "191": {
      "title": "97 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "192": {
      "title": "98 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 18
    },
    "193": {
      "title": "99 -",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "194": {
      "title": "«نهى الرجال والنساء عن دخول الحمامات، ثم رخص للرجال أن يدخلوها بالمآزر»",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "195": {
      "title": "100 -",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "196": {
      "title": ": «ادخلوا» قالا: كلنا يا أم المؤمنين؟ قالت: «نعم، ادخلوا كلكم» ولا تعلم عائشة أن معهم ابن",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 18
    },
    "197": {
      "title": "101 -",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 19
    },
    "198": {
      "title": "102 -",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "199": {
      "title": ": «لا حمى إلا لله ولرسوله»",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "200": {
      "title": "103 -",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "201": {
      "title": ": «ليبعثن الله أقواما على منابر من نور، يغبطهم الناس، ليسوا بأنبياء ولا شهداء» فقام أعرابي،",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "202": {
      "title": "104 -",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "203": {
      "title": ": «ادعوا لي ابن أبي ربيعة» فقال: «هذا مالك، فبارك الله لك في مالك، إنما جزاء السلف الوفاء",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "204": {
      "title": "105 -",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 20
    },
    "205": {
      "title": ": «إذا سمعتم به في أرض فلا تقدموا عليه، وإذا وقع بأرض وأنتم بها، فلا تخرجوا فرارا منه» قال:",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "206": {
      "title": "106 -",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "207": {
      "title": "107 -",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "208": {
      "title": ": «من أصاب دما أقيم عليه الحد في ذلك فهو كفارة»",
