    },
    "2": {
      "title": "كلمات أقولهن عند الكرب: لا إله إلا الله الحليم الكريم، سبحان الله رب السماوات السبع ورب",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "3": {
      "title": "2 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "4": {
      "title": "، كن في الدنيا كأنك غريب، أو عابر سبيل، وعد نفسك في الموتى \".",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "5": {
      "title": "3 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "6": {
      "title": ": \" {يوم يقوم الناس لرب العالمين} [المطففين: 6] ، قال: يقومون في الرشح إلى أطراف",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "7": {
      "title": "4 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "8": {
      "title": "الله عز وجل أعطى ملكا من الملائكة أسماع الخلق، فهو قائم على قبري إلى يوم القيامة، لا يصلي",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 2
    },
    "9": {
      "title": "5 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "10": {
      "title": ": \" أول جمعة جمعت في الإسلام جمعت بالمدينة، والثانية بأرض البحرين، في قرية يقال لها:",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "11": {
      "title": "6 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "12": {
      "title": "الله لعن على لسان نبيه صلى الله عليه وسلم المتشبهات بالرجال من النساء، والمتشبهين من",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "13": {
      "title": "7 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "14": {
      "title": ": \" مثلي ومثل الأنبياء، كمثل رجل ابتنى بنيانا، فأجملها، وأحسنها، وبقي في زاوية من زواياها",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "15": {
      "title": "8 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "16": {
      "title": "مثلي ومثلكم، كمثل رجل استوقد نارا، فجعلت هذه الدواب والفراش تقعن فيها، وجعلن يغلبنه، وأنا",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "17": {
      "title": "9 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "18": {
      "title": ": «من كذب علي متعمدا، فليتبوأ مقعده من النار»",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "19": {
      "title": "10 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 3
    },
    "20": {
      "title": "، «لا نكاح إلا بولي»",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "21": {
      "title": "11 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "22": {
      "title": ": «إذا كان خمس كان خمس، إذا كان الربا كان الخسف، وإذا جار الحاكم قحط المطر، وإذا ضيعت الزكاة",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "23": {
      "title": "12 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "24": {
      "title": ": \" خرج رجل من المسجد بعدما نودي للصلاة، فقال أبو هريرة: أما هذا، فقد عصى أبا القاسم صلى الله",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "25": {
      "title": "13 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "26": {
      "title": ": «من لقي الله عز وجل يشهد أن لا إله إلا الله من نفس يقين، دخل الجنة»",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "27": {
      "title": "14 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "28": {
      "title": ": \" قام عبد الله على الصدع الذي في الصفا، فقال له رجل: ههنا يا أبا عبد الرحمن؟ قال: هذا والذي",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "29": {
      "title": "15 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "30": {
      "title": "أذن، فتتبع فاه ههنا وههنا، والتفت يمينا وشمالا» .",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 4
    },
    "31": {
      "title": "16 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "32": {
      "title": ": «من اشترى شاة مصراة ولم يبين، فالمشتري بالخيار ثلاثة أيام، إن شاء ردها، وصاعا من",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "33": {
      "title": "17 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "34": {
      "title": ": \" أصاب الناس ظلمة ومطر على عهد رسول الله صلى الله عليه وسلم، فأمر بلالا، فنادى: صلوا في",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "35": {
      "title": "18 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "36": {
      "title": ": الكبرياء ردائي، والعظمة إزاري، فمن نازعني واحدا منهما أدخلته النار \"",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "37": {
      "title": "19 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "38": {
      "title": ": «كنا نؤمر بالسواك إذا قمنا من الليل»",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "39": {
      "title": "20 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "40": {
      "title": "إذا خرج، قال: «اللهم إني أعوذ بك أن أضل أو أضل، أو أزل أو أزل، أو أن أظلم أو أن أظلم، أو",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "41": {
      "title": "21 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "42": {
      "title": "الله عز وجل يملي للظالم، وقال مرة: يمهل للظالم حتى إذا أخذه لم يفلته، ثم قرأ: {وكذلك أخذ",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 5
    },
    "43": {
      "title": "22 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "44": {
      "title": ": «لا سبق إلا في خف، أو حافر»",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "45": {
      "title": "23 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "46": {
      "title": "\" {فلنحيينه حياة طيبة} [النحل: 97] ، قال: يلبس حلالا، ويأكل حلالا \"",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "47": {
      "title": "24 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "48": {
      "title": "\" {قسم لذي حجر} [الفجر: 5] ، قال: لذي عقل \"",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "49": {
      "title": "25 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "50": {
      "title": ": «لذي ستر»",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "51": {
      "title": "26 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "52": {
      "title": "بنيت دارا، وأنا أحب أن تدخلها، وتدعو لي بالبركة، قال: فقام الحسن، وقمنا معه، فدخل سرية،",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "53": {
      "title": "27 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "54": {
      "title": ": «أول قطرة من دم الأضحية كفارة لأربعة آلاف خطيئة»",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "55": {
      "title": "28 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "56": {
      "title": "«ليت أمي لم تلدني، نبئت أني وارد، ولم أنبأ أني صادر»",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": null
    }
