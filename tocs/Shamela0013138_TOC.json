      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "116": {
      "title": "\" ثلاث من جاء بهن مع إيمان دخل من أي أبواب الجنة شاء، وزوج من حور العين حيث شاء: من أدى",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "117": {
      "title": "54 -",
      "level": 1,
