      "start_ms": 14,
      "end_ms": 14
    },
    "119": {
      "title": "«من مر على المقابر وقرأ قل هو الله أحد إحدى عشرة مرة، ثم وهب أجره للأموات أعطي من الأجر",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "120": {
      "title": "55 -",
      "level": 1,
