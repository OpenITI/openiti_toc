    },
    "2": {
      "title": "AUTO باب فضل العقل وذم الهوى",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 17
    },
    "3": {
      "title": "AUTO لكل داء دواء يستطب به ... إلا الحماقة أعيت من يداويها",
      "level": 2,
      "parent": 2,
      "start_ms": 12,
      "end_ms": 17
    },
    "4": {
      "title": "AUTO باب أدب العلم",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 63
    },
    "5": {
      "title": "AUTO وقد قالت الحكماء: أصل العلم الرغبة وثمرته السعادة وأصل الزهد",
      "level": 2,
      "parent": 4,
      "start_ms": 29,
      "end_ms": 46
    },
    "6": {
      "title": "AUTO التوفر ويحصل به الاستكثار (والسابع) عدم القواطع المذهلة من",
      "level": 2,
      "parent": 4,
      "start_ms": 46,
      "end_ms": 50
    },
    "7": {
      "title": "AUTO وترى أزهد البرية في الح- ... ج لها أهلها لقرب المكان",
      "level": 2,
      "parent": 4,
      "start_ms": 50,
      "end_ms": 63
    },
    "8": {
      "title": "AUTO باب أدب الدين",
      "level": 1,
      "parent": null,
      "start_ms": 63,
      "end_ms": 99
    },
    "9": {
      "title": "AUTO باب أدب الدنيا",
      "level": 1,
      "parent": null,
      "start_ms": 99,
      "end_ms": 182
    },
    "10": {
      "title": "AUTO وإذ قد بلغ بنا القول إلى ذلك فسنبدأ بذكر ما تصلح به الدنيا",
      "level": 2,
      "parent": 9,
      "start_ms": 103,
      "end_ms": 115
    },
    "11": {
      "title": "AUTO اعلم أن ما به تصلح الدنيا حتى تصير أحوالها منتظمة وأمورها",
      "level": 3,
      "parent": 10,
      "start_ms": 103,
      "end_ms": 104
    },
    "12": {
      "title": "AUTO ما صحة أبدا بنافعة ... حتى يصح الدين والخلق",
      "level": 3,
      "parent": 10,
      "start_ms": 104,
      "end_ms": 108
    },
    "13": {
      "title": "AUTO فأخبر الرشيد بدلك فبكى بكاء شديدا ودعا أبا العتاهية فاستحله",
      "level": 3,
      "parent": 10,
      "start_ms": 108,
      "end_ms": 111
    },
    "14": {
      "title": "AUTO (والغيرة) واسطة بين الحسد وسوء العادة (والظرف) واسطة بين",
      "level": 3,
      "parent": 10,
      "start_ms": 111,
      "end_ms": 113
    },
    "15": {
      "title": "AUTO لا تنس في الصحة أيام السقم ... فإن عقبى تارك الحزم ندم",
      "level": 3,
      "parent": 10,
      "start_ms": 113,
      "end_ms": 114
    },
    "16": {
      "title": "AUTO المواد فقد يتفرع عن أسباب إلهية وهو من نتائج العدل المقترن ms113 بها.",
      "level": 3,
      "parent": 10,
      "start_ms": 114,
      "end_ms": 115
    },
    "17": {
      "title": "AUTO وبحسب ما أختل من قواعدها يكون اختلالها وفسادها.",
      "level": 2,
      "parent": 9,
      "start_ms": 115,
      "end_ms": 127
    },
    "18": {
      "title": "AUTO وأما ما يصلح به حال الإنسان فيها فثلاثة أشياء وهي قواعد",
      "level": 3,
      "parent": 17,
      "start_ms": 115,
      "end_ms": 115
    },
    "19": {
      "title": "AUTO وللنفس آداب هي تمام طاعتها وكمال مصلحتها وقد أفردنا لها من",
      "level": 3,
      "parent": 17,
      "start_ms": 115,
      "end_ms": 127
    },
    "20": {
      "title": "AUTO فبعل يراعيها وخدر يكنها ... وقبر يواريها وأفضلها القبر",
      "level": 2,
      "parent": 9,
      "start_ms": 127,
      "end_ms": 144
    },
    "21": {
      "title": "AUTO فالنار بالماء الذي هو ضدها ... تعطي النضاج وطبعها الإحراق",
      "level": 2,
      "parent": 9,
      "start_ms": 144,
      "end_ms": 182
    },
    "22": {
      "title": "AUTO باب أدب النفس",
      "level": 1,
      "parent": null,
      "start_ms": 182,
      "end_ms": null
    },
    "23": {
      "title": "AUTO منا ما تكن ولم يطاوعها فيما تحب إذا كان غيا ولا صرف عنها ما",
      "level": 2,
      "parent": 22,
      "start_ms": 186,
      "end_ms": 220
    },
    "24": {
      "title": "AUTO وسنذكر من أحوال أدب الرياضة والاستصلاح فصولا تحتوي على ما",
      "level": 3,
      "parent": 23,
      "start_ms": 187,
      "end_ms": 192
    },
    "25": {
      "title": "AUTO وذلك من أوكد أسباب الكرامة وأقوى مواد النعم وأبلغ شافع إلى",
      "level": 3,
      "parent": 23,
      "start_ms": 192,
      "end_ms": 196
    },
    "26": {
      "title": "AUTO فهذه سبعة أسباب أحدثت سوء خلق كان عاما. وههنا سبب خاص يحدث",
      "level": 3,
      "parent": 23,
      "start_ms": 196,
      "end_ms": 200
    },
    "27": {
      "title": "AUTO وإنني لأرى من لا حياء له ... ولا أمانة وسط القوم عريانا",
      "level": 3,
      "parent": 23,
      "start_ms": 200,
      "end_ms": 208
    },
    "28": {
      "title": "AUTO تعفو بعدل وتسطو إن سطوت به ... فلا عدمتك من عاف ومنتقم",
      "level": 3,
      "parent": 23,
      "start_ms": 208,
      "end_ms": 215
    },
    "29": {
      "title": "AUTO نحن نرى قبول السعاية شرا منها لأن السعاية دلالة والقبول",
      "level": 3,
      "parent": 23,
      "start_ms": 215,
      "end_ms": 220
    },
    "30": {
      "title": "AUTO الطيرة وسوء الظن والسحد فإذا تطيرت فلا ترجع وإذا ظننت فلا",
      "level": 2,
      "parent": 22,
      "start_ms": 220,
      "end_ms": null
    },
    "31": {
      "title": "AUTO (الفصل الأول في الكلام والصمت)",
      "level": 3,
      "parent": 30,
      "start_ms": 220,
      "end_ms": 231
    },
    "32": {
      "title": "AUTO فإذا اجتمعت في الأمثال المضروبة هذه الشروط الأربعة كانت",
      "level": 3,
      "parent": 30,
      "start_ms": 231,
      "end_ms": 242
    },
    "33": {
      "title": "AUTO وكل الحادثات إذا تناهت ... فموصول بها ms241 الفرج القريب",
      "level": 3,
      "parent": 30,
      "start_ms": 242,
      "end_ms": 248
    },
    "34": {
      "title": "AUTO فلا تمنحن الرأي من ms247 ليس أهله ... فلا أنت محمود ولا الرأي نافعه",
      "level": 3,
      "parent": 30,
      "start_ms": 248,
      "end_ms": 250
    },
    "35": {
      "title": "AUTO وما السر في قلبي كميت بحفرة ... لأني أرى المدفون ينتظر النشرا",
      "level": 3,
      "parent": 30,
      "start_ms": 250,
      "end_ms": 253
    },
    "36": {
      "title": "AUTO ان الصغيرة الضحك. وقال عمر بن الخطاب رضي الله عنه: من كثر",
      "level": 3,
      "parent": 30,
      "start_ms": 253,
      "end_ms": 256
    },
    "37": {
      "title": "AUTO فلم يلبث إلا أياما حتى قتل شر قتلة وصلب رأسه على قصره ثم",
      "level": 3,
      "parent": 30,
      "start_ms": 256,
      "end_ms": 283
    },
    "38": {
      "title": "AUTO خمسا قبل خمس: شبابك قبل هرمك وصحتك قبل سقمك وغناك قبل فقرك",
      "level": 3,
      "parent": 30,
      "start_ms": 283,
      "end_ms": null
    }
