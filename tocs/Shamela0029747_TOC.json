      "start_ms": 1,
      "end_ms": 1
    },
    "2": {
      "title": ": من لا يشكر القليل لا يشكر الكثير، والتحدث بنعمة الله شكر، والسكوت عنها كفر، والجماعة",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "3": {
      "title": "2 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "4": {
      "title": "يعتكف في العشر الأواخر من رمضان \".",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "5": {
      "title": "3 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 2
    },
    "6": {
      "title": ": من يحسن أن يتكلم بالعربية فلا يتكلمن بالعجمية؛ فإنه يورث النفاق \".",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "7": {
      "title": "4 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "8": {
      "title": ": من أكرم ذا شيبة كأنما قد أكرم نوحا في قومه، ومن أكرم نوحا في قومه فقد أكرم الله عز",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "9": {
      "title": "5 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "10": {
      "title": "أحسني جوار نعم الله عز وجل؛ فإنها قل ما نفرت من قوم فكادت أن ترجع",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "11": {
      "title": "6 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "12": {
      "title": ": أعطاني ربي عز وجل في علي خصالا في الدنيا وخصالا في الآخرة، أعطاني به أنه صاحب لوائي عند",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 3
    },
    "13": {
      "title": "7 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "14": {
      "title": ": «إنه قد أصابت فلانا فاقة فحلت له الصدقة، حتى يصيب سدادا من العيش، فما سوى ذلك من المسألة",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "15": {
      "title": "8 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "16": {
      "title": ": التسبيح للرجال، والتصفيق للنساء في الصلاة \".",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "17": {
      "title": "9 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 4
    },
    "18": {
      "title": "قطع رسول الله صلى الله عليه وسلم يد سارق في مجن \".",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "19": {
      "title": "10 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "20": {
      "title": "وأنا متكئ على قبر، فقال: لا تؤذ صاحب هذا القبر \".",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "21": {
      "title": "11 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "22": {
      "title": ": لا طاعة لمخلوق في معصية الخالق \".",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "23": {
      "title": "12 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "24": {
      "title": ": توضأت أنا ورسول الله صلى الله عليه وسلم من إناء واحد قد أصابت منه الهرة قبل ذلك \".",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 5
    },
    "25": {
      "title": "13 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "26": {
      "title": "أتدري أين تغرب؟ قلت: الله ورسوله أعلم.",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 6
    },
    "27": {
      "title": "14 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "28": {
      "title": ": لا تجلسوا إلى القبور، ولا تصلوا إليها \".",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "29": {
      "title": "16 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "30": {
      "title": "ما رأيناك تركت الصلاة على أحد إلا على هذا.",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 7
    },
    "31": {
      "title": "17 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "32": {
      "title": "لم يكن رسول الله صلى الله عليه وسلم يحجبه شيء من القرآن إلا الجنابة \".",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "33": {
      "title": "18 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "34": {
      "title": ": لو أن أحدكم إذا نزل منزلا قال: أعوذ بكلمات الله التامة من شر ما خلق لم يضره شيء في ذلك",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "35": {
      "title": "19 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "36": {
      "title": "بين الركن اليماني، يقول: \" {ربنا آتنا في الدنيا حسنة وفي الآخرة حسنة وقنا عذاب النار}",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "37": {
      "title": "20 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "38": {
      "title": ": نعمتان مغبون فيهما كثير من الناس، الصحة والفراغ \".",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "39": {
      "title": "21 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 8
    },
    "40": {
      "title": ": من أحب أن يسبق الدائب المجتهد فليكف عن الذنوب \".",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "41": {
      "title": "22 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "42": {
      "title": ": سألت ربي مسألة وددت أني لم أكن سألته، قلت: أي رب قد كان قبلي أنبياء منهم من سخرت له الريح",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "43": {
      "title": "23 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "44": {
      "title": ": هذا صراط الله المستقيم ثم خط سبلا، ثم قال: وليس من هذه السبل سبيل إلا عليه الشيطان يدعو",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "45": {
      "title": "24 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 9
    },
    "46": {
      "title": "، إذا صليت المكتوبة، فقولي: سبحان الله عشرا، والحمد لله عشرا، والله أكبر عشرا، ثم سلي ما",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "47": {
      "title": "25 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "48": {
      "title": "إن بني إسرائيل استخلفوا خليفة عليهم بعد موسى عليه السلام، فقام يصلي في القمراء فوق بيت",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "49": {
      "title": "26 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 10
    },
    "50": {
      "title": ": من جعل قاضيا فقد ذبح بغير سكين \".",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "51": {
      "title": "27 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "52": {
      "title": ": الدنيا سجن المؤمن، وجنة الكافر \".",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "53": {
      "title": "28 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "54": {
      "title": ": جنات الفردوس أربعة، ثنتان من ذهب، وثنتان من فضة , وحليتهما وآنيتهما وما فيهما، وليس بين",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "55": {
      "title": "29 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "56": {
      "title": ": مثل أمتي مثل المطر، لا يدرى أوله خير أو آخره \".",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "57": {
      "title": "30 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 11
    },
    "58": {
      "title": ": بشر المشائين في ظلم الليل إلى المساجد من نور تام يوم القيامة \".",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "59": {
      "title": "31 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "60": {
      "title": ": التأني من الله، والعجلة من الشيطان، وما أحد أكثر معاذير من الله عز وجل \"",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "61": {
      "title": "32 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "62": {
      "title": ": تسمونهم محمدا ثم تسبونهم \"",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "63": {
      "title": "33 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "64": {
      "title": ": إن من حق إجلال الله عز وجل على العباد إكرام حامل القرآن غير الجافي عنه ولا الغالي",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "65": {
      "title": "34 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "66": {
      "title": ": احفظوني في أصحابي وأزواجي وأصهاري \"",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "67": {
      "title": "35 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 12
    },
    "68": {
      "title": ": كلمتان خفيفتان على اللسان ثقيلتان في الميزان حبيبتان إلى الرحمن: سبحان الله وبحمده سبحان",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "69": {
      "title": "36 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "70": {
      "title": "قدم أصحاب النبي صلى الله عليه وسلم الأهواز، فكانوا يصلون في الطرق \"",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "71": {
      "title": "37 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "72": {
      "title": ": \" سيد آي القرآن آية الكرسي: {الله لا إله إلا هو الحي القيوم} [البقرة: 255] \"",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 13
    },
    "73": {
      "title": "38 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "74": {
      "title": "إذا اختلف الناس أن أتخذ سيفا من خشب، وقد اتخذته، فإن شئت خرجت معك.",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "75": {
      "title": "39 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "76": {
      "title": ": إن الله لعن الخمر بعينها، وعاصرها، ومعتصرها، وبائعها، ومشتريها، وحاملها، والمحمولة إليه،",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 14
    },
    "77": {
      "title": "40 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "78": {
      "title": "كانت أموال بني النضير مما أفاء الله عز وجل على رسوله صلى الله عليه وسلم، مما لم يوجف",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "79": {
      "title": "41 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "80": {
      "title": ": من كذب علي متعمدا فليتبوأ مقعده من النار.",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "81": {
      "title": "42 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "82": {
      "title": ": العلم ثلاثة وما سواهن فهو فضل: آية محكمة، أو فريضة عادلة، أو سنة",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "83": {
      "title": "43 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 15
    },
    "84": {
      "title": ": الحمى قطعة من النار، فأبردوها عنكم بالماء البارد.",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "85": {
      "title": "44 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "86": {
      "title": "عن كسر السكة الجائزة إلا من بأس",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "87": {
      "title": "45 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "88": {
      "title": ": أرحم ما يكون الله على عبده إذا وضع في حفرته",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "89": {
      "title": "46 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "90": {
      "title": ": أحب الناس إلى الله عز وجل أولهم دخولا المساجد، وآخرهم خروجا",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "91": {
      "title": "47 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "92": {
      "title": ": من كان عليه دين وهو يريد أداءه فهو في جوار الله عز وجل فأحببت أن أكون في ذمة الله عز",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "93": {
      "title": "48 -",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 16
    },
    "94": {
      "title": "إذا اغتسل من جنابة بدأ فيغسل يديه، ثم يتوضأ كما يتوضأ للصلاة، ثم يغمس يديه في الماء فيخلل",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "95": {
      "title": "49 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "96": {
      "title": ": ليس من البر الصيام في السفر",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "97": {
      "title": "50 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "98": {
      "title": ": من أصبح معافى في بدنه آمنا في سربه عنده قوت يومه فكأنما حيزت له الدنيا، يا ابن جعشم يكفيك",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "99": {
      "title": "51 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "100": {
      "title": ": لكل أمة مجوس، ومجوس هذه الأمة القدرية، إن مرضوا فلا تعودوهم، وإن ماتوا فلا تشهدوهم، وإن",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "101": {
      "title": "52 -",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 17
    },
    "102": {
      "title": ": من أحب أن يجتهد في الدعاء فليقل: اللهم أعني على ذكرك وشكرك وحسن عبادتك",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "103": {
      "title": "53 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "104": {
      "title": "\" {وإذ أخذ ربك من بني آدم من ظهورهم ذريتهم} [الأعراف: 172] .",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "105": {
      "title": "54 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
