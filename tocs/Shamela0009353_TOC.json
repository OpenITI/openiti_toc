    },
    "2": {
      "title": "رجلا مات فدخل الجنة، فقيل له: ما كنت تعمل؟ فإما ذكر وإما ذكر، فقال: إني كنت أبايع الناس",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "3": {
      "title": "2 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 3
    },
    "4": {
      "title": ": «جنتان من ذهب آنيتهما وما فيهما، وجنتان من فضة وآنيتهما وما فيهما، وما بين القوم وبين أن",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "5": {
      "title": "3 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "6": {
      "title": "ليدخل رأسه وهو في المسجد فأرجله، قالت: وكان لا يدخل البيت إلا لحاجة إذا كان",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "7": {
      "title": "4 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 4
    },
    "8": {
      "title": ": من هذا؟ فقلت: أنا.",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "9": {
      "title": "5 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "10": {
      "title": "\" أيصلي الرجل في ثوب واحد؟ ، قال: أوكلكم له ثوبان \".",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "11": {
      "title": "6 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 5
    },
    "12": {
      "title": "«البيعان بالخيار ما لم يتفرقا» .",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "13": {
      "title": "7 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "14": {
      "title": "8 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "15": {
      "title": "عمرو بن مرة، وهو يقول: «إني لأحسبه خير أهل الأرض» .",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 6
    },
    "16": {
      "title": "9 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "17": {
      "title": ": أين المظهر يا أبا ليلى؟ ، فقلت: في الجنة.",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "18": {
      "title": "10-",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 7
    },
    "19": {
      "title": "11 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 8
    },
    "20": {
      "title": ": إلى أين يا أبا ليلى؟ فقلت: إلى الجنة، فقال صلى الله عليه وسلم: إن شاء الله، فأنشدته:",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": null
    }
