{
  "filename": "0622IbnShamsKhilafa.AdabNafica.Shamela0005433-ara1",
  "sections": {
    "1": {
      "title": "كتاب الآداب",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "2": {
      "title": "لابن شمس الخلافة",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "3": {
      "title": "جعفر بن محمد بن مختار الأفضلي",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "4": {
      "title": "باب الحكمة من النثر",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "5": {
      "title": "وقال أمير المؤمنين علي رضي الله عنه من لم يتأمل الأمور بعين عقله, لم يقع سيف",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "6": {
      "title": "وكتب أبو بكر رضي الله عنه إلى عكرمة بن أبي جهل - وهو عامله على عمان - إياك أن",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 2
    },
    "7": {
      "title": "وقال عمر بن الخطاب رضي الله عنه ms01 ما عاقبت من عصى الله فيك, بمثل أن تطيع الله فيه.",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "8": {
      "title": "من المأثور عن الحكماء",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 5
    },
    "9": {
      "title": "وقال أرسطو طاليس للطالب البالغ, لذة الإدراك, وللطالب ms04 المحروم, راحة اليأس.",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "10": {
      "title": "وقال بزرجمهر الشدائد قبل المواهب بمنزلة الجوع قبل الطعام, يحسن به موقعه ويلذ معه",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "11": {
      "title": "وقال نصر بن سيار كل شيء يبدو صغيرا ثم يكبر, إلا المصيبة فإنها تبدو كبيرة ثم",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 6
    },
    "12": {
      "title": "وقال خالد بن برمك التعزية بعد ثلاث تجديد للمصيبة, والتهنئة بعد ثلاث استخفاف",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "13": {
      "title": "وقال آخر مثل الذي يعلم الناس الخير ولا يعمل به, كمثل أعمى بيده سراج يستضيء به",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "14": {
      "title": "وقال آخر لولا أن بين المحبوبات عوارض من المكاره, لما استعذب مذاقها ولا حسن",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 7
    },
    "15": {
      "title": "وقال بعض الحكماء إياك والعجلة, فإنه مكسبة للمذلة, مجلبة للندامة, منفرة لأهل",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "16": {
      "title": "وقال خالد بن صفوان لابنه يا بني! كن أحسن ما تكون في الظاهر حالا, أقل ما تكون في",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "17": {
      "title": "وفي كتاب كليلة ودمنة إذا أحدث لك العدو صداقة لعلة ألجأته إليك, فمع ذهاب العلة",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 8
    },
    "18": {
      "title": "وقال ابن المعتز الحوادث الممضة مكسبة لحظوظ جزيلة. منها ثواب مدخور, وتطهير من",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 9
    },
    "19": {
      "title": "وقال حسان بن تبع الحميري لا تثقن بالملك فإنه ملول, ms08 ولا بالمرأة فإنها حرون, ولا",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "20": {
      "title": "وقال آخر النفس غير فارغة أبدا, فإن شغلتها بما يصلحها, وإلا شغلتك بما يفسدك.",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "21": {
      "title": "وقال محمد بن عبد الملك الزيات احذروا الصديق الجاهل, أكثر من حذركم العدو العاقل,",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "22": {
      "title": "وقال النعمان بن المنذر من سأل فوق قدره استحق الحرمان, ومن ألحف في المسألة استحق",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 10
    },
    "23": {
      "title": "وقيل لأعرابي لم قطعت أخاك وهو من أبيك وأمك؟ فقال إني لأقطع العضو الفاسد وهو أقرب",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "24": {
      "title": "وقال العتبي سمعت أعرابيا يقول لآخر إن فلانا وإن خف عليك, فإن عقاربه تسري إليك,",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "25": {
      "title": "وقال إعرابي لآخر اسحب من يتناسى معروفه عندك, ويتذكر حقوقك عليه.",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 11
    },
    "26": {
      "title": "وقال هارون الرشيد لإسماعيل بن صبيح إياك والدالة فإنها تفسد الحرمة, وتنقص الذمة,",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "27": {
      "title": "وقال آخر حركة الإقبال بطيئة وحركة الإدبار سريعة, لأن المقبل كالصاعد مرقاة,",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "28": {
      "title": "وقيل لبعضهم ما الحزم؟ فقال سوء الظن بالناس. قيل فما الصواب؟ قال المشورة. قيل فما",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "29": {
      "title": "وعرض مروان الحمار جنده فكان سبعين ألف عربي على سبعين ألف عربي. فقال إذا انقضت",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 12
    },
    "30": {
      "title": "وقال بعضهم لأبي العيناء - وراءه ضعيفا من الكبر - كيف أصبحت أبا العيناء؟ فقال",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "31": {
      "title": "وقال أبو بكر الخوارزمي صغير البر ألطف وأطيب, كما أن قليل الماء أشهى وأعذب.",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "32": {
      "title": "وقيل لشريك بن عبد الله إن معاوية كان حليما. فقال كلا, لو كان حليما ما سفه الحق",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 13
    },
    "33": {
      "title": "وقال دارا الأكبر مثل العدو الضاحك إليك, مثل الحنظلة النضرة أوراقها القاتل",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "34": {
      "title": "وقال آخر دع الكذب حيث ترى أنه ينفعك, فإنه يضرك. واستعمل الصدق حيث ترى أنه يضرك ,",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "35": {
      "title": "وقال ابن المقفع إذا حاججت فلا تغضب, فإن الغضب يقطع عنك الحجة, ويظهر عليك الخصم.",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "36": {
      "title": "فصل",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "37": {
      "title": "في الملوك وذكر أحوالهم",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 14
    },
    "38": {
      "title": "وقال بهرام جور لا شيء أضر بالملوك من استخبار من لا يصدق أن خبر, واستكفاء من لا",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "39": {
      "title": "وقال ابن المقفع ليس للملك أن يغضب, لأن القدرة من وراء حاجته؛ وليس له أن يكذب,",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "40": {
      "title": "وكان كسرى يقول عاملوا الأحرار بمحض المودة, وعاملوا العامة بالرغبة والرهبة,",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 15
    },
    "41": {
      "title": "وقال عمر بن الخطاب رضي الله عنه لا يصلح لهذا الأمر إلا اللين في غير ضعف, القوي",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 15
    },
    "42": {
      "title": "فصل",
      "level": 1,
      "parent": null,
      "start_ms": 15,
      "end_ms": 16
    },
    "43": {
      "title": "فيما يجب على من يصحب ms15 السلطان",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "44": {
      "title": "وقال خالد بن صفوان من صحب السلطان بالنصيحة والأمانة, كان أكثر عدوا ممن صحبه",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 16
    },
    "45": {
      "title": "وقال أفلاطون إذا خدمت ملكا فلا تطعه في معصية بارئك, فإن إحسانه إليك أفضل من",
      "level": 1,
      "parent": null,
      "start_ms": 16,
      "end_ms": 17
    },
    "46": {
      "title": "وقال أفلاطون لا تشيرن على الملك في أحد بما تكره أن يعمله في أمرك إذا حللت محله.",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "47": {
      "title": "في ذم الحسد",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "48": {
      "title": "وقال عمرو بن العاص ما بلغني عن أحد شنآن قط, إلا سللت سخيمة قلبه بجهدي, إلا حاسد",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "49": {
      "title": "ووجد في كتاب لجعفر بن يحيى - أربعة أسطر مكتوبة بالذهب - الرزق مقسوم, الحريص",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "50": {
      "title": "فصل",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "51": {
      "title": "في ذم الغيبة",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 18
    },
    "52": {
      "title": "وقال رجل للحسن البصري بلغني أنك تغتابني. فقال لم يبلغ من مقامك عندي أن أحكمك في",
      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 19
    },
    "53": {
      "title": "فصل في الإخوان والحض عليهم",
      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 20
    },
    "54": {
      "title": "فصل",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 20
    },
    "55": {
      "title": "وقال آخر التواضع مع البخل والجهل, أحسن من التكبر مع البذل والعقل؛ فأعظم بحسنة",
      "level": 1,
      "parent": null,
      "start_ms": 20,
      "end_ms": 21
    },
    "56": {
      "title": "في مدح التواضع",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "57": {
      "title": "في الحض على اكتساب الأدب",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 22
    },
    "58": {
      "title": "فصل",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 22
    },
    "59": {
      "title": "اثنين",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 22
    },
    "60": {
      "title": "وقال لقمان لابنه يا بني شيئان إذا أنت حفظتهما لا تبالي ما صنعت بعدهما؛ ذنبك",
      "level": 1,
      "parent": null,
      "start_ms": 22,
      "end_ms": 23
    },
    "61": {
      "title": "فصل ثلاثة",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 23
    },
    "62": {
      "title": "وقال عمر بن الخطاب رضي الله عنه ثلاث تثبتن لك الود في صدر أخيك أن تبدأه بالسلام,",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 24
    },
    "63": {
      "title": "ولما قتل أنو شروان, بزرجمهر وجد في منطقته كتابا فيه ثلاث كلمات. وهي إن كان القدر",
      "level": 1,
      "parent": null,
      "start_ms": 24,
      "end_ms": 25
    },
    "64": {
      "title": "وقال سليمان بن داود عليهما السلام أبغضت نفسي ثلاثة وغرت أن تطلع الشمس عليهن؛",
      "level": 1,
      "parent": null,
      "start_ms": 25,
      "end_ms": 25
    },
    "65": {
      "title": "وقال العالم رضي الله عنه إن الله خبأ ثلاثا في ثلاث خبأ رضاه في يسير من طاعته,",
      "level": 1,
      "parent": null,
      "start_ms": 25,
      "end_ms": 26
    },
    "66": {
      "title": "وفي كتاب كليلة ودمنة لينفق ذو المال ماله في ثلاثة مواضع في الصدقة إن أراد",
      "level": 1,
      "parent": null,
      "start_ms": 26,
      "end_ms": 26
    },
    "67": {
      "title": "وكان يقال من ألهم ثلاثا لم يحرم من ألهم الدعاء؛ لم يحرم الإجابة, ومن ألهم",
      "level": 1,
      "parent": null,
      "start_ms": 26,
      "end_ms": 26
    },
    "68": {
      "title": "وقال سهل بن هارون ثلاثة من المجانين وإن كانوا من العقلاء الغضبان, والسكران,",
      "level": 1,
      "parent": null,
      "start_ms": 26,
      "end_ms": 27
    },
    "69": {
      "title": "فصل",
      "level": 1,
      "parent": null,
      "start_ms": 27,
      "end_ms": 27
    },
    "70": {
      "title": "أربعة",
      "level": 1,
      "parent": null,
      "start_ms": 27,
      "end_ms": 27
    },
    "71": {
      "title": "وعن المدايني قال خرج الزهري يوما من عند هشام بن عبد الملك. فقال ما سمعت بمثل",
      "level": 1,
      "parent": null,
      "start_ms": 27,
      "end_ms": 27
    },
    "72": {
      "title": "وقال محمد بن الربيع, لحاتم الأصم على ما بنيت أمرك؟ قال على أربع خصال علمت أن",
      "level": 1,
      "parent": null,
      "start_ms": 27,
      "end_ms": 28
    },
    "73": {
      "title": "وقال المأمون الناس بين أربع طبقات إمارة, وتجارة, وصناعة, وزارعة. فمن لم يكن من",
      "level": 1,
      "parent": null,
      "start_ms": 28,
      "end_ms": 28
    },
    "74": {
      "title": "فصل خمسة",
      "level": 1,
      "parent": null,
      "start_ms": 28,
      "end_ms": 29
    },
    "75": {
      "title": "وقال علي كرم الله وجهه أوصيكم بخمس لو ضربتم إليها آباط الإبل لكان قليلا",
      "level": 1,
      "parent": null,
      "start_ms": 29,
      "end_ms": 30
    },
    "76": {
      "title": "فصل ستة",
      "level": 1,
      "parent": null,
      "start_ms": 30,
      "end_ms": 30
    },
    "77": {
      "title": "وقال أمير المؤمنين علي رضي الله عنه لا خير في صحبة من اجتمع فيه ست خصال إن حدثك",
      "level": 1,
      "parent": null,
      "start_ms": 30,
      "end_ms": 30
    },
    "78": {
      "title": "وقال بعض الحكماء عمارة الدنيا منوطة بستة أشياء",
      "level": 1,
      "parent": null,
      "start_ms": 30,
      "end_ms": 32
    },
    "79": {
      "title": "فصل",
      "level": 1,
      "parent": null,
      "start_ms": 32,
      "end_ms": 32
    },
    "80": {
      "title": "ثمانية",
      "level": 1,
      "parent": null,
      "start_ms": 32,
      "end_ms": 33
    },
    "81": {
      "title": "فصل تسعة",
      "level": 1,
      "parent": null,
      "start_ms": 33,
      "end_ms": 34
    },
    "82": {
      "title": "وقيل ms33 لحكيم. ما النعمة؟ قال هي في تسعة أشياء",
      "level": 1,
      "parent": null,
      "start_ms": 34,
      "end_ms": 34
    },
    "83": {
      "title": "فصل عشرة",
      "level": 1,
      "parent": null,
      "start_ms": 34,
      "end_ms": 34
    },
    "84": {
      "title": "باب الفصول القصار من البلاغة والحكمة",
      "level": 1,
      "parent": null,
      "start_ms": 34,
      "end_ms": 34
    },
    "85": {
      "title": "فصل في ألفاظ يتمثل بها من القرآن الكريم",
      "level": 1,
      "parent": null,
      "start_ms": 34,
      "end_ms": 36
    },
    "86": {
      "title": "فصل في أمثال العرب",
      "level": 1,
      "parent": null,
      "start_ms": 36,
      "end_ms": 36
    },
    "87": {
      "title": "فصل الأخبار بما أوله ألف",
      "level": 1,
      "parent": null,
      "start_ms": 36,
      "end_ms": 40
    },
    "88": {
      "title": "فصل الأخبار بسائر الحروف",
      "level": 1,
      "parent": null,
      "start_ms": 40,
