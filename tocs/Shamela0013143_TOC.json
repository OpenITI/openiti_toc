    },
    "20": {
      "title": ": \" رأيت كأني أدخلت الجنة، فإذا بالثوري، والأوزاعي، وغيرهم، ولم أر مالكا، فسألت عن مالك، قيل",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "21": {
      "title": "8 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "22": {
      "title": ": «من صام يوم عاشوراء كتب الله له بها عبادة ستين سنة بصيامها وقيامها، ومن صام يوم عاشوراء",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "23": {
      "title": "[ص: 72]",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 6
    },
    "24": {
      "title": "9 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "25": {
      "title": "المحرم شهر الله وإن فيه يوما يعني عاشوراء، أذنب فيه قوم ذنبا عظيما، فتابوا فيه، فكان يسمى",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "26": {
      "title": "10 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "27": {
      "title": ": «كان يوم عاشوراء يوما يصام في الجاهلية، فلما فرض شهر رمضان من شاء صامه، ومن شاء لم",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "28": {
      "title": ": «ما رأيت أحدا ممن كان بالكوفة من أصحاب رسول الله صلى الله عليه وسلم آمر بصوم عاشوراء من",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "29": {
      "title": "12 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "30": {
      "title": ": «من وسع على عياله يوم عاشوراء، وسع الله عليه سائر سنته»",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "31": {
      "title": "13 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "32": {
      "title": ": «لئن عشت إلى قابل لأصومن التاسع يعني يوم عاشوراء»",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "33": {
      "title": "14 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 7
    },
    "34": {
      "title": "يصوم يوم عاشوراء، ويأمر بصيامه»",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "35": {
      "title": "15 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "36": {
      "title": ": \" أوفدني يوسف بن عمر إلى هشام بن عبد الملك في وفد العراق، فقدمت عليه، وقد خرج متبديا",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
