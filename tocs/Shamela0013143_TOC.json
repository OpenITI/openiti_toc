    "8": {
      "title": "أشد، أو أكثر ما أخاف على أمتي عمل قوم لوط»",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "9": {
      "title": ": «إذا تزوج العبد بغير إذن سيده، فهو عاهر»",
      "level": 1,
