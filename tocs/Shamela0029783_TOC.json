      "end_ms": 5
    },
    "24": {
      "title": ": «من زار مسجدي هذا لا يزوره إلا ويصلي فيه ركعتين أو أربع ركعات كان له عند الله عدل حجة",
      "level": 1,
      "parent": null,
      "start_ms": 5,
