{
  "filename": "0845Maqrizi.MukhtasarKamil.Shamela0005848-ara1.mARkdown",
  "sections": {
    "1": {
      "title": "مقدمة المؤلف",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "2": {
      "title": "باب من لم يكثر من الرواية مخافة [الزلل] .",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 2
    },
    "3": {
      "title": "باب وزر (الكاذب) على رسول الله - صلى الله عليه وسلم - إذا أضل به الناس، وشدة عقوبة من يكذب عليه فيحل الحرام ويحرم الحلال",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 3
    },
    "4": {
      "title": "باب أعظم الكذب هو الكذب على رسول الله - صلى الله عليه وسلم - والكذب عليه ليس كالكذب على غيره، وأن الكاذب عليه لا يريح ريح الجنة، وأن عليه لعنة الله والملائكة والناس أجمعين.",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "5": {
      "title": "باب اتقاء حديث النبي - صلى الله عليه وسلم - إلا ما يتيقنه [ويعلمه ويعرفه]",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 4
    },
    "6": {
      "title": "باب تحريم الكذب على رسول الله - صلى الله عليه وسلم - وأن الذي يروي عنه كذبا هو أحدهما، وإن كان الكاذب فيه غيره.",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "7": {
      "title": "باب من شدد من الصحابة في الرواية عنه فرقا من الكذب فيه وقال: كبرناونسينا. ومن قال: لأن يخر من السماء أحب إليه من (أن) يكذب عليه",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 5
    },
    "8": {
      "title": "باب من كان إذا حدث فزع، وقال: \" أو كما قال \". وإنكار من أنكر منهم على من أكثر من الرواية عنه",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 6
    },
    "9": {
      "title": "باب كتابة الحديث وتدوينه وحفظه عند قصر الإسناد",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 7
    },
    "10": {
      "title": "باب من اختار قلة الحديث، وذم من أكثر منه.",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 8
    },
    "11": {
      "title": "باب الكاذب يكتب عند الله كذابا، أو يهديه إلى كذبه الفجور، وما نهي عن الكذب في الجد والهزل، وإن الكذاب مخلاف / لموعده",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 9
    },
    "12": {
      "title": "باب الكذاب [يكون] مجانبا للإيمان، و [أن] الكذب يكون من مهانة النفس، وأن الظريف لا يكذب",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 10
    },
    "13": {
      "title": "باب التدليس من الكذب، والتلقين هو الذي يكذب فيه",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "14": {
      "title": "باب كل الكذب يكتب على ابن آدم، واللسان الكاذب من أعظم الخطايا، ومن أكبر الخيانة أن تحدث أخاك بحديث هو لك مصدق وأنت له كاذب.",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 11
    },
    "15": {
      "title": "باب طلب الغريب علامة الكذب، والجراح في الكتاب علامة الصدق، وأن آفةالكذب النسيان",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "16": {
      "title": "باب ما يفشو آخر الزمان من الكذابين على رسول الله - صلى الله عليه وسلم -، وما يتوقع من ظهور الشياطين للناس فيحدثون ويفتنون.",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 12
    },
    "17": {
      "title": "ذكر من استجاز تكذيب من تبين له كذبه من الصحابة والتابعين وتابعي التابعين ومن بعدهم",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 38
    },
    "18": {
      "title": "فمن الصحابة رضي الله عنهم:",
      "level": 2,
      "parent": 17,
      "start_ms": 12,
      "end_ms": 14
    },
    "19": {
      "title": "ومن التابعين:",
      "level": 2,
      "parent": 17,
      "start_ms": 14,
      "end_ms": 20
    },
    "20": {
      "title": "ومن تابعي التابعين",
      "level": 2,
      "parent": 17,
      "start_ms": 20,
      "end_ms": 38
    },
    "21": {
      "title": "قال ابن عدي: وفي هذه الطبقة ممن أدركتهم وكتبت عنهم أو يقاربونهم في الإسناد والمعرفة ومحلهم محل من ذكرت في طبقتهم، وكلهم يجوز لهم الكلام في الرجال.",
      "level": 3,
      "parent": 20,
      "start_ms": 38,
      "end_ms": 38
    },
    "22": {
      "title": "من مدح الحجاز والعراق ورواتهما وذم البصرة والكوفة وبغداد ورواتهم",
      "level": 1,
      "parent": null,
      "start_ms": 38,
      "end_ms": 39
    },
    "23": {
      "title": "ما يخاف على هذه الأمة من الهلكة إذا رووا عن غير الثقات",
      "level": 1,
      "parent": null,
      "start_ms": 39,
      "end_ms": 40
    },
    "24": {
      "title": "ذكر القوم الذين يميزون الرجال وصفتهم",
      "level": 1,
      "parent": null,
      "start_ms": 40,
      "end_ms": 41
    },
    "25": {
      "title": "نهي الرجل أن يأخذ دينه إلا عمن يرضاه لأن العلم دين",
      "level": 1,
      "parent": null,
      "start_ms": 41,
      "end_ms": 42
    },
    "26": {
      "title": "صفة من لا يؤخذ عنه العلم",
      "level": 1,
      "parent": null,
      "start_ms": 42,
      "end_ms": 43
    },
    "27": {
      "title": "صفة من يؤخذ عنه العلم",
      "level": 1,
      "parent": null,
      "start_ms": 43,
      "end_ms": 44
    },
