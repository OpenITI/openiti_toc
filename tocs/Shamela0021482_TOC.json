    },
    "2": {
      "title": ": «اغزوا تغنموا، وصوموا تصحوا، وسافروا تغنموا»",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "3": {
      "title": "2 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "4": {
      "title": "توضأ مرة مرة»",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "5": {
      "title": "3 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "6": {
      "title": ": \" توضأ النبي صلى الله عليه وسلم مرة مرة، ثم قال: هذا وضوء من لا يقبل الله له صلاة إلا به،",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "7": {
      "title": "4 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "8": {
      "title": ": \" اشتكت النار إلى ربها عز وجل، فقالت: أي رب، أكل بعضي بعضا، فأذن لها بنفسين، نفس بالشتاء،",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "9": {
      "title": "5 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "10": {
      "title": ": «فضل عائشة على النساء، كفضل الثريد على سائر الطعام»",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "11": {
      "title": "6 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 2
    },
    "12": {
      "title": ": «لو كان المؤمن في جحر، قيض له من يؤذيه»",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "13": {
      "title": "7 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "14": {
      "title": ": «إذا ولغ الكلب في الإناء، فاغسلوا سبع مرات إحداهن بالتراب»",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "15": {
      "title": "8 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "16": {
      "title": ": «من أنكح بغير ولي، فنكاحها باطل، والسلطان ولي من لا ولي له»",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "17": {
      "title": "9 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "18": {
      "title": ": «من أصبح مرضيا لوالديه أو أحدهما، أصبح له بابان مفتوحان إلى الجنة، ومن أصبح مسخطا لوالديه",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "19": {
      "title": "10 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "20": {
      "title": ": \" لا يفطرن الصائم: القيء، والاحتلام، والحجامة \"",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "21": {
      "title": "11 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "22": {
      "title": ": «من قرأ آية الكرسي دبر كل صلاة مكتوبة، دخل الجنة»",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "23": {
      "title": "12 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 3
    },
    "24": {
      "title": "، «من دعاكم على كراع، فأجيبوه»",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "25": {
      "title": "13 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "26": {
      "title": ": «لا تدخل الملائكة بيتا فيه كلب، ولا صورة»",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "27": {
      "title": "14 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "28": {
      "title": ": «العائد في هبته، كالكلب يعود في قيئه»",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "29": {
      "title": "15 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "30": {
      "title": ": «تابعوا بين الحج والعمرة، فوالذي نفسي بيده، إن متابعتهما لتنفي الفقر، والذنوب عن العبد،",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": null
    }
