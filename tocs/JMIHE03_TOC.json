    "10": {
      "title": "فصل في أنه تعالى لا يجوز أن يكون عالما قادرا حيا بمعان قديمة كائنة فيما لم يزل",
      "level": 2,
      "parent": 9,
      "start_ms": 8,
      "end_ms": 8
    },
    "11": {
      "title": "فصل في أن كل ذات لا بد من كونها مثلا لغيرها أو مخالفة له",
      "level": 2,
      "parent": 9,
      "start_ms": 8,
      "end_ms": 9
    },
    "12": {
      "title": "فصل فيما يفيده وصفنا للشيء أنه مخالف لغيره ومثل له",
      "level": 2,
      "parent": 9,
      "start_ms": 9,
      "end_ms": 12
    },
    "13": {
      "title": "فصل في أن الذات لا تخالف وتوافق من حيث كانت ذاتا",
      "level": 2,
      "parent": 9,
      "start_ms": 12,
      "end_ms": 13
    },
    "14": {
      "title": "في أن الخلاف والوفاق لا يكونان بالمعاني",
      "level": 2,
      "parent": 9,
      "start_ms": 13,
      "end_ms": 14
    },
    "15": {
      "title": "في أن الخلاف والوفاق لا يقعان بالأسماء",
      "level": 2,
      "parent": 9,
      "start_ms": 14,
      "end_ms": 15
    },
    "16": {
      "title": "في الصفات",
