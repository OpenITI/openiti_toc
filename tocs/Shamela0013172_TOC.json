    "11": {
      "title": "وأما حديث أهل مكة حديث عمرو بن دينار الذي رواه سفيان بن عيينة فأسنده",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "12": {
      "title": "[ص: 46]",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "13": {
      "title": "وأما حديث حماد بن زيد، عن عمرو الذي نقص من إسناده ابن عباس",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "14": {
      "title": "[ص: 47]",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 4
    },
    "15": {
      "title": "وأما حديث أهل الكوفة الذي تفرد به شيبان عن الأعمش ووافق أهل مكة، فقال: عن ابن عباس، عن عمر، عن النبي صلى الله عليه وسلم",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "16": {
      "title": "[ص: 48]",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "17": {
      "title": "[ص: 50]",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "18": {
      "title": "وأما حديث عمار بن رزيق بمتابعته ما روى شيبان بن عبد الرحمن عن الأعمش",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 5
    },
    "19": {
      "title": "[ص: 52]",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "20": {
      "title": "[ص: 53]",
      "level": 1,
      "parent": null,
      "start_ms": 5,
