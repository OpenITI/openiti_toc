{
  "filename": "0410IbnMardawayh.Majalis.Shamela0008275-ara1",
  "sections": {
    "1": {
      "title": "1 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "2": {
      "title": "[ص: 106]",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "3": {
      "title": "يؤخذ الرجل فيحفر له في الأرض فيجعل فيها، ويجاء بالمنشار فيوضع على رأسه، فينشر باثنين، فما",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "4": {
      "title": "2 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 2
    },
    "5": {
      "title": "كلكم راع، وكلكم مسؤول عن رعيته؛ الرجل عن أهل بيته، والمرأة عن أهل بيتها، والعبد عن مال",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "6": {
      "title": "3 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "7": {
      "title": ": «خير الدعاء يوم عرفة، وخير ما جاء به النبيون قبلي لا إله إلا الله»",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "8": {
      "title": "4 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "9": {
      "title": ": \" لا يحقرن أحدكم يرى أمرا لله فيه مقال أن يقول فيه، فيبعثه الله عز وجل يوم القيامة، فيقول:",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "10": {
      "title": "5 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "11": {
      "title": "قسم بينكم أخلاقكم كما قسم بينكم أرزاقكم، وإن الله تعالى يعطي الدنيا من يحب ومن لا يحب،",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 3
    },
    "12": {
      "title": "6 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "13": {
      "title": "قسم بينكم أخلاقكم كما قسم بينكم أرزاقكم، وإن الله عز وجل يعطي المال من يحب ومن لا يحب ولا",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "14": {
      "title": "7 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "15": {
      "title": "أولى الناس بالله وبرسوله الذي بدأهم بالسلام»",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "16": {
      "title": "8 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 4
    },
    "17": {
      "title": ": «من اطلع في بيت قوم قبل أن يأذنوا له فقد حل لهم أن يفقؤوا عينه»",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "18": {
      "title": "9 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "19": {
      "title": "أصحاب هذه الصور يعذبون يوم القيامة، ويقال لهم: أحيوا ما خلقتم \"",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "20": {
      "title": "10 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "21": {
      "title": ": «أذهب البأس رب الناس، واشف أنت الشافي، لا شافي إلا أنت، اللهم إني أسألك شفاء لا يغادر",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "22": {
      "title": "11 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "23": {
      "title": ": \" إن كنا لنطرد على عهد رسول الله صلى الله عليه وسلم أن نصلي بين الساريتين إلا أن نلجأ",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "24": {
      "title": "12 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "25": {
      "title": ": يا أهل الجنة، تخلدون فلا تموتون أبدا، وتصحون فلا تمرضون أبدا، وتشبون فلا تهرمون أبدا،",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "26": {
      "title": "13 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 5
    },
    "27": {
      "title": "يكتحل كل ليلة، ويحتجم كل شهر، ويشرب الدواء في كل سمة",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "28": {
      "title": "14 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "29": {
      "title": ": \" هلاك هذه الأمة إذا بغت نساؤها ورجالها، واستخف بالقرآن، وكان النكاح زنى: يطلق الرجل",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "30": {
      "title": "15 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "31": {
      "title": "، لك الحمد لما بسطت رزقنا، وأظهرت أمننا، وأحسنت معافاتنا، ومن كل ما سألناك أعطيتنا، فلك",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "32": {
      "title": "16 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "33": {
      "title": "17 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 6
    },
    "34": {
      "title": "، من لقي الله عز وجل بهما غير شاك لم يحجب عن الجنة»",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "35": {
      "title": "18 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "36": {
      "title": "، فما رآه المسلمون حسنا فهو عند الله حسن، وما رآه المسلمون سيئا فهو عند الله",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "37": {
      "title": "19 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "38": {
      "title": "خلق أحدكم يجمع في بطن أمه خمسة وأربعين يوما، ثم يكون علقة مثل ذلك، ثم يكون مضغة مثل ذلك،",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "39": {
      "title": "20 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 7
    },
    "40": {
      "title": ": اطردهم لا يجترؤون علينا. قال: وكنت أنا وابن مسعود ورجل من هذيل، ورجلان نسيت أسماءهما،",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "41": {
      "title": "21 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "42": {
      "title": "منزلنا غدا إن شاء الله لخيف بني كنانة بحيث تقاسموا على الكفر»",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "43": {
      "title": "22 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "44": {
      "title": "، عندك ما يكفيك فلم تطلب ما يطغيك؟ لا بقليل تقنع، ولا بكثير تشبع، إذا أصبحت آمنا في سربك،",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "45": {
      "title": "23 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "46": {
      "title": ": «الهين اللين السهل القريب»",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "47": {
      "title": "24 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 8
    },
    "48": {
      "title": "ليس شيء يقربكم من النار ويباعدكم عن الجنة إلا وقد نهيتكم عنه، وإنه ليس من شيء يدنيكم من",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "49": {
      "title": "25 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "50": {
      "title": ": رأيت رسول الله صلى الله عليه وسلم والحسن بن علي عليهما السلام يشبهه",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "51": {
      "title": "26 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "52": {
      "title": ": «إذا أتي أحدكم بالطيب فليصب منه»",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "53": {
      "title": "27 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "54": {
      "title": ": «أحب بيوتكم إلى الله عز وجل بيت فيه يتيم مكرم»",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "55": {
      "title": "28 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 9
    },
    "56": {
      "title": ": «لا تجوز شهادة خائن ولا خائنة، ولا ذي غمر على أخيه، ولا موقوفا على حد»",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "57": {
      "title": "29 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "58": {
      "title": ": \" ستة لعنتهم؛ فلعنهم الله، وكل نبي مجاب الدعوة: المكذب بقدر الله، والزائد في كتاب الله،",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "59": {
      "title": "30 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "60": {
      "title": "أذن له بالدعاء»",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "61": {
      "title": "31 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "62": {
      "title": ": \" لا يكن حبك كلفا، ولا يكن بغضك تلفا. قلت: كيف ذلك يا أمير المؤمنين؟ قال: إذا أحببت كلفت",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "63": {
      "title": "32 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 10
    },
    "64": {
      "title": "33 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "65": {
      "title": ": \" لأقضين بينكم بالحق: أما ما أعطيته فيرده إليك، وأما ابنك فيجلد مائة جلدة، ويغرب سنة، وأما",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "66": {
      "title": "34 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "67": {
      "title": ": «إذا اطمأن الرجل إلى الرجل، ثم قتله بعدما اطمأن إليه نصب له لواء غدر»",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "68": {
      "title": "35 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 11
    },
    "69": {
      "title": ": «الخيل معقود بنواصيها الخير إلى يوم القيامة» قيل: وما ذاك؟ قال: «الأجر، والمغنم إلى يوم",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "70": {
      "title": "36 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "71": {
      "title": "في الجنة طيرا له سبعون ألف ريشة، فإذا وضع الخوان قدام ولي من الأولياء جاء الطير فسقط",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "72": {
      "title": "37 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "73": {
      "title": ": «أيما مؤمن سقى مؤمنا شربة على ظمأ سقاه الله عز وجل يوم القيامة من الرحيق المختوم، وأيما",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "74": {
      "title": "38 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "75": {
      "title": ": \" يخرج من النار من قال: لا إله إلا الله وكان في قلبه من الخير ما يزن شعيرة، ثم يخرج من",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "76": {
      "title": "39 -",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 12
    },
    "77": {
      "title": "خلق السماوات وكان الإسلام قديما، وكان فيه زيادة، فأما في آخر الزمان فإنه ينقص» ، قال: فقال",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "78": {
      "title": "40 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "79": {
      "title": ": «على كل ذي ميسم من الإنسان صلاة كل يوم» ، فقال رجل من القوم: هذا من أشد ما أتينا به قال",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "80": {
      "title": "41 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "81": {
      "title": ": \" لا حسد إلا في اثنين: رجل أتاه الله الكتاب فهو يقوم به آناء الليل وآناء النهار، ورجل أتاه",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "82": {
      "title": "42 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "83": {
      "title": "الله أمرني بمداراة الناس كما أمرني بإقامة الفرائض»",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "84": {
      "title": "43 -",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 13
    },
    "85": {
      "title": ": \" ما من عبد يقول حين يمسي أو حين يصبح ثلاث مرات: رضيت بالله ربا، وبالإسلام دينا، ومحمد نبيا",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "86": {
      "title": "44 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "87": {
      "title": ": \" من حج بمال حرام فقال: لبيك اللهم لبيك، قال الله عز وجل له: لا لبيك ولا سعديك، وحجك مردود",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "88": {
      "title": "45 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "89": {
      "title": ": «شر الطعام طعام الوليمة؛ يدعى الشبعان ويترك الغرثان»",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "90": {
      "title": "46 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "91": {
      "title": ": «أيما مؤمن لقي مؤمنا فصافحه وتبسم في وجهه؛ لم يفترقا إلا عن مغفرة»",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "92": {
      "title": "47 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "93": {
      "title": ": «لو تكونون إذا خرجتم من عندي كما تكونون عندي؛ لزاركم الملائكة؛ ولصافحتكم في الطريق، ولو لم",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 13
    },
    "94": {
      "title": "48 -",
      "level": 1,
      "parent": null,
      "start_ms": 13,
      "end_ms": 14
    },
    "95": {
      "title": ": «المؤمن في الدنيا كالغريب، لا ينافس في عزها، ولا يجزع من ذلها، للناس حال وله حال، وجهوا",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": 14
    },
    "96": {
      "title": "49 -",
      "level": 1,
      "parent": null,
      "start_ms": 14,
      "end_ms": null
    }
  },
