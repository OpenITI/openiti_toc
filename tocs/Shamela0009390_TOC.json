      "parent": null,
      "start_ms": 23,
      "end_ms": 23
    },
    "101": {
      "title": "51 -",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 23
    },
    "102": {
      "title": ": «قتل المؤمن عند الله أعظم من زوال الدنيا» .",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 23
    },
    "103": {
      "title": "52 -",
      "level": 1,
      "parent": null,
      "start_ms": 23,
      "end_ms": 24
    },
    "104": {
      "title": "، لقتل المؤمن أعظم عند الله يوم القيامة من زوال الدنيا»",
      "level": 1,
      "parent": null,
      "start_ms": 24,
      "end_ms": 24
    },
    "105": {
      "title": "53 -",
      "level": 1,
      "parent": null,
      "start_ms": 24,
      "end_ms": 24
    },
    "106": {
      "title": ": «لقتل المؤمن أعظم عند الله من زوال الدنيا» .",
      "level": 1,
      "parent": null,
      "start_ms": 24,
      "end_ms": 24
    },
    "107": {
      "title": "54 -",
      "level": 1,
      "parent": null,
      "start_ms": 24,
      "end_ms": 24
    },
    "108": {
      "title": "؟ لو أن أهل السماء والأرض أجمعوا على قتل امرئ مسلم؛ لعذبهم الله بلا عدد ولا",
      "level": 1,
      "parent": null,
      "start_ms": 24,
      "end_ms": 24
    },
    "109": {
      "title": "55 -",
      "level": 1,
      "parent": null,
      "start_ms": 24,
      "end_ms": 25
    },
    "110": {
      "title": ": «لو أجمع أهل السماء وأهل الأرض على قتل امرئ مؤمن؛ لعذبهم الله، عز وجل» .",
      "level": 1,
      "parent": null,
      "start_ms": 25,
      "end_ms": 25
    },
    "111": {
      "title": "56 -",
      "level": 1,
      "parent": null,
      "start_ms": 25,
      "end_ms": 25
    },
    "112": {
      "title": "57 -",
      "level": 1,
      "parent": null,
      "start_ms": 25,
      "end_ms": 25
    },
    "113": {
      "title": ": «لا يشهدن أحدكم قتيلا لعله أن يكون قتل ظلما، فينزل عليه السخط» .",
      "level": 1,
      "parent": null,
      "start_ms": 25,
      "end_ms": 25
    },
    "114": {
      "title": "58 -",
      "level": 1,
      "parent": null,
      "start_ms": 25,
      "end_ms": 26
    },
    "115": {
      "title": ": «لا يعجبنك رحب الذراعين يسفك الدماء، فإن له عند الله قاتلا أو قتيلا لا يموت، ولا يعجبنك",
      "level": 1,
      "parent": null,
      "start_ms": 26,
      "end_ms": 26
    },
    "116": {
      "title": "59 -",
      "level": 1,
      "parent": null,
      "start_ms": 26,
      "end_ms": 26
    },
    "117": {
      "title": ": «قاتل به المشركين ما قوتلوا، فإذا رأيت المسلمين، قد أقبل بعضهم على بعض فامش بسيفك إلى أحد،",
      "level": 1,
      "parent": null,
      "start_ms": 26,
      "end_ms": 26
    },
    "118": {
      "title": "60 -",
      "level": 1,
      "parent": null,
      "start_ms": 26,
      "end_ms": 26
    },
    "119": {
      "title": ": «لا يزال المسلم معنقا صالحا ما لم يصب دما حراما، فإذا أصاب دما حراما",
      "level": 1,
      "parent": null,
      "start_ms": 26,
      "end_ms": 26
    },
    "120": {
      "title": "61 -",
      "level": 1,
      "parent": null,
      "start_ms": 26,
      "end_ms": 27
    },
    "121": {
      "title": ": «أول ما يقضى بين الناس في الدماء، وأول ما يحاسب به العبد الصلاة» .",
      "level": 1,
      "parent": null,
      "start_ms": 27,
      "end_ms": 27
    },
    "122": {
      "title": "62 -",
      "level": 1,
      "parent": null,
      "start_ms": 27,
      "end_ms": 27
    },
    "123": {
      "title": ": حملت على رجل من المشركين، فلما غشيته بالرمح؛ قال: إني مسلم، فظننت أنه متعوذ، فقتلته،",
      "level": 1,
      "parent": null,
      "start_ms": 27,
      "end_ms": 27
    },
    "124": {
      "title": "63 -",
      "level": 1,
      "parent": null,
      "start_ms": 27,
      "end_ms": 28
    },
    "125": {
      "title": ": «كيف أنت ولا إله إلا الله؟» فقال: يا رسول الله: إنما قالها متعوذا، فقال رسول الله، صلى الله",
      "level": 1,
      "parent": null,
      "start_ms": 28,
      "end_ms": 28
    },
    "126": {
      "title": "64 -",
      "level": 1,
      "parent": null,
      "start_ms": 28,
      "end_ms": 28
    },
    "127": {
      "title": ": يأيها الذين آمنوا إذا ضربتم في سبيل الله فتثبتوا أنزلت في رجل من بني مرة بن عوف بن سعد بن",
      "level": 1,
      "parent": null,
      "start_ms": 28,
      "end_ms": 28
    },
    "128": {
      "title": "65 -",
      "level": 1,
      "parent": null,
      "start_ms": 28,
      "end_ms": 29
    },
    "129": {
      "title": "، أضرب رقبته؟ قال: قلت نعم، والآن إن أمرتني فعلت، قال: فقال أبو بكر: \" ليس تلك لأحد بعد رسول",
      "level": 1,
      "parent": null,
      "start_ms": 29,
      "end_ms": 29
    },
    "130": {
      "title": "66 -",
      "level": 1,
      "parent": null,
      "start_ms": 29,
      "end_ms": 29
    },
    "131": {
      "title": "أضرب عنقه؟ قال: لا، ليست لأحد بعد رسول الله، صلى الله عليه وسلم.",
      "level": 1,
      "parent": null,
      "start_ms": 29,
      "end_ms": 29
    },
    "132": {
      "title": "67 -",
      "level": 1,
      "parent": null,
      "start_ms": 29,
      "end_ms": 29
    },
    "133": {
      "title": "الله، عز وجل، لم يحل في الفتنة شيئا حرمه قبل ذلك، ما بال أحدكم يأتي أخاه فيسلم عليه، ثم",
      "level": 1,
      "parent": null,
      "start_ms": 29,
      "end_ms": 29
    },
    "134": {
      "title": "68 -",
      "level": 1,
      "parent": null,
      "start_ms": 29,
      "end_ms": 30
    },
    "135": {
      "title": ": \" يجيء المقتول آخذا قاتله وأوداجه تشخب دما عند ذي العزة، فيقول: رب، سل هذا فيم قتلني؟",
      "level": 1,
      "parent": null,
      "start_ms": 30,
      "end_ms": 30
    },
    "136": {
      "title": "69 -",
      "level": 1,
      "parent": null,
      "start_ms": 30,
      "end_ms": 30
    },
    "137": {
      "title": ": «لا ترجعوا بعدي كفارا يضرب بعضكم رقاب بعض، ولا يؤخذ أحدكم بجريرة ابنه ولا بجريرة",
      "level": 1,
      "parent": null,
      "start_ms": 30,
      "end_ms": 30
    },
    "138": {
      "title": "70 -",
      "level": 1,
      "parent": null,
      "start_ms": 30,
      "end_ms": 30
    },
    "139": {
      "title": "أعتى الناس على الله من قتل في حرم الله، أو قتل غير قاتله، أو قتل بذحول",
      "level": 1,
      "parent": null,
      "start_ms": 30,
      "end_ms": 30
    },
    "140": {
      "title": "71 -",
      "level": 1,
      "parent": null,
      "start_ms": 30,
      "end_ms": 31
    },
    "141": {
      "title": ": «ستكون بعدي فتن شداد، خير الناس فيها مسلمو أهل البوادي، الذين لا يندون من دماء الناس ولا",
      "level": 1,
      "parent": null,
      "start_ms": 31,
      "end_ms": 31
    },
    "142": {
      "title": "72 -",
      "level": 1,
      "parent": null,
      "start_ms": 31,
      "end_ms": 31
    },
    "143": {
      "title": ": «لا يحل لمسلم أن يروع مسلما» .",
      "level": 1,
      "parent": null,
      "start_ms": 31,
      "end_ms": 31
    },
    "144": {
      "title": "73 -",
      "level": 1,
      "parent": null,
      "start_ms": 31,
      "end_ms": 31
    },
    "145": {
      "title": "أمرني: إذا كان قتال بين فئتين من المسلمين أن أتخذ سيفا من خشب، واستل وهو في حجزه، فقال:",
      "level": 1,
      "parent": null,
      "start_ms": 31,
      "end_ms": 31
    },
    "146": {
      "title": "74 -",
      "level": 1,
      "parent": null,
      "start_ms": 31,
      "end_ms": 32
    },
    "147": {
      "title": "ستكون فتنة وفرقة واختلاف، فإذا كان ذلك، فإن استطعت أن تكون المقتول لا القاتل",
      "level": 1,
      "parent": null,
      "start_ms": 32,
      "end_ms": 32
    },
    "148": {
      "title": "75 -",
      "level": 1,
      "parent": null,
      "start_ms": 32,
      "end_ms": 32
    },
    "149": {
      "title": ": «قاتل به ما قوتل العدو، فإذا رأيت الناس يقتل بعضهم بعضا، فاعمد به إلى صخرة فاضربه بها، ثم",
      "level": 1,
      "parent": null,
      "start_ms": 32,
      "end_ms": 32
    },
    "150": {
      "title": "76 -",
      "level": 1,
      "parent": null,
      "start_ms": 32,
      "end_ms": 32
    },
    "151": {
      "title": ": «سيكون من بعدي فتنة، النائم فيها خير من اليقظان، والقاعد خير من القائم، والقائم فيها خير",
      "level": 1,
      "parent": null,
      "start_ms": 32,
      "end_ms": 32
    },
    "152": {
      "title": "77 -",
      "level": 1,
      "parent": null,
      "start_ms": 32,
      "end_ms": 33
    },
    "153": {
      "title": ": «قاتل به ما قوتل العدو، فإذا رأيت الناس يقتل بعضهم بعضا، فاعمد به إلى صخرة فاضربه بها، ثم",
      "level": 1,
      "parent": null,
      "start_ms": 33,
      "end_ms": 33
    },
    "154": {
      "title": "78 -",
      "level": 1,
      "parent": null,
      "start_ms": 33,
      "end_ms": 33
    },
    "155": {
      "title": ": \" إن أدركت شيئا من هذه الفتن فاعمد إلى أحد فاكسر به حد سيفك، ثم اقعد في بيتك، قال: فإن دخل",
      "level": 1,
      "parent": null,
      "start_ms": 33,
      "end_ms": 33
    },
    "156": {
      "title": "79 -",
      "level": 1,
      "parent": null,
      "start_ms": 33,
      "end_ms": 33
    },
    "157": {
      "title": "، كيف تفعل إذا جاع الناس حتى لا تستطيع أن تقوم من فراشك إلى مسجدك ومن مسجدك إلى فراشك؟»",
      "level": 1,
      "parent": null,
      "start_ms": 33,
      "end_ms": 33
    },
    "158": {
      "title": "80 -",
      "level": 1,
      "parent": null,
      "start_ms": 33,
      "end_ms": 34
    },
    "159": {
      "title": "ستكون فتنة وفرقة، فاضرب بسيفك عرض أو عرض أحد، واكسر نبلك، واقطع وترك، واقعد في بيتك، قال:",
      "level": 1,
      "parent": null,
      "start_ms": 34,
      "end_ms": 34
    },
    "160": {
      "title": "81 -",
      "level": 1,
      "parent": null,
      "start_ms": 34,
      "end_ms": 34
    },
    "161": {
      "title": ": «تكون فتنة، النائم فيها خير من المضطجع، والمضطجع فيها خير من القاعد، والقاعد فيها خير من",
      "level": 1,
      "parent": null,
      "start_ms": 34,
      "end_ms": 35
    },
    "162": {
      "title": "82 -",
      "level": 1,
      "parent": null,
      "start_ms": 35,
      "end_ms": 35
    },
    "163": {
      "title": ": «لو أن أهل السماء وأهل الأرض اشتركوا في دم مؤمن؛ لأكبهم الله في النار»",
      "level": 1,
      "parent": null,
      "start_ms": 35,
      "end_ms": 35
    },
    "164": {
      "title": "83 -",
      "level": 1,
      "parent": null,
      "start_ms": 35,
      "end_ms": 35
    },
    "165": {
      "title": ": «الله أضن بدم عبده المؤمن من أحدكم بكريمة ماله حتى يقبضه على فراشه» .",
      "level": 1,
      "parent": null,
      "start_ms": 35,
      "end_ms": 35
    },
    "166": {
      "title": "84 -",
      "level": 1,
      "parent": null,
      "start_ms": 35,
      "end_ms": 36
    },
    "167": {
      "title": ": «ما من رجل استرعاه الله رعية إلا سأله عنها يوم القيامة؛ أقام أمر الله فيهم أم أضاعه؟ حتى",
      "level": 1,
      "parent": null,
      "start_ms": 36,
      "end_ms": 36
    },
    "168": {
      "title": "85 -",
      "level": 1,
      "parent": null,
      "start_ms": 36,
      "end_ms": 36
    },
    "169": {
      "title": ": كيف أصنع بأهل المشرق، والله ما أحب أنها دانت لي سبعين سنة، وأنه قتل في سببي رجل واحد،",
      "level": 1,
      "parent": null,
      "start_ms": 36,
      "end_ms": null
    }
