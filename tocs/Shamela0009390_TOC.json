    "84": {
      "title": "ستكون فتن، النائم فيها خير من اليقظان، والقاعد فيها خير من القائم، والقائم فيها خير من",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "85": {
      "title": "42 -",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "86": {
      "title": ": «ستكون من بعدي فتنة، النائم فيها خير من اليقظان، والقاعد فيها خير من القائم، والقائم خير",
      "level": 1,
      "parent": null,
      "start_ms": 21,
      "end_ms": 21
    },
    "87": {
