      "end_ms": 6
    },
    "19": {
      "title": ": \" لا يحل دم امرئ مسلم يشهد أن لا إله إلا الله وأني رسول الله، إلا بإحدى ثلاث: النفس بالنفس،",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
