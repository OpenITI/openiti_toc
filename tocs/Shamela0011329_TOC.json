    },
    "2": {
      "title": "اقسام ما يجري صفة أو خبرا على الرب",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 5
    },
    "3": {
      "title": "باب الإخبار أوسع من باب الأسماء والصفات",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "4": {
      "title": "الصفة إذا كانت منقسمة إلى كمال ونقص لم تدخل بمطلقها في أسمائه، بل يطلق عليه منها كمالها،",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "5": {
      "title": "لا يلزم الإخبار عنه بالفعل مقيدا أن يشتق له من أسم مطلق",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "6": {
      "title": "أسماء الله الحسنى أعلام وأوصاف والوصف لا ينافي العلمية",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "7": {
      "title": "دلالة الأسماء على الذات تكون بالمطابقة والتضمن الإلتزام",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "8": {
      "title": "الأسماء الحسنى لها إعتبار من حيث الذات وإعتبار من حيث الصفات",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 6
    },
    "9": {
      "title": ": أن ما يطلق عليه في باب الأسماء والصفات توقيفي،",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "10": {
      "title": "الإسم إذ اطلق على الله جاز أن يشتق من المصدر والفعل",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "11": {
      "title": "أفعال الرب صادرة عن أسمائه وصفاته",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "12": {
      "title": ": إحصاء الأسماء الحسنى والعلم بها أصل للعلم بكل معلوم،",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 7
    },
    "13": {
      "title": "أسماء الله كلها حسنى وليس فيها اسم غير ذلك",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "14": {
      "title": "بيان مراتب إحصاء أسماء الله الحسنى",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 8
    },
    "15": {
      "title": "اختلاف النظار في الأسماء التي تطلق على الله وعلى العبد",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "16": {
      "title": "الأسم والصفة لها ثلاث إعتبارات",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "17": {
      "title": "1-",
      "level": 1,
