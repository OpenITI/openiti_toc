      "end_ms": 9
    },
    "20": {
      "title": "الصفة إذا قامت بموصوف لزمها أمور أربعة",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 10
    },
    "21": {
      "title": "الأسماء الحسنى لا تدخل تحت حصر ولا تحد بعدد",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 11
    },
    "22": {
      "title": "الأسماء الأحسنى منها مايطلق عليه مفردا ومقترنا بغيره",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 11
    },
    "23": {
      "title": "الرب تعالى متصف بصفات الكمال المحض وله من الكمال أكمله",
      "level": 1,
      "parent": null,
      "start_ms": 11,
      "end_ms": 12
    },
    "24": {
      "title": "من الأسماء الحسنى ما يكون دالا على عدة صفات",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 12
    },
    "25": {
      "title": "بيان أنواع الإلحاد في أسمائه وصفاته",
      "level": 1,
      "parent": null,
      "start_ms": 12,
      "end_ms": 14
    },
    "26": {
      "title": "خاتمة مشتملة على التنبيه على أهمية هذه القاعدة",
