    "146": {
      "title": "الباب الثالث في أنه هو أول من آمن وأسلم وصلى، ونور الحق قد طلع من قلبه وتجلى",
      "level": 1,
      "parent": null,
      "start_ms": 125,
      "end_ms": 131
    },
    "147": {
      "title": "الباب الرابع في رسوخ قدمه في الإيمان والإسلام، ومرتبة إيمانه ومزية رجحانه في الأنام، وشدته في دين الله عز وجل، ومتابعته سنة رسوله الأجل مدى الليالي والأيام",
      "level": 1,
      "parent": null,
      "start_ms": 131,
      "end_ms": 133
    },
    "148": {
      "title": "الباب الخامس في أن النبي منه وهو من النبي، رغما لكل جاحد غوي وجاهل غبي",
      "level": 1,
      "parent": null,
      "start_ms": 133,
      "end_ms": 135
    },
    "149": {
      "title": "الباب السادس في ذكر محبة النبي إياه ومتى غاب كيف اشتاق إلى محياه",
      "level": 1,
      "parent": null,
      "start_ms": 135,
      "end_ms": 136
    },
    "150": {
      "title": "الباب السابع في ترنم أغاني النبوة في مغاني الفتوة بأحبيته إلى الله ورسول الله،",
      "level": 1,
      "parent": null,
      "start_ms": 136,
      "end_ms": 144
    },
    "151": {
      "title": "الباب الثامن في الحث والتحريض على ولايته ومحبته، والمنع والتحذير عن عداوته ومسبته،",
      "level": 1,
      "parent": null,
      "start_ms": 144,
      "end_ms": 158
    },
    "152": {
      "title": "الباب التاسع في أنه مولى من كان النبي مولاه، فيا له من عطاء ما أجزأه وأولاه!",
      "level": 1,
      "parent": null,
      "start_ms": 158,
      "end_ms": 164
    },
    "153": {
      "title": "الباب العاشر أنه وصي النبي (صلى الله عليه وآله) ووارثه، وولي كل مؤمن بعده، وأنه يقضي دين النبي وينجز وعده",
      "level": 1,
      "parent": null,
      "start_ms": 164,
      "end_ms": 170
    },
    "154": {
      "title": "الباب الحادي عشر في قول النبي (صلى الله عليه وآله) أنه خليفته، وحثه على تأميره، وإبراز ذلك وفق ما في خاطره العاطر وضميره",
      "level": 1,
      "parent": null,
      "start_ms": 170,
      "end_ms": 172
    },
    "155": {
      "title": "الباب الثاني عشر في أن النبي (صلى الله عليه وآله) لما آخى بين كل متماثلين من المهاجرين والأنصار آثره لنفسه بذلك، وهذه رفعة مجد وخلعة جيد ما قدت إلا بقد قدره هنالك",
      "level": 1,
      "parent": null,
      "start_ms": 172,
      "end_ms": 174
    },
    "156": {
      "title": "الباب الثالث عشر في أنه ظهر النبي (صلى الله عليه وآله) ووزيره، ومثله كما سماه ونظيره",
      "level": 1,
      "parent": null,
      "start_ms": 174,
      "end_ms": 177
    },
    "157": {
      "title": "الباب الرابع عشر في أن اسمه قرين اسم النبي في العرش والجنان، فيا له من روح الروح وبرد الجنان",
      "level": 1,
      "parent": null,
      "start_ms": 177,
      "end_ms": 180
    },
    "158": {
      "title": "الباب الخامس عشر في أن النبي (صلى الله عليه وآله) دار حكمة ومدينة علم وعلي لهما باب، وأنه أعلم الناس بالله وأحكامه وأيامه وكلامه بلا ارتياب",
      "level": 1,
      "parent": null,
      "start_ms": 180,
      "end_ms": 187
    },
    "159": {
      "title": "الباب السادس عشر في أنه كما يقاتل النبي (صلى الله عليه وآله) على تنزيل القرآن كان يقاتل على تأويله، وأن النبي توعد به الكفار وكان عليه أكثر تعويله",
      "level": 1,
      "parent": null,
      "start_ms": 187,
      "end_ms": 202
    },
    "160": {
      "title": "الباب السابع عشر فيما أوحى الله إلى نبيه (صلى الله عليه وآله) ليلة الإسراء في سريته،",
      "level": 1,
      "parent": null,
      "start_ms": 202,
      "end_ms": 205
    },
    "161": {
      "title": "الباب الثامن عشر في أنه حاز خصائص أعاظم الأنبياء، وفاز بإيتاء خصال الكمال أكارم الأصفياء",
      "level": 1,
      "parent": null,
      "start_ms": 205,
      "end_ms": 206
    },
    "162": {
      "title": "الباب التاسع عشر في تنويه ملائكة الله بتعريفه وذكره، ورؤيته إياهم وكلامهم معه",
      "level": 1,
      "parent": null,
      "start_ms": 206,
      "end_ms": 209
    },
    "163": {
      "title": "الباب العشرون في أنه حامل لواء النبي (صلى الله عليه وآله) في المشاهد، وخص بهذه الميزة، وحمل لواء الحمد يوم القيامة عن كل مجاهد",
      "level": 1,
      "parent": null,
      "start_ms": 209,
      "end_ms": 210
    },
    "164": {
      "title": "الباب الحادي والعشرون في أن الله باهى به ملائكة السماوات العلى وأنهم والأنبياء مشتاقون إلى لقائه،",
      "level": 1,
      "parent": null,
      "start_ms": 210,
      "end_ms": 211
    },
    "165": {
      "title": "الباب الثاني والعشرون في أنه مختار الملك الجبار بعد النبي المختار من أهل الأرض،",
      "level": 1,
      "parent": null,
      "start_ms": 211,
      "end_ms": 212
    },
    "166": {
      "title": "الباب الثالث والعشرون في بيان منزلته عند النبي (صلى الله عليه وآله)",
      "level": 1,
      "parent": null,
      "start_ms": 212,
      "end_ms": 215
    },
    "167": {
      "title": "الباب الرابع والعشرون في مشاورة النبي (صلى الله عليه وآله) إياه دون غيره",
      "level": 1,
      "parent": null,
      "start_ms": 215,
      "end_ms": 216
    },
    "168": {
      "title": "الباب الخامس والعشرون في عروجه الشريف منكب النبي سيد الأنام، في خروجه إلى دفع الأضداد والأصنام،",
      "level": 1,
      "parent": null,
      "start_ms": 216,
      "end_ms": 216
    },
    "169": {
      "title": "الباب السادس والعشرون في أمر النبي (صلى الله عليه وآله) بسد الأبواب المشروعة في المسجد غير بابه،",
      "level": 1,
      "parent": null,
      "start_ms": 216,
      "end_ms": 218
    },
    "170": {
      "title": "الباب السابع والعشرون فيما له من نفائس الخصائص وشواهق السوابق مما لا يجاريه فيه سابق، ولا يماري فيه لاحق",
      "level": 1,
      "parent": null,
      "start_ms": 218,
      "end_ms": 224
    },
    "171": {
      "title": "الباب الثامن والعشرون في بيان أفضل منزلته عند النبي (صلى الله عليه وآله)",
      "level": 1,
      "parent": null,
      "start_ms": 224,
      "end_ms": 225
    },
    "172": {
      "title": "الباب التاسع والعشرون في أن فيه جميع ما في الناس من حسن الشمائل، وليس في الناس ما فيه من المناقب العلية والفضائل",
      "level": 1,
      "parent": null,
      "start_ms": 225,
      "end_ms": 231
    },
    "173": {
      "title": "الباب الثلاثون في أن النظر إلى وجهه الكريم عبادة، وأن أكابر الصحابة كانوا يحدون النظر إليه بهذه الإرادة",
      "level": 1,
      "parent": null,
      "start_ms": 231,
      "end_ms": 231
    },
    "174": {
      "title": "الباب الحادي والثلاثون في بشارة النبي (صلى الله عليه وآله) بمغفرة الله إياه،",
      "level": 1,
      "parent": null,
      "start_ms": 231,
      "end_ms": 232
    },
    "175": {
      "title": "الباب الثاني والثلاثون في أن الله أرسل إليه هدية من الجنة في الدنيا،",
      "level": 1,
      "parent": null,
      "start_ms": 232,
      "end_ms": 232
    },
    "176": {
      "title": "الباب الثالث والثلاثون في إشفاق النبي عليه وإشفاقه، وحسن معونته إياه وإرفاقه",
      "level": 1,
      "parent": null,
      "start_ms": 232,
      "end_ms": 233
    },
    "177": {
      "title": "الباب الرابع والثلاثون في وصف النبي (صلى الله عليه وآله) شيعته وأتباعه بين الأصحاب، وذكر ما لهم عند الله من الأجر والثواب",
      "level": 1,
      "parent": null,
      "start_ms": 233,
      "end_ms": 235
    },
    "178": {
      "title": "الباب الخامس والثلاثون في ذكر أحواله يوم القيامة ومناصبه وما خصه الله تعالى هنالك من مناقبه",
      "level": 1,
      "parent": null,
      "start_ms": 235,
      "end_ms": 236
    },
    "179": {
      "title": "الباب السادس والثلاثون في جلال علائه وكمال اعتلائه في فراديس الجنات،",
      "level": 1,
      "parent": null,
      "start_ms": 236,
      "end_ms": 238
    },
    "180": {
      "title": "الباب السابع والثلاثون فيما ظهر له وعنه من خصائص الكرامات وإن كان ذكرها دون قدره فيما له من نفائس المقامات",
      "level": 1,
      "parent": null,
      "start_ms": 238,
      "end_ms": 244
    },
    "181": {
      "title": "الباب التاسع والثلاثون في ذكر انكسار جناحه عن الدنيا الدنية وتبرمه عن البقاء في عالم الفناء، واختيار صلاحه في مسامرة الملائكة الأعلى في مواطن القدس العالية البناء",
      "level": 1,
      "parent": null,
      "start_ms": 244,
      "end_ms": 254
    },
    "182": {
      "title": "ذكر إخباره عن نفسه أنه يقتل في المقتولين، فيا من إمام سري مقدام جريء معرض عن الباطل مقبل على الحق في المقبولين",
      "level": 3,
      "parent": null,
      "start_ms": 244,
      "end_ms": 254
    },
    "183": {
      "title": "ذكر سبب ظهور شقاوة قاتله بقتله، وما يعذب به قاتله الآن جزاء لخبله وختله",
      "level": 3,
      "parent": 182,
      "start_ms": 245,
      "end_ms": 247
    },
    "184": {
      "title": "ذكر ما وصى به الأهل والأولاد والأصحاب، لا زال خائضا في رحمة الله في المرجع والمآب",
      "level": 3,
      "parent": 182,
      "start_ms": 247,
      "end_ms": 249
    },
    "185": {
      "title": "ذكر تاريخ وفاته وكيفية موته ومدة عمره، وغسله وكفنه ومن صلى عليه وموضع قبره",
      "level": 3,
      "parent": 182,
      "start_ms": 249,
      "end_ms": 252
    },
    "186": {
      "title": "ذكر قول الحسن (عليه السلام) بعد دفن أبيه، وآيات وعلامات ظهرت بعد قتل هذا الولي الوجيه النبيه",
      "level": 3,
      "parent": 182,
      "start_ms": 252,
      "end_ms": 254
    },
    "187": {
      "title": "الباب الأربعون في ذكر أولاده وأعقابه، يغشاهم رحمة الله متجددة مدى الدهر بتجدد أحقابه",
      "level": 1,
      "parent": null,
      "start_ms": 254,
      "end_ms": 257
    },
    "188": {
      "title": "الباب الحادي والأربعون في نتف من لطائف ثنائه على ربه وأدعيته وشرائف خطبه وموعظته الفصاح، وطرف من طرائف أقضيته وغرائب كتبه وأجوبته الملاح",
      "level": 1,
      "parent": null,
      "start_ms": 257,
      "end_ms": 292
    },
    "189": {
      "title": "[فصل] خاتمة لهذا الباب يعود عائدتها على أولي الألباب",
      "level": 3,
      "parent": null,
      "start_ms": 288,
      "end_ms": 292
    },
    "190": {
      "title": "القسم الثالث في ذكر بواقي أهل البيت الذين بحبهم وموالاتهم حياة كل قلب ميت",
      "level": 1,
      "parent": null,
      "start_ms": 292,
      "end_ms": 292
    },
    "191": {
      "title": "الباب الأول في ذكر أهل البيت وفضائلهم",
      "level": 1,
      "parent": null,
      "start_ms": 292,
      "end_ms": 305
    },
    "192": {
      "title": "ذكر فضائلهم على الإجمال",
      "level": 3,
      "parent": null,
      "start_ms": 292,
      "end_ms": 305
    },
    "193": {
      "title": "ذكر من نزل فيه آية التطهير والإيجاب، ومن المعني بالآل والأهل في ذلك عند ذوي الألباب",
      "level": 3,
      "parent": 192,
      "start_ms": 297,
      "end_ms": 305
    },
    "194": {
      "title": "الباب الثاني في شأن سيدة نساء العالمين في حضرة الكبرياء، الطاهرة البتول الزاهرة لغير الأفول فاطمة قرة عين الرسول سيد الأنبياء",
      "level": 1,
      "parent": null,
      "start_ms": 305,
      "end_ms": 331
    },
    "195": {
      "title": "ذكر سبب تسميتها فاطمة وتحريم ذريتها على النار الحاطمة، وطهارتها من الحيض والنفاس سلام الله تعالى عليه عدد الأنفاس",
      "level": 3,
      "parent": null,
      "start_ms": 306,
      "end_ms": 331
    },
    "196": {
      "title": "ذكر محلها من أبيها وكرامتها عليه وتقبيل النبي إياها وأنها أحب الناس من النساء إليه، وأن الله يغضب لغضبها ويرضى لرضاها لقربتها لديه",
      "level": 3,
      "parent": 195,
      "start_ms": 306,
      "end_ms": 308
    },
    "197": {
      "title": "ذكر فضلها وسيادتها على النسوان في الدنيا وفي الجنة الرضوان",
      "level": 3,
      "parent": 195,
      "start_ms": 308,
      "end_ms": 310
    },
    "198": {
      "title": "ذكر من خطبها من أكابر الصحابة فلم ينل من النبي (صلى الله عليه وآله) القبول والإجابة فخطبها علي فزوجها إياه وكرم بذلك وجهه ومحياه",
      "level": 3,
      "parent": 195,
      "start_ms": 310,
      "end_ms": 322
    },
    "199": {
      "title": "ذكر سيرتها وسمتها وما لحقها من الشدة والضيق في معيشتها،",
      "level": 3,
      "parent": 195,
      "start_ms": 322,
      "end_ms": 328
    },
    "200": {
      "title": "ذكر ارتحالها عن هذه الدنيا الدنية وانتقالها منها إلى الدرجات العليا السنية وذكر من يلي غسلها ودفنها والصلاة عليها وكيفية عبورها في المحشر وظهور أنواع كرامة الله تعالى لديها",
      "level": 3,
      "parent": 195,
      "start_ms": 328,
      "end_ms": 330
    },
    "201": {
      "title": "ذكر من صلى عليها ومن دخل في قبرها",
      "level": 3,
      "parent": 195,
      "start_ms": 330,
      "end_ms": 330
    },
    "202": {
      "title": "ذكر موضع قبرها",
      "level": 3,
      "parent": 195,
      "start_ms": 330,
      "end_ms": 331
    },
    "203": {
      "title": "الباب الثالث في ذكر سبطي رسول الله وقرطي عرش الله،",
      "level": 1,
      "parent": null,
      "start_ms": 331,
      "end_ms": null
    },
    "204": {
      "title": "فلنذكر الآن ما ورد من الفضائل، مختصا بالحسن المجتبى الكريم الشمائل",
      "level": 3,
      "parent": null,
      "start_ms": 334,
      "end_ms": null
    },
    "205": {
      "title": "ذكر الفضائل المخصوصة بالحسين وأحد القرطين وثاني السبطين،",
      "level": 3,
      "parent": 204,
      "start_ms": 337,
      "end_ms": 338
    },
    "206": {
      "title": "ذكر ما ورد من الفضائل لهذين السيدين الأخوين معا،",
      "level": 3,
      "parent": 204,
      "start_ms": 338,
      "end_ms": 345
    },
    "207": {
      "title": "ذكر أحوال وأقوال وأفعال تؤثر وتروى، عن الإمام ابن الإمام الحسن المجتبى، الذي يحيى بحبه قلب كل مؤمن ويقوى",
      "level": 3,
      "parent": 204,
      "start_ms": 345,
      "end_ms": 351
    },
    "208": {
      "title": "ذكر خروجه إلى معاوية وتسليم الأمر له لما استشهد أمير المؤمنين علي المرتضى عليه التحية من الله تعالى ما هو أولى وأرضى",
      "level": 3,
      "parent": 204,
      "start_ms": 351,
      "end_ms": 352
    },
    "209": {
      "title": "ذكر وفاة الحسن عليه من التحية ما هي أولى وأحسن",
      "level": 3,
      "parent": 204,
      "start_ms": 352,
      "end_ms": 356
    },
    "210": {
      "title": "ذكر أولاد الحسن ومن تعقب منهم وذكر بعض ذريته",
      "level": 3,
      "parent": 204,
      "start_ms": 356,
      "end_ms": 357
    },
    "211": {
      "title": "ذكر أخبار وردت في مقتل أحد السبطين أبي عبد الله الحسين (عليه السلام)، وتاريخ قتله، وذكر قاتله، فيا خزي من اجترأ عليه وسوء مصير فاعله",
      "level": 3,
      "parent": 204,
      "start_ms": 357,
      "end_ms": 360
    },
    "212": {
      "title": "وأما سبب قتله آتاه الله تعالى مزيد فضله",
      "level": 3,
      "parent": 204,
      "start_ms": 360,
      "end_ms": 369
    },
    "213": {
      "title": "ذكر آيات وكرامات ظهرت في مقتل هذا الإمام العالي المقامات",
      "level": 3,
      "parent": 204,
      "start_ms": 369,
      "end_ms": 372
    },
    "214": {
      "title": "ذكر مراثي وأشعار قيلت في مقتله (عليه السلام) جزاء لما ضيق عليه في مخرجه ومدخله",
      "level": 3,
      "parent": 204,
      "start_ms": 372,
      "end_ms": 378
    },
    "215": {
      "title": "ذكر أولاده وذريته وأعقابه (عليهم السلام)",
      "level": 3,
      "parent": 204,
      "start_ms": 378,
      "end_ms": 380
    },
    "216": {
      "title": "وها أنا أذكر بعض شأنه وأمره، وما أعطاه الله علو مقاماته ورفعة قدره",
      "level": 3,
      "parent": 204,
      "start_ms": 380,
      "end_ms": null
    }
