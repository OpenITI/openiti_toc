      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 19
    },
    "180": {
      "title": ": «إن الرجل ليكون من أهل الصلاة والزكاة والعمرة والحج، حتى ذكر سهام الخير، وما يجزى يوم",
      "level": 1,
