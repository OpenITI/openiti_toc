      "level": 1,
      "parent": null,
      "start_ms": 18,
      "end_ms": 19
    },
    "174": {
      "title": ": \" ثلاثة يدعون الله فلا يستجيب لهم: رجل أعطى ماله سفيها، وقال الله عز وجل {ولا تؤتوا السفهاء",
      "level": 1,
