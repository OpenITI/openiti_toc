      "end_ms": 17
    },
    "156": {
      "title": ": \" هل كان رسول الله صلى الله عليه وسلم يقرأ في الظهر والعصر؟ قال: نعم.",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "157": {
      "title": "85 -",
      "level": 1,
      "parent": null,
      "start_ms": 17,
      "end_ms": 17
    },
    "158": {
      "title": ": \" قل: سبحان الله، والحمد لله، ولا إله إلا الله، والله أكبر، ولا حول ولا قوة إلا بالله \" فضم",
      "level": 1,
