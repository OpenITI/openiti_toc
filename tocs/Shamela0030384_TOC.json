      "level": 1,
      "parent": null,
      "start_ms": 19,
      "end_ms": 20
    },
    "182": {
      "title": ": إني وقعت على أهلي، وكان ذلك في شهر رمضان، فقال رسول الله صلى الله عليه وسلم: «أعتق",
      "level": 1,
      "parent": null,
      "start_ms": 20,
