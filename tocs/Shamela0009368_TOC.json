    "2": {
      "title": "حارثة تزوج إلى طيئ بامرأة من بني نبهان، فأولدها: جبلة وأسماء , وأسامة , وزيدا، وتوفيت",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 4
    },
    "3": {
      "title": "2 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "4": {
      "title": "أن يأتيها في منزلها , فيصلي في مكان يتخذ مصلى، ففعل النبي صلى الله عليه وسلم أتاها",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 5
    },
    "5": {
      "title": "3 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "6": {
      "title": ": \" قدمت عير من طعام، فيها جمل لعثمان بن عفان عليه دقيق حواري وسمن وعسل، فأتاها النبي صلى",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "7": {
      "title": "4 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "8": {
      "title": "\" عن المسح على الخفين، فقال: أمرنا رسول الله صلى الله عليه وسلم بثلاثة أيام ولياليهن",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "9": {
      "title": "5 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "10": {
      "title": "يحمل هذا العلم من كل خلف عدوله، ينفون عنه تحريف الغالين، وانتحال المبطلين، وتأويل",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "11": {
      "title": "6 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 6
    },
    "12": {
      "title": ": «بين الملحمة الكبرى وفتح وخروج الدجال سبعة أشهر»",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "13": {
      "title": "7 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "14": {
      "title": ": «بين يدي الدجال نيف وسبعون دجالا»",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "15": {
      "title": "8 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "16": {
      "title": ": «إني أنذركم من الدجال كما أنذر نوح قومه»",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "17": {
      "title": "9 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "18": {
      "title": ": \" إذا فرغ أحدكم من التشهد فليتعوذ من أربع: من عذاب جهنم، ومن عذاب القبر، وفتنة المحيا",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "19": {
      "title": "10 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "20": {
      "title": "\" أخر ليلة صلاة العشاء ثم خرج، فقال: إنما حبسني حديث كان تميم الداري، يحدثنيه عن رجل كان في",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 6
    },
    "21": {
      "title": "11 -",
      "level": 1,
      "parent": null,
      "start_ms": 6,
      "end_ms": 7
    },
    "22": {
      "title": ": «صعد رسول الله صلى الله عليه وسلم المنبر، وكان لا يصعد إلا يوم الجمعة» ، وذكر حديث الجساسة ms06",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "23": {
      "title": "12 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "24": {
      "title": ": «رأيت الدجال رجل أقمر هجان ضخم، كأن شعر رأسه أغصان شجرة، أعور كأن عينه كوكب الصبح، شبهته",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "25": {
      "title": "13 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "26": {
      "title": ": «على أنقاب المدينة ملائكة لا يدخلها الدجال ولا الطاعون»",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "27": {
      "title": "14 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "28": {
      "title": ": «ليس من بلد إلا سيطؤها الدجال، إلا مكة والمدينة ليس نقب من نقابها إلا عليه الملائكة حافين",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "29": {
      "title": "15 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "30": {
      "title": ": «أهل الجنة عشرون ومائة صف، أمتي منها ثمانون صفا»",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "31": {
      "title": "16 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "32": {
      "title": ": «من جاء منكم الجمعة فليغتسل»",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 7
    },
    "33": {
      "title": "17 -",
      "level": 1,
      "parent": null,
      "start_ms": 7,
      "end_ms": 8
    },
    "34": {
      "title": ": «عموا بالسلام، وعموا بالتشميت»",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "35": {
      "title": "18 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "36": {
      "title": "يسلم عن يمينه السلام عليكم ورحمة الله، وعن يساره السلام عليكم ورحمه",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "37": {
      "title": "19 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "38": {
      "title": "توضأ فخلل لحيته بالماء، ثم قال: هكذا أمرني ربي عز وجل \"",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "39": {
      "title": "20 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "40": {
      "title": "\" يقرأ على المنبر: قل يا أيها الكافرون وقل هو الله أحد \"",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "41": {
      "title": "21 -",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
    "42": {
      "title": "«جمع بين المغرب والعشاء بجمع صلاة المغرب ثلاثا والعشاء ركعتين بإقامة",
      "level": 1,
      "parent": null,
      "start_ms": 8,
      "end_ms": 8
    },
