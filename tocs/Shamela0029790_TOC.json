    "7": {
      "title": "4 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "8": {
      "title": ": «النظر إلى المصحف عبادة، والنظر إلى الرجل الذي يدعو إلى السنة وينهى عن البدعة عبادة»",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 9
    },
    "9": {
      "title": "5 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "10": {
      "title": ": \" تحروا ليلة القدر لسبع عشرة، في صبيحة يوم بدر، ولسبع يبقين، ولتسع يبقين؛ فإن الشمس بين",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "11": {
      "title": "6 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "12": {
      "title": "لا يخرج من بيته حتى ينظر في كتبه",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 9
    },
    "13": {
      "title": "7 -",
      "level": 1,
      "parent": null,
      "start_ms": 9,
      "end_ms": 10
    },
    "14": {
      "title": ": «من خرج في طلب العلم فهو في سبيل الله حتى يرجع»",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "15": {
      "title": "8 -",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 10
    },
    "16": {
      "title": ": «لا ينبغي أن يكون الحسد والملق إلا في طلب العلم» .",
      "level": 1,
      "parent": null,
      "start_ms": 10,
      "end_ms": 13
    },
    "17": {
