    "3": {
      "title": "فصل وشهر رمضان من جملة الشهور",
      "level": 3,
      "parent": 2,
      "start_ms": 2,
      "end_ms": 3
    },
    "4": {
      "title": "فصل والذي يدل على فساد ذلك أنه لو وجب على الإنسان في كفارة ظهار",
      "level": 3,
      "parent": 2,
      "start_ms": 3,
      "end_ms": 3
    },
    "5": {
      "title": "فصل وأما ما تعلق به أصحاب العدد في أن شهر رمضان لا يكون أقل من ثلاثين يوما",
      "level": 3,
      "parent": 2,
      "start_ms": 3,
      "end_ms": 4
    },
    "6": {
      "title": "فصل ومما تعلقوا به أيضا",
      "level": 3,
      "parent": 2,
      "start_ms": 4,
      "end_ms": 5
    },
    "7": {
      "title": "فصل وأما رواه الحديث بأن شهر رمضان شهر من شهور السنة يكون تسعة وعشرين يوما ويكون ثلاثين يوما",
      "level": 3,
      "parent": 2,
      "start_ms": 5,
      "end_ms": 9
    },
    "8": {
      "title": "فصل فأما ما تعلق به من شذ عن أصحابنا ومال إلى مذهب الغلاة وبعض الشيعة في العدد",
      "level": 3,
      "parent": 2,
      "start_ms": 9,
      "end_ms": 10
    },
    "9": {
      "title": "فصل وبعد فإن الذي يرد عنهم على سبيل التقية لا ينقله جمهور فقهائهم",
