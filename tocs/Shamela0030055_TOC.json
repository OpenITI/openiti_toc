    "1": {
      "title": "1 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "2": {
      "title": ": \" سيصاح برجل من أمتي على رؤوس الخلائق , وينشر عليه تسعة وتسعون سجلا كل سجل منها مد البصر",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "3": {
      "title": "2 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "4": {
      "title": ": \" يأتي الله عز وجل بالعبد المؤمن يوم القيامة حتى يجعله في حجابه , فيقول له: اقرأ صحيفتك",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 1
    },
    "5": {
      "title": "3 -",
      "level": 1,
      "parent": null,
      "start_ms": 1,
      "end_ms": 2
    },
    "6": {
      "title": ": «إن الله عز وجل أعطاني ما لم يعط أحدا من الأنبياء , وفضلني على جميع العالمين , وجعل لأمتي",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "7": {
      "title": "4 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "8": {
      "title": ": «يا ابن آدم ما تنصفني , أتحبب إليك بالنعم وتتمقت إلي بالمعاصي , خيري إليك ينزل , وشركك إلي",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 2
    },
    "9": {
      "title": "5 -",
      "level": 1,
      "parent": null,
      "start_ms": 2,
      "end_ms": 3
    },
    "10": {
      "title": ": «اشهدوا سكان سماواتي أني غفرت له»",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "11": {
      "title": "6 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "12": {
      "title": ": «يا غلام من أنا؟» قال: أنت رسول الله , قال: «صدقت بارك الله فيك» .",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "13": {
      "title": "7 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "14": {
      "title": ": \" إن الله عز وجل أعطى ملكا من الملائكة أسماع الخلائق وهو قائم على قبري حتى تقوم الساعة",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 3
    },
    "15": {
      "title": "8 -",
      "level": 1,
      "parent": null,
      "start_ms": 3,
      "end_ms": 4
    },
    "16": {
      "title": ": «ليس يتحسر أهل الجنة إلا على ساعة مرت بهم لا يذكرون الله عز وجل فيها»",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "17": {
      "title": "9 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "18": {
      "title": "9 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "19": {
      "title": ": «إن البخيل من إذا ذكرت عنده فلم يصل علي , صلى الله عليه وسلم»",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 4
    },
    "20": {
      "title": "10 -",
      "level": 1,
      "parent": null,
      "start_ms": 4,
      "end_ms": 5
    },
    "21": {
      "title": ": «إن ابنك قد غفر له بحسن ظنه بربه» قال: قال رسول الله صلى الله عليه وسلم: \" إن عبدا في جهنم",
      "level": 1,
      "parent": null,
      "start_ms": 5,
      "end_ms": 5
    },
    "22": {
      "title": "11 -",
      "level": 1,
      "parent": null,
      "start_ms": 5,
