    "63": {
      "title": "1/ قوله تعالى: @QUR@09 ومن الناس من يشري نفسه ابتغاء مرضات الله",
      "level": 3,
      "parent": null,
      "start_ms": 90,
      "end_ms": null
    },
    "64": {
      "title": "2/ قوله تعالى: @QUR@08 يا أيها الذين آمنوا ادخلوا في السلم كافة",
      "level": 3,
      "parent": 63,
      "start_ms": 93,
      "end_ms": 93
    },
    "65": {
      "title": "3/ قوله تعالى: @QUR@010 فمن يكفر بالطاغوت ويؤمن بالله فقد استمسك بالعروة الوثقى",
      "level": 3,
      "parent": 63,
      "start_ms": 93,
      "end_ms": 93
    },
    "66": {
      "title": "4/ قوله تعالى: @QUR@014 إن الله اصطفى آدم ونوحا وآل إبراهيم وآل عمران على العالمين",
      "level": 3,
      "parent": 63,
      "start_ms": 93,
      "end_ms": 93
    },
    "67": {
      "title": "5/ قوله تعالى: @QUR@030 فمن حاجك فيه من بعد ما جاءك من العلم فقل تعالوا ندع أبناءنا وأبناءكم ونساءنا ونساءكم وأنفسنا وأنفسكم ثم نبتهل فنجعل لعنت الله على الكاذبين",
      "level": 3,
      "parent": 63,
      "start_ms": 93,
      "end_ms": 94
    },
    "68": {
      "title": "6/ قوله تعالى: @QUR@08 واعتصموا بحبل الله جميعا ولا تفرقوا",
      "level": 3,
      "parent": 63,
      "start_ms": 94,
      "end_ms": 94
    },
    "69": {
      "title": "7/ قوله تعالى: @QUR@08 إن الله يأمركم أن تؤدوا الأمانات إلى أهلها",
      "level": 3,
      "parent": 63,
      "start_ms": 94,
      "end_ms": 94
    },
    "70": {
      "title": "8/ قوله تعالى: @QUR@09 أم يحسدون الناس على ما آتاهم الله من فضله",
      "level": 3,
      "parent": 63,
      "start_ms": 94,
      "end_ms": 94
    },
    "71": {
      "title": "9/ قوله تعالى: @QUR@017 إنما وليكم الله ورسوله والذين آمنوا الذين يقيمون الصلاة ويؤتون الزكاة وهم راكعون",
      "level": 3,
      "parent": 63,
      "start_ms": 94,
      "end_ms": 95
    },
    "72": {
      "title": "10/ قوله تعالى: @QUR@09 واتقوا فتنة لا تصيبن الذين ظلموا منكم خاصة",
      "level": 3,
      "parent": 63,
      "start_ms": 95,
      "end_ms": 96
    },
    "73": {
      "title": "11/ قوله تعالى: @QUR@06 هو الذي أيدك بنصره وبالمؤمنين",
      "level": 3,
      "parent": 63,
      "start_ms": 96,
      "end_ms": 96
    },
    "74": {
      "title": "12/ قوله تعالى: @QUR@031 فإذا انسلخ الأشهر الحرم فاقتلوا المشركين حيث وجدتموهم وخذوهم واحصروهم واقعدوا لهم كل مرصد فإن تابوا وأقاموا الصلاة وآتوا الزكاة فخلوا سبيلهم إن الله غفور رحيم",
      "level": 3,
      "parent": 63,
      "start_ms": 96,
      "end_ms": 96
    },
    "75": {
      "title": "13/ قوله تعالى: @QUR@010 يا أيها الذين آمنوا اتقوا الله وكونوا مع الصادقين",
      "level": 3,
      "parent": 63,
      "start_ms": 96,
      "end_ms": 97
    },
    "76": {
      "title": "14/ قوله تعالى: @QUR@05 قل بفضل الله وبرحمته",
      "level": 3,
      "parent": 63,
      "start_ms": 97,
      "end_ms": 97
    },
    "77": {
      "title": "15/ قوله تعالى: @QUR@011 أفمن كان على بينة من ربه ويتلوه شاهد منه",
      "level": 3,
      "parent": 63,
      "start_ms": 97,
      "end_ms": 97
    },
    "78": {
      "title": "16/ قوله تعالى: @QUR@07 إنما أنت منذر ولكل قوم هاد",
      "level": 3,
      "parent": 63,
      "start_ms": 97,
      "end_ms": 98
    },
    "79": {
      "title": "17/ قوله تعالى: @QUR@010 والباقيات الصالحات خير عند ربك ثوابا وخير أملا",
      "level": 3,
      "parent": 63,
      "start_ms": 98,
      "end_ms": 99
    },
    "80": {
      "title": "18/ قوله تعالى: @QUR@07 وأمر أهلك بالصلاة واصطبر عليها",
      "level": 3,
      "parent": 63,
      "start_ms": 99,
      "end_ms": 99
    },
    "81": {
      "title": "19/ قوله تعالى: @QUR@07 فسئلوا أهل الذكر إن كنتم لا تعلمون",
      "level": 3,
      "parent": 63,
      "start_ms": 99,
      "end_ms": 99
    },
    "82": {
      "title": "20/ قوله تعالى: @QUR@017 الذين إن مكناهم في الأرض أقاموا الصلاة وآتوا الزكاة وأمروا بالمعروف ونهوا عن المنكر",
      "level": 3,
      "parent": 63,
      "start_ms": 99,
      "end_ms": 100
    },
    "83": {
      "title": "21/ قوله تعالى: @QUR@06 في بيوت أذن الله أن ترفع",
      "level": 3,
      "parent": 63,
      "start_ms": 100,
      "end_ms": 100
    },
    "84": {
      "title": "22/ قوله تعالى: @QUR@09 لا تدعوا اليوم ثبورا واحدا وادعوا ثبورا كثيرا",
      "level": 3,
      "parent": 63,
      "start_ms": 100,
      "end_ms": 101
    },
    "85": {
      "title": "23/ قوله تعالى: @QUR@016 والذين يقولون ربنا هب لنا من أزواجنا وذرياتنا قرة أعين واجعلنا للمتقين إماما",
      "level": 3,
      "parent": 63,
      "start_ms": 101,
      "end_ms": 101
    },
    "86": {
      "title": "24/ قوله تعالى: @QUR@011 إن نشأ ننزل عليهم من السماء آية فظلت أعناقهم لها خاضعين",
      "level": 3,
      "parent": 63,
      "start_ms": 101,
      "end_ms": 102
    },
    "87": {
      "title": "25/ قوله تعالى: @QUR@04 وأنذر عشيرتك الأقربين",
      "level": 3,
      "parent": 63,
      "start_ms": 102,
      "end_ms": 104
    },
    "88": {
      "title": "26/ قوله تعالى: @QUR@019 أمن يجيب المضطر إذا دعاه ويكشف السوء ويجعلكم خلفاء الأرض أإله مع الله قليلا ما تذكرون",
      "level": 3,
      "parent": 63,
      "start_ms": 104,
      "end_ms": 104
